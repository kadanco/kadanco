---
// src/layouts/Layout.astro
//
// IMPORTANT, reconcile the <head> below with your CURRENT Layout.astro.
// I did not have your original Layout, so I reconstructed a sensible head
// (charset, viewport, title/description, canonical, OG/Twitter, favicon, fonts,
// global.css). Keep anything you already have that is not here: analytics,
// specific favicon files, a real og-default image, verification tags, etc.
// If you paste your current Layout, I will merge precisely instead.
//
// What changed structurally: Layout now renders the shared Nav, Footer and
// ContactModal around <slot/>, and owns the global UI script (colour-aware nav,
// scroll progress, section spy). Pages no longer hard-code any of these.
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import ContactModal from '../components/ContactModal.astro';

const {
  title = 'Kadanco. Senior marketing operators for B2B companies.',
  description = 'Kadanco is a senior, full-stack marketing function for B2B companies. Two operators own the strategy and run the execution themselves. Owned and executed.',
  ogImage = 'https://assets.kadanco.com/og-default.png',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://kadanco.com').href;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#1A0175" />

    <!-- Open Graph / Twitter (reconcile with your current tags) -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Favicon (reconcile paths with what you actually have in R2 / public) -->
    <link rel="icon" href="https://assets.kadanco.com/favicons/favicon.svg" type="image/svg+xml" />

    <!-- Fira Sans (weights/method may differ from your current setup) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fira+Sans:ital,wght@0,400;0,500;0,600;0,900;1,500&display=swap" rel="stylesheet" />

    <slot name="head" />
  </head>
  <body>
    <Nav />

    <slot />

    <Footer />
    <ContactModal />

    <!-- Global UI: colour-aware nav, scroll progress, section spy. -->
    <!-- Moved here from index.astro so it runs on every page exactly once. -->
    <script is:inline>
      (function () {
        var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        var nav = document.querySelector('.nav');
        if (nav) {
          var themed = Array.prototype.slice.call(document.querySelectorAll('[data-theme]'));
          var navTheme = function () {
            var probe = 40, theme = 'dark';
            for (var i = 0; i < themed.length; i++) {
              var r = themed[i].getBoundingClientRect();
              if (r.top <= probe && r.bottom > probe) { theme = themed[i].getAttribute('data-theme'); break; }
            }
            nav.classList.toggle('nav--light', theme === 'light');
            nav.classList.toggle('nav--dark', theme !== 'light');
          };
          window.addEventListener('scroll', navTheme, { passive: true });
          window.addEventListener('resize', navTheme);
          navTheme();
        }

        if (!reduce) {
          var bar = document.createElement('div'); bar.className = 'scroll-progress'; document.body.appendChild(bar);
          var update = function () { var d = document.documentElement; var max = d.scrollHeight - d.clientHeight; bar.style.transform = 'scaleX(' + (max > 0 ? d.scrollTop / max : 0) + ')'; };
          window.addEventListener('scroll', update, { passive: true }); window.addEventListener('resize', update); update();
        }
        if (!reduce && 'IntersectionObserver' in window) {
          var io = new IntersectionObserver(function (entries) {
            entries.forEach(function (entry) { if (entry.isIntersecting) { entry.target.classList.add('is-visible'); io.unobserve(entry.target); } });
          }, { threshold: 0.1, rootMargin: '0px 0px -40px 0px' });
          var sel = '.section .eyebrow, .section h2, .section .lead, .section .grid, .section .who-top, .section .embed-slot, .section .tags, .section .founders-grid, .section .compliance-row';
          document.querySelectorAll(sel).forEach(function (el) {
            if (el.getBoundingClientRect().top < window.innerHeight * 0.92) return;
            el.classList.add('reveal'); io.observe(el);
          });
        }
        if ('IntersectionObserver' in window) {
          var map = {};
          document.querySelectorAll('.nav-links .navlink').forEach(function (a) { var href = a.getAttribute('href') || ''; var h = href.indexOf('#'); if (h >= 0) { var id = href.slice(h + 1); if (id) map[id] = a; } });
          var ids = Object.keys(map);
          if (ids.length) {
            var spy = new IntersectionObserver(function (entries) {
              entries.forEach(function (entry) { if (!entry.isIntersecting) return; ids.forEach(function (id) { map[id].classList.remove('active'); }); if (map[entry.target.id]) map[entry.target.id].classList.add('active'); });
            }, { rootMargin: '-45% 0px -50% 0px' });
            ids.forEach(function (id) { var s = document.getElementById(id); if (s) spy.observe(s); });
          }
        }
      })();
    </script>
  </body>
</html>