---
// src/layouts/Layout.astro
//
// Head restored verbatim from the pre-refactor Layout (commit 84c1d91):
// the real adaptive favicon pair, the correct Fira Sans weights (incl. 700),
// and the original OG tags. The only structural change versus that original is
// the body: this Layout now renders the shared Nav, Footer and ContactModal
// around <slot/>, and owns the global UI script (scroll progress, motion,
// section spy), so pages no longer hard-code any of these.
//
// `themeable`: the page supports dark mode. Only then does the nav show the
// light/dark toggle; every other page is pinned to light.
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import ContactModal from '../components/ContactModal.astro';
import { defaultLocale, switcherLocales } from '../i18n/ui';
import { asLocale, basePath, hasTranslation, localizeUrl } from '../i18n/utils';

const { title, description, themeable = false } = Astro.props;

// Active locale, canonical URL, and hreflang alternates. We only advertise a
// language version that actually exists (see translatedRoutes in i18n/ui.ts),
// so search engines never follow an hreflang into a fallback redirect.
const locale = asLocale(Astro.currentLocale);
const base = basePath(Astro.url.pathname, locale);
const withSlash = (p) => (p === '/' ? '/' : p + '/');
const canonicalHref = new URL(localizeUrl(locale, withSlash(base)), Astro.site).href;
const alternates = switcherLocales.filter((l) => hasTranslation(l, base));
const showHreflang = alternates.length > 1;
const altHref = (l) => new URL(localizeUrl(l, withSlash(base)), Astro.site).href;
---
<!doctype html>
<html lang={locale} data-mode={themeable ? undefined : 'light'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalHref} />
    {showHreflang && alternates.map((l) => <link rel="alternate" hreflang={l} href={altHref(l)} />)}
    {showHreflang && <link rel="alternate" hreflang="x-default" href={altHref(defaultLocale)} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="https://assets.kadanco.com/public/og.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Kadanco. Stop buying marketing management. Start buying execution." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content="https://assets.kadanco.com/public/og.png" />

    <!-- Flags JS before first paint so the hero can start hidden without flashing. -->
    <script is:inline>document.documentElement.className += ' js';</script>
    <!-- Restores the visitor's theme choice before first paint (themeable pages only). -->
    {themeable && <script is:inline>try { var m = localStorage.getItem('kd-theme'); if (m === 'light' || m === 'dark') document.documentElement.setAttribute('data-mode', m); } catch (e) {}</script>}
    <!-- Anime.js 4.5.0, self-hosted rather than CDN: no third-party request, so no
         visitor IP leaves the EU and nothing extra to declare in the privacy policy.
         Deferred, so it is parsed before DOMContentLoaded but never blocks render. -->
    <script is:inline defer src="/vendor/anime.umd.min.js"></script>

    <!-- Consent + analytics. CookieYes loads FIRST and sets Google Consent Mode
         defaults (all denied) before GTM. GA4 and any other tags are configured
         INSIDE the GTM container and fire only after consent. Both are is:inline
         so they emit verbatim and are never bundled (standalone previews keep
         working). Do not reorder: CookieYes must come before GTM. -->
    <!-- Start cookieyes banner -->
    <script is:inline id="cookieyes" type="text/javascript" src="https://cdn-cookieyes.com/client_data/abbfd62297b528b6e712cd6a9df37028/script.js"></script>
    <!-- End cookieyes banner -->
    <!-- Google Tag Manager -->
    <script is:inline>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer','GTM-MF44PR8H');</script>
    <!-- End Google Tag Manager -->

    <link rel="icon" type="image/svg+xml" href="https://assets.kadanco.com/logo/favicon-dark.svg" media="(prefers-color-scheme: light)" />
    <link rel="icon" type="image/svg+xml" href="https://assets.kadanco.com/logo/favicon-light.svg" media="(prefers-color-scheme: dark)" />
    <link rel="icon" type="image/svg+xml" href="https://assets.kadanco.com/logo/favicon-dark.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fira+Sans:ital,wght@0,400;0,500;1,400&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-MF44PR8H" height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->
    <Nav themeable={themeable} />

    <slot />

    <Footer />
    <ContactModal />

    <!-- Global UI: colour-aware nav, scroll progress, motion, section spy. -->
    <!-- Lives here so it runs on every page exactly once. -->
    <script is:inline>
      (function () {
        var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        // Colour-aware nav (original look): white text over dark grounds, ink
        // over light ones. Reads the real background just under the nav, so it
        // works on every page and in dark mode. A gradient or image counts as
        // dark unless a parent says data-theme="light".
        var nav = document.querySelector('.nav');
        if (nav) {
          var lum = function (rgb) {
            var m = rgb.match(/\d+(\.\d+)?/g); if (!m) return 1;
            var c = m.slice(0, 3).map(function (v) { v = v / 255; return v <= 0.03928 ? v / 12.92 : Math.pow((v + 0.055) / 1.055, 2.4); });
            return 0.2126 * c[0] + 0.7152 * c[1] + 0.0722 * c[2];
          };
          var groundUnder = function () {
            var x = window.innerWidth / 2, y = nav.offsetHeight + 4;
            var stack = document.elementsFromPoint ? document.elementsFromPoint(x, y) : [];
            for (var i = 0; i < stack.length; i++) {
              var el = stack[i];
              if (nav.contains(el)) continue;
              var cs = getComputedStyle(el);
              if (cs.backgroundImage && cs.backgroundImage !== 'none' && el.tagName !== 'IMG') {
                var tagged = el.closest('[data-theme]');
                return tagged ? tagged.getAttribute('data-theme') : 'dark';
              }
              var bg = cs.backgroundColor;
              var alpha = bg.match(/rgba?\([^)]*,\s*([\d.]+)\)$/);
              if (bg && bg !== 'transparent' && !(alpha && parseFloat(alpha[1]) === 0) && bg.indexOf('rgba(0, 0, 0, 0)') !== 0) {
                return lum(bg) > 0.4 ? 'light' : 'dark';
              }
            }
            return 'dark';
          };
          var navTheme = function () {
            var theme = groundUnder();
            nav.classList.toggle('nav--light', theme === 'light');
            nav.classList.toggle('nav--dark', theme !== 'light');
          };
          window.addEventListener('scroll', navTheme, { passive: true });
          window.addEventListener('resize', navTheme);
          window.addEventListener('kd-theme-change', function () { setTimeout(navTheme, 30); });
          if (window.matchMedia) { var mqd = window.matchMedia('(prefers-color-scheme: dark)'); if (mqd.addEventListener) mqd.addEventListener('change', navTheme); }
          navTheme();
        }

        if (!reduce) {
          var bar = document.createElement('div'); bar.className = 'scroll-progress'; document.body.appendChild(bar);
          var update = function () { var d = document.documentElement; var max = d.scrollHeight - d.clientHeight; bar.style.transform = 'scaleX(' + (max > 0 ? d.scrollTop / max : 0) + ')'; };
          window.addEventListener('scroll', update, { passive: true }); window.addEventListener('resize', update); update();
        }
        // ---------------- MOTION ----------------
        // Anime.js drives the entrances. It is deferred, so it is guaranteed to be
        // parsed by DOMContentLoaded. If it failed to load we fall back to the CSS
        // class path, so content is never left stuck invisible.
        var REVEAL_SEL = '.section .eyebrow, .section h2, .section .lead, .section .grid, .section .who-top, .section .embed-slot, .section .tags, .section .founders-grid, .section .compliance-row'
          // homepage sections in the October design
          + ', .home-head, .home-offers, .home-uc, .home-uc-all, .home-faq, .cmp-text, .cmx';

        // Shared motion tokens. Confident but restrained: short travel, quick settle.
        var M = { dur: 620, ease: 'out(3)', rise: 18, stagger: 70 };

        function whenVisible(el, cb, margin) {
          var io = new IntersectionObserver(function (entries) {
            entries.forEach(function (e) { if (e.isIntersecting) { io.unobserve(e.target); cb(e.target); } });
          }, { threshold: 0.15, rootMargin: margin || '0px 0px -40px 0px' });
          io.observe(el);
        }

        // Fallback: the original CSS-class reveal, used if Anime.js is unavailable.
        function legacyReveal() {
          document.documentElement.classList.add('motion-off');
          var io = new IntersectionObserver(function (entries) {
            entries.forEach(function (entry) { if (entry.isIntersecting) { entry.target.classList.add('is-visible'); io.unobserve(entry.target); } });
          }, { threshold: 0.1, rootMargin: '0px 0px -40px 0px' });
          document.querySelectorAll(REVEAL_SEL).forEach(function (el) {
            if (el.getBoundingClientRect().top < window.innerHeight * 0.92) return;
            el.classList.add('reveal'); io.observe(el);
          });
        }

        function heroIntro(A) {
          var items = document.querySelectorAll('.hero .container > *');
          if (!items.length) return;
          A.animate(items, {
            opacity: [0, 1],
            translateY: [22, 0],
            duration: 760,
            delay: A.stagger(90, { start: 80 }),
            ease: 'out(4)'
          });
        }

        function revealOnScroll(A) {
          document.querySelectorAll(REVEAL_SEL).forEach(function (el) {
            // Above-the-fold content is shown immediately, never animated in.
            if (el.getBoundingClientRect().top < window.innerHeight * 0.92) return;
            A.utils.set(el, { opacity: 0, translateY: M.rise });
            whenVisible(el, function (target) {
              A.animate(target, { opacity: [0, 1], translateY: [M.rise, 0], duration: M.dur, ease: M.ease });
            });
          });
        }

        // Generic choreography for the inline SVG diagrams on the use-case pages.
        // Shapes settle in, connector strokes draw themselves, labels fade last.
        function diagrams(A) {
          document.querySelectorAll('svg[data-anim="diagram"]').forEach(function (svg) {
            var shapes = svg.querySelectorAll('rect, circle');
            var texts = svg.querySelectorAll('text');
            // Paths that already carry a dash pattern are decorative dashed
            // connectors: drawing them would overwrite the dashes, so they fade.
            var draws = [], fades = [];
            svg.querySelectorAll('path').forEach(function (pth) {
              if (pth.closest('defs')) return; // arrow markers must stay put
              // closest() catches a dash pattern set on the path OR inherited from a
              // parent <g>. Drawing those would replace the dashes with a solid line.
              (pth.closest('[stroke-dasharray]') ? fades : draws).push(pth);
            });

            A.utils.set(shapes, { opacity: 0, scale: 0.96 });
            A.utils.set(texts, { opacity: 0 });
            A.utils.set(fades, { opacity: 0 });

            whenVisible(svg, function () {
              var tl = A.createTimeline({ defaults: { ease: M.ease } });
              tl.add(shapes, { opacity: [0, 1], scale: [0.96, 1], duration: 520, delay: A.stagger(55) }, 0);
              if (draws.length) {
                tl.add(A.svg.createDrawable(draws), { draw: ['0 0', '0 1'], duration: 700, delay: A.stagger(70), ease: 'inOut(2)' }, 220);
              }
              if (fades.length) tl.add(fades, { opacity: [0, 1], duration: 460, delay: A.stagger(70) }, 380);
              tl.add(texts, { opacity: [0, 1], duration: 420, delay: A.stagger(35) }, 300);
            }, '0px 0px -80px 0px');
          });
        }

        if (!reduce && 'IntersectionObserver' in window) {
          document.addEventListener('DOMContentLoaded', function () {
            var A = window.anime;
            if (!A || !A.animate) { legacyReveal(); return; }
            heroIntro(A);
            revealOnScroll(A);
            diagrams(A);
          });
        } else {
          document.documentElement.classList.add('motion-off');
        }
        if ('IntersectionObserver' in window) {
          var map = {};
          document.querySelectorAll('.nav-links .navlink').forEach(function (a) { var href = a.getAttribute('href') || ''; var h = href.indexOf('#'); if (h >= 0) { var id = href.slice(h + 1); if (id) map[id] = a; } });
          var ids = Object.keys(map);
          if (ids.length) {
            var spy = new IntersectionObserver(function (entries) {
              entries.forEach(function (entry) { if (!entry.isIntersecting) return; ids.forEach(function (id) { map[id].classList.remove('active'); }); if (map[entry.target.id]) map[entry.target.id].classList.add('active'); });
            }, { rootMargin: '-45% 0px -50% 0px' });
            ids.forEach(function (id) { var s = document.getElementById(id); if (s) spy.observe(s); });
          }
        }
      })();
    </script>
  </body>
</html>