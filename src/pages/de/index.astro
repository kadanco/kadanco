---
import Layout from '../../layouts/Layout.astro';
import ComparisonMatrix from '../../components/ComparisonMatrix.astro';
import UseCaseSpotlight from '../../components/UseCaseSpotlight.astro';
import CadenceTimeline from '../../components/CadenceTimeline.astro';
---
<Layout
  title="Kadanco. Marketing-Umsetzung für B2B-Unternehmen."
  description="Kadanco ist eine komplette Marketing-Funktion für B2B-Unternehmen. Zwei Macher verantworten die Strategie und setzen sie selbst um. Verantwortet und umgesetzt."
>
  <main id="top">

    <!-- ===================== HERO ===================== -->
    <section class="hero" data-theme="dark">
      <div class="container">
        <span class="eyebrow">Ein eingebettetes Marketing-Team für B2B-Unternehmen</span>
        <h1>Kaufen Sie kein Marketing-Management.<br><span class="hl">Kaufen Sie Umsetzung.</span></h1>
        <p class="lead">Jede andere Option verkauft Ihnen Strategie oder Aufsicht und versagt genau dort, wo die Arbeit tatsächlich passiert. Wir verantworten den Plan und setzen ihn selbst um, ohne Übergabe an Junioren. Von der Zusage bis zum ersten Ergebnis in 14 Tagen.</p>
        <div class="hero-cta">
          <button class="btn btn-primary btn-lg" data-open-modal>Kostenloses Audit anfordern</button>
          <p class="hero-cta-note">Wir zeigen Ihnen die wenigen Hebel, die zählen. Dann setzen wir sie um.</p>
        </div>
      </div>
    </section>

    <!-- ===================== LOGOS ===================== -->
    <section class="logos" data-theme="light">
      <div class="container">
        <div class="logos-head"><span class="eyebrow dark">Zwei Karrieren hinter der Arbeit</span></div>
        <div class="logo-marquee">
          <div class="logo-track">
            <img src="https://assets.kadanco.com/logos/mercedes-benz.svg" alt="Mercedes-Benz" class="logo" />
            <img src="https://assets.kadanco.com/logos/opel.svg" alt="Opel" class="logo" />
            <img src="https://assets.kadanco.com/logos/toyota.svg" alt="Toyota" class="logo" />
            <img src="https://assets.kadanco.com/logos/merck.svg" alt="Merck" class="logo" />
            <img src="https://assets.kadanco.com/logos/oracle.svg" alt="Oracle" class="logo" />
            <img src="https://assets.kadanco.com/logos/consorsbank.svg" alt="Consorsbank" class="logo" />
            <img src="https://assets.kadanco.com/logos/dkb.svg" alt="DKB" class="logo" />
            <img src="https://assets.kadanco.com/logos/sparkasse.svg" alt="Sparkasse" class="logo" />
            <img src="https://assets.kadanco.com/logos/mercedes-benz.svg" alt="" aria-hidden="true" class="logo logo--dupe" />
            <img src="https://assets.kadanco.com/logos/opel.svg" alt="" aria-hidden="true" class="logo logo--dupe" />
            <img src="https://assets.kadanco.com/logos/toyota.svg" alt="" aria-hidden="true" class="logo logo--dupe" />
            <img src="https://assets.kadanco.com/logos/merck.svg" alt="" aria-hidden="true" class="logo logo--dupe" />
            <img src="https://assets.kadanco.com/logos/oracle.svg" alt="" aria-hidden="true" class="logo logo--dupe" />
            <img src="https://assets.kadanco.com/logos/consorsbank.svg" alt="" aria-hidden="true" class="logo logo--dupe" />
            <img src="https://assets.kadanco.com/logos/dkb.svg" alt="" aria-hidden="true" class="logo logo--dupe" />
            <img src="https://assets.kadanco.com/logos/sparkasse.svg" alt="" aria-hidden="true" class="logo logo--dupe" />
          </div>
        </div>
        <p class="logos-note">Wir bringen vier Jahrzehnte gemeinsame Erfahrung aus Enterprise-Software, Services, Automotive, Pharma und SaaS mit, in Produkt, Marketing und Vertrieb.</p>
      </div>
    </section>

    <!-- ===================== PROBLEM ===================== -->
    <section id="services" class="section band-ink" data-theme="dark">
      <div class="container">
        <div class="split">
          <ComparisonMatrix
            label="Die üblichen Wege"
            theme="dark"
            caption="Kein einzelner Weg ist die ganze Funktion. <b>An der Umsetzung scheitern sie alle.</b>"
            columns={[{ name: "Strategie" }, { name: "Umsetzung", pulse: true }, { name: "Verantwortung" }]}
            rows={[
              { route: "Agentur", reason: "Partner-Sätze für Arbeit, an der Junioren lernen.", marks: ["part", "gap", "part"] },
              { route: "Fractional CMO", reason: "Schreibt den Plan und überlässt Ihnen die Umsetzung.", marks: ["has", "gap", "gap"] },
              { route: "Freelancer + Tools", reason: "Jeder macht einen Teil, niemand verantwortet den Funnel.", marks: ["gap", "part", "gap"] },
              { route: "Inhouse-Einstellung", reason: "Ein oder zwei Personen tief, lange Einarbeitung, der Rest bleibt liegen.", marks: ["part", "part", "has"] },
            ]}
          />
          <div class="content">
            <span class="eyebrow">Das Overhead-Problem</span>
            <h2>Die meisten Marketing-Budgets<br>kaufen Management<br><span class="hl-peri">und keine Umsetzung.</span></h2>
            <p class="lead" style="margin-top:20px">
              Wenn Ihr Unternehmen wächst, brauchen Sie eine Marketing-Funktion, die liefert. Jeder übliche Weg
              dorthin kostet Sie an einer Stelle: beim Overhead, bei der Verantwortung oder bei der Zeit.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- ===================== USE CASES ===================== -->
    <section id="use-cases" class="section band-lime" data-theme="light">
      <div class="container">
        <div class="split">
          <div class="content">
            <span class="eyebrow indigo">Use Cases</span>
            <h2>Was die Funktion <span class="hl-indigo">liefert.</span></h2>
            <p class="lead" style="margin-top:20px">
              Einige der Ergebnisse, für die Teams uns holen, und die Workstreams, die dahinterstehen.
            </p>
          </div>
          <UseCaseSpotlight
            interval={3000}
            items={[
              { eyebrow: "Markteintritt", name: "DACH-Markteintritt", href: "/de/use-cases/dach-market-entry/", summary: "Eine deutschsprachige Präsenz, die wächst, End-to-End betrieben.", bundle: ["Lokalisierte Positionierung", "Ein deutschsprachiger Content-Motor", "LinkedIn für das Team", "Ein Event-Programm", "Distribution, die sich aufbaut"], own: "Eine deutschsprachige Präsenz, die Woche für Woche stärker wird, Ihre bestehenden Assets, die endlich im Markt wirken, und ein Pipeline-Programm, das Ihr Vertrieb nicht selbst betreiben muss." },
              { eyebrow: "Founder-Content", name: "Founder-Content & Pipeline", href: "/de/use-cases/founder-led-content/", summary: "Ein Publishing-Programm in der Stimme der Gründer, das messbare Pipeline erzeugt.", bundle: ["Messaging & Positionierung", "Ghostwriting & Content", "SEO & GEO", "Outbound, vorgewärmt durch Content", "RevOps, um Conversions zu messen"], own: "Ein verlässliches Publishing-Programm in Ihrer Stimme, das messbare Pipeline erzeugt statt Vanity-Engagement." },
              { eyebrow: "Conversion", name: "Relaunch, der die Conversion hebt", href: "/de/use-cases/conversion-rebuild/", summary: "Eine Website und eine Botschaft, die zum heutigen Unternehmen passen.", bundle: ["Neupositionierung auf den Stand von heute", "Marken- und Website-Relaunch", "Vertriebsunterlagen", "Conversion-Optimierung", "Lifecycle & Automatisierung"], own: "Eine Website und eine Story, die zum heutigen Unternehmen passen, plus ein messbarer Funnel, den Sie laufend verbessern können." },
              { eyebrow: "Events", name: "Event-Pipeline-Engineering", href: "/de/use-cases/event-pipeline/", summary: "Bewertete Events, ABM vor dem Event und ein ROI-Report in 30 Tagen.", bundle: ["Events, bewertet nach ICP-Überschneidung und Personendichte", "LinkedIn- und Meta-ABM ab vier Wochen vorher, mit Kalender-Slots", "Dinners und Roundtables, auf denen Deals entstehen", "Anreicherung am selben Tag, CRM-Sync und sequenziertes Follow-up"], own: "Teilnehmer, die Sie kennen, bevor sie den Raum betreten, Termine in einem gefüllten Kalender und ein ROI-Report innerhalb von 30 Tagen, in dem jeder Termin zugeordnet ist." },
            ]}
          />
        </div>
      </div>
    </section>

    <!-- ===================== WHO WE ARE ===================== -->
    <section id="founders" class="section band-paper" data-theme="light">
      <div class="container">
        <div class="who-top">
          <div>
            <span class="eyebrow indigo">Über uns</span>
            <h2>Zwei Macher, <span class="hl-indigo">die Verantwortung übernehmen.</span></h2>
          </div>
          <div class="bubble">
            <strong>KADANCO</strong> ist eine komplette Marketing-Funktion für B2B-Unternehmen. Zwei Macher
            übernehmen die Verantwortung für die Strategie und setzen sie selbst um. Ein Team, ein System,
            eine Zahl, die Sie steuern. Kein Agentur-Overhead, keine Übergaben an Junioren, kein Stapel
            Freelancer, den Sie managen müssen.
          </div>
        </div>

        <div class="founders-grid">
          <div class="card founder">
            <img src="https://assets.kadanco.com/public/maria.jpeg" alt="Maria" class="avatar" />
            <h3>Maria</h3>
            <span class="role">Gründerin &amp; Product Managerin</span>
            <p>20+ Jahre Produkterfahrung, Made in Berlin | B2B Sustainable Energy Management | EdTech | Financial Wellbeing</p>
            <a class="btn btn-indigo btn-block" href="https://www.linkedin.com/in/miarichter/" target="_blank" rel="noopener">LinkedIn-Profil ansehen</a>
          </div>
          <div class="card founder">
            <img src="https://assets.kadanco.com/public/karan.jpeg" alt="Karan" class="avatar" />
            <h3>Karan</h3>
            <span class="role">Gründer &amp; Growth Manager</span>
            <p>Ersetzen Sie Ihren GTM-Stack durch eine Plattform | Founder @ hubsell</p>
            <a class="btn btn-indigo btn-block" href="https://www.linkedin.com/in/krnshrm/" target="_blank" rel="noopener">LinkedIn-Profil ansehen</a>
          </div>
        </div>

        <div class="tags">
          <span class="tag">Produktentwicklung</span>
          <span class="tag">Produktmanagement</span>
          <span class="tag">Produktdesign</span>
          <span class="tag">Produktmarketing</span>
          <span class="tag">Leadgenerierung</span>
          <span class="tag">Demand Generation</span>
          <span class="tag">Growth Marketing</span>
          <span class="tag">E-Mail-Marketing</span>
          <span class="tag">Marketingberatung</span>
          <span class="tag">Marketingstrategie</span>
          <span class="tag">Copywriting</span>
        </div>
      </div>
    </section>

    <!-- ===================== OUR APPROACH ===================== -->
    <section class="section center" data-theme="light">
      <div class="container">
        <span class="eyebrow indigo">Unser Ansatz</span>
        <h2>Eine Funktion. <span class="hl-indigo">Der ganze Stack.</span></h2>
        <div class="grid cols-3" style="margin-top:48px;text-align:left">
          <div class="card card--approach">
            <span class="lab">Eine Verantwortung</span>
            <h3><span class="t1">Ein Team, verantwortlich</span> <span class="t2">für alles.</span></h3>
            <p style="margin-top:12px">Ein einziges Team verantwortet die gesamte Funktion und eine Zahl, statt einer Riege von Spezialisten, die Sie koordinieren müssen.</p>
          </div>
          <div class="card card--approach">
            <span class="lab">Erfahrene Umsetzung</span>
            <h3><span class="t1">Die Strategen, die die Arbeit machen</span> <span class="t2">für Ihre Teams.</span></h3>
            <p style="margin-top:12px">Die Macher, die die Richtung vorgeben, machen die Arbeit selbst. Keine Junior-Umsetzung, keine Account-Ebene, kein Aufschlag.</p>
          </div>
          <div class="card card--approach">
            <span class="lab">Ein System</span>
            <h3><span class="t1">Zwölf Maßnahmen,</span> <span class="t2">ein Motor.</span></h3>
            <p style="margin-top:12px">Jede Maßnahme läuft als Teil eines verbundenen Systems, damit der gesamte Stack zusammenwirkt, statt zwischen Dienstleistern zu versickern.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ===================== HOW WE OPERATE ===================== -->
    <section class="section band-deep" data-theme="dark">
      <div class="container">
        <div class="split">
          <CadenceTimeline
            steps={[
              { n: "01", title: "Verstehen", body: "Wir lernen Ihren Markt, Ihr ICP, Ihren Funnel und Ihre Zahlen kennen und einigen uns auf die wenigen Hebel, die Ihre Pipeline am stärksten verändern." },
              { n: "02", title: "Aufbauen", body: "Wir machen die Arbeit selbst: Marke, Website, Kampagnen, Content, Systeme. Keine Briefings, die über den Zaun geworfen werden." },
              { n: "03", title: "Liefern", amp: "& iterieren", body: "Echte Ergebnisse in Wochen, nicht in Quartalen. Danach liefern wir weiter, und der Motor wird jeden Monat stärker.", loop: "und es baut sich auf" },
            ]}
          />
          <div class="content">
            <span class="eyebrow">Wie wir arbeiten</span>
            <h2>Wir beraten die Arbeit nicht. <span class="hl">Wir verantworten und machen sie.</span></h2>
            <p class="lead" style="margin-top:20px">
              KADANCO arbeitet als Ihre Marketing-Funktion, nicht als Dienstleister daneben. Die beiden
              Personen, die die Arbeit definieren, sind die beiden, die sie machen. Wir übernehmen die
              Verantwortung für das Ergebnis, führen die Maßnahmen selbst aus und richten das gesamte System
              auf Pipeline aus. Vier Kunden gleichzeitig, damit jeder Account erfahrene Umsetzung bekommt.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- ===================== FAQ ===================== -->
    <section id="faq" class="section band-paper center" data-theme="light">
      <div class="container">
        <span class="eyebrow indigo">FAQ</span>
        <h2>Fragen, <span class="hl-indigo">beantwortet.</span></h2>
        <div class="grid cols-3" style="margin-top:48px">
          <div class="card faq-card">
            <h3>Wie arbeiten Sie mit uns?</h3>
            <p>Wir arbeiten als Ihre Marketing-Funktion in einem Quartalsmandat: Markt, ICP und Funnel verstehen, die Maßnahmen festlegen, die die Pipeline am stärksten bewegen, und sie dann selbst umsetzen. Vier Kunden gleichzeitig.</p>
          </div>
          <div class="card faq-card">
            <h3>Wie schnell sehen wir Ergebnisse?</h3>
            <p>Die erste Umsetzung ist innerhalb von zwei Wochen nach Start live. Danach arbeiten wir in Quartalszyklen: planen, liefern, auswerten, und der Motor wird stärker.</p>
          </div>
          <div class="card faq-card">
            <h3>Wer macht die Arbeit?</h3>
            <p>Die beiden Macher, die Ihre Arbeit definieren, sind die beiden, die sie machen. Keine Account-Ebene, keine Junior-Umsetzung, kein Aufschlag.</p>
          </div>
          <div class="card faq-card">
            <h3>Was kostet das?</h3>
            <p>Wir schneiden jedes Mandat auf das zu, was Ihre Pipeline braucht, mit einer planbaren Untergrenze und einer Obergrenze, die Sie steuern. Am schnellsten kommen Sie in einem kurzen Gespräch zu einer Zahl.</p>
          </div>
          <div class="card faq-card">
            <h3>Nur Unternehmen, die nach Deutschland kommen?</h3>
            <p>Nein. Wir betreiben die komplette Marketing-Funktion für B2B-Unternehmen allgemein. Der DACH-Markteintritt ist ein Use Case, den wir auf muttersprachlichem Niveau beherrschen, nicht das ganze Angebot.</p>
          </div>
          <div class="card faq-card">
            <h3>Was gehört zur Funktion?</h3>
            <p>Der ganze Stack: Positionierung, Marke und Website, Content und Ghostwriting, ABM und Demand, Paid, Events, SEO und GEO, CRO und RevOps. Wir setzen die Maßnahmen ein, die Ihre Pipeline bewegen.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ===================== COMPLIANCE ===================== -->
    <section class="section band-lime center" data-theme="light">
      <div class="container">
        <span class="eyebrow dark">Compliance</span>
        <div class="compliance-row">
          <img class="badge" src="https://assets.kadanco.com/badges/gdpr.svg" alt="DSGVO-konform" />
          <img class="badge" src="https://assets.kadanco.com/badges/eu.svg" alt="EU" />
          <img class="badge" src="https://assets.kadanco.com/badges/made-in-germany.svg" alt="Made in Germany" />
        </div>
      </div>
    </section>

    <!-- ===================== FINAL CTA ===================== -->
    <section class="section cta-band center" data-theme="dark">
      <div class="container">
        <span class="eyebrow peri">Kontakt</span>
        <h2>Sagen Sie uns, wo Sie <span class="hl">wachsen wollen.</span></h2>
        <p class="lead" style="margin-top:20px">Wir zeigen Ihnen die wenigen Hebel, die für Ihre Pipeline am wichtigsten sind. Dann setzen wir sie um.</p>
        <div class="cta-actions">
          <button class="btn btn-primary btn-lg" data-open-modal>Kostenloses Audit anfordern</button>
        </div>
        <p class="cta-note">Kostenlos und unverbindlich. Wir melden uns schnell.</p>
      </div>
    </section>

  </main>
</Layout>
