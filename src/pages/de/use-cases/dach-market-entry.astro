---
import Layout from '../../../layouts/Layout.astro';
import ComparisonMatrix from '../../../components/ComparisonMatrix.astro';
import CadenceTimeline from '../../../components/CadenceTimeline.astro';
---
<Layout
  title="DACH-Markteintritt für B2B-Unternehmen | Kadanco"
  description="Treten Sie in den deutschen Markt ein mit einem Team von Machern, das Ihre deutschsprachige Präsenz aufbaut und betreibt. Positionierung, Content, LinkedIn und Events, verantwortet von zwei Machern, einer davon deutscher Muttersprachler."
>
  <main id="top">

    <!-- ===================== HERO ===================== -->
    <section class="hero" data-theme="dark">
      <div class="container">
        <span class="eyebrow">Use Case &middot; DACH-Markteintritt</span>
        <h1>Eine deutschsprachige Präsenz,<br><span class="hl">aufgebaut und betrieben.</span></h1>
        <p class="lead">Eine übersetzte englische Website gewinnt keine deutschen B2B-Käufer, und der Aufbau eines deutschen Marketing-Teams dauert Monate, die Sie nicht haben. Wir geben Ihnen eine echte deutschsprachige Präsenz (Positionierung, Content, LinkedIn und Events), aufgebaut und betrieben von zwei Machern, eine davon deutsche Muttersprachlerin. Erste Umsetzung innerhalb von zwei Wochen live.</p>
        <div class="hero-cta">
          <button class="btn btn-primary btn-lg" data-open-modal>Kostenloses Audit anfordern</button>
          <p class="hero-cta-note">Wir zeigen Ihnen die wenigen Hebel, die DACH öffnen. Dann setzen wir sie um.</p>
        </div>
      </div>
    </section>

    <!-- ===================== WHY IT STALLS (matrix) ===================== -->
    <section class="section band-ink" data-theme="dark">
      <div class="container">
        <span class="eyebrow peri">Warum der DACH-Eintritt stockt</span>
        <h2>Hineingehen ist leicht. <span class="hl">Ankommen nicht.</span></h2>
        <p class="lead" style="margin-top:20px;max-width:740px">
          Die meisten B2B-Unternehmen gehen auf eine dieser Arten nach DACH, und die meisten verlieren an
          denselben Stellen: bei der Sprache, bei der Umsetzung oder bei der Verantwortung für die Pipeline.
        </p>
        <div style="margin-top:44px">
          <ComparisonMatrix
            label="Die üblichen Wege nach DACH"
            theme="dark"
            caption="Kein einzelner Weg deckt alle drei ab. <b>Genau das betreiben wir.</b>"
            columns={[{ name: "Auf Deutsch" }, { name: "Umsetzung", pulse: true }, { name: "Verantwortung" }]}
            rows={[
              { route: "Auf Englisch betreiben", reason: "Günstig und schnell, aber deutsche Käufer wählen still den lokalen Anbieter.", marks: ["gap", "part", "gap"] },
              { route: "Übersetzungsagentur", reason: "Sie bekommen Wörter, keine Präsenz und keine verantwortete Pipeline.", marks: ["part", "gap", "gap"] },
              { route: "Deutsche Marketing-Einstellung", reason: "Sprachlich und fachlich stark, aber lange Einarbeitung und nur eine Person tief.", marks: ["has", "part", "part"] },
              { route: "Freelancer", reason: "Jeder macht einen Teil, Positionierung, Content und Follow-up ergeben nie ein Ganzes.", marks: ["part", "part", "gap"] },
            ]}
          />
        </div>
      </div>
    </section>

    <!-- ===================== WHAT WE RUN (flow) ===================== -->
    <section class="section band-paper" data-theme="light">
      <div class="container">
        <span class="eyebrow indigo">Was wir im Markt betreiben</span>
        <h2>Fünf Workstreams, <span class="hl-indigo">ein deutschsprachiges Programm.</span></h2>
        <p class="lead" style="margin-top:20px;max-width:740px">
          Kein Projekt, das endet. Eine Präsenz, die wir aufbauen und weiter betreiben, gemessen daran, ob sie
          Pipeline erzeugt.
        </p>
        <div style="max-width:1000px;margin:44px auto 0">
          <svg viewBox="0 0 1120 460" data-anim="diagram" xmlns="http://www.w3.org/2000/svg" style="width:100%;height:auto;display:block" role="img" aria-label="Fünf Workstreams (lokalisierte Positionierung, ein deutschsprachiger Content-Motor, LinkedIn für das Team, ein Event-Programm und Distribution) laufen als ein deutschsprachiges Programm, das deutsche Pipeline erzeugt.">
            <defs>
              <marker id="ucflowarrow" markerWidth="12" markerHeight="12" refX="7" refY="5" orient="auto" markerUnits="userSpaceOnUse">
                <path d="M1 1 L9 5 L1 9" fill="none" stroke="#3B38DF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </marker>
            </defs>
            <g fill="none" stroke="#B2B1FF" stroke-width="2">
              <path d="M324 60  C 404 60  392 230 452 230"/>
              <path d="M324 145 C 404 145 400 230 452 230"/>
              <path d="M324 230 L 452 230"/>
              <path d="M324 315 C 404 315 400 230 452 230"/>
              <path d="M324 400 C 404 400 392 230 452 230"/>
            </g>
            <g font-family="Fira Sans" font-size="18" font-weight="500" fill="#201E1F">
              <g>
                <rect x="24" y="31" width="300" height="58" rx="14" fill="#FFFFFF" stroke="#E6E6F0" stroke-width="1.5"/>
                <rect x="40" y="53" width="14" height="14" rx="3" fill="#DAFF02"/>
                <text x="68" y="65">Localised positioning</text>
              </g>
              <g>
                <rect x="24" y="116" width="300" height="58" rx="14" fill="#FFFFFF" stroke="#E6E6F0" stroke-width="1.5"/>
                <rect x="40" y="138" width="14" height="14" rx="3" fill="#DAFF02"/>
                <text x="68" y="150">German content engine</text>
              </g>
              <g>
                <rect x="24" y="201" width="300" height="58" rx="14" fill="#FFFFFF" stroke="#E6E6F0" stroke-width="1.5"/>
                <rect x="40" y="223" width="14" height="14" rx="3" fill="#DAFF02"/>
                <text x="68" y="235">LinkedIn for the team</text>
              </g>
              <g>
                <rect x="24" y="286" width="300" height="58" rx="14" fill="#FFFFFF" stroke="#E6E6F0" stroke-width="1.5"/>
                <rect x="40" y="308" width="14" height="14" rx="3" fill="#DAFF02"/>
                <text x="68" y="320">An event motion</text>
              </g>
              <g>
                <rect x="24" y="371" width="300" height="58" rx="14" fill="#FFFFFF" stroke="#E6E6F0" stroke-width="1.5"/>
                <rect x="40" y="393" width="14" height="14" rx="3" fill="#DAFF02"/>
                <text x="68" y="405">Distribution that builds</text>
              </g>
            </g>
            <rect x="452" y="182" width="214" height="96" rx="18" fill="#3B38DF"/>
            <text x="559" y="222" font-family="Fira Sans" font-size="19" font-weight="600" fill="#FFFFFF" text-anchor="middle">One German-language</text>
            <text x="559" y="248" font-family="Fira Sans" font-size="19" font-weight="600" fill="#FFFFFF" text-anchor="middle">motion, run for you</text>
            <path d="M666 230 L 792 230" fill="none" stroke="#3B38DF" stroke-width="2.5" marker-end="url(#ucflowarrow)"/>
            <rect x="800" y="190" width="296" height="80" rx="16" fill="#DAFF02"/>
            <text x="948" y="224" font-family="Fira Sans" font-size="21" font-weight="700" fill="#201E1F" text-anchor="middle">German pipeline</text>
            <text x="948" y="248" font-family="Fira Sans" font-size="14" font-weight="500" fill="#201E1F" text-anchor="middle">meetings booked, owned end to end</text>
          </svg>
        </div>
      </div>
    </section>

    <!-- ===================== WHAT YOU OWN ===================== -->
    <section class="section band-deep" data-theme="dark">
      <div class="container">
        <span class="eyebrow peri">Was Sie bekommen</span>
        <h2>Eine Marktpräsenz, <span class="hl">kein Übersetzungsprojekt.</span></h2>
        <div class="grid cols-3" style="margin-top:48px;text-align:left">
          <div class="card">
            <h3>Eine Präsenz, die wächst</h3>
            <p>Eine deutschsprachige Präsenz, die jede Woche stärker wird, statt eines einmaligen Launches, der wieder verstummt.</p>
          </div>
          <div class="card">
            <h3>Ihre Assets, im Einsatz</h3>
            <p>Die Positionierung, der Content und die Marke, die Sie bereits bezahlt haben, wirken endlich im Markt, statt auf Englisch liegen zu bleiben.</p>
          </div>
          <div class="card">
            <h3>Ein Pipeline-Programm</h3>
            <p>Ein Programm, in das sich Ihr Vertrieb einklinkt, mit organisierten Terminen und Follow-up, statt eines, das er selbst aufbauen und betreiben muss.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ===================== THE EDGE ===================== -->
    <section class="section band-paper" data-theme="light">
      <div class="container">
        <div class="split">
          <div class="content">
            <span class="eyebrow indigo">Warum Kadanco für DACH</span>
            <h2>Muttersprachliche Umsetzung, <span class="hl-indigo">keine Übersetzungsschicht.</span></h2>
          </div>
          <div class="content">
            <p class="lead">Maria ist deutsche Muttersprachlerin und hat als Produkt- und Markenverantwortliche für deutsche Unternehmen gearbeitet. Karan verantwortet Growth und GTM. Die beiden übernehmen Ihre DACH-Präsenz und betreiben sie selbst: keine Übergabe an Junioren, keine Agentur, die Freelancer koordiniert. Sie bekommen die Arbeit selbst, auf Deutsch, von den Menschen, die sie verantworten. <a class="hl-indigo" href="/de/#about">Die Macher kennenlernen</a>.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ===================== FIRST 90 DAYS ===================== -->
    <section class="section band-deep" data-theme="dark">
      <div class="container">
        <span class="eyebrow peri">Die ersten 90 Tage</span>
        <h2>Live in Wochen, <span class="hl">nicht in Quartalen.</span></h2>
        <CadenceTimeline
          steps={[
            { n: "01", title: "Verstehen", body: "Wir lernen das deutsche Segment kennen, in das Sie eintreten, dazu Ihr ICP und Ihre Zahlen, und einigen uns auf die wenigen Hebel, die den Markt am schnellsten öffnen." },
            { n: "02", title: "Aufbauen", body: "Wir bauen die deutschsprachige Präsenz selbst: Positionierung, Content-Motor, LinkedIn und die ersten Events. Keine Briefings an eine Übersetzungsagentur." },
            { n: "03", title: "Liefern", amp: "& iterieren", body: "Erste Umsetzung in Wochen live. Danach liefern wir weiter in den Markt, und die Präsenz wird jeden Monat stärker.", loop: "und die Pipeline wächst" },
          ]}
        />
      </div>
    </section>

    <!-- ===================== ONE USE CASE NOTE ===================== -->
    <section class="section center" data-theme="light">
      <div class="container">
        <p class="lead" style="max-width:720px;margin:0 auto">
          DACH ist einer der Wege, auf denen Teams mit uns arbeiten. Es ist einer von mehreren. Dieselben zwei Macher planen und verantworten Produkt, Marketing und Vertrieb für B2B-Unternehmen.
          <a class="hl-indigo" href="/de/">Alles, was wir tun →</a>
        </p>
      </div>
    </section>

    <!-- ===================== FINAL CTA ===================== -->
    <section class="section cta-band center" data-theme="dark">
      <div class="container">
        <span class="eyebrow peri">Kontakt</span>
        <h2>Bereit für <span class="hl">DACH?</span></h2>
        <p class="lead" style="margin-top:20px">Sagen Sie uns, in welches Segment Sie eintreten. Wir zeigen Ihnen die wenigen Hebel, die zählen, und setzen sie um.</p>
        <div class="cta-actions">
          <button class="btn btn-primary btn-lg" data-open-modal>Kostenloses Audit anfordern</button>
        </div>
        <p class="cta-note">Kostenlos und unverbindlich. Wir melden uns schnell.</p>
      </div>
    </section>

  </main>
</Layout>
