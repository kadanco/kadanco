---
import Layout from '../layouts/Layout.astro';
import ComparisonMatrix from '../components/ComparisonMatrix.astro';
---
<Layout
  title="Kadanco. Senior marketing operators for B2B companies."
  description="Kadanco is a senior, full-stack marketing function for B2B companies. Two operators own the strategy and run the execution themselves. Owned and executed."
>
  <!-- ===================== NAV ===================== -->
  <header class="nav nav--dark">
    <div class="container nav-inner">
      <a class="brand" href="#top" aria-label="Kadanco — home">
        <img class="brand-logo brand-logo--dark" src="https://assets.kadanco.com/logo/wordmark-light.svg" alt="Kadanco" />
        <img class="brand-logo brand-logo--light" src="https://assets.kadanco.com/logo/wordmark-dark.svg" alt="Kadanco" />
      </a>
      <nav class="nav-links" aria-label="Primary">
        <a class="navlink" href="#services">Services</a>
        <a class="navlink" href="#use-cases">Use Cases</a>
        <a class="navlink" href="#founders">Who We Are</a>
        <a class="navlink" href="#faq">FAQ</a>
        <button class="btn btn-primary" data-open-modal>Lets Talk</button>
      </nav>
    </div>
  </header>

  <main id="top">

    <!-- ===================== HERO (centered, 2-line H1, no buttons) ===================== -->
    <section class="hero" data-theme="dark">
      <div class="container">
        <span class="eyebrow">40+ Years Experience</span>
        <h1>Senior Marketing Operators<br><span class="hl">For B2B Companies</span></h1>
        <p class="lead">Your Marketing Function. Owned And Executed.</p>
      </div>
    </section>

    <!-- ===================== CLIENT LOGOS (286px band, centered, infinite) ===================== -->
    <section class="logos" data-theme="light">
      <div class="container">
        <div class="logos-head"><span class="eyebrow dark">Global B2B + B2C Clients</span></div>
        <div class="logo-marquee">
          <div class="logo-track">
            <!-- SET 1 — replace src/alt with your real files in /public/logos/ -->
            <img src="https://assets.kadanco.com/logos/mercedes-benz.svg" alt="Mercedes-Benz" class="logo" />
            <img src="https://assets.kadanco.com/logos/opel.svg" alt="Opel" class="logo" />
            <img src="https://assets.kadanco.com/logos/toyota.svg" alt="Toyota" class="logo" />
            <img src="https://assets.kadanco.com/logos/merck.svg" alt="Merck" class="logo" />
            <img src="https://assets.kadanco.com/logos/oracle.svg" alt="Oracle" class="logo" />
            <img src="https://assets.kadanco.com/logos/consorsbank.svg" alt="Consorsbank" class="logo" />
            <img src="https://assets.kadanco.com/logos/dkb.svg" alt="DKB" class="logo" />
            <img src="https://assets.kadanco.com/logos/sparkasse.svg" alt="Sparkasse" class="logo" />
            <!-- SET 2 — decorative duplicate for the seamless loop -->
            <img src="https://assets.kadanco.com/logos/mercedes-benz.svg" alt="" aria-hidden="true" class="logo logo--dupe" />
            <img src="https://assets.kadanco.com/logos/opel.svg" alt="" aria-hidden="true" class="logo logo--dupe" />
            <img src="https://assets.kadanco.com/logos/toyota.svg" alt="" aria-hidden="true" class="logo logo--dupe" />
            <img src="https://assets.kadanco.com/logos/merck.svg" alt="" aria-hidden="true" class="logo logo--dupe" />
            <img src="https://assets.kadanco.com/logos/oracle.svg" alt="" aria-hidden="true" class="logo logo--dupe" />
            <img src="https://assets.kadanco.com/logos/consorsbank.svg" alt="" aria-hidden="true" class="logo logo--dupe" />
            <img src="https://assets.kadanco.com/logos/dkb.svg" alt="" aria-hidden="true" class="logo logo--dupe" />
            <img src="https://assets.kadanco.com/logos/sparkasse.svg" alt="" aria-hidden="true" class="logo logo--dupe" />
          </div>
        </div>
      </div>
    </section>

    <!-- ===================== PROBLEM (dark band, visual LEFT) ===================== -->
    <section id="services" class="section band-ink" data-theme="dark">
      <div class="container">
        <div class="split">
          <!-- EMBED: routes-vs-needs matrix -->
          <ComparisonMatrix
            label="The standard routes"
            theme="dark"
            caption="No single route is the whole function. <b>Execution is where they all leak.</b>"
            columns={[{ name: "Strategy" }, { name: "Execution", pulse: true }, { name: "Ownership" }]}
            rows={[
              { route: "Agency", reason: "Partner rates for work the juniors are learning on.", marks: ["part", "gap", "part"] },
              { route: "Fractional CMO", reason: "Writes the plan, then leaves you to run it.", marks: ["has", "gap", "gap"] },
              { route: "Freelancers + tools", reason: "Everyone runs a slice; nobody owns the funnel.", marks: ["gap", "part", "gap"] },
              { route: "In-house hire", reason: "One or two hires deep; slow to ramp, the rest neglected.", marks: ["part", "part", "has"] },
            ]}
          />
          <div class="content">
            <span class="eyebrow">The Overhead Problem</span>
            <h2>Most Marketing Spend<br>Buys Management<br><span class="hl-peri">And No Execution.</span></h2>
            <p class="lead" style="margin-top:20px">
              At EUR 2 to 5M you need a full marketing function. Every standard way of getting one taxes
              you somewhere: in overhead, in ownership, or in time.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- ===================== USE CASES (lime band, visual RIGHT) ===================== -->
    <section id="use-cases" class="section band-lime" data-theme="light">
      <div class="container">
        <div class="split">
          <div class="content">
            <span class="eyebrow indigo">Use Cases</span>
            <h2>What The Function <span class="hl-indigo">Delivers.</span></h2>
            <p class="lead" style="margin-top:20px">
              A few of the outcomes teams hire us for, and the bundle of motions behind each. This is how
              the engine runs, not a menu.
            </p>
          </div>
          <!-- EMBED: drop your use-cases visual here (iframe / video / lottie / svg) -->
          <div class="embed-slot">Visual embed</div>
        </div>
      </div>
    </section>

    <!-- ===================== WHO WE ARE ===================== -->
    <section id="founders" class="section band-paper" data-theme="light">
      <div class="container">
        <div class="who-top">
          <div>
            <span class="eyebrow indigo">Who We Are</span>
            <h2>Two Senior Operators <span class="hl-indigo">That Take Ownership.</span></h2>
          </div>
          <div class="bubble">
            <strong>KADANCO</strong> is a complete marketing function for B2B companies. Two senior operators
            take ownership of the strategy and run the execution themselves. One team, one system of action,
            one number you control. No agency overhead, no junior hand-offs, no stack of freelancers to manage.
          </div>
        </div>

        <div class="founders-grid">
          <div class="card founder">
            <img src="https://media.licdn.com/dms/image/v2/D4D03AQEnZ21QpKUzyw/profile-displayphoto-scale_200_200/B4DZq25JOKIEAY-/0/1764005028381?e=1782950400&v=beta&t=dBKuzYs_ZuP9XVARuZB6RXydEXDFbKp1jJWpM9I1D58" alt="Maria" class="avatar" />
            <h3>Maria</h3>
            <span class="role">Founder &amp; Product Manager</span>
            <p>20+ Product Experience Made in Berlin | B2B Sustainable Energy Management | EdTech | Financial Wellbeing</p>
            <a class="btn btn-indigo btn-block" href="https://www.linkedin.com/in/miarichter/" target="_blank" rel="noopener">View LinkedIn Profile</a>
          </div>
          <div class="card founder">
            <img src="https://media.licdn.com/dms/image/v2/D4D03AQH2pg2p6SkR8g/profile-displayphoto-shrink_200_200/profile-displayphoto-shrink_200_200/0/1728300291304?e=1782950400&v=beta&t=if1GJMJbGKpWBggZTHHHOi-qne7HElqPs1fCxLDiSaI" alt="Karan" class="avatar" />
            <h3>Karan</h3>
            <span class="role">Founder &amp; Growth Manager</span>
            <p>Replace your GTM stack with one platform | Founder @ hubsell</p>
            <a class="btn btn-indigo btn-block" href="https://www.linkedin.com/in/krnshrm/" target="_blank" rel="noopener">View LinkedIn Profile</a>
          </div>
        </div>

        <div class="tags">
          <span class="tag">Product Development</span>
          <span class="tag">Product Management</span>
          <span class="tag">Product Design</span>
          <span class="tag">Product Marketing</span>
          <span class="tag">Lead Generation</span>
          <span class="tag">Demand Generation</span>
          <span class="tag">Growth Marketing</span>
          <span class="tag">Email Marketing</span>
          <span class="tag">Marketing Consulting</span>
          <span class="tag">Marketing Strategy</span>
          <span class="tag">Copywriting</span>
        </div>
      </div>
    </section>

    <!-- ===================== OUR APPROACH (white+outline cards, hover fills deep-indigo) ===================== -->
    <section class="section center" data-theme="light">
      <div class="container">
        <span class="eyebrow indigo">Our Approach</span>
        <h2>One Function. <span class="hl-indigo">The Whole Stack.</span></h2>
        <div class="grid cols-3" style="margin-top:48px;text-align:left">
          <div class="card card--approach">
            <span class="lab">One Owner</span>
            <h3><span class="t1">One Team, Accountable</span> <span class="t2">For Everything.</span></h3>
            <p style="margin-top:12px">A single team owns the whole function and one number, not a roster of specialists you have to coordinate.</p>
          </div>
          <div class="card card--approach">
            <span class="lab">Senior Execution</span>
            <h3><span class="t1">The Strategists That Do The Work</span> <span class="t2">For Your Teams.</span></h3>
            <p style="margin-top:12px">The operators who set the direction do the hands-on work. No junior delivery, no account layer, no markup.</p>
          </div>
          <div class="card card--approach">
            <span class="lab">One System Of Action</span>
            <h3><span class="t1">Twelve Motions,</span> <span class="t2">One Engine.</span></h3>
            <p style="margin-top:12px">Every motion runs as part of one connected system, so the whole stack compounds instead of leaking between vendors.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ===================== HOW WE OPERATE (Problem-style split + visual) ===================== -->
    <section class="section band-deep" data-theme="dark">
      <div class="container">
        <div class="split">
          <!-- EMBED: drop your how-we-operate visual here (iframe / video / lottie / svg) -->
          <div class="embed-slot">Visual embed</div>
          <div class="content">
            <span class="eyebrow">How We Operate</span>
            <h2>We Don't Advise The Work. <span class="hl">We Own It And Execute It.</span></h2>
            <p class="lead" style="margin-top:20px">
              KADANCO operates as your marketing function, not a vendor attached to it. The two people who
              scope the work are the two people who do it. We take ownership of the outcome, run the motions
              ourselves, and keep the whole system pointed at pipeline. Four clients at a time, so every
              account gets senior execution.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- ===================== FAQ (centered, 3-col card grid) ===================== -->
    <section id="faq" class="section band-paper center" data-theme="light">
      <div class="container">
        <span class="eyebrow indigo">FAQ</span>
        <h2>Questions, <span class="hl-indigo">Answered.</span></h2>
        <div class="grid cols-3" style="margin-top:48px">
          <div class="card faq-card">
            <h3>How do you work with us?</h3>
            <p>We run as your marketing function on a quarterly engagement: map the market, ICP and funnel, agree the motions that move pipeline most, then execute them ourselves. Four clients at a time.</p>
          </div>
          <div class="card faq-card">
            <h3>How fast do we see results?</h3>
            <p>First execution is live inside two weeks of kickoff. From there we run in quarterly cycles, plan, ship, review, and the engine compounds.</p>
          </div>
          <div class="card faq-card">
            <h3>Who does the work?</h3>
            <p>The two operators who scope your work are the two who do it. No account-management layer, no junior delivery, no markup.</p>
          </div>
          <div class="card faq-card">
            <h3>What does it cost?</h3>
            <p>We scope each engagement to what your pipeline needs, with a predictable floor and a ceiling you control. The fastest way to a number is a short conversation.</p>
          </div>
          <div class="card faq-card">
            <h3>Only companies entering Germany?</h3>
            <p>No. We run the full marketing function for B2B companies generally. DACH market entry is one use case we do well in native German, not the whole offer.</p>
          </div>
          <div class="card faq-card">
            <h3>What's included in the function?</h3>
            <p>The whole stack: positioning, brand and website, content and ghostwriting, ABM and demand, paid, events, SEO and GEO, CRO, and RevOps. We deploy whichever motions move your pipeline.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ===================== COMPLIANCE ===================== -->
    <section class="section band-lime center" data-theme="light">
      <div class="container">
        <span class="eyebrow dark">Compliance</span>
        <div class="compliance-row">
          <!-- PLACEHOLDER badges — replace each <svg> with your real badge image (e.g. /badges/gdpr.svg) -->
          <img class="badge" src="https://assets.kadanco.com/badges/gdpr.svg" alt="GDPR compliant" />
          <img class="badge" src="https://assets.kadanco.com/badges/eu.svg" alt="EU" />
          <img class="badge" src="https://assets.kadanco.com/badges/made-in-germany.svg" alt="Made in Germany" />
        </div>
      </div>
    </section>

  </main>

  <!-- ===================== FOOTER ===================== -->
  <footer class="footer" data-theme="light">
    <div class="container footer-inner">
      <a class="brand" href="#top" aria-label="Kadanco — home"><img class="brand-logo" src="https://assets.kadanco.com/logo/wordmark-dark.svg" alt="Kadanco" /></a>
      <p class="small">© 2026 Kadanco UG</p>
      <div class="footer-links">
        <a href="mailto:hello@kadanco.com">hello@kadanco.com</a>
        <a href="#" aria-label="Kadanco on LinkedIn">LinkedIn</a>
        <a href="/imprint/">Imprint &amp; Privacy</a>
      </div>
    </div>
  </footer>

  <!-- ===================== PLUNK modal (unchanged) ===================== -->
  <div class="modal-overlay" id="contact" role="dialog" aria-modal="true" aria-labelledby="contact-title">
    <div class="modal">
      <button class="x" data-close-modal aria-label="Close dialog">✕</button>
      <div id="form-body">
        <span class="eyebrow indigo">Lets Talk</span>
        <h3 id="contact-title">Start a conversation</h3>
        <p class="muted" style="margin-top:6px">Tell us a bit about you and we'll reply within 24 hours.</p>
        <form id="contact-form" novalidate>
          <div class="hp" aria-hidden="true">
            <label for="f-hp">Leave this field empty</label>
            <input id="f-hp" name="_gotcha" tabindex="-1" autocomplete="off" />
          </div>
          <div class="field"><label for="f-name">Name</label><input id="f-name" name="name" autocomplete="name" required /></div>
          <div class="field"><label for="f-email">Work email</label><input id="f-email" name="email" type="email" autocomplete="email" required /></div>
          <div class="field"><label for="f-company">Company</label><input id="f-company" name="company" autocomplete="organization" /></div>
          <div class="field"><label for="f-website">Website <span class="muted">(optional)</span></label><input id="f-website" name="website" /></div>
          <div class="field"><label for="f-goal">What are you trying to grow?</label><textarea id="f-goal" name="goal"></textarea></div>
          <p class="form-error" id="form-error" role="alert" style="display:none"></p>
          <button class="btn btn-primary btn-block" type="submit">Send</button>
        </form>
      </div>
      <div id="form-success" class="success" style="display:none">
        <div class="check" aria-hidden="true">✓</div>
        <h3>Thanks — talk soon.</h3>
        <p class="muted" style="margin-top:6px">We'll be in touch within 24 hours.</p>
      </div>
    </div>
  </div>

  <script is:inline>
    (function () {
      var overlay = document.getElementById('contact');
      var lastFocus = null;
      function openModal() { lastFocus = document.activeElement; overlay.classList.add('open'); document.body.style.overflow = 'hidden'; var f = overlay.querySelector('input, button'); if (f) f.focus(); }
      function closeModal() { overlay.classList.remove('open'); document.body.style.overflow = ''; if (lastFocus && lastFocus.focus) lastFocus.focus(); }
      document.querySelectorAll('[data-open-modal]').forEach(function (b) { b.addEventListener('click', function (e) { e.preventDefault(); openModal(); }); });
      document.querySelectorAll('[data-close-modal]').forEach(function (b) { b.addEventListener('click', closeModal); });
      overlay.addEventListener('click', function (e) { if (e.target === overlay) closeModal(); });
      document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && overlay.classList.contains('open')) closeModal(); });
      var form = document.getElementById('contact-form');
      var errEl = document.getElementById('form-error');
      function val(id) { var el = document.getElementById(id); return el ? el.value : ''; }
      form.addEventListener('submit', function (e) {
        e.preventDefault();
        if (!form.checkValidity()) { form.reportValidity(); return; }
        var btn = form.querySelector('button[type="submit"]'); var label = btn.textContent;
        btn.disabled = true; btn.textContent = 'Sending…'; errEl.style.display = 'none';
        fetch('/api/contact', { method: 'POST', headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ name: val('f-name'), email: val('f-email'), company: val('f-company'), website: val('f-website'), goal: val('f-goal'), _gotcha: val('f-hp') }) })
        .then(function (res) { return res.json().catch(function () { return {}; }).then(function (out) {
          if (res.ok && out.ok) { document.getElementById('form-body').style.display = 'none'; document.getElementById('form-success').style.display = 'block'; }
          else { throw new Error((out && out.error) || 'Something went wrong.'); } }); })
        .catch(function (err) { errEl.textContent = err.message + ' You can also email hello@kadanco.com.'; errEl.style.display = 'block'; btn.disabled = false; btn.textContent = label; });
      });
    })();
  </script>

  <script is:inline>
    (function () {
      var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      var nav = document.querySelector('.nav');
      var themed = Array.prototype.slice.call(document.querySelectorAll('[data-theme]'));
      function navTheme() {
        var probe = 40, theme = 'dark';
        for (var i = 0; i < themed.length; i++) {
          var r = themed[i].getBoundingClientRect();
          if (r.top <= probe && r.bottom > probe) { theme = themed[i].getAttribute('data-theme'); break; }
        }
        nav.classList.toggle('nav--light', theme === 'light');
        nav.classList.toggle('nav--dark', theme !== 'light');
      }
      window.addEventListener('scroll', navTheme, { passive: true });
      window.addEventListener('resize', navTheme);
      navTheme();

      if (!reduce) {
        var bar = document.createElement('div'); bar.className = 'scroll-progress'; document.body.appendChild(bar);
        var update = function () { var d = document.documentElement; var max = d.scrollHeight - d.clientHeight; bar.style.transform = 'scaleX(' + (max > 0 ? d.scrollTop / max : 0) + ')'; };
        window.addEventListener('scroll', update, { passive: true }); window.addEventListener('resize', update); update();
      }
      if (!reduce && 'IntersectionObserver' in window) {
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (entry) { if (entry.isIntersecting) { entry.target.classList.add('is-visible'); io.unobserve(entry.target); } });
        }, { threshold: 0.1, rootMargin: '0px 0px -40px 0px' });
        var sel = '.section .eyebrow, .section h2, .section .lead, .section .grid, .section .who-top, .section .embed-slot, .section .tags, .section .founders-grid, .section .compliance-row';
        document.querySelectorAll(sel).forEach(function (el) {
          if (el.getBoundingClientRect().top < window.innerHeight * 0.92) return;
          el.classList.add('reveal'); io.observe(el);
        });
      }
      if ('IntersectionObserver' in window) {
        var map = {};
        document.querySelectorAll('.nav-links .navlink').forEach(function (a) { var href = a.getAttribute('href') || ''; var h = href.indexOf('#'); if (h >= 0) { var id = href.slice(h + 1); if (id) map[id] = a; } });
        var ids = Object.keys(map);
        if (ids.length) {
          var spy = new IntersectionObserver(function (entries) {
            entries.forEach(function (entry) { if (!entry.isIntersecting) return; ids.forEach(function (id) { map[id].classList.remove('active'); }); if (map[entry.target.id]) map[entry.target.id].classList.add('active'); });
          }, { rootMargin: '-45% 0px -50% 0px' });
          ids.forEach(function (id) { var s = document.getElementById(id); if (s) spy.observe(s); });
        }
      }
    })();
  </script>
</Layout>