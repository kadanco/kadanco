---
import Layout from '../layouts/Layout.astro';
import ComparisonMatrix from '../components/ComparisonMatrix.astro';
import UseCaseSpotlight from '../components/UseCaseSpotlight.astro';
import CadenceTimeline from '../components/CadenceTimeline.astro';
---
<Layout
  title="Kadanco. Marketing operators for B2B companies."
  description="Kadanco is a full-stack marketing function for B2B companies. Two operators own the strategy and run the execution themselves. Owned and executed."
>
  <main id="top">

    <!-- ===================== HERO (centered, 2-line H1, no buttons) ===================== -->
    <section class="hero" data-theme="dark">
      <div class="container">
        <span class="eyebrow">An embedded marketing team for B2B companies</span>
        <h1>Stop buying marketing management.<br><span class="hl">Start buying execution.</span></h1>
        <p class="lead">Every other option sells you strategy or oversight, then fails where the work actually gets done. We own the plan and run it ourselves, with no junior handoffs. From sign-on to first deliverable in 14 days.</p>
        <div class="hero-cta">
          <button class="btn btn-primary btn-lg" data-open-modal>Get a free audit</button>
          <p class="hero-cta-note">Discover the few moves that matter, then we execute them.</p>
        </div>
      </div>
    </section>

    <!-- ===================== CLIENT LOGOS (286px band, centered, infinite) ===================== -->
    <section class="logos" data-theme="light">
      <div class="container">
        <div class="logos-head"><span class="eyebrow dark">Two careers behind the work</span></div>
        <div class="logo-marquee">
          <div class="logo-track">
            <!-- SET 1, replace src/alt with your real files in /public/logos/ -->
            <img src="https://assets.kadanco.com/logos/mercedes-benz.svg" alt="Mercedes-Benz" class="logo" />
            <img src="https://assets.kadanco.com/logos/opel.svg" alt="Opel" class="logo" />
            <img src="https://assets.kadanco.com/logos/toyota.svg" alt="Toyota" class="logo" />
            <img src="https://assets.kadanco.com/logos/merck.svg" alt="Merck" class="logo" />
            <img src="https://assets.kadanco.com/logos/oracle.svg" alt="Oracle" class="logo" />
            <img src="https://assets.kadanco.com/logos/consorsbank.svg" alt="Consorsbank" class="logo" />
            <img src="https://assets.kadanco.com/logos/dkb.svg" alt="DKB" class="logo" />
            <img src="https://assets.kadanco.com/logos/sparkasse.svg" alt="Sparkasse" class="logo" />
            <!-- SET 2, decorative duplicate for the seamless loop -->
            <img src="https://assets.kadanco.com/logos/mercedes-benz.svg" alt="" aria-hidden="true" class="logo logo--dupe" />
            <img src="https://assets.kadanco.com/logos/opel.svg" alt="" aria-hidden="true" class="logo logo--dupe" />
            <img src="https://assets.kadanco.com/logos/toyota.svg" alt="" aria-hidden="true" class="logo logo--dupe" />
            <img src="https://assets.kadanco.com/logos/merck.svg" alt="" aria-hidden="true" class="logo logo--dupe" />
            <img src="https://assets.kadanco.com/logos/oracle.svg" alt="" aria-hidden="true" class="logo logo--dupe" />
            <img src="https://assets.kadanco.com/logos/consorsbank.svg" alt="" aria-hidden="true" class="logo logo--dupe" />
            <img src="https://assets.kadanco.com/logos/dkb.svg" alt="" aria-hidden="true" class="logo logo--dupe" />
            <img src="https://assets.kadanco.com/logos/sparkasse.svg" alt="" aria-hidden="true" class="logo logo--dupe" />
          </div>
        </div>
        <p class="logos-note">We bring four decades of collective experience across enterprise software, services, automotive, pharma, and SaaS in product, marketing, and sales.</p>
      </div>
    </section>

    <!-- ===================== PROBLEM (dark band, visual LEFT) ===================== -->
    <section id="services" class="section band-ink" data-theme="dark">
      <div class="container">
        <div class="split">
          <!-- EMBED: routes-vs-needs matrix -->
          <ComparisonMatrix
            label="The standard routes"
            theme="dark"
            caption="No single route is the whole function. <b>Execution is where they all leak.</b>"
            columns={[{ name: "Strategy" }, { name: "Execution", pulse: true }, { name: "Ownership" }]}
            rows={[
              { route: "Agency", reason: "Partner rates for work the juniors are learning on.", marks: ["part", "gap", "part"] },
              { route: "Fractional CMO", reason: "Writes the plan, then leaves you to run it.", marks: ["has", "gap", "gap"] },
              { route: "Freelancers + tools", reason: "Everyone runs a slice; nobody owns the funnel.", marks: ["gap", "part", "gap"] },
              { route: "In-house hire", reason: "One or two hires deep; slow to ramp, the rest neglected.", marks: ["part", "part", "has"] },
            ]}
          />
          <div class="content">
            <span class="eyebrow">The Overhead Problem</span>
            <h2>Most Marketing Spend<br>Buys Management<br><span class="hl-peri">And No Execution.</span></h2>
            <p class="lead" style="margin-top:20px">
              As your company scales you need a marketing function that deploys. Every standard way of getting one taxes
              you somewhere: in overhead, in ownership, or in time.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- ===================== USE CASES (lime band, visual RIGHT) ===================== -->
    <section id="use-cases" class="section band-lime" data-theme="light">
      <div class="container">
        <div class="split">
          <div class="content">
            <span class="eyebrow indigo">Use Cases</span>
            <h2>What The Function <span class="hl-indigo">Delivers.</span></h2>
            <p class="lead" style="margin-top:20px">
              A few of the outcomes teams hire us for, and the bundle of workstreams behind each.
            </p>
          </div>
          <!-- EMBED: use-case spotlight (auto-advancing, shuffle to details) -->
          <UseCaseSpotlight
            interval={3000}
            items={[
              { eyebrow: "Market entry", name: "DACH market entry", summary: "A German-language presence that compounds, run end to end.", bundle: ["Localised positioning", "A German content engine", "LinkedIn for the team", "An event motion", "Distribution that compounds"], own: "A German-language presence that compounds weekly, your existing assets finally working in-market, and a pipeline motion your salespeople don't have to run themselves." },
              { eyebrow: "Founder content", name: "Founder-led content & pipeline", summary: "A publishing motion in the founder's voice, feeding measurable pipeline.", bundle: ["Messaging & positioning", "Ghostwriting & content", "SEO & GEO", "Outbound warmed by the content", "RevOps to track what converts"], own: "A consistent publishing motion in the founder's voice, feeding measurable pipeline instead of vanity engagement." },
              { eyebrow: "Conversion", name: "Rebuild that lifts conversion", summary: "A site and message that match where the company actually is now.", bundle: ["Repositioning around where you are now", "Brand & website rebuild", "Sales collateral", "Conversion-rate optimisation", "Lifecycle & automation"], own: "A site and story that match the company today, plus an instrumented funnel you can keep improving." },
              { eyebrow: "Events", name: "Event pipeline engineering", summary: "Scored events, pre-event ABM, and CFO-grade ROI in 30 days.", bundle: ["Events scored by ICP overlap and persona density", "LinkedIn & Meta ABM from four weeks out, with calendar holds", "Hosted dinners and roundtables where deals close", "Same-day enrichment, CRM sync and sequenced follow-up"], own: "Attendees who recognise you before they walk in, meetings booked into a held calendar, and a CFO-grade ROI report inside 30 days with every meeting tagged." },
            ]}
          />
        </div>
      </div>
    </section>

    <!-- ===================== WHO WE ARE ===================== -->
    <section id="founders" class="section band-paper" data-theme="light">
      <div class="container">
        <div class="who-top">
          <div>
            <span class="eyebrow indigo">Who We Are</span>
            <h2>Two Operators <span class="hl-indigo">That Take Ownership.</span></h2>
          </div>
          <div class="bubble">
            <strong>KADANCO</strong> is a complete marketing function for B2B companies. Two operators
            take ownership of the strategy and run the execution themselves. One team, one system of action,
            one number you control. No agency overhead, no junior hand-offs, no stack of freelancers to manage.
          </div>
        </div>

        <div class="founders-grid">
          <div class="card founder">
            <img src="https://assets.kadanco.com/public/maria.jpeg" alt="Maria" class="avatar" />
            <h3>Maria</h3>
            <span class="role">Founder &amp; Product Manager</span>
            <p>20+ Product Experience Made in Berlin | B2B Sustainable Energy Management | EdTech | Financial Wellbeing</p>
            <a class="btn btn-indigo btn-block" href="https://www.linkedin.com/in/miarichter/" target="_blank" rel="noopener">View LinkedIn Profile</a>
          </div>
          <div class="card founder">
            <img src="https://assets.kadanco.com/public/karan.jpeg" alt="Karan" class="avatar" />
            <h3>Karan</h3>
            <span class="role">Founder &amp; Growth Manager</span>
            <p>Replace your GTM stack with one platform | Founder @ hubsell</p>
            <a class="btn btn-indigo btn-block" href="https://www.linkedin.com/in/krnshrm/" target="_blank" rel="noopener">View LinkedIn Profile</a>
          </div>
        </div>

        <div class="tags">
          <span class="tag">Product Development</span>
          <span class="tag">Product Management</span>
          <span class="tag">Product Design</span>
          <span class="tag">Product Marketing</span>
          <span class="tag">Lead Generation</span>
          <span class="tag">Demand Generation</span>
          <span class="tag">Growth Marketing</span>
          <span class="tag">Email Marketing</span>
          <span class="tag">Marketing Consulting</span>
          <span class="tag">Marketing Strategy</span>
          <span class="tag">Copywriting</span>
        </div>
      </div>
    </section>

    <!-- ===================== OUR APPROACH (white+outline cards, hover fills deep-indigo) ===================== -->
    <section class="section center" data-theme="light">
      <div class="container">
        <span class="eyebrow indigo">Our Approach</span>
        <h2>One Function. <span class="hl-indigo">The Whole Stack.</span></h2>
        <div class="grid cols-3" style="margin-top:48px;text-align:left">
          <div class="card card--approach">
            <span class="lab">One Owner</span>
            <h3><span class="t1">One Team, Accountable</span> <span class="t2">For Everything.</span></h3>
            <p style="margin-top:12px">A single team owns the whole function and one number, not a roster of specialists you have to coordinate.</p>
          </div>
          <div class="card card--approach">
            <span class="lab">Senior Execution</span>
            <h3><span class="t1">The Strategists That Do The Work</span> <span class="t2">For Your Teams.</span></h3>
            <p style="margin-top:12px">The operators who set the direction do the hands-on work. No junior delivery, no account layer, no markup.</p>
          </div>
          <div class="card card--approach">
            <span class="lab">One System Of Action</span>
            <h3><span class="t1">Twelve Motions,</span> <span class="t2">One Engine.</span></h3>
            <p style="margin-top:12px">Every motion runs as part of one connected system, so the whole stack compounds instead of leaking between vendors.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ===================== HOW WE OPERATE (Problem-style split + visual) ===================== -->
    <section class="section band-deep" data-theme="dark">
      <div class="container">
        <div class="split">
          <!-- EMBED: how-we-operate cadence-line process timeline -->
          <CadenceTimeline
            steps={[
              { n: "01", title: "Map", body: "We learn your market, your ICP, your funnel and your numbers, then agree on the few moves that change your pipeline the most." },
              { n: "02", title: "Build", body: "We do the work ourselves: the brand, the site, the campaigns, the content, the systems. No briefs thrown over a wall." },
              { n: "03", title: "Ship", amp: "& iterate", body: "Real work in weeks, not quarters. Then we keep shipping, and the engine gets stronger every month.", loop: "and it compounds" },
            ]}
          />
          <div class="content">
            <span class="eyebrow">How We Operate</span>
            <h2>We Don't Advise The Work. <span class="hl">We Own It And Execute It.</span></h2>
            <p class="lead" style="margin-top:20px">
              KADANCO operates as your marketing function, not a vendor attached to it. The two people who
              scope the work are the two people who do it. We take ownership of the outcome, run the motions
              ourselves, and keep the whole system pointed at pipeline. Four clients at a time, so every
              account gets senior execution.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- ===================== FAQ (centered, 3-col card grid) ===================== -->
    <section id="faq" class="section band-paper center" data-theme="light">
      <div class="container">
        <span class="eyebrow indigo">FAQ</span>
        <h2>Questions, <span class="hl-indigo">Answered.</span></h2>
        <div class="grid cols-3" style="margin-top:48px">
          <div class="card faq-card">
            <h3>How do you work with us?</h3>
            <p>We run as your marketing function on a quarterly engagement: map the market, ICP and funnel, agree the motions that move pipeline most, then execute them ourselves. Four clients at a time.</p>
          </div>
          <div class="card faq-card">
            <h3>How fast do we see results?</h3>
            <p>First execution is live inside two weeks of kickoff. From there we run in quarterly cycles, plan, ship, review, and the engine compounds.</p>
          </div>
          <div class="card faq-card">
            <h3>Who does the work?</h3>
            <p>The two operators who scope your work are the two who do it. No account-management layer, no junior delivery, no markup.</p>
          </div>
          <div class="card faq-card">
            <h3>What does it cost?</h3>
            <p>We scope each engagement to what your pipeline needs, with a predictable floor and a ceiling you control. The fastest way to a number is a short conversation.</p>
          </div>
          <div class="card faq-card">
            <h3>Only companies entering Germany?</h3>
            <p>No. We run the full marketing function for B2B companies generally. DACH market entry is one use case we do well in native German, not the whole offer.</p>
          </div>
          <div class="card faq-card">
            <h3>What's included in the function?</h3>
            <p>The whole stack: positioning, brand and website, content and ghostwriting, ABM and demand, paid, events, SEO and GEO, CRO, and RevOps. We deploy whichever motions move your pipeline.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ===================== COMPLIANCE ===================== -->
    <section class="section band-lime center" data-theme="light">
      <div class="container">
        <span class="eyebrow dark">Compliance</span>
        <div class="compliance-row">
          <!-- PLACEHOLDER badges, replace each with your real badge image (e.g. /badges/gdpr.svg) -->
          <img class="badge" src="https://assets.kadanco.com/badges/gdpr.svg" alt="GDPR compliant" />
          <img class="badge" src="https://assets.kadanco.com/badges/eu.svg" alt="EU" />
          <img class="badge" src="https://assets.kadanco.com/badges/made-in-germany.svg" alt="Made in Germany" />
        </div>
      </div>
    </section>

    <!-- ===================== FINAL CTA ===================== -->
    <section class="section cta-band center" data-theme="dark">
      <div class="container">
        <span class="eyebrow peri">Lets Talk</span>
        <h2>Tell us where you're trying to <span class="hl">grow.</span></h2>
        <p class="lead" style="margin-top:20px">We'll show you the few moves that matter most for your pipeline, then we'll make them.</p>
        <div class="cta-actions">
          <button class="btn btn-primary btn-lg" data-open-modal>Get a free audit</button>
        </div>
        <p class="cta-note">Free, no obligation. We'll get back to you quickly.</p>
      </div>
    </section>

  </main>
</Layout>