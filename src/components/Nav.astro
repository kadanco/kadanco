---
// src/components/Nav.astro
// Shared site navigation. Rendered once by Layout.astro, so it is no longer
// hard-coded per page. Section links point to the homepage (/#id) so they work
// from sub-pages (glossary, imprint) too, not just the homepage.
// Colour-aware behaviour is driven by the global script in Layout.astro.
//
// Resources is a dropdown: it reveals on hover and keyboard focus (desktop) and
// toggles on click (touch). The trigger reuses the .navlink class so it inherits
// the colour-aware styling. Like the other nav links it is hidden below 880px,
// the footer keeps the glossary reachable on mobile.
---
<header class="nav nav--dark">
  <div class="container nav-inner">
    <a class="brand" href="/" aria-label="Kadanco, home">
      <img class="brand-logo brand-logo--dark" src="https://assets.kadanco.com/logo/wordmark-light.svg" alt="Kadanco" />
      <img class="brand-logo brand-logo--light" src="https://assets.kadanco.com/logo/wordmark-dark.svg" alt="Kadanco" />
    </a>
    <nav class="nav-links" aria-label="Primary">
      <a class="navlink" href="/#services">Services</a>
      <a class="navlink" href="/#use-cases">Use Cases</a>
      <a class="navlink" href="/#founders">Who We Are</a>
      <a class="navlink" href="/#faq">FAQ</a>
      <div class="nav-resources">
        <button type="button" class="navlink nav-resources-trigger" aria-haspopup="true" aria-expanded="false">
          Resources
          <svg class="nav-caret" width="11" height="11" viewBox="0 0 12 12" aria-hidden="true"><path d="M2.5 4.5l3.5 3.5 3.5-3.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <div class="nav-resources-menu" role="menu">
          <a class="nav-resources-link" href="/glossary/" role="menuitem">Glossary</a>
        </div>
      </div>
      <button class="btn btn-primary" data-open-modal>Lets Talk</button>
    </nav>
  </div>
</header>

<style>
  .nav-resources { position: relative; display: inline-flex; }
  .nav-resources-trigger {
    display: inline-flex; align-items: center; gap: 6px;
    background: none; border: 0; padding: 0; margin: 0;
    font-family: inherit; line-height: 1; cursor: pointer;
  }
  .nav-caret { transition: transform 0.2s ease; opacity: 0.75; }
  .nav-resources:hover .nav-caret,
  .nav-resources.open .nav-caret { transform: rotate(180deg); }

  .nav-resources-menu {
    position: absolute; top: calc(100% + 16px); left: 50%;
    transform: translateX(-50%) translateY(-6px);
    min-width: 184px; padding: 6px;
    background: #fff; border: 1px solid var(--border); border-radius: var(--radius);
    box-shadow: 0 18px 44px -20px rgba(26, 1, 117, 0.30);
    opacity: 0; visibility: hidden; pointer-events: none;
    transition: opacity 0.16s ease, transform 0.16s ease;
    z-index: 90;
  }
  .nav-resources:hover .nav-resources-menu,
  .nav-resources:focus-within .nav-resources-menu,
  .nav-resources.open .nav-resources-menu {
    opacity: 1; visibility: visible; pointer-events: auto;
    transform: translateX(-50%) translateY(0);
  }
  .nav-resources-link {
    display: block; padding: 9px 12px; border-radius: 7px;
    color: var(--ink); text-decoration: none; font-size: 0.95rem; opacity: 1;
    transition: background 0.15s ease, color 0.15s ease;
  }
  .nav-resources-link:hover { background: var(--field); color: var(--indigo); }

  @media (max-width: 880px) { .nav-resources { display: none; } }
</style>

<script is:inline>
  (function () {
    var wrap = document.querySelector('.nav-resources');
    if (!wrap) return;
    var trigger = wrap.querySelector('.nav-resources-trigger');
    function close() {
      wrap.classList.remove('open');
      if (trigger) trigger.setAttribute('aria-expanded', 'false');
    }
    if (trigger) {
      trigger.addEventListener('click', function (e) {
        e.preventDefault();
        var isOpen = wrap.classList.toggle('open');
        trigger.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
      });
    }
    document.addEventListener('click', function (e) {
      if (!wrap.contains(e.target)) close();
    });
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') close();
    });
  })();
</script>