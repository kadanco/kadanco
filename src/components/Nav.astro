---
// src/components/Nav.astro
// Shared site navigation. Rendered once by Layout.astro, so it is no longer
// hard-coded per page. Section links point to the homepage (/#id) so they work
// from sub-pages (glossary, imprint) too, not just the homepage.
// Colour-aware behaviour is driven by the global script in Layout.astro.
//
// Resources is a dropdown: it reveals on hover and keyboard focus (desktop) and
// toggles on click (touch). The trigger reuses the .navlink class so it inherits
// the colour-aware styling. Like the other nav links it is hidden below 880px,
// the footer keeps the glossary reachable on mobile.
//
// Labels come from the i18n dictionary (src/i18n/ui.ts) and links run through
// localizedHref, so one nav serves both languages. The language switcher reuses
// the same dropdown markup and script as Use Cases and Resources.
import { switcherLocales, localeNames } from '../i18n/ui';
import { asLocale, useTranslations, localizedHref, localizeUrl, basePath, hasTranslation } from '../i18n/utils';

const locale = asLocale(Astro.currentLocale);
const t = useTranslations(locale);
const base = basePath(Astro.url.pathname, locale);

const useCases = [
  { key: 'uc.dach', href: '/use-cases/dach-market-entry/' },
  { key: 'uc.founder', href: '/use-cases/founder-led-content/' },
  { key: 'uc.conversion', href: '/use-cases/conversion-rebuild/' },
  { key: 'uc.events', href: '/use-cases/event-pipeline/' },
];

// A language is a real link only where THIS page is translated; otherwise it is
// shown greyed out, so nobody clicks through to a redirect.
const langItems = switcherLocales.map((l) => ({
  code: l,
  name: localeNames[l],
  current: l === locale,
  available: hasTranslation(l, base),
  href: localizeUrl(l, base === '/' ? '/' : base + '/'),
}));
---
<header class="nav nav--dark">
  <div class="container nav-inner">
    <a class="brand" href={localizedHref(locale, '/')} aria-label={t('nav.home')}>
      <img class="brand-logo brand-logo--dark" src="https://assets.kadanco.com/logo/wordmark-light.svg" alt="Kadanco" />
      <img class="brand-logo brand-logo--light" src="https://assets.kadanco.com/logo/wordmark-dark.svg" alt="Kadanco" />
    </a>
    <nav class="nav-links" aria-label="Primary">
      <a class="navlink" href={localizedHref(locale, '/#services')}>{t('nav.services')}</a>
      <div class="nav-resources">
        <button type="button" class="navlink nav-resources-trigger" aria-haspopup="true" aria-expanded="false">
          {t('nav.usecases')}
          <svg class="nav-caret" width="11" height="11" viewBox="0 0 12 12" aria-hidden="true"><path d="M2.5 4.5l3.5 3.5 3.5-3.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <div class="nav-resources-menu nav-resources-menu--wide" role="menu">
          {useCases.map((l) => (
            <a class="nav-resources-link" href={localizedHref(locale, l.href)} role="menuitem">{t(l.key)}</a>
          ))}
          <a class="nav-resources-link nav-resources-link--all" href={localizedHref(locale, '/#use-cases')} role="menuitem">{t('nav.allusecases')}</a>
        </div>
      </div>
      <a class="navlink" href={localizedHref(locale, '/#founders')}>{t('nav.whoweare')}</a>
      <a class="navlink" href={localizedHref(locale, '/#faq')}>{t('nav.faq')}</a>
      <div class="nav-resources">
        <button type="button" class="navlink nav-resources-trigger" aria-haspopup="true" aria-expanded="false">
          {t('nav.resources')}
          <svg class="nav-caret" width="11" height="11" viewBox="0 0 12 12" aria-hidden="true"><path d="M2.5 4.5l3.5 3.5 3.5-3.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <div class="nav-resources-menu" role="menu">
          <a class="nav-resources-link" href="/glossary/" role="menuitem">{t('nav.glossary')}</a>
        </div>
      </div>
      <div class="nav-resources nav-lang">
        <button type="button" class="navlink nav-resources-trigger" aria-haspopup="true" aria-expanded="false" aria-label={t('lang.label')}>
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M3 12h18"/><path d="M12 3a15 15 0 0 1 0 18"/><path d="M12 3a15 15 0 0 0 0 18"/></svg>
          <span>{localeNames[locale]}</span>
          <svg class="nav-caret" width="11" height="11" viewBox="0 0 12 12" aria-hidden="true"><path d="M2.5 4.5l3.5 3.5 3.5-3.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <div class="nav-resources-menu" role="menu">
          {langItems.map((it) => (
            it.current
              ? <span class="nav-resources-link is-current" aria-current="true">{it.name}</span>
              : it.available
                ? <a class="nav-resources-link" href={it.href} role="menuitem" hreflang={it.code}>{it.name}</a>
                : <span class="nav-resources-link is-soon">{it.name}</span>
          ))}
        </div>
      </div>
      <button class="btn btn-primary" data-open-modal>{t('nav.cta')}</button>
      <button type="button" class="nav-burger" id="nav-burger" aria-expanded="false" aria-controls="nav-mobile" aria-label={t('nav.menu')}>
        <span class="nav-burger-box" aria-hidden="true"><span></span><span></span><span></span></span>
      </button>
    </nav>
  </div>

  <!-- Mobile panel. The sub-groups are native <details>, so they are keyboard
       accessible and work even if the script fails. Only the panel itself needs JS. -->
  <div class="nav-mobile" id="nav-mobile" hidden>
    <div class="container">
      <a class="nav-m-link" href={localizedHref(locale, '/#services')}>{t('nav.services')}</a>

      <details class="nav-m-group">
        <summary>
          <span>{t('nav.usecases')}</span>
          <svg class="nav-m-caret" width="12" height="12" viewBox="0 0 12 12" aria-hidden="true"><path d="M2.5 4.5l3.5 3.5 3.5-3.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </summary>
        <div class="nav-m-sub">
          {useCases.map((l) => (
            <a class="nav-m-sublink" href={localizedHref(locale, l.href)}>{t(l.key)}</a>
          ))}
          <a class="nav-m-sublink" href={localizedHref(locale, '/#use-cases')}>{t('nav.allusecases')}</a>
        </div>
      </details>

      <a class="nav-m-link" href={localizedHref(locale, '/#founders')}>{t('nav.whoweare')}</a>
      <a class="nav-m-link" href={localizedHref(locale, '/#faq')}>{t('nav.faq')}</a>

      <details class="nav-m-group">
        <summary>
          <span>{t('nav.resources')}</span>
          <svg class="nav-m-caret" width="12" height="12" viewBox="0 0 12 12" aria-hidden="true"><path d="M2.5 4.5l3.5 3.5 3.5-3.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </summary>
        <div class="nav-m-sub">
          <a class="nav-m-sublink" href="/glossary/">{t('nav.glossary')}</a>
        </div>
      </details>

      <!-- Language: the trigger spells out the current language in full, next to the globe. -->
      <details class="nav-m-group nav-m-lang">
        <summary aria-label={t('lang.label')}>
          <span class="nav-m-langname">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M3 12h18"/><path d="M12 3a15 15 0 0 1 0 18"/><path d="M12 3a15 15 0 0 0 0 18"/></svg>
            {localeNames[locale]}
          </span>
          <svg class="nav-m-caret" width="12" height="12" viewBox="0 0 12 12" aria-hidden="true"><path d="M2.5 4.5l3.5 3.5 3.5-3.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </summary>
        <div class="nav-m-sub">
          {langItems.map((it) => (
            it.current
              ? <span class="nav-m-sublink is-current" aria-current="true">{it.name}</span>
              : it.available
                ? <a class="nav-m-sublink" href={it.href} hreflang={it.code}>{it.name}</a>
                : <span class="nav-m-sublink is-soon">{it.name}</span>
          ))}
        </div>
      </details>

      <button class="btn btn-primary btn-block nav-m-cta" data-open-modal>{t('nav.cta')}</button>
    </div>
  </div>
</header>

<style>
  .nav-resources { position: relative; display: inline-flex; }
  .nav-resources-trigger {
    display: inline-flex; align-items: center; gap: 6px;
    background: none; border: 0; padding: 0; margin: 0;
    font-family: inherit; line-height: 1; cursor: pointer;
  }
  .nav-caret { transition: transform 0.2s ease; opacity: 0.75; }
  .nav-resources:hover .nav-caret,
  .nav-resources.open .nav-caret { transform: rotate(180deg); }

  .nav-resources-menu {
    position: absolute; top: calc(100% + 16px); left: 50%;
    transform: translateX(-50%) translateY(-6px);
    min-width: 184px; padding: 6px;
    background: #fff; border: 1px solid var(--border); border-radius: var(--radius);
    box-shadow: 0 18px 44px -20px rgba(26, 1, 117, 0.30);
    opacity: 0; visibility: hidden; pointer-events: none;
    transition: opacity 0.16s ease, transform 0.16s ease;
    z-index: 90;
  }
  /* Invisible bridge across the gap so the menu stays open while the pointer */
  /* travels from the trigger down to the menu (fixes the finicky hover). */
  .nav-resources-menu::before {
    content: ""; position: absolute; left: 0; right: 0; top: -16px; height: 16px;
  }
  .nav-resources:hover .nav-resources-menu,
  .nav-resources:focus-within .nav-resources-menu,
  .nav-resources.open .nav-resources-menu {
    opacity: 1; visibility: visible; pointer-events: auto;
    transform: translateX(-50%) translateY(0);
  }
  .nav-resources-link {
    display: block; padding: 9px 12px; border-radius: var(--radius);
    color: var(--ink); text-decoration: none; font-size: 0.95rem; opacity: 1;
    transition: background 0.15s ease, color 0.15s ease;
  }
  .nav-resources-link:hover { background: var(--field); color: var(--indigo); }
  /* the use-cases menu carries longer labels than Resources */
  .nav-resources-menu--wide { min-width: 236px; }
  .nav-resources-link--all {
    margin-top: 5px; padding-top: 12px;
    border-top: 1px solid var(--border);
    color: var(--muted); font-size: 0.9rem;
  }

  .nav-lang .nav-resources-trigger { gap: 7px; }
  .nav-lang .nav-resources-menu { min-width: 150px; }
  .nav-resources-link.is-current { color: var(--indigo); font-weight: 500; cursor: default; }
  .nav-resources-link.is-soon { color: var(--muted); opacity: 0.55; cursor: default; }

  @media (max-width: 880px) { .nav-resources { display: none; } }

  /* ===================== MOBILE MENU ===================== */
  /* Hidden on desktop; the burger and panel only exist below 880px, which is the
     same breakpoint where the desktop links and dropdowns are hidden. */
  .nav-burger { display: none; }
  .nav-mobile { display: none; }

  @media (max-width: 880px) {
    .nav-burger {
      display: inline-flex; align-items: center; justify-content: center;
      background: none; border: 0; padding: 8px; margin: 0 -8px 0 0;
      color: inherit; cursor: pointer;
    }
    .nav-burger-box { position: relative; display: block; width: 22px; height: 16px; }
    .nav-burger-box span {
      position: absolute; left: 0; right: 0; height: 2px; border-radius: 2px;
      background: currentColor;
      transition: transform 0.2s ease, opacity 0.15s ease, top 0.2s ease;
    }
    .nav-burger-box span:nth-child(1) { top: 0; }
    .nav-burger-box span:nth-child(2) { top: 7px; }
    .nav-burger-box span:nth-child(3) { top: 14px; }
    .nav-burger[aria-expanded="true"] .nav-burger-box span:nth-child(1) { top: 7px; transform: rotate(45deg); }
    .nav-burger[aria-expanded="true"] .nav-burger-box span:nth-child(2) { opacity: 0; }
    .nav-burger[aria-expanded="true"] .nav-burger-box span:nth-child(3) { top: 7px; transform: rotate(-45deg); }

    /* Solid panel: the nav bar itself is transparent, so the panel supplies its
       own background and always uses ink-on-white regardless of section theme. */
    .nav-mobile {
      display: block;
      background: #fff;
      border-top: 1px solid var(--border);
      box-shadow: 0 24px 44px -24px rgba(26, 1, 117, 0.35);
      max-height: calc(100dvh - 80px);
      overflow-y: auto;
      padding: 8px 0 22px;
      color: var(--ink);
    }
    .nav-mobile[hidden] { display: none; }

    .nav-m-link,
    .nav-m-group > summary {
      display: flex; align-items: center; justify-content: space-between;
      gap: 12px; width: 100%;
      padding: 14px 2px;
      border-bottom: 1px solid var(--border);
      color: var(--ink); text-decoration: none;
      font-size: 1.05rem; font-weight: 500;
    }
    .nav-m-group > summary { cursor: pointer; list-style: none; }
    .nav-m-group > summary::-webkit-details-marker { display: none; }
    .nav-m-caret { opacity: 0.6; flex: none; transition: transform 0.2s ease; }
    .nav-m-group[open] > summary .nav-m-caret { transform: rotate(180deg); }

    .nav-m-sub { padding: 6px 0 12px 2px; display: flex; flex-direction: column; }
    .nav-m-sublink {
      padding: 11px 12px; border-radius: var(--radius);
      color: var(--muted); text-decoration: none; font-size: 1rem;
    }
    .nav-m-sublink:hover { background: var(--field); color: var(--indigo); }
    .nav-m-sublink.is-current { color: var(--indigo); font-weight: 500; }
    .nav-m-sublink.is-soon { opacity: 0.55; }

    .nav-m-langname { display: inline-flex; align-items: center; gap: 9px; }

    .nav-m-cta { margin-top: 18px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-burger-box span, .nav-m-caret { transition: none; }
  }
</style>

<script is:inline>
  (function () {
    // There is more than one dropdown in the nav (Use Cases, Resources), so this
    // handles all of them: opening one closes the others.
    var wraps = Array.prototype.slice.call(document.querySelectorAll('.nav-resources'));
    if (!wraps.length) return;
    function close(wrap) {
      wrap.classList.remove('open');
      var t = wrap.querySelector('.nav-resources-trigger');
      if (t) t.setAttribute('aria-expanded', 'false');
    }
    function closeAll(except) {
      wraps.forEach(function (w) { if (w !== except) close(w); });
    }
    wraps.forEach(function (wrap) {
      var trigger = wrap.querySelector('.nav-resources-trigger');
      if (!trigger) return;
      trigger.addEventListener('click', function (e) {
        e.preventDefault();
        var isOpen = wrap.classList.toggle('open');
        trigger.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
        if (isOpen) closeAll(wrap);
      });
    });
    document.addEventListener('click', function (e) {
      wraps.forEach(function (w) { if (!w.contains(e.target)) close(w); });
    });
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') closeAll(null);
    });
  })();

  // Mobile panel toggle. Guarded so it runs once even if the nav is re-rendered.
  (function () {
    if (window.__navMobileInit) return;
    var burger = document.getElementById('nav-burger');
    var panel = document.getElementById('nav-mobile');
    if (!burger || !panel) return;
    window.__navMobileInit = true;

    function setOpen(open) {
      panel.hidden = !open;
      burger.setAttribute('aria-expanded', open ? 'true' : 'false');
      // Lock background scroll while the panel is open.
      document.body.style.overflow = open ? 'hidden' : '';
      if (!open) {
        // Collapse the accordions so the panel reopens in a known state.
        panel.querySelectorAll('details[open]').forEach(function (d) { d.open = false; });
      }
    }

    burger.addEventListener('click', function () {
      setOpen(panel.hidden);
    });

    // Any navigation or the CTA closes the panel.
    panel.addEventListener('click', function (e) {
      var el = e.target.closest ? e.target.closest('a, [data-open-modal]') : null;
      if (el) setOpen(false);
    });

    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && !panel.hidden) {
        setOpen(false);
        burger.focus();
      }
    });

    // Returning to desktop width must not leave a locked body or an open panel.
    window.addEventListener('resize', function () {
      if (window.innerWidth > 880 && !panel.hidden) setOpen(false);
    });
  })();
</script>