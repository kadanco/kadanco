---
// src/components/Nav.astro
// Shared site navigation, rendered once by Layout.astro. October 2026 design:
// solid navy bar, white links, EN / DE switch in lilac, blue CTA.
// Section links point to the homepage (/#id) so they work from sub-pages too.
//
// The Light / Auto / Dark theme switch is shown only on pages that support
// dark mode (Layout passes `themeable`). Its state lives on <html data-mode>
// and in localStorage; the head script in Layout.astro restores it before
// first paint so there is no flash.
//
// Labels come from the i18n dictionary (src/i18n/ui.ts) and links run through
// localizedHref, so one nav serves both languages. The use case and glossary
// pages are reached from the footer.
import { switcherLocales } from '../i18n/ui';
import { asLocale, useTranslations, localizedHref, localizeUrl, basePath, hasTranslation } from '../i18n/utils';

const { themeable = false } = Astro.props;
const locale = asLocale(Astro.currentLocale);
const t = useTranslations(locale);
const base = basePath(Astro.url.pathname, locale);

const links = [
  { key: 'nav.product', href: '/#product' },
  { key: 'nav.marketing', href: '/#marketing' },
  { key: 'nav.sales', href: '/#sales' },
  { key: 'nav.about', href: '/#about' },
];

// A language is a real link only where THIS page is translated; otherwise it is
// shown greyed out, so nobody clicks through to a redirect.
const langItems = switcherLocales.map((l) => ({
  code: l,
  current: l === locale,
  available: hasTranslation(l, base),
  href: localizeUrl(l, base === '/' ? '/' : base + '/'),
}));

const themes = [
  { t: 'light', key: 'theme.light' },
  { t: 'system', key: 'theme.auto' },
  { t: 'dark', key: 'theme.dark' },
];
---
<header class="nav">
  <div class="container nav-inner">
    <a class="brand" href={localizedHref(locale, '/')} aria-label={t('nav.home')}>
      <img class="brand-logo" src="https://assets.kadanco.com/logo/wordmark-light.svg" alt="Kadanco" />
    </a>
    <nav class="nav-links" aria-label="Primary">
      {links.map((l) => <a class="navlink" href={localizedHref(locale, l.href)}>{t(l.key)}</a>)}
    </nav>
    <div class="nav-right">
      <span class="nav-lang" aria-label={t('lang.label')}>
        {langItems.map((it, i) => (
          <>
            {i > 0 && <span class="nav-lang-sep" aria-hidden="true">/</span>}
            {it.current
              ? <span class="is-current" aria-current="true">{it.code.toUpperCase()}</span>
              : it.available
                ? <a href={it.href} hreflang={it.code}>{it.code.toUpperCase()}</a>
                : <span class="is-soon">{it.code.toUpperCase()}</span>}
          </>
        ))}
      </span>
      {themeable && (
        <div class="theme-switch" role="group" aria-label={t('theme.label')}>
          {themes.map((m) => <button type="button" data-t={m.t} aria-pressed={m.t === 'system' ? 'true' : 'false'}>{t(m.key)}</button>)}
        </div>
      )}
      <button class="btn btn-primary btn-sm nav-cta" data-open-modal>{t('nav.cta')}</button>
      <button type="button" class="nav-burger" id="nav-burger" aria-expanded="false" aria-controls="nav-mobile" aria-label={t('nav.menu')}>
        <span class="nav-burger-box" aria-hidden="true"><span></span><span></span><span></span></span>
      </button>
    </div>
  </div>

  <!-- Mobile panel. Only the open/close needs JS. -->
  <div class="nav-mobile" id="nav-mobile" hidden>
    <div class="container">
      {links.map((l) => <a class="nav-m-link" href={localizedHref(locale, l.href)}>{t(l.key)}</a>)}

      <div class="nav-m-row">
        <span class="nav-m-lang" aria-label={t('lang.label')}>
          {langItems.map((it, i) => (
            <>
              {i > 0 && <span aria-hidden="true">/</span>}
              {it.current
                ? <span class="is-current" aria-current="true">{it.code.toUpperCase()}</span>
                : it.available
                  ? <a href={it.href} hreflang={it.code}>{it.code.toUpperCase()}</a>
                  : <span class="is-soon">{it.code.toUpperCase()}</span>}
            </>
          ))}
        </span>
        {themeable && (
          <div class="theme-switch theme-switch--light" role="group" aria-label={t('theme.label')}>
            {themes.map((m) => <button type="button" data-t={m.t} aria-pressed={m.t === 'system' ? 'true' : 'false'}>{t(m.key)}</button>)}
          </div>
        )}
      </div>

      <button class="btn btn-primary btn-block nav-m-cta" data-open-modal>{t('nav.cta')}</button>
    </div>
  </div>
</header>

<style>
  .nav-right { display: flex; align-items: center; gap: 18px; }

  .nav-lang { display: inline-flex; align-items: center; gap: 6px; font-size: 0.9rem; font-weight: 500; color: var(--kd-lilac); }
  .nav-lang a { color: var(--kd-lilac); text-decoration: none; }
  .nav-lang a:hover { color: var(--kd-white); }
  .nav-lang .is-current { color: var(--kd-white); }
  .nav-lang .is-soon { opacity: 0.45; }

  /* Light / Auto / Dark, same pattern as the brand system's theme control */
  .theme-switch { display: inline-flex; gap: 2px; padding: 3px; border: 1px solid rgba(255, 255, 255, 0.25); border-radius: var(--radius); }
  .theme-switch button {
    all: unset; cursor: pointer; padding: 5px 9px; border-radius: var(--radius);
    font-size: 0.75rem; font-weight: 500; color: var(--kd-lilac-soft);
  }
  .theme-switch button[aria-pressed="true"] { background: var(--kd-blue-2); color: var(--kd-white); }
  .theme-switch button:focus-visible { outline: 2px solid var(--kd-lilac); outline-offset: 1px; }
  .theme-switch--light { border-color: var(--kd-beige-3); }
  .theme-switch--light button { color: var(--kd-ink-2); }

  @media (max-width: 880px) {
    .nav-links, .nav-right .nav-lang, .nav-right .theme-switch, .nav-cta { display: none; }
  }

  /* ===================== MOBILE MENU ===================== */
  .nav-burger { display: none; }
  .nav-mobile { display: none; }

  @media (max-width: 880px) {
    .nav-burger {
      display: inline-flex; align-items: center; justify-content: center;
      background: none; border: 0; padding: 8px; margin: 0 -8px 0 0;
      color: inherit; cursor: pointer;
    }
    .nav-burger-box { position: relative; display: block; width: 22px; height: 16px; }
    .nav-burger-box span {
      position: absolute; left: 0; right: 0; height: 2px; border-radius: 2px;
      background: currentColor;
      transition: transform 0.2s ease, opacity 0.15s ease, top 0.2s ease;
    }
    .nav-burger-box span:nth-child(1) { top: 0; }
    .nav-burger-box span:nth-child(2) { top: 7px; }
    .nav-burger-box span:nth-child(3) { top: 14px; }
    .nav-burger[aria-expanded="true"] .nav-burger-box span:nth-child(1) { top: 7px; transform: rotate(45deg); }
    .nav-burger[aria-expanded="true"] .nav-burger-box span:nth-child(2) { opacity: 0; }
    .nav-burger[aria-expanded="true"] .nav-burger-box span:nth-child(3) { top: 7px; transform: rotate(-45deg); }

    .nav-mobile {
      display: block;
      background: var(--kd-white);
      border-top: 1px solid var(--kd-beige-3);
      max-height: calc(100dvh - 80px);
      overflow-y: auto;
      padding: 8px 0 22px;
      color: var(--kd-ink);
    }
    .nav-mobile[hidden] { display: none; }

    .nav-m-link {
      display: flex; align-items: center; width: 100%;
      padding: 14px 2px;
      border-bottom: 1px solid var(--kd-beige-3);
      color: var(--kd-ink); text-decoration: none;
      font-size: 1.05rem; font-weight: 500;
    }
    .nav-m-row { display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; padding: 16px 2px 0; }
    .nav-m-lang { display: inline-flex; gap: 8px; font-weight: 500; color: var(--kd-ink-2); }
    .nav-m-lang a { color: var(--kd-blue-2); text-decoration: none; }
    .nav-m-lang .is-current { color: var(--kd-ink); }
    .nav-m-lang .is-soon { opacity: 0.45; }
    .nav-m-cta { margin-top: 18px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-burger-box span { transition: none; }
  }
</style>

<script is:inline>
  // Theme switch. Every switch on the page (desktop and mobile) stays in sync.
  (function () {
    var root = document.documentElement;
    var btns = Array.prototype.slice.call(document.querySelectorAll('.theme-switch button'));
    if (!btns.length) return;
    function show(mode) {
      btns.forEach(function (b) { b.setAttribute('aria-pressed', b.getAttribute('data-t') === mode ? 'true' : 'false'); });
    }
    function set(mode) {
      if (mode === 'system') root.removeAttribute('data-mode'); else root.setAttribute('data-mode', mode);
      show(mode);
      try { if (mode === 'system') localStorage.removeItem('kd-theme'); else localStorage.setItem('kd-theme', mode); } catch (e) {}
    }
    btns.forEach(function (b) { b.addEventListener('click', function () { set(b.getAttribute('data-t')); }); });
    show(root.getAttribute('data-mode') || 'system');
  })();

  // Mobile panel toggle. Guarded so it runs once even if the nav is re-rendered.
  (function () {
    if (window.__navMobileInit) return;
    var burger = document.getElementById('nav-burger');
    var panel = document.getElementById('nav-mobile');
    if (!burger || !panel) return;
    window.__navMobileInit = true;

    function setOpen(open) {
      panel.hidden = !open;
      burger.setAttribute('aria-expanded', open ? 'true' : 'false');
      // Lock background scroll while the panel is open.
      document.body.style.overflow = open ? 'hidden' : '';
    }

    burger.addEventListener('click', function () {
      setOpen(panel.hidden);
    });

    // Any navigation or the CTA closes the panel.
    panel.addEventListener('click', function (e) {
      var el = e.target.closest ? e.target.closest('a, [data-open-modal]') : null;
      if (el) setOpen(false);
    });

    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && !panel.hidden) {
        setOpen(false);
        burger.focus();
      }
    });

    // Returning to desktop width must not leave a locked body or an open panel.
    window.addEventListener('resize', function () {
      if (window.innerWidth > 880 && !panel.hidden) setOpen(false);
    });
  })();
</script>
