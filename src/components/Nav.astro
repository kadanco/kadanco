---
// src/components/Nav.astro
// Shared site navigation, rendered once by Layout.astro.
//
// Look: the original kadanco.com nav. Fixed and transparent with a blur,
// white text over dark sections and ink text over light ones, the logo
// swapping to match, the lime underline on links and the lime CTA. This is
// a deliberate exception to the "no glass" brand rule (owner decision).
// The colour switch is driven by the script in Layout.astro, which reads the
// background under the nav, so it also follows dark mode.
//
// Content: four items, Services, Use Cases and Resources as dropdowns plus
// About, then a plain EN / DE switch, a light/dark toggle (only on pages that
// support dark mode, see `themeable` in Layout.astro) and "Let's Talk".
// Dropdowns open on hover and keyboard focus (desktop) and on click (touch).
// The use case list comes from src/data/use-cases.ts, so it stays in sync.
// Resources is meant to grow (blog posts later): add items to `resources`.
import { switcherLocales } from '../i18n/ui';
import { useCases } from '../data/use-cases';
import { asLocale, useTranslations, localizedHref, localizeUrl, basePath, hasTranslation } from '../i18n/utils';

const { themeable = false } = Astro.props;
const locale = asLocale(Astro.currentLocale);
const t = useTranslations(locale);
const base = basePath(Astro.url.pathname, locale);

type Item = { label: string; href: string; all?: boolean };
type Menu = { key: string; items: Item[] };

const services: Item[] = [
  { label: 'Product Design', href: '/#product' },
  { label: 'Product Marketing', href: '/#marketing' },
  { label: 'Sales', href: '/#sales' },
];
// pages link to their detail page; case studies to their card on /use-cases/
const ucItems: Item[] = useCases.map((u) => ({
  label: (u[locale] ?? u.en).name,
  href: u.kind === 'page' && u.href ? u.href : `/use-cases/#${u.id}`,
}));
const resources: Item[] = [
  { label: t('nav.glossary'), href: '/glossary/' },
  { label: t('nav.faq'), href: '/#faq' },
];
const menus: Menu[] = [
  { key: 'nav.services', items: services },
  { key: 'nav.usecases', items: [...ucItems, { label: t('nav.allusecases'), href: '/use-cases/', all: true }] },
  { key: 'nav.resources', items: resources },
];
const about = { key: 'nav.about', href: '/#about' };


// A language is a real link only where THIS page is translated; otherwise it is
// shown greyed out, so nobody clicks through to a redirect.
const langItems = switcherLocales.map((l) => ({
  code: l,
  current: l === locale,
  available: hasTranslation(l, base),
  href: localizeUrl(l, base === '/' ? '/' : base + '/'),
}));
---
<header class="nav nav--dark">
  <div class="container nav-inner">
    <a class="brand" href={localizedHref(locale, '/')} aria-label={t('nav.home')}>
      <img class="brand-logo brand-logo--dark" src="https://assets.kadanco.com/logo/wordmark-light.svg" alt="Kadanco" />
      <img class="brand-logo brand-logo--light" src="https://assets.kadanco.com/logo/wordmark-dark.svg" alt="Kadanco" />
    </a>
    <nav class="nav-links" aria-label="Primary">
      {menus.map((m) => (
        <div class="nav-dd">
          <button type="button" class="navlink nav-dd-trigger" aria-haspopup="true" aria-expanded="false">
            {t(m.key)}
            <svg class="nav-caret" width="11" height="11" viewBox="0 0 12 12" aria-hidden="true"><path d="M2.5 4.5l3.5 3.5 3.5-3.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
          </button>
          <div class="nav-dd-menu" role="menu">
            {m.items.map((it) => <a class:list={['nav-dd-link', { 'nav-dd-link--all': it.all }]} href={localizedHref(locale, it.href)} role="menuitem">{it.label}</a>)}
          </div>
        </div>
      ))}
      <a class="navlink" href={localizedHref(locale, about.href)}>{t(about.key)}</a>

      <span class="nav-lang" aria-label={t('lang.label')}>
        {langItems.map((it, i) => (
          <>
            {i > 0 && <span class="nav-lang-sep" aria-hidden="true">/</span>}
            {it.current
              ? <span class="is-current" aria-current="true">{it.code.toUpperCase()}</span>
              : it.available
                ? <a href={it.href} hreflang={it.code}>{it.code.toUpperCase()}</a>
                : <span class="is-soon">{it.code.toUpperCase()}</span>}
          </>
        ))}
      </span>

      {themeable && (
        <button type="button" class="theme-toggle" data-theme-toggle aria-label={t('theme.toDark')} data-label-dark={t('theme.toDark')} data-label-light={t('theme.toLight')}>
          <svg class="ic-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z" /></svg>
          <svg class="ic-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
        </button>
      )}

      <button class="btn btn-lime nav-cta" data-open-modal>{t('nav.cta')}</button>
      <button type="button" class="nav-burger" id="nav-burger" aria-expanded="false" aria-controls="nav-mobile" aria-label={t('nav.menu')}>
        <span class="nav-burger-box" aria-hidden="true"><span></span><span></span><span></span></span>
      </button>
    </nav>
  </div>

  <!-- Mobile panel. Only the open/close needs JS. -->
  <div class="nav-mobile" id="nav-mobile" hidden>
    <div class="container">
      {menus.map((m) => (
        <details class="nav-m-group">
          <summary>
            <span>{t(m.key)}</span>
            <svg class="nav-m-caret" width="12" height="12" viewBox="0 0 12 12" aria-hidden="true"><path d="M2.5 4.5l3.5 3.5 3.5-3.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
          </summary>
          <div class="nav-m-sub">
            {m.items.map((it) => <a class:list={['nav-m-sublink', { 'nav-m-sublink--all': it.all }]} href={localizedHref(locale, it.href)}>{it.label}</a>)}
          </div>
        </details>
      ))}
      <a class="nav-m-link" href={localizedHref(locale, about.href)}>{t(about.key)}</a>
      <div class="nav-m-row">
        <span class="nav-lang" aria-label={t('lang.label')}>
          {langItems.map((it, i) => (
            <>
              {i > 0 && <span class="nav-lang-sep" aria-hidden="true">/</span>}
              {it.current
                ? <span class="is-current" aria-current="true">{it.code.toUpperCase()}</span>
                : it.available
                  ? <a href={it.href} hreflang={it.code}>{it.code.toUpperCase()}</a>
                  : <span class="is-soon">{it.code.toUpperCase()}</span>}
            </>
          ))}
        </span>
        {themeable && (
          <button type="button" class="theme-toggle" data-theme-toggle aria-label={t('theme.toDark')} data-label-dark={t('theme.toDark')} data-label-light={t('theme.toLight')}>
            <svg class="ic-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z" /></svg>
            <svg class="ic-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
          </button>
        )}
      </div>
    </div>
  </div>
</header>

<style>
  /* EN / DE: plain text in the nav colour, the current language at full strength */
  .nav-lang { display: inline-flex; align-items: center; gap: 6px; font-size: 0.9rem; font-weight: 500; }
  .nav-lang a { color: inherit; text-decoration: none; opacity: .6; }
  .nav-lang a:hover { opacity: 1; }
  .nav-lang .nav-lang-sep { opacity: .4; }
  .nav-lang .is-soon { opacity: .3; }

  /* light/dark: one icon button; shows the moon in light mode, the sun in dark */
  .theme-toggle { display: inline-grid; place-items: center; width: 32px; height: 32px; margin: 0 -6px; padding: 0; border: 0; border-radius: var(--kd-radius); background: none; color: inherit; cursor: pointer; opacity: .82; }
  .theme-toggle:hover { opacity: 1; }
  .theme-toggle:focus-visible { outline: 2px solid currentColor; outline-offset: 2px; }
  .theme-toggle .ic-sun { display: none; }
  :global([data-mode="dark"]) .theme-toggle .ic-sun { display: block; }
  :global([data-mode="dark"]) .theme-toggle .ic-moon { display: none; }
  @media (prefers-color-scheme: dark) {
    :global(html:not([data-mode])) .theme-toggle .ic-sun { display: block; }
    :global(html:not([data-mode])) .theme-toggle .ic-moon { display: none; }
  }

  @media (max-width: 880px) { .nav-links > .nav-lang, .nav-links > .theme-toggle { display: none; } }
  .nav-links .navlink { white-space: nowrap; }
  @media (max-width: 1080px) { .nav-links { gap: 22px; } }

  /* ---------- dropdowns (hover and focus on desktop, click on touch) ---------- */
  .nav-dd { position: relative; display: inline-flex; }
  .nav-dd-trigger { display: inline-flex; align-items: center; gap: 6px; background: none; border: 0; padding: 0; margin: 0; font-family: inherit; line-height: 1; cursor: pointer; }
  .nav-caret { transition: transform .2s ease; opacity: .75; }
  .nav-dd:hover .nav-caret, .nav-dd.open .nav-caret { transform: rotate(180deg); }
  .nav-dd-menu {
    position: absolute; top: calc(100% + 16px); left: 50%; z-index: 90;
    min-width: 200px; padding: 6px;
    background: var(--kd-white); border: 1px solid var(--kd-beige-3); border-radius: var(--kd-radius);
    box-shadow: 0 18px 44px -20px rgba(26, 1, 117, .3);
    transform: translateX(-50%) translateY(-6px); opacity: 0; visibility: hidden; pointer-events: none;
    transition: opacity .16s ease, transform .16s ease;
  }
  /* invisible bridge so the menu stays open while the pointer moves down to it */
  .nav-dd-menu::before { content: ""; position: absolute; left: 0; right: 0; top: -16px; height: 16px; }
  .nav-dd:hover .nav-dd-menu, .nav-dd:focus-within .nav-dd-menu, .nav-dd.open .nav-dd-menu {
    opacity: 1; visibility: visible; pointer-events: auto; transform: translateX(-50%) translateY(0);
  }
  .nav-dd-link { display: block; padding: 9px 12px; border-radius: var(--kd-radius); color: var(--kd-ink); text-decoration: none; font-size: .95rem; white-space: nowrap; }
  .nav-dd-link:hover, .nav-dd-link:focus-visible { background: var(--kd-beige-1); color: var(--kd-blue-2); outline: none; }
  .nav-dd-link--all { margin-top: 5px; padding-top: 12px; border-top: 1px solid var(--kd-beige-3); border-radius: 0 0 var(--kd-radius) var(--kd-radius); font-weight: var(--kd-weight-medium); }
  @media (max-width: 880px) { .nav-dd { display: none; } }
  /* narrow phones: the logo never shrinks; the CTA gets smaller instead */
  .brand { flex: none; }
  @media (max-width: 480px) {
    .nav-inner { gap: 12px; }
    .nav-links { gap: 16px; }
    .nav-cta { min-height: 38px; padding: 0 14px; font-size: 0.85rem; }
  }

  /* ===================== MOBILE MENU ===================== */
  .nav-burger { display: none; }
  .nav-mobile { display: none; }

  @media (max-width: 880px) {
    .nav-burger {
      display: inline-flex; align-items: center; justify-content: center;
      background: none; border: 0; padding: 8px; margin: 0 -8px 0 0;
      color: inherit; cursor: pointer;
    }
    .nav-burger-box { position: relative; display: block; width: 22px; height: 16px; }
    .nav-burger-box span {
      position: absolute; left: 0; right: 0; height: 2px; border-radius: 2px;
      background: currentColor;
      transition: transform 0.2s ease, opacity 0.15s ease, top 0.2s ease;
    }
    .nav-burger-box span:nth-child(1) { top: 0; }
    .nav-burger-box span:nth-child(2) { top: 7px; }
    .nav-burger-box span:nth-child(3) { top: 14px; }
    .nav-burger[aria-expanded="true"] .nav-burger-box span:nth-child(1) { top: 7px; transform: rotate(45deg); }
    .nav-burger[aria-expanded="true"] .nav-burger-box span:nth-child(2) { opacity: 0; }
    .nav-burger[aria-expanded="true"] .nav-burger-box span:nth-child(3) { top: 7px; transform: rotate(-45deg); }

    /* Solid panel: the nav bar is transparent, so the panel brings its own
       white background and ink text, whatever section is behind it. */
    .nav-mobile {
      display: block;
      background: var(--kd-white);
      border-top: 1px solid var(--kd-beige-3);
      max-height: calc(100dvh - 80px);
      overflow-y: auto;
      padding: 8px 0 22px;
      color: var(--kd-ink);
    }
    .nav-mobile[hidden] { display: none; }
    .nav-m-link {
      display: flex; align-items: center; width: 100%;
      padding: 14px 2px;
      border-bottom: 1px solid var(--kd-beige-3);
      color: var(--kd-ink); text-decoration: none;
      font-size: 1.05rem; font-weight: 500;
    }
    .nav-m-group > summary {
      display: flex; align-items: center; justify-content: space-between; gap: 12px;
      padding: 14px 2px; border-bottom: 1px solid var(--kd-beige-3);
      color: var(--kd-ink); font-size: 1.05rem; font-weight: 500; cursor: pointer; list-style: none;
    }
    .nav-m-group > summary::-webkit-details-marker { display: none; }
    .nav-m-caret { opacity: .6; flex: none; transition: transform .2s ease; }
    .nav-m-group[open] > summary .nav-m-caret { transform: rotate(180deg); }
    .nav-m-sub { display: flex; flex-direction: column; padding: 6px 0 12px 2px; }
    .nav-m-sublink { padding: 10px 12px; border-radius: var(--kd-radius); color: var(--kd-ink-2); text-decoration: none; }
    .nav-m-sublink:hover { background: var(--kd-beige-1); color: var(--kd-blue-2); }
    .nav-m-sublink--all { font-weight: 500; color: var(--kd-ink); }
    .nav-m-row { display: flex; align-items: center; gap: 24px; padding: 16px 2px 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-burger-box span { transition: none; }
  }
</style>

<script is:inline>
  // Light/dark toggle. Until the visitor clicks, the site follows the system
  // setting. A click switches to the other mode and remembers it.
  (function () {
    var root = document.documentElement;
    var btns = Array.prototype.slice.call(document.querySelectorAll('[data-theme-toggle]'));
    if (!btns.length) return;
    var mq = window.matchMedia ? window.matchMedia('(prefers-color-scheme: dark)') : null;
    function current() {
      var m = root.getAttribute('data-mode');
      if (m === 'light' || m === 'dark') return m;
      return mq && mq.matches ? 'dark' : 'light';
    }
    function label() {
      var next = current() === 'dark' ? 'light' : 'dark';
      btns.forEach(function (b) { b.setAttribute('aria-label', b.getAttribute(next === 'dark' ? 'data-label-dark' : 'data-label-light')); });
    }
    btns.forEach(function (b) {
      b.addEventListener('click', function () {
        var next = current() === 'dark' ? 'light' : 'dark';
        root.setAttribute('data-mode', next);
        try { localStorage.setItem('kd-theme', next); } catch (e) {}
        label();
        window.dispatchEvent(new Event('kd-theme-change'));
      });
    });
    if (mq && mq.addEventListener) mq.addEventListener('change', label);
    label();
  })();

  // Dropdowns: click toggles (touch), opening one closes the others; a click
  // outside or Escape closes all. Hover and focus are handled in CSS.
  (function () {
    var wraps = Array.prototype.slice.call(document.querySelectorAll('.nav-dd'));
    if (!wraps.length) return;
    function close(w) { w.classList.remove('open'); var b = w.querySelector('.nav-dd-trigger'); if (b) b.setAttribute('aria-expanded', 'false'); }
    wraps.forEach(function (w) {
      var b = w.querySelector('.nav-dd-trigger');
      b.addEventListener('click', function (e) {
        e.preventDefault();
        var open = w.classList.toggle('open');
        b.setAttribute('aria-expanded', open ? 'true' : 'false');
        wraps.forEach(function (o) { if (o !== w) close(o); });
      });
    });
    document.addEventListener('click', function (e) { wraps.forEach(function (w) { if (!w.contains(e.target)) close(w); }); });
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape') wraps.forEach(close); });
  })();

  // Mobile panel toggle. Guarded so it runs once even if the nav is re-rendered.
  (function () {
    if (window.__navMobileInit) return;
    var burger = document.getElementById('nav-burger');
    var panel = document.getElementById('nav-mobile');
    if (!burger || !panel) return;
    window.__navMobileInit = true;

    function setOpen(open) {
      panel.hidden = !open;
      burger.setAttribute('aria-expanded', open ? 'true' : 'false');
      // Lock background scroll while the panel is open.
      document.body.style.overflow = open ? 'hidden' : '';
    }

    burger.addEventListener('click', function () { setOpen(panel.hidden); });

    // Any navigation or the CTA closes the panel.
    panel.addEventListener('click', function (e) {
      var el = e.target.closest ? e.target.closest('a, [data-open-modal]') : null;
      if (el) setOpen(false);
    });

    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && !panel.hidden) { setOpen(false); burger.focus(); }
    });

    // Returning to desktop width must not leave a locked body or an open panel.
    window.addEventListener('resize', function () {
      if (window.innerWidth > 880 && !panel.hidden) setOpen(false);
    });
  })();
</script>
