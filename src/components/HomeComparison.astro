---
// src/components/HomeComparison.astro
// The comparison section, in the spot it holds on the live site (right after
// the client logos). Structure from the live "Overhead Problem" section (EN and
// DE): the four standard routes against strategy, execution and ownership,
// written for product, marketing and sales together.
// Design from the October route matrix (design/04_sections/use-cases/
// ...UseCaseDach.dc.html): soft rows, round marks, and a highlighted
// "Solution" row for Kadanco that covers all three.
//
// Light: the design's pale lilac band. Dark mode: the page ground with the
// design's dark marks (lime covered, lilac partial, ink gap).
import { asLocale } from '../i18n/utils';

const locale = asLocale(Astro.currentLocale);

type Mark = 'has' | 'part' | 'gap';
// Homepage only: use case pages show their routes in their own design (UseCaseDetail.astro).
interface ComparisonContent {
  eyebrow: string; h2a: string; h2b: string; lead: string; cols: string[]; solution: string;
  // more: one line per column (strategy, execution, ownership), shown on hover, focus or tap
  rows: { route: string; why: string; marks: Mark[]; more: string[] }[];
  kad: { route: string; why: string; more: string[] }; legend: { has: string; part: string; gap: string }; cap: string; hint: string;
}
const homeCopy = {
  en: {
    eyebrow: 'The Problem',
    h2a: 'Most Outside Help Sells Consulting.',
    h2b: 'The Work Stays With You.',
    lead: 'Product, marketing and sales all need people who plan the work and then do it. Every standard way of getting them costs you somewhere in overhead, in ownership, or in time.',
    cols: ['Strategy', 'Execution', 'Ownership'],
    solution: 'Solution',
    rows: [
      { route: 'Agency', why: 'You pay partner rates but get junior-level work.', marks: ['part', 'gap', 'part'] as Mark[],
        more: ['Partners pitch the plan, then hand it to account managers.', 'Juniors do the work, one discipline at a time, billed by the hour.', 'They own the deliverables. Your pipeline and revenue stay with you.'] },
      { route: 'Freelancers + tools', why: 'You pay for many specialists but get no one who owns the result.', marks: ['gap', 'part', 'gap'] as Mark[],
        more: ['Nobody sets the plan. You brief every specialist yourself.', 'Good individual work that rarely fits together.', 'Every gap between them lands back on your desk.'] },
      { route: 'In-house hires', why: 'You pay full salaries but get months of hiring and ramp-up first.', marks: ['part', 'part', 'has'] as Mark[],
        more: ['Strong once they know the business, after months of ramp-up.', 'One person per function, so the backlog grows faster than they ship.', 'Full ownership, at full salary, with hiring risk on every seat.'] },
    ],
    kad: { route: 'KADANCO', why: 'You pay for operators and get the work planned, done and owned.',
      more: ['Senior operators map your product, market and funnel, then agree the few moves that matter.', 'The same people do the work. First results go live within two weeks.', 'We own the outcome across product, marketing and sales, measured in revenue.'] },
    legend: { has: 'Covered', part: 'Partial', gap: 'Gap' },
    cap: 'No single route covers all three. We do.',
    hint: 'Hover or tap a row for the details.',
  },
  de: {
    eyebrow: 'Das Overhead-Problem',
    h2a: 'Die meisten externen Partner verkaufen Beratung.',
    h2b: 'Die Arbeit bleibt bei Ihnen.',
    lead: 'Produkt, Marketing und Vertrieb brauchen Menschen, die die Arbeit planen und dann selbst machen. Jeder übliche Weg dorthin kostet Sie an einer Stelle: beim Overhead, bei der Verantwortung oder bei der Zeit.',
    cols: ['Strategie', 'Umsetzung', 'Verantwortung'],
    solution: 'Lösung',
    rows: [
      { route: 'Agentur', why: 'Partner-Sätze für Arbeit, an der Junioren lernen, eine Disziplin nach der anderen.', marks: ['part', 'gap', 'part'] as Mark[],
        more: ['Partner präsentieren den Plan und geben ihn an Account Manager weiter.', 'Junioren machen die Arbeit, eine Disziplin nach der anderen, nach Stunden abgerechnet.', 'Sie verantworten die Lieferungen. Pipeline und Umsatz bleiben bei Ihnen.'] },
      { route: 'Freelancer + Tools', why: 'Jeder macht einen Teil, niemand verantwortet das Ergebnis.', marks: ['gap', 'part', 'gap'] as Mark[],
        more: ['Niemand setzt den Plan. Sie briefen jeden Spezialisten selbst.', 'Gute Einzelarbeit, die selten zusammenpasst.', 'Jede Lücke zwischen ihnen landet wieder bei Ihnen.'] },
      { route: 'Inhouse-Einstellungen', why: 'Langsam gefunden und eingearbeitet, eine Funktion nach der anderen.', marks: ['part', 'part', 'has'] as Mark[],
        more: ['Stark, sobald sie das Geschäft kennen, nach Monaten der Einarbeitung.', 'Eine Person pro Funktion, der Rückstand wächst schneller, als geliefert wird.', 'Volle Verantwortung, zum vollen Gehalt, mit Recruiting-Risiko für jede Stelle.'] },
    ],
    kad: { route: 'KADANCO', why: 'Plant und macht Produkt, Marketing und Vertrieb und verantwortet das Ergebnis.',
      more: ['Erfahrene Macher verstehen Produkt, Markt und Funnel und legen die wenigen Hebel fest, die zählen.', 'Dieselben Leute machen die Arbeit. Erste Ergebnisse sind innerhalb von zwei Wochen live.', 'Wir verantworten das Ergebnis über Produkt, Marketing und Vertrieb, gemessen am Umsatz.'] },
    legend: { has: 'Abgedeckt', part: 'Teilweise', gap: 'Lücke' },
    cap: 'Kein einzelner Weg deckt alle drei ab. Wir schon.',
    hint: 'Fahren Sie über eine Zeile oder tippen Sie darauf, um Details zu sehen.',
  },
}[locale];
const copy: ComparisonContent = homeCopy;
const marks: Mark[] = ['has', 'part', 'gap'];
---
<!-- data-theme="light": the nav reads gradients as dark unless told otherwise; in dark
     mode this band is a plain colour, which the nav measures directly -->
<section class="cmp" id="comparison" data-theme="light">
  <div class="container cmp-in">
    <div class="cmp-text">
      <span class="cmp-eyebrow">{copy.eyebrow}</span>
      <h2>{copy.h2a} <em>{copy.h2b}</em></h2>
      <p class="cmp-lead">{copy.lead}</p>
    </div>

    <div class="cmx" role="table" aria-label={copy.eyebrow}>
      <div class="cmx-head" role="row">
        <span class="cmx-sp" role="columnheader"></span>
        {copy.cols.map((c) => <span class="cmx-colh" role="columnheader">{c}</span>)}
      </div>
      {copy.rows.map((r) => (
        <>
          <div class="cmx-rule" aria-hidden="true"></div>
          <div class="cmx-item" tabindex="0">
          <div class="cmx-row" role="row">
            <span class="cmx-route" role="rowheader">{r.route}<span class="cmx-why">{r.why}</span></span>
            {r.marks.map((m, k) => (
              <span class="cmx-cell" role="cell" aria-label={`${copy.cols[k]}: ${copy.legend[m]}`}>
                <span class={`cmx-mk cmx-${m}`} aria-hidden="true">
                  {m === 'has' && <svg width="16" height="16" viewBox="0 0 16 16"><path d="M3 8.5 L6.5 12 L13 4" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" /></svg>}
                  {m === 'part' && <svg width="16" height="16" viewBox="0 0 16 16"><path d="M3 8 q2.5 -3.5 5 0 q2.5 3.5 5 0" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>}
                  {m === 'gap' && <svg width="16" height="16" viewBox="0 0 16 16"><path d="M4 8 L12 8" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" /></svg>}
                </span>
              </span>
            ))}
          </div>
          <div class="cmx-more"><ul>{r.more.map((t, k) => <li><b>{copy.cols[k]}</b> {t}</li>)}</ul></div>
          </div>
        </>
      ))}
      <div class="cmx-item cmx-kad" tabindex="0" data-solution={copy.solution}>
      <div class="cmx-row" role="row">
        <span class="cmx-route" role="rowheader">{copy.kad.route}<span class="cmx-why">{copy.kad.why}</span></span>
        {copy.cols.map((c) => (
          <span class="cmx-cell" role="cell" aria-label={`${c}: ${copy.legend.has}`}>
            <span class="cmx-mk cmx-has" aria-hidden="true"><svg width="16" height="16" viewBox="0 0 16 16"><path d="M3 8.5 L6.5 12 L13 4" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" /></svg></span>
          </span>
        ))}
      </div>
      <div class="cmx-more"><ul>{copy.kad.more.map((t, k) => <li><b>{copy.cols[k]}</b> {t}</li>)}</ul></div>
      </div>
      <div class="cmx-legend">
        {marks.map((m) => <span class="cmx-lg"><span class={`cmx-dot cmx-${m}`}></span>{copy.legend[m]}</span>)}
      </div>
      <p class="cmx-cap">{copy.cap}</p>
      <p class="cmx-hint">{copy.hint}</p>
    </div>
  </div>
</section>

<style>
  /* light: pale lilac band from the design */
  .cmp {
    --c-bg: linear-gradient(180deg, var(--kd-white) 0%, var(--kd-lilac-tint) 45%, var(--kd-lilac-soft) 100%);
    --c-fg: var(--kd-blue-1); --c-fg-2: var(--kd-blue-1); --c-accent: var(--kd-blue-2);
    --c-rule: rgba(26, 1, 117, .16); --c-row-hover: rgba(255, 255, 255, .4);
    --c-has-bg: var(--kd-blue-2); --c-has-fg: var(--kd-white);
    --c-part-bg: var(--kd-signal-1); --c-part-fg: var(--kd-blue-1);
    --c-gap-bg: var(--kd-white); --c-gap-fg: rgba(26, 1, 117, .6); --c-gap-ring: rgba(26, 1, 117, .18);
    background: var(--c-bg); color: var(--c-fg);
  }
  /* dark mode: page ground, the design's dark marks */
  :global(:root[data-mode="dark"]) .cmp {
    --c-bg: var(--kd-bg); --c-fg: var(--kd-white); --c-fg-2: var(--kd-lilac-soft); --c-accent: var(--kd-lilac);
    --c-rule: rgba(255, 255, 255, .12); --c-row-hover: rgba(255, 255, 255, .05);
    --c-has-bg: var(--kd-signal-1); --c-has-fg: var(--kd-ink);
    --c-part-bg: var(--kd-lilac); --c-part-fg: var(--kd-ink);
    --c-gap-bg: var(--kd-ink); --c-gap-fg: var(--kd-lilac-soft); --c-gap-ring: transparent;
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-mode])) .cmp {
      --c-bg: var(--kd-bg); --c-fg: var(--kd-white); --c-fg-2: var(--kd-lilac-soft); --c-accent: var(--kd-lilac);
      --c-rule: rgba(255, 255, 255, .12); --c-row-hover: rgba(255, 255, 255, .05);
      --c-has-bg: var(--kd-signal-1); --c-has-fg: var(--kd-ink);
      --c-part-bg: var(--kd-lilac); --c-part-fg: var(--kd-ink);
      --c-gap-bg: var(--kd-ink); --c-gap-fg: var(--kd-lilac-soft); --c-gap-ring: transparent;
    }
  }

  .cmp-in { padding-top: 96px; padding-bottom: 96px; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 64px; align-items: center; }
  @media (max-width: 980px) { .cmp-in { grid-template-columns: minmax(0, 1fr); gap: 40px; padding-top: 64px; padding-bottom: 64px; } }

  .cmp-text { display: flex; flex-direction: column; gap: 16px; }
  .cmp-eyebrow { font-size: var(--kd-text-xs); line-height: var(--kd-lh-xs); font-weight: var(--kd-weight-medium); letter-spacing: .04em; text-transform: uppercase; color: var(--c-accent); }
  .cmp h2 { margin: 0; font-size: var(--kd-text-l); line-height: var(--kd-lh-l); font-weight: var(--kd-weight-medium); letter-spacing: .06px; text-wrap: balance; }
  .cmp h2 em { font-style: normal; color: var(--c-accent); }
  .cmp-lead { margin: 0; font-size: var(--kd-text-s); line-height: var(--kd-lh-s); color: var(--c-fg-2); opacity: .85; max-width: 52ch; }

  /* matrix */
  .cmx { width: 100%; max-width: 560px; justify-self: end; }
  @media (max-width: 980px) { .cmx { justify-self: start; } }
  .cmx-head { display: flex; align-items: flex-end; padding-bottom: 14px; }
  .cmx-sp { flex: 1; }
  /* long German headings (VERANTWORTUNG) fit: smaller caps, and hyphenation as a last resort */
  .cmx-colh { width: 104px; flex: none; text-align: center; font-size: 11px; font-weight: var(--kd-weight-medium); letter-spacing: .04em; text-transform: uppercase; opacity: .7; hyphens: auto; overflow-wrap: anywhere; }
  .cmx-rule { height: 1px; background: var(--c-rule); }
  .cmx-row { display: flex; align-items: center; }
  /* a row plus its detail; hover, keyboard focus or a tap opens the detail */
  .cmx-item { border-radius: var(--kd-radius); transition: background .15s; outline: none; }
  .cmx-item:hover, .cmx-item:focus-within { background: var(--c-row-hover); }
  .cmx-item:focus-visible { box-shadow: inset 0 0 0 2px var(--c-accent); }
  .cmx-more { display: grid; grid-template-rows: 0fr; transition: grid-template-rows .3s ease; }
  .cmx-more > ul { overflow: hidden; min-height: 0; list-style: none; margin: 0; padding: 0 12px; display: grid; gap: 6px; }
  .cmx-item:hover .cmx-more, .cmx-item:focus-within .cmx-more { grid-template-rows: 1fr; }
  .cmx-more li { font-size: 14px; line-height: 1.45; color: var(--c-fg-2); }
  .cmx-more li:last-child { padding-bottom: 14px; }
  .cmx-more b { font-weight: var(--kd-weight-medium); color: var(--c-fg); }
  .cmx-more b::after { content: ':'; }
  .cmx-hint { margin: 6px 0 0; font-size: 13px; opacity: .7; }
  @media (prefers-reduced-motion: reduce) { .cmx-more { transition: none; } }
  .cmx-route { flex: 1; min-width: 0; padding: 12px 10px 12px 12px; font-size: 17px; font-weight: var(--kd-weight-medium); line-height: 1.35; }
  .cmx-why { display: block; margin-top: 3px; font-size: 14px; font-weight: var(--kd-weight-regular); line-height: 1.4; opacity: .72; }
  .cmx-cell { width: 104px; flex: none; display: flex; justify-content: center; padding: 14px 0; }
  .cmx-mk { width: 30px; height: 30px; border-radius: 50%; display: grid; place-items: center; }
  .cmx-has { background: var(--c-has-bg); color: var(--c-has-fg); }
  .cmx-part { background: var(--c-part-bg); color: var(--c-part-fg); }
  .cmx-gap { background: var(--c-gap-bg); color: var(--c-gap-fg); box-shadow: inset 0 0 0 1px var(--c-gap-ring); }

  /* the solution row */
  .cmx-kad, .cmx-kad:focus-visible { position: relative; margin-top: 26px; box-shadow: inset 0 0 0 2px var(--c-accent); }
  .cmx-kad::before { content: attr(data-solution); position: absolute; top: -11px; right: 14px; height: 22px; padding: 0 9px; display: flex; align-items: center; border-radius: var(--kd-radius); background: var(--kd-blue-2); color: var(--kd-white); font-size: 11px; font-weight: var(--kd-weight-medium); letter-spacing: .08em; text-transform: uppercase; line-height: 1; }
  .cmx-kad .cmx-route { letter-spacing: .02em; }

  .cmx-legend { display: flex; gap: 22px; margin-top: 22px; flex-wrap: wrap; }
  .cmx-lg { display: flex; align-items: center; gap: 8px; font-size: 13px; opacity: .78; }
  .cmx-dot { width: 14px; height: 14px; border-radius: 50%; }
  .cmx-cap { margin: 16px 0 0; font-size: 17px; line-height: 1.5; font-weight: var(--kd-weight-medium); }

  @media (max-width: 560px) {
    .cmx-colh, .cmx-cell { width: 66px; }
    .cmx-colh { font-size: 9px; letter-spacing: 0; }
    .cmx-route { font-size: 15px; }
    .cmx-why { font-size: 13px; }
  }
</style>
