---
// src/components/UseCaseCard.astro
// One use case card, shared by the homepage and the /use-cases/ overview.
// Data comes from src/data/use-cases.ts.
//
// size="compact"  label, title, summary, link (homepage grid)
// size="full"     adds the workstreams, or the problem and what we do (overview)
// featured        wide card across the whole grid (Product Design)
//
// The labels show every department the use case touches: the lead one
// filled in its colour, the others outlined.
//
// Use cases with a detail page link to it. Case studies without one open the
// contact modal. Supports dark mode through the theme role tokens.
import type { UseCase } from '../data/use-cases';
import { asLocale, localizedHref } from '../i18n/utils';
import IsoIcon from './IsoIcon.astro';

interface Props { uc: UseCase; size?: 'compact' | 'full'; featured?: boolean }
const { uc, size = 'compact', featured = false } = Astro.props;
const locale = asLocale(Astro.currentLocale);
const t = uc[locale] ?? uc.en;

const ui = {
  en: { product: 'Product', marketing: 'Marketing', sales: 'Sales', page: 'Full use case', talk: 'Talk to us about this', own: 'What you get', problem: 'The problem', approach: 'What we do' },
  de: { product: 'Produkt', marketing: 'Marketing', sales: 'Vertrieb', page: 'Zum Use Case', talk: 'Sprechen Sie uns darauf an', own: 'Was Sie bekommen', problem: 'Das Problem', approach: 'Was wir tun' },
}[locale];

const hasPage = uc.kind === 'page' && uc.href;
const href = hasPage ? localizedHref(locale, uc.href!) : '#contact';
const showDetail = size === 'full' || featured;
---
<a
  class:list={['uc-card', `uc-card--${uc.dept}`, { 'uc-card--featured': featured, 'uc-card--full': size === 'full' }]}
  href={href}
  id={uc.id}
  data-dept={uc.dept}
  data-depts={uc.depts.join(' ')}
  data-open-modal={hasPage ? undefined : ''}
>
  <div class="uc-main">
    <IsoIcon name={uc.icon} size={featured ? 72 : 56} class="uc-icon" />
    <div class="uc-labels">
      {uc.depts.map((d, i) => <span class={i === 0 ? 'uc-dept' : 'uc-dept uc-dept--also'}>{ui[d]}</span>)}
    </div>
    <h3>{t.name}</h3>
    <p class="uc-summary">{t.tagline}</p>
    {t.own && <p class="uc-own"><span>{ui.own}</span>{t.own}</p>}
    {!showDetail && <span class="uc-link">{hasPage ? ui.page : ui.talk} →</span>}
  </div>

  {showDetail && (
    <div class="uc-detail">
      {t.bundle && (
        <ul class="uc-bundle">{t.bundle.map((b) => <li>{b}</li>)}</ul>
      )}
      {t.problem && (
        <dl class="uc-pa">
          <dt>{ui.problem}</dt><dd>{t.problem}</dd>
          <dt>{ui.approach}</dt><dd>{t.approach}</dd>
        </dl>
      )}
      <span class="uc-link">{hasPage ? ui.page : ui.talk} →</span>
    </div>
  )}
</a>

<style>
  .uc-card { display: flex; flex-direction: column; gap: 18px; padding: 28px; background: var(--kd-surface); border: 1px solid var(--kd-line); border-top: 4px solid var(--uc-c); border-radius: var(--kd-radius); color: var(--kd-fg); text-decoration: none; transition: transform .18s ease, border-color .18s ease; }
  .uc-card[hidden] { display: none; }
  .uc-card:hover { transform: translateY(-4px); border-color: var(--kd-accent); border-top-color: var(--uc-c); }
  .uc-card:focus-visible { outline: 2px solid var(--kd-accent); outline-offset: 2px; }
  .uc-main { display: flex; flex-direction: column; gap: 12px; flex: 1 1 auto; }
  .uc-detail { display: flex; flex-direction: column; gap: 14px; }
  .uc-card--full:not(.uc-card--featured) .uc-main { flex: 0 0 auto; }
  .uc-card--full .uc-detail { flex: 1 1 auto; }

  .uc-card--product { --uc-c: var(--kd-dept-product); --uc-ink: var(--kd-white); }
  .uc-card--marketing { --uc-c: var(--kd-dept-marketing); --uc-ink: var(--kd-blue-1); }
  .uc-card--sales { --uc-c: var(--kd-dept-sales); --uc-ink: var(--kd-blue-1); }

  .uc-labels { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; }
  .uc-dept { display: inline-flex; align-items: center; padding: 3px 10px; border-radius: var(--kd-radius); background: var(--uc-c); color: var(--uc-ink); font-size: 13px; font-weight: var(--kd-weight-medium); letter-spacing: .04em; text-transform: uppercase; }
  .uc-dept--also { padding: 1px 8px; background: transparent; border: 2px solid var(--kd-line); color: var(--kd-fg-2); }
  .uc-card h3 { margin: 0; font-size: var(--kd-text-s); line-height: var(--kd-lh-s); font-weight: var(--kd-weight-medium); }
  .uc-summary { margin: 0; font-size: 17px; line-height: 1.45; color: var(--kd-fg-2); }
  .uc-own { margin: 0; padding-left: 12px; border-left: 3px solid var(--uc-c); font-size: 15px; line-height: 1.45; color: var(--kd-fg); }
  .uc-own span { display: block; margin-bottom: 2px; font-size: 12px; font-weight: var(--kd-weight-medium); letter-spacing: .04em; text-transform: uppercase; color: var(--kd-accent); }
  .uc-link { margin-top: auto; padding-top: 4px; font-size: 17px; font-weight: var(--kd-weight-medium); color: var(--kd-accent); }

  .uc-bundle { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 8px; }
  .uc-bundle li { position: relative; padding-left: 22px; font-size: 16px; line-height: 1.4; }
  .uc-bundle li::before { content: ""; position: absolute; left: 0; top: .45em; width: 10px; height: 10px; border-radius: 2px; background: var(--uc-c); }
  .uc-pa { margin: 0; display: grid; gap: 4px; }
  .uc-pa dt { margin-top: 8px; font-size: 13px; font-weight: var(--kd-weight-medium); letter-spacing: .04em; text-transform: uppercase; color: var(--kd-accent); }
  .uc-pa dt:first-child { margin-top: 0; }
  .uc-pa dd { margin: 0; font-size: 16px; line-height: 1.45; }

  /* featured: wide, text left and detail right */
  .uc-card--featured { grid-column: 1 / -1; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 24px 48px; padding: 36px; }
  .uc-card--featured h3 { font-size: var(--kd-text-m); line-height: var(--kd-lh-m); }
  .uc-card--featured .uc-summary { font-size: 19px; }
  @media (max-width: 880px) { .uc-card--featured { grid-template-columns: minmax(0, 1fr); padding: 28px; } }

  @media (prefers-reduced-motion: reduce) { .uc-card { transition: none; } .uc-card:hover { transform: none; } }
</style>
