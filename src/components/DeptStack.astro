---
// src/components/DeptStack.astro
// Homepage use cases: three stacked sticky cards, one per department
// (Product, Marketing, Sales). Each card shows the service (label, title,
// short text from the offer cards), lists the use cases it leads with
// direct links, then a CTA. The left half is a photo of real people
// (Unsplash License, self-hosted in public/images/use-cases/, credits in docs/).
//
// Every card has the same height, so while scrolling each card fully covers
// the one before it and only a slim edge of the earlier cards stays visible.
// Each card lists exactly three entries; missing ones are placeholders.
// The 24px card radius follows the design (exception to the 5px rule).
import { navCases, type Dept } from '../data/use-cases';
import { auditHref } from '../data/intakes';
import { asLocale, localizedHref } from '../i18n/utils';

interface Card { id: Dept; label: string; title: string; body: string; link: string }
interface Props { cards: Card[] }
const { cards } = Astro.props;
const locale = asLocale(Astro.currentLocale);
const ui = {
  en: { list: 'Use cases', soon: 'More use cases coming soon', all: 'All use cases',
        alt: { product: 'Woman in glasses and a striped top working on a laptop at her desk', marketing: 'Two colleagues working together at a laptop', sales: 'Smiling man in a suit on a phone call at his desk with a laptop' } },
  de: { list: 'Use Cases', soon: 'Weitere Use Cases folgen', all: 'Alle Use Cases',
        alt: { product: 'Frau mit Brille und gestreiftem Shirt arbeitet am Laptop an ihrem Schreibtisch', marketing: 'Zwei Kolleginnen arbeiten gemeinsam am Laptop', sales: 'Lächelnder Mann im Anzug telefoniert an seinem Schreibtisch mit Laptop' } },
}[locale];
const PER_CARD = 3; // most cases a card lists; cards list only the nav use cases, without placeholders

const rows = cards.map((card) => {
  const items = navCases.filter((u) => u.dept === card.id).slice(0, PER_CARD).map((u) => ({
    name: (u[locale] ?? u.en).name,
    href: localizedHref(locale, u.href ?? '/'),
  }));
  const placeholders = 0;
  return { card, items, placeholders };
});
---
<div class="ds-stack">
  {rows.map(({ card, items, placeholders }, i) => (
    <article class={`ds ds--${card.id}`} id={`uc-${card.id}`} style={`--i:${i}`}>
      <div class="ds-text">
        <span class="ds-label">{card.label}</span>
        <h3>{card.title}</h3>
        <p class="ds-body">{card.body}</p>
        <p class="ds-list-head">{ui.list}</p>
        <ul class="ds-list">
          {items.map((it) => <li><a href={it.href}><span>{it.name}</span><span aria-hidden="true">→</span></a></li>)}
          {Array.from({ length: placeholders }).map(() => <li class="ds-soon"><span>{ui.soon}</span></li>)}
        </ul>
        <a class="ds-cta" href={localizedHref(locale, auditHref[card.id])}>{card.link} →</a>
      </div>
      <div class="ds-media">
        <img src={`/images/use-cases/${card.id}.jpg`} alt={ui.alt[card.id]} width="1200" height="800" loading="eager" decoding="async" />
      </div>
    </article>
  ))}
</div>

<style>
  .ds-stack { display: flex; flex-direction: column; gap: 32px; padding-bottom: 24px; }
  /* equal heights, so each card covers the previous one completely */
  .ds {
    --h: clamp(460px, calc(100svh - 150px), 580px);
    position: sticky; top: 96px; /* same top for every card, so each one fully covers the previous one (no stepped edge) */
    height: var(--h);
    display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    border-radius: 24px; overflow: hidden; box-shadow: 0 -10px 40px -14px rgba(26, 1, 117, .32);
    background: var(--ds-bg); color: var(--ds-fg);
  }
  .ds--product { --ds-bg: var(--kd-dept-product); --ds-fg: var(--kd-white); --ds-tag-bg: var(--kd-signal-1); --ds-tag-fg: var(--kd-blue-1); --ds-line: rgba(255, 255, 255, .22); }
  .ds--marketing { --ds-bg: var(--kd-dept-marketing); --ds-fg: var(--kd-blue-1); --ds-tag-bg: var(--kd-blue-2); --ds-tag-fg: var(--kd-white); --ds-line: rgba(26, 1, 117, .18); }
  .ds--sales { --ds-bg: var(--kd-dept-sales); --ds-fg: var(--kd-blue-1); --ds-tag-bg: var(--kd-blue-2); --ds-tag-fg: var(--kd-white); --ds-line: rgba(26, 1, 117, .18); }

  .ds-text { display: flex; flex-direction: column; gap: 14px; padding: 44px 48px; min-height: 0; }
  .ds-label { align-self: flex-start; padding: 3px 10px; border-radius: var(--kd-radius); background: var(--ds-tag-bg); color: var(--ds-tag-fg); font-size: 13px; font-weight: var(--kd-weight-medium); letter-spacing: .04em; text-transform: uppercase; }
  .ds h3 { margin: 0; font-size: clamp(28px, 3.2vw, 42px); line-height: 1.1; font-weight: var(--kd-weight-medium); letter-spacing: -.01em; }
  .ds-body { margin: 0; font-size: 18px; line-height: 1.45; }
  .ds-list-head { margin: 6px 0 0; font-size: 12px; font-weight: var(--kd-weight-medium); letter-spacing: .06em; text-transform: uppercase; opacity: .75; }
  .ds-list { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--ds-line); }
  .ds-list li { border-bottom: 1px solid var(--ds-line); }
  .ds-list a, .ds-soon span { display: flex; justify-content: space-between; gap: 16px; padding: 11px 2px; font-size: 17px; font-weight: var(--kd-weight-medium); color: inherit; text-decoration: none; }
  .ds-list a span:last-child { transition: transform .15s ease; }
  .ds-list a:hover span:first-child { text-decoration: underline; }
  .ds-list a:hover span:last-child { transform: translateX(4px); }
  .ds-list a:focus-visible { outline: 2px solid var(--ds-fg); outline-offset: 2px; border-radius: var(--kd-radius); }
  .ds-soon span { opacity: .55; font-weight: var(--kd-weight-regular); font-style: italic; }
  .ds-cta { margin-top: auto; align-self: flex-start; padding: 12px 22px; border-radius: var(--kd-radius); background: var(--ds-fg); color: var(--ds-bg); font-weight: var(--kd-weight-medium); text-decoration: none; transition: transform .15s; }
  .ds-cta:hover { transform: translateY(-2px); }
  .ds-cta:focus-visible { outline: 2px solid var(--ds-fg); outline-offset: 3px; }

  .ds-media { order: 0; min-height: 0; background: var(--kd-blue-1); } /* photo on the right, text on the left */
  /* the middle card (Marketing) flips: photo left, text right, so the text reads left, right, left */
  .ds--marketing .ds-media { order: -1; }
  .ds-media img { display: block; width: 100%; height: 100%; object-fit: cover; }

  /* phones: photo on top as a band, text below; heights follow the content,
     so the cards sit in a plain column (no sticky stacking) */
  @media (max-width: 880px) {
    .ds { --h: auto; grid-template-columns: 1fr; position: relative; top: auto; }
    .ds-media, .ds--marketing .ds-media { order: -1; height: 200px; } /* phones: photo on top for every card */
    .ds-text { padding: 26px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .ds { position: relative; top: auto; }
    .ds-cta, .ds-list a span:last-child { transition: none; }
  }
</style>
