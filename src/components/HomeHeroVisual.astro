---
// src/components/HomeHeroVisual.astro
// Homepage hero visual: three isometric boards stacked as slices, drawn in the
// style of the October "Conversion rebuild" hero illustration
// (design/04_sections/use-cases/...UseCaseConversion.dc.html): navy outlines,
// white faces, coloured tops. Product is the foundation (an app screen),
// Marketing sits on it (a content card and text lines), Sales is on top
// (pipeline bars lying flat, growing in length). Each slice's label is printed
// flat on its top face, along the front edge.
//
// Interaction: hovering (or tapping, or focusing) a slice turns it from the
// isometric view into a straight top-down view, brings it to the front and
// shows its service text on the right. The other two slices keep floating
// and fade into the background. Leaving the visual turns the slice back the
// same way it turned. There is no load animation; the slices always float.
//
// How: every shape is computed twice on the server, once in isometric and
// once in the straight view, and stored on the element (data-a, data-b).
// A small script blends between the two. Without JavaScript the visual is a
// static isometric drawing.
//
// Geometry: true isometric (30 degrees), the same angles as the design file.
import { asLocale } from '../i18n/utils';

const locale = asLocale(Astro.currentLocale);
const copy = {
  en: {
    aria: 'Product, marketing and sales as three stacked layers, product at the base',
    more: 'See the offer',
    slices: {
      product: { label: '01 · Product', name: 'Product Design', out: 'A product that is easy to use, demo and sell.' },
      marketing: { label: '02 · Marketing', name: 'Product Marketing', out: 'A story buyers understand in seconds.' },
      sales: { label: '03 · Sales', name: 'Sales', out: 'Pipeline that does not hang on one founder.' },
    },
  },
  de: {
    aria: 'Produkt, Marketing und Vertrieb als drei gestapelte Ebenen, das Produkt als Basis',
    more: 'Zum Angebot',
    slices: {
      product: { label: '01 · Produkt', name: 'Product Design', out: 'Ein Produkt, das sich leicht nutzen, zeigen und verkaufen lässt.' },
      marketing: { label: '02 · Marketing', name: 'Product Marketing', out: 'Eine Geschichte, die Käufer sofort verstehen.' },
      sales: { label: '03 · Vertrieb', name: 'Sales', out: 'Eine Pipeline, die nicht an einer Person hängt.' },
    },
  },
}[locale];

// ---------- geometry ----------
// Content is laid out as it looks in the straight view: u to the right (0..U),
// v downwards (0..V), the label along the bottom edge. In the isometric view
// each board is turned a quarter, so that bottom edge becomes the front-right
// edge and the label reads upwards, from bottom left to top right.
const U = 136, V = 100, T = 6;     // board in the straight view: width, height, thickness
const W = V, D = U;                // the same board in isometric x (down-right) and y (down-left)
const GAP = 100;                   // vertical distance between slices
const PAD = 16;
const STRIP = 18;                  // label strip along the bottom edge (straight view)
const C30 = Math.cos(Math.PI / 6), S30 = 0.5;
const TOP = 2 * GAP + T + 16;      // highest point (top slice plus its tallest block)
const ox = PAD + D * C30, oy = PAD + TOP;
const iso = (x: number, y: number, z: number) => [ox + (x - y) * C30, oy + (x + y) * S30 - z];
// layout (u, v) to board (x, y): the quarter turn
const toX = (u: number, v: number) => v, toY = (u: number, v: number) => U - u;

// straight view: the board seen from directly above, centred where its
// isometric top face sits, nudged left to leave room for the text
const SHIFT = 34;
const flatOf = (zBase: number) => {
  const [cx, cy] = iso(W / 2, D / 2, zBase + T);
  return (u: number, v: number) => [cx - SHIFT + (u - U / 2), cy + (v - V / 2)];
};

type P3 = [number, number, number];
type Face = { a: string; b: string; cls: string };
type Box = { depth: number; faces: Face[] };
const fmt = (pts: number[][]) => pts.map(([x, y]) => `${x.toFixed(1)},${y.toFixed(1)}`).join(' ');

// a box from (u0,v0) to (u1,v1) in the layout, standing on z0 with height h:
// the three faces seen from the front, in isometric (a) and straight view (b)
const boxOn = (flat: (u: number, v: number) => number[]) =>
  (u0: number, u1: number, v0: number, v1: number, z0: number, h: number, top = ''): Box => {
    const x0 = toX(u0, v0), x1 = toX(u0, v1), y0 = toY(u1, v0), y1 = toY(u0, v0);
    const faces: { pts: P3[]; cls: string }[] = [
      { pts: [[x0, y1, z0 + h], [x1, y1, z0 + h], [x1, y1, z0], [x0, y1, z0]], cls: 'f side' },
      { pts: [[x1, y0, z0 + h], [x1, y1, z0 + h], [x1, y1, z0], [x1, y0, z0]], cls: 'f side' },
      { pts: [[x0, y0, z0 + h], [x1, y0, z0 + h], [x1, y1, z0 + h], [x0, y1, z0 + h]], cls: `f ${top}`.trim() },
    ];
    return {
      depth: x0 + x1 + y0 + y1, // painter's order: further back is drawn first
      faces: faces.map((f) => ({
        a: fmt(f.pts.map(([x, y, z]) => iso(x, y, z))),
        b: fmt(f.pts.map(([x, y]) => flat(U - y, x))),
        cls: f.cls,
      })),
    };
  };
// board first, then its blocks from back to front
const stack = (board: Box, blocks: Box[]) => [board, ...blocks.sort((a, b) => a.depth - b.depth)].flatMap((b) => b.faces);

const zP = 0, zM = GAP, zS = 2 * GAP;
const fP = flatOf(zP), fM = flatOf(zM), fS = flatOf(zS);
const bP = boxOn(fP), bM = boxOn(fM), bS = boxOn(fS);

const product = stack(bP(0, U, 0, V, zP, T), [
  bP(8, U - 8, 8, 20, zP + T, 4, 'acc'),                       // top bar of the app screen
  // the two UI blocks share the top bar's outer edges (8 and U - 8), with a 12 gap
  bP(8, (U - 12) / 2, 32, V - STRIP - 4, zP + T, 8, 'acc'),        // UI block
  bP((U + 12) / 2, U - 8, 32, V - STRIP - 4, zP + T, 14, 'acc'),   // UI block
]);
const marketing = stack(bM(0, U, 0, V, zM, T), [
  bM(12, U - 12, 12, 30, zM + T, 3),                           // headline strip
  bM(12, 62, 40, 46, zM + T, 2, 'ink'),                        // text lines
  bM(12, 54, 52, 58, zM + T, 2, 'ink'),
  bM(12, 46, 64, 70, zM + T, 2, 'ink'),
  bM(74, U - 12, 40, V - STRIP - 4, zM + T, 8, 'acc'),         // content card
]);
// pipeline bars lie flat like the blocks on the other slices and grow in length
const sales = stack(bS(0, U, 0, V, zS, T), [
  bS(20, 40, 50, V - STRIP - 4, zS + T, 8, 'acc'),
  bS(58, 78, 30, V - STRIP - 4, zS + T, 8, 'acc'),
  bS(96, 116, 10, V - STRIP - 4, zS + T, 8, 'acc'),
]);

// browser dots on the app screen's top bar, in both views
const dots = [16, 24, 32].map((u) => ({ a: iso(toX(u, 14), toY(u, 14), zP + T + 4), b: fP(u, 14) }));

// label printed on the top face along the bottom edge (straight view). In the
// isometric view its baseline runs along the board's -y axis (up and to the
// right) and its height along +x; in the straight view it is upright.
const lab = (z: number, flat: (u: number, v: number) => number[]) => {
  const [ax, ay] = iso(toX(12, V - 6), toY(12, V - 6), z + T);
  const [bx, by] = flat(12, V - 6);
  return { a: [C30, -S30, C30, S30, ax, ay].map((n) => +n.toFixed(4)).join(' '), b: [1, 0, 0, 1, bx, by].map((n) => +n.toFixed(4)).join(' ') };
};

// where the text panel sits in the straight view: right of the board, centred on it
const panelAt = (flat: (u: number, v: number) => number[]) => { const [x, y] = flat(U, V / 2); return { x: x + 14, y }; };

const vbW = Math.ceil(ox + W * C30 + PAD), vbH = Math.ceil(oy + (W + D) * S30 + PAD);

// hover bands: one horizontal band per slice, split halfway between slices,
// so the target does not move while a slice turns
const centreY = (z: number) => iso(W / 2, D / 2, z + T)[1];
const cyS = centreY(zS), cyM = centreY(zM), cyP = centreY(zP);
const bands = [
  { i: 2, y0: 0, y1: (cyS + cyM) / 2 },
  { i: 1, y0: (cyS + cyM) / 2, y1: (cyM + cyP) / 2 },
  { i: 0, y0: (cyM + cyP) / 2, y1: vbH },
];

const ids = ['product', 'marketing', 'sales'] as const;
const slices = ids.map((id, i) => {
  const z = [zP, zM, zS][i], flat = [fP, fM, fS][i];
  const pa = panelAt(flat);
  return { id, i, faces: [product, marketing, sales][i], text: copy.slices[id], at: lab(z, flat), panel: { left: (pa.x / vbW) * 100, top: (pa.y / vbH) * 100 } };
});
---
<div class="hv-slices" role="group" aria-label={copy.aria} data-hv>
  <div class="hv-stage">
    <svg viewBox={`0 0 ${vbW} ${vbH}`} fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" stroke-linecap="round" aria-hidden="true">
      <g class="hv-layers">
        {slices.map((s) => (
          <g class={`slice slice--${s.id}`} style={`--d:${s.i}`} data-slice={s.i}>
            <g class="slice-in">
              {s.faces.map((f) => <polygon points={f.a} data-a={f.a} data-b={f.b} class={f.cls} />)}
              {s.id === 'product' && dots.map((d) => (
                <circle cx={d.a[0].toFixed(1)} cy={d.a[1].toFixed(1)} r="1.8" class="dot" data-a={`${d.a[0].toFixed(1)},${d.a[1].toFixed(1)}`} data-b={`${d.b[0].toFixed(1)},${d.b[1].toFixed(1)}`} />
              ))}
              <text transform={`matrix(${s.at.a})`} data-a={s.at.a} data-b={s.at.b} class="lbl">{s.text.label}</text>
            </g>
          </g>
        ))}
      </g>
    </svg>

    {/* hover, tap and keyboard targets: one stable band per slice */}
    {bands.map((b) => (
      <button type="button" class="hv-hit" data-i={b.i} aria-label={slices[b.i].text.name} aria-expanded="false"
        style={`top:${(b.y0 / vbH) * 100}%;height:${((b.y1 - b.y0) / vbH) * 100}%`}></button>
    ))}

    {slices.map((s) => (
      <div class={`hv-panel hv-panel--${s.id}`} data-panel={s.i} style={`left:${s.panel.left.toFixed(2)}%;top:${s.panel.top.toFixed(2)}%`} aria-hidden="true">
        <span class="hv-panel-tag">{s.text.label}</span>
        <b>{s.text.name}</b>
        <p>{s.text.out}</p>
        <a href={`#${s.id}`} tabindex="-1">{copy.more} →</a>
      </div>
    ))}
  </div>
</div>

<style>
  .hv-slices { color: var(--kd-blue-1); }
  .hv-stage { position: relative; width: fit-content; max-width: 100%; margin: 0 auto; }
  /* height follows the window so the hero stays short enough to show the logo row */
  .hv-stage svg { display: block; height: clamp(360px, calc(100svh - 300px), 560px); width: auto; max-width: 100%; overflow: visible; }
  @media (max-width: 980px) { .hv-stage { width: 100%; max-width: 420px; } .hv-stage svg { height: auto; width: 100%; } }

  /* faces: white with navy outline, coloured tops per department */
  .f { fill: var(--kd-white); }
  .slice--product { --acc: var(--kd-dept-product); }
  .slice--marketing { --acc: var(--kd-dept-marketing); }
  .slice--sales { --acc: var(--kd-dept-sales); }
  .acc { fill: var(--acc); }
  .ink { fill: var(--kd-blue-1); }
  .dot { fill: var(--kd-white); stroke: none; }
  .lbl { fill: var(--kd-blue-1); stroke: none; font-family: var(--kd-font-sans); font-size: 10px; font-weight: var(--kd-weight-medium); letter-spacing: .08em; text-transform: uppercase; }

  /* all three slices float gently out of step from the first frame (negative
     delays start them mid-cycle). The active slice pauses in place, so the
     float continues from the same spot when the hover ends: no jump. */
  .slice { animation: hv-float 5s ease-in-out infinite; animation-delay: calc(var(--d) * -1.7s); }
  .slice.is-active { animation-play-state: paused; }
  @keyframes hv-float { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-5px); } }

  /* the other two slices step back */
  .slice-in { transition: opacity .35s ease; }
  .is-focus .slice:not(.is-active) .slice-in { opacity: .3; }

  /* targets: invisible, full width, stacked over the drawing */
  .hv-hit { position: absolute; left: 0; width: 100%; margin: 0; padding: 0; border: 0; background: none; cursor: pointer; }
  .hv-hit:focus-visible { outline: 2px solid var(--kd-white); outline-offset: -2px; border-radius: var(--kd-radius); }

  /* text panel: right of the straight board */
  .hv-panel { position: absolute; z-index: 2; width: min(240px, 46vw); transform: translate(0, -50%) translateX(-8px); opacity: 0; visibility: hidden; pointer-events: none; transition: opacity .3s ease, transform .3s ease, visibility 0s linear .3s; color: var(--kd-white); display: flex; flex-direction: column; gap: 6px; }
  .hv-panel.is-on { opacity: 1; visibility: visible; pointer-events: auto; transform: translate(0, -50%); transition: opacity .3s ease .3s, transform .3s ease .3s, visibility 0s; }
  .hv-panel-tag { font-size: 12px; font-weight: var(--kd-weight-medium); letter-spacing: .08em; text-transform: uppercase; color: var(--kd-lilac); }
  .hv-panel b { font-size: 22px; line-height: 1.2; font-weight: var(--kd-weight-medium); }
  .hv-panel p { margin: 0; font-size: 16px; line-height: 1.45; color: var(--kd-lilac-soft); }
  .hv-panel a { margin-top: 4px; font-size: 16px; font-weight: var(--kd-weight-medium); color: var(--kd-signal-1); text-decoration: none; }
  .hv-panel a:hover { text-decoration: underline; }
  /* narrow screens: the panel sits over the bottom of the drawing on a solid card */
  @media (max-width: 980px) {
    .hv-panel { left: 0 !important; top: auto !important; bottom: 0; width: 100%; padding: 16px 18px; border-radius: var(--kd-radius); background: var(--kd-blue-1); transform: translateY(8px); }
    .hv-panel.is-on { transform: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .slice { animation: none; }
    .slice-in, .hv-panel, .hv-panel.is-on { transition: none; }
  }
</style>

<script is:inline>
  // Turns the hovered slice into its straight view and back. Each polygon,
  // dot and label carries its isometric (data-a) and straight (data-b) values;
  // this blends between them.
  (function () {
    var root = document.querySelector('[data-hv]');
    if (!root) return;
    var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var layers = root.querySelector('.hv-layers');
    var nums = function (s) { return s.split(/[ ,]+/).map(Number); };

    var slices = Array.prototype.slice.call(root.querySelectorAll('[data-slice]')).map(function (g) {
      var parts = Array.prototype.slice.call(g.querySelectorAll('[data-a]')).map(function (el) {
        return { el: el, a: nums(el.getAttribute('data-a')), b: nums(el.getAttribute('data-b')), tag: el.tagName.toLowerCase() };
      });
      return { g: g, parts: parts, t: 0, target: 0 };
    });
    var order = slices.map(function (s) { return s.g; });
    var panels = Array.prototype.slice.call(root.querySelectorAll('[data-panel]'));
    var hits = Array.prototype.slice.call(root.querySelectorAll('.hv-hit'));

    function draw(s) {
      var e = s.t < 0.5 ? 2 * s.t * s.t : 1 - Math.pow(-2 * s.t + 2, 2) / 2; // ease in-out
      s.parts.forEach(function (p) {
        var v = p.a.map(function (n, k) { return n + (p.b[k] - n) * e; });
        if (p.tag === 'polygon') {
          var out = [];
          for (var k = 0; k < v.length; k += 2) out.push(v[k].toFixed(2) + ',' + v[k + 1].toFixed(2));
          p.el.setAttribute('points', out.join(' '));
        } else if (p.tag === 'circle') {
          p.el.setAttribute('cx', v[0].toFixed(2)); p.el.setAttribute('cy', v[1].toFixed(2));
        } else {
          p.el.setAttribute('transform', 'matrix(' + v.map(function (n) { return n.toFixed(4); }).join(' ') + ')');
        }
        // side faces vanish in the straight view
        if (p.el.classList.contains('side')) p.el.style.opacity = String(1 - e);
      });
    }

    // next frame: an animation frame, with a backup timer in case frames are
    // paused (hidden or headless pages); whichever comes first runs, once
    function next(fn) {
      var done = false;
      var go = function (t) { if (done) return; done = true; fn(t); };
      requestAnimationFrame(go);
      setTimeout(function () { go(performance.now()); }, 50);
    }
    var running = false, last = 0;
    function tick(now) {
      if (!last) last = now;
      var dt = Math.max(0, Math.min(64, now - last)); last = now;
      var busy = false;
      slices.forEach(function (s) {
        if (s.t === s.target) return;
        var step = reduce ? 1 : dt / 420;
        s.t = s.target > s.t ? Math.min(s.target, s.t + step) : Math.max(s.target, s.t - step);
        draw(s); busy = true;
      });
      if (busy) next(tick); else { running = false; if (active < 0) restack(-1); }
    }
    function run() { if (!running) { running = true; last = 0; next(tick); } }

    var active = -1, front = -1;
    function restack(i) {
      if (i < 0) { order.forEach(function (g) { layers.appendChild(g); }); front = -1; return; }
      if (front >= 0 && front !== i) layers.appendChild(slices[front].g); // the one turning back
      layers.appendChild(slices[i].g);
      front = i;
    }
    function set(i) {
      if (i === active) return;
      active = i;
      root.classList.toggle('is-focus', i >= 0);
      slices.forEach(function (s, k) {
        s.target = k === i ? 1 : 0;
        s.g.classList.toggle('is-active', k === i);
      });
      // the active slice is drawn last, so it sits in front. A slice turning
      // back stays in front of the resting ones until it is isometric again;
      // the original order returns once everything has settled.
      if (i >= 0) restack(i);
      panels.forEach(function (p, k) {
        var on = k === i;
        p.classList.toggle('is-on', on);
        p.setAttribute('aria-hidden', on ? 'false' : 'true');
        var a = p.querySelector('a'); if (a) a.tabIndex = on ? 0 : -1;
      });
      hits.forEach(function (h) { h.setAttribute('aria-expanded', String(+h.getAttribute('data-i') === i)); });
      run();
    }

    // Mouse: hover opens. Touch and keyboard: tap or focus opens. A tap also
    // fires focus and click, so click only ever opens; tapping outside, moving
    // the mouse away or Escape closes.
    hits.forEach(function (h) {
      var i = +h.getAttribute('data-i');
      h.addEventListener('pointerenter', function (e) { if (e.pointerType === 'mouse') set(i); });
      h.addEventListener('focus', function () { set(i); });
      h.addEventListener('click', function () { set(i); });
    });
    root.addEventListener('pointerleave', function (e) { if (e.pointerType === 'mouse') set(-1); });
    document.addEventListener('click', function (e) { if (!root.contains(e.target)) set(-1); });
    root.addEventListener('focusout', function (e) { if (!root.contains(e.relatedTarget)) set(-1); });
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape') set(-1); });
  })();
</script>
