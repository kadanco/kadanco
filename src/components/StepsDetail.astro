                  })}</div>
                  <div class="c-post" aria-live="polite">
                    <div class="c-who"><span class="c-av"></span><b>{labels.cnt.author}</b><span class="c-in">in</span></div>
                    {labels.cnt.posts.map((t, k) => <p class={`c-pt c-pt--${k}`}>{t}</p>)}
                    <div class="c-react"><i></i><i></i><i></i><span class="c-ok">✓ {labels.cnt.approved}</span></div>
                  </div>
