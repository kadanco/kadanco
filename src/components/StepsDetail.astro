              )}

              {s.key === 'articles' && labels.cnt && (
                <div class="c-art" data-mx data-view="search">
                  <div class="c-page" aria-hidden="true">
                    <span class="m-kick">{labels.cnt.guide}</span>
                    <b>{labels.cnt.articleH}</b>
                    <em></em><em></em><em class="s"></em><em></em><em class="s"></em>
                  </div>
                  <div class="c-found">
                    <div class="m-ctl" role="group">
                      <button type="button" class="m-chip" data-mx-set="view" data-mx-val="search" aria-pressed="true">⌕ {labels.cnt.search}</button>
                      <button type="button" class="m-chip" data-mx-set="view" data-mx-val="ai" aria-pressed="false">✦ {labels.cnt.ai}</button>
                    </div>
                    <div class="c-serp" aria-live="polite">
                      <div class="c-res on"><span class="c-n">1</span><div><b>{labels.cnt.url}</b><span>{labels.cnt.articleH}</span></div></div>
                      {labels.cnt.others.map((o, k) => <div class="c-res"><span class="c-n">{k + 2}</span><div><b>{o}</b><em class="s"></em></div></div>)}
