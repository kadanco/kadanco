  .p-frames { display: grid; grid-template-columns: repeat(2, 1fr); gap: 18px; padding: 4px 22px 0; }
  .p-flabel { display: block; margin-bottom: 4px; font-size: 11px; font-weight: var(--kd-weight-medium); color: var(--kd-blue-2); }
  .p-fs { display: grid; gap: 7px; align-content: start; min-height: 140px; padding: 12px; border-radius: 3px; background: var(--kd-white); box-shadow: 0 0 0 1px var(--wf), 0 8px 18px -12px rgba(26, 1, 117, .35); }
  .p-fs em.t { width: 50%; height: 9px; background: var(--kd-blue-1); }
  .p-grid2 { display: grid; grid-template-columns: 1fr 1fr; gap: 6px; }
