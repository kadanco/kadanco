  .p-tree em.in { margin-left: 10px; }
  .p-tree em.on { background: var(--kd-blue-2); }
  .p-code2 { margin: 0; padding: 18px; font-size: 13px; background: var(--kd-blue-1); color: var(--kd-white); font-family: ui-monospace, Menlo, Consolas, monospace; font-size: 12px; line-height: 1.7; white-space: pre-wrap; overflow-wrap: anywhere; }
  .p-code2 .k { color: var(--kd-lilac); } .p-code2 .f { color: var(--kd-signal-1); } .p-code2 .s { color: var(--kd-signal-1); } .p-code2 .t, .p-code2 .a { color: var(--kd-lilac-tint); }
  .p-prev { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; padding: 14px 16px; border-top: 1px solid var(--wf); }
  .p-prevl { width: 100%; font-size: 11px; font-weight: var(--kd-weight-medium); letter-spacing: .04em; text-transform: uppercase; opacity: .65; }
  .p-status { grid-column: 2; display: flex; flex-wrap: wrap; align-items: flex-start; gap: 8px; padding: 0 16px 16px; }
  .p-status span { padding: 3px 10px; border-radius: var(--kd-radius); background: var(--kd-signal-1); font-size: 11px; font-weight: var(--kd-weight-medium); }

  /* ---------- Website Production pictures ---------- */
  /* brand board */
  .w-brand { display: grid; grid-template-columns: 1.15fr 1fr; gap: 12px; }
  .w-pos { display: grid; gap: 8px; align-content: start; }
  .w-opt { display: grid; grid-template-columns: 18px 1fr auto auto; align-items: center; gap: 8px; padding: 6px 8px; border-radius: var(--kd-radius); box-shadow: inset 0 0 0 1px var(--wf); }
  .w-opt.on { box-shadow: inset 0 0 0 2px var(--kd-blue-2); }
  .w-opt-l { font-weight: var(--kd-weight-medium); opacity: .6; }
  .w-opt.on .w-opt-l { opacity: 1; color: var(--kd-blue-2); }
  .w-risk { display: flex; gap: 3px; }
  .w-risk i { width: 7px; height: 7px; border-radius: 50%; background: var(--wf); }
  .w-risk i.on { background: var(--kd-lilac); }
  .w-tick { display: grid; place-items: center; width: 18px; height: 18px; border-radius: 50%; background: var(--kd-signal-1); font-size: 11px; }
  .w-riskl { justify-self: end; font-size: 10px; font-weight: var(--kd-weight-medium); letter-spacing: .04em; text-transform: uppercase; opacity: .6; }
  .w-id { display: grid; gap: 10px; align-content: start; }
  .w-logo { display: flex; align-items: center; justify-content: center; gap: 10px; height: 62px; border-radius: var(--kd-radius); background: var(--kd-blue-1); }
  .w-mark { display: grid; place-items: center; width: 30px; height: 30px; border-radius: var(--kd-radius); background: var(--kd-signal-1); }
  .w-mark i { width: 13px; height: 13px; border-radius: 50%; background: var(--kd-blue-1); }
  .w-word { width: 64px; height: 11px; border-radius: 3px; background: var(--kd-white); }
  .w-sw { display: grid; grid-template-columns: repeat(4, 1fr); gap: 6px; }
  .w-sw i { height: 26px; border-radius: var(--kd-radius); }
  .w-sw i:nth-child(1) { background: var(--kd-blue-1); } .w-sw i:nth-child(2) { background: var(--kd-blue-2); } .w-sw i:nth-child(3) { background: var(--kd-lilac); } .w-sw i:nth-child(4) { background: var(--kd-signal-1); }
  .w-type { display: flex; align-items: center; gap: 12px; padding: 10px 12px; }
  .w-aa { font-size: 34px; line-height: 1; font-weight: var(--kd-weight-medium); }
  .w-voice { display: flex; flex-wrap: wrap; gap: 4px; }
  .w-voice span { padding: 1px 7px; border-radius: var(--kd-radius); background: var(--kd-lilac-tint); font-size: 11px; font-weight: var(--kd-weight-medium); }
  .w-msg { grid-column: 1 / -1; display: grid; gap: 6px; }
  .w-msg .p-h { margin-bottom: 2px; }
  .w-hl { display: block; width: 62%; height: 10px; border-radius: 3px; background: var(--kd-blue-1); box-shadow: 0 4px 0 -1px var(--kd-signal-1); margin-bottom: 4px; }

  /* concept: site map, wireframe with copy pins, keyword and question notes */
  .w-concept { display: grid; grid-template-columns: .8fr 1.4fr; grid-template-rows: auto auto; gap: 12px; align-items: start; }
  .w-tree { display: grid; justify-items: start; gap: 14px; padding: 12px 8px; border-radius: var(--kd-radius); border: 1px dashed var(--wf); }
  .w-node { display: block; padding: 3px 6px; border-radius: 3px; border: 1.5px solid var(--kd-blue-1); background: var(--kd-white); font-size: 10px; font-weight: var(--kd-weight-medium); white-space: nowrap; text-align: center; }
  .w-node--top { position: relative; background: var(--kd-blue-1); color: var(--kd-white); }
  .w-node--top::after { content: ''; position: absolute; left: 13px; top: 100%; height: 8px; border-left: 1.5px solid var(--kd-blue-1); }
  .w-kids { display: grid; gap: 6px; margin: -14px 0 0 13px; padding: 14px 0 0 12px; border-left: 1.5px solid var(--kd-blue-1); }
  .w-kids .w-node { position: relative; justify-self: start; }
  .w-kids .w-node::before { content: ''; position: absolute; right: calc(100% + 1.5px); top: 50%; width: 12px; border-top: 1.5px solid var(--kd-blue-1); }
  .w-wire { position: relative; display: grid; gap: 10px; padding: 12px; border-radius: var(--kd-radius); border: 1.5px solid var(--wf); }
  .w-wnav { display: flex; align-items: center; gap: 6px; }
  .w-wnav span { width: 30px; height: 8px; border-radius: 3px; background: var(--wf); }
  .w-wnav em { width: 22px; height: 5px; } .w-wnav em:first-of-type { margin-left: auto; }
  .w-whero { display: grid; grid-template-columns: 1.2fr 1fr; gap: 10px; align-items: center; }
  .w-wcopy { display: grid; gap: 6px; }
  .w-wh { display: block; height: 9px; width: 90%; border-radius: 3px; background: color-mix(in srgb, var(--kd-blue-1) 34%, transparent); }
  .w-wh.s { width: 64%; }
  .w-wbtn { display: block; width: 52px; height: 15px; border-radius: var(--kd-radius); box-shadow: inset 0 0 0 1.5px color-mix(in srgb, var(--kd-blue-1) 34%, transparent); }
  .w-wimg { aspect-ratio: 4 / 3; border-radius: 3px; box-shadow: inset 0 0 0 1.5px var(--wf); background:
      linear-gradient(to top right, transparent calc(50% - 1px), var(--wf) 50%, transparent calc(50% + 1px)),
      linear-gradient(to bottom right, transparent calc(50% - 1px), var(--wf) 50%, transparent calc(50% + 1px)); }
  .w-wcards { display: grid; grid-template-columns: repeat(3, 1fr); gap: 6px; }
  .w-wcards span { height: 26px; border-radius: 3px; box-shadow: inset 0 0 0 1.5px var(--wf); }
  .w-pin { display: grid; place-items: center; width: 18px; height: 18px; border-radius: 50%; background: var(--kd-signal-1); color: var(--kd-blue-1); font-size: 10px; font-weight: var(--kd-weight-medium); flex: none; }
  .w-wire .w-pin { position: absolute; }
  .w-pin--1 { left: 6px; top: 34px; } .w-pin--2 { right: 6px; bottom: 40px; }
  .w-notes { grid-column: 1 / -1; display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  .w-note { display: flex; gap: 8px; align-items: flex-start; padding: 10px; }
  .w-note > div { flex: 1; display: grid; gap: 6px; }
  .w-note b { font-size: 11px; font-weight: var(--kd-weight-medium); }

  /* design: one page on three devices */
  .w-design { display: grid; grid-template-columns: 2.4fr 1.3fr .8fr; gap: 14px; align-items: end; }
  .w-screen { display: grid; gap: 8px; padding: 10px; border-radius: var(--kd-radius); border: 2px solid var(--kd-blue-1); background: var(--kd-white); }
  .w-dev--1 .w-screen { border-radius: 10px; }
  .w-dev--2 .w-screen { border-radius: 12px; padding: 12px 7px; }
  .w-snav { display: flex; align-items: center; gap: 5px; }
  .w-snav span { width: 26px; height: 7px; border-radius: 3px; background: var(--kd-blue-1); }
  .w-snav em { width: 18px; height: 4px; } .w-snav em:first-of-type { margin-left: auto; }
  .w-snav u { width: 30px !important; height: 11px !important; margin-left: auto; }
  .w-dev--0 .w-snav u { margin-left: 0; }
  .w-shero { display: grid; grid-template-columns: 1.1fr 1fr; gap: 8px; align-items: center; }
  .w-dev--1 .w-shero, .w-dev--2 .w-shero { grid-template-columns: 1fr; }
  .w-scopy { display: grid; gap: 5px; }
  .w-sh { display: block; height: 8px; width: 92%; border-radius: 3px; background: var(--kd-blue-1); }
  .w-sh.b { width: 66%; background: var(--kd-blue-2); box-shadow: 0 3px 0 -1px var(--kd-signal-1); }
  .w-scopy u { width: 50% !important; height: 13px !important; margin-top: 3px; }
  .w-simg { position: relative; aspect-ratio: 4 / 3; border-radius: 3px; background: var(--kd-blue-2); overflow: hidden; }
  .w-simg i { position: absolute; right: 16%; top: 16%; width: 26%; aspect-ratio: 1; border-radius: 50%; background: var(--kd-signal-1); }
  .w-simg b { position: absolute; left: 14%; bottom: 14%; width: 42%; height: 36%; border-radius: 3px; background: var(--kd-lilac); }
  .w-scards { display: grid; grid-template-columns: repeat(auto-fit, minmax(0, 1fr)); grid-auto-flow: column; gap: 5px; }
  .w-scards span { height: 22px; border-radius: 3px; background: var(--kd-lilac-tint); }

  /* develop: CMS editor and live page */
  .w-dev2 { display: grid; grid-template-columns: 1fr 1.2fr; gap: 12px; }
  .w-cms { display: grid; gap: 9px; align-content: start; }
  .w-field { display: grid; gap: 4px; }
  .w-field em.s { width: 34%; }
  .w-field--row { grid-template-columns: auto 1fr; align-items: center; gap: 8px; }
  .w-in { display: grid; gap: 4px; align-content: center; height: 22px; padding: 0 8px; border-radius: var(--kd-radius); border: 1.5px solid color-mix(in srgb, var(--kd-blue-1) 25%, transparent); }
  .w-in--tall { height: 38px; }
  .w-in i { display: block; height: 5px; width: 80%; border-radius: 3px; background: var(--kd-blue-1); opacity: .7; }
  .w-in i.s { width: 50%; }
  .w-pub { justify-self: start; padding: 3px 12px; border-radius: var(--kd-radius); background: var(--kd-blue-2); color: var(--kd-white); font-size: 11px; font-weight: var(--kd-weight-medium); }
  .w-live { display: grid; gap: 8px; align-content: start; }
  .w-livetag { justify-self: start; padding: 2px 8px; border-radius: var(--kd-radius); background: var(--kd-blue-1); color: var(--kd-signal-1); font-size: 11px; font-weight: var(--kd-weight-medium); }
  .w-lpage { display: grid; gap: 7px; padding: 14px; border-radius: var(--kd-radius); border: 2px solid var(--kd-blue-1); }
  .w-lpage u { width: 40% !important; height: 15px !important; }
  .w-checks { grid-column: 1 / -1; padding: 0; }

  /* optimise: search, AI answer and scores */
  .w-opt2 { display: grid; grid-template-columns: 1.1fr 1fr; gap: 12px; align-items: start; }
  .w-serp { display: grid; gap: 7px; }
  .w-q { padding: 4px 10px; border-radius: 99px; box-shadow: inset 0 0 0 1.5px var(--wf); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .w-res { display: grid; grid-template-columns: auto 1fr; gap: 8px; align-items: center; padding: 6px 8px; border-radius: var(--kd-radius); }
  .w-res > div { display: grid; gap: 5px; }
  .w-res b { font-weight: var(--kd-weight-medium); color: var(--kd-blue-2); }
  .w-res em.m { width: 50%; background: color-mix(in srgb, var(--kd-blue-1) 26%, transparent); }
  .w-n { display: grid; place-items: center; width: 18px; height: 18px; border-radius: 50%; box-shadow: inset 0 0 0 1px var(--wf); font-size: 10px; }
  .w-res.on { background: color-mix(in srgb, var(--kd-blue-2) 7%, var(--kd-white)); box-shadow: inset 3px 0 0 var(--kd-blue-2); }
  .w-res.on .w-n { background: var(--kd-signal-1); box-shadow: none; font-weight: var(--kd-weight-medium); }
  .w-ai { display: grid; gap: 7px; padding: 14px; border-radius: var(--kd-radius); background: var(--kd-blue-1); color: var(--kd-white); }
  .sd-canvas .w-ai em { background: rgba(255, 255, 255, .22); }
  .w-ai-l { color: var(--kd-signal-1); font-weight: var(--kd-weight-medium); }
  .w-cite { justify-self: start; margin-top: 2px; padding: 2px 8px; border-radius: var(--kd-radius); background: var(--kd-signal-1); color: var(--kd-blue-1); font-weight: var(--kd-weight-medium); }
  .w-scores { grid-column: 1 / -1; display: grid; grid-template-columns: 1.4fr 1fr 1fr 1fr; gap: 10px; }
  .w-gauge { display: flex; align-items: center; gap: 10px; padding: 10px 12px; }
  .w-gauge b, .w-sc b { font-weight: var(--kd-weight-medium); }
  /* speed gauge: a half ring, mostly filled */
  .w-arc { flex: none; width: 44px; height: 22px; border-radius: 44px 44px 0 0; background: conic-gradient(from -90deg at 50% 100%, var(--kd-blue-2) 0 150deg, var(--wf) 150deg 180deg, transparent 180deg); -webkit-mask: radial-gradient(circle at 50% 100%, transparent 13px, black 14px); mask: radial-gradient(circle at 50% 100%, transparent 13px, black 14px); }
  .w-sc { display: flex; align-items: center; justify-content: space-between; gap: 6px; padding: 10px 12px; }
  .w-sc span { display: grid; place-items: center; width: 18px; height: 18px; border-radius: 50%; background: var(--kd-signal-1); font-size: 11px; }

  @media (max-width: 560px) {
    .w-brand, .w-concept, .w-dev2, .w-opt2 { grid-template-columns: 1fr; }
    .w-design { grid-template-columns: 1fr 1fr; }
    .w-dev--0 { grid-column: 1 / -1; }
    .w-scores { grid-template-columns: 1fr 1fr; }
    .w-notes { grid-template-columns: 1fr; }
  }

  /* ---------- look 'campaign' (Marketing): pinned paper instead of an app window ---------- */
  .sd--campaign .sd-win { position: relative; overflow: visible; border: 0; background: var(--kd-beige-1); color: var(--kd-ink); box-shadow: 0 26px 50px -28px rgba(26, 1, 117, .55), 0 0 0 1px var(--kd-beige-3); transform: rotate(-1deg); }
  .sd--campaign .sd-step--flip .sd-win { transform: rotate(1deg); }
  .sd--campaign .sd-win::before { content: ''; position: absolute; z-index: 2; left: 50%; top: -12px; width: 96px; height: 24px; margin-left: -48px; background: color-mix(in srgb, var(--kd-signal-1) 72%, transparent); transform: rotate(-3deg); }
  .sd--campaign .sd-bar { display: none; }
  .sd--campaign .sd-canvas { container-type: inline-size; padding: 28px; }
  .sd--campaign .sd-num { color: var(--kd-blue-1); }
  .sd--campaign .sd-list--do li::before { background: var(--kd-blue-1); }
  .sd--campaign .sd-list--get li::before { border-color: var(--kd-blue-1); }
  .sd--campaign .sd-when { border-color: var(--kd-blue-1); color: var(--kd-blue-1); }
  .sd--campaign .sd-cta { background: var(--kd-blue-1); }
  .sd--campaign mark { background: linear-gradient(transparent 52%, var(--kd-signal-1) 52% 94%, transparent 94%); color: inherit; -webkit-box-decoration-break: clone; box-decoration-break: clone; }
  .m-kick { font-size: clamp(9px, 1.9cqi, 12px); font-weight: var(--kd-weight-medium); letter-spacing: .08em; text-transform: uppercase; opacity: .65; }
  .m-logo { font-size: clamp(22px, 7cqi, 44px); font-weight: var(--kd-weight-logo); letter-spacing: -.02em; line-height: 1; }

  /* controls inside the pictures: small chips, navy when chosen */
  .m-ctl { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; }
  .m-ctl-l { margin-right: 4px; font-size: clamp(9px, 1.8cqi, 12px); font-weight: var(--kd-weight-medium); letter-spacing: .06em; text-transform: uppercase; opacity: .7; }
  .m-chip, .m-arrow, .m-arc button, .m-swb { font: inherit; color: inherit; cursor: pointer; }
  .m-chip { padding: 4px 10px; border: 1.5px solid var(--kd-blue-1); border-radius: var(--kd-radius); background: var(--kd-white); font-size: clamp(10px, 2cqi, 13px); font-weight: var(--kd-weight-medium); transition: background-color .2s ease, color .2s ease; }
  .m-chip small { font-size: .85em; opacity: .8; }
  .m-chip[aria-pressed="true"] { background: var(--kd-blue-1); color: var(--kd-white); }
  .m-chip:hover { background: var(--kd-lilac-tint); } .m-chip[aria-pressed="true"]:hover { background: var(--kd-blue-1); }
  :is(.m-chip, .m-arrow, .m-arc button, .m-swb):focus-visible { outline: 2px solid var(--kd-blue-2); outline-offset: 2px; }
  .m-hint { font-size: clamp(9px, 1.8cqi, 12px); font-weight: var(--kd-weight-medium); letter-spacing: .04em; opacity: .65; }

  /* 1 map: pick an option and your dot moves; the statement and the risk follow */
  .m-map { display: grid; gap: 3cqi; }
  .m-plot { position: relative; aspect-ratio: 2.6 / 1; margin: 0 6cqi; background:
      linear-gradient(var(--kd-ink), var(--kd-ink)) center / 1.5px 100% no-repeat,
      linear-gradient(var(--kd-ink), var(--kd-ink)) center / 100% 1.5px no-repeat; }
  .m-ax { position: absolute; max-width: 40%; font-size: clamp(8px, 1.9cqi, 12px); font-weight: var(--kd-weight-medium); letter-spacing: .04em; text-transform: uppercase; line-height: 1.15; }
  .m-ax--l { left: 0; top: 50%; transform: translate(0, calc(-100% - 4px)); } .m-ax--r { right: 0; top: 50%; transform: translate(0, 4px); text-align: right; }
  .m-ax--b { left: 50%; bottom: 0; transform: translate(6px, 0); } .m-ax--t { left: 50%; top: 0; transform: translate(6px, 0); }
  .m-dot { position: absolute; display: grid; place-items: center; width: clamp(16px, 4cqi, 24px); aspect-ratio: 1; margin: -2cqi 0 0 -2cqi; border-radius: 50%; background: var(--kd-beige-3); font-size: clamp(8px, 1.8cqi, 11px); color: var(--kd-ink-2); }
  .m-you { position: absolute; left: var(--x); top: var(--y); display: grid; place-items: center; width: clamp(34px, 9cqi, 54px); aspect-ratio: 1; margin: -4.5cqi 0 0 -4.5cqi; border-radius: 50%; background: var(--kd-signal-1); color: var(--kd-blue-1); font-size: clamp(10px, 2.4cqi, 14px); font-weight: var(--kd-weight-medium); box-shadow: 0 0 0 4px var(--kd-blue-1); transition: left .6s cubic-bezier(.3, .7, .3, 1), top .6s cubic-bezier(.3, .7, .3, 1); }
  .m-map[data-opt="a"] { --x: 27%; --y: 74%; } .m-map[data-opt="b"] { --x: 78%; --y: 28%; } .m-map[data-opt="c"] { --x: 30%; --y: 24%; }
  .m-opt-out { display: none; gap: 1.6cqi; }
  .m-map[data-opt="a"] .m-opt-out--a, .m-map[data-opt="b"] .m-opt-out--b, .m-map[data-opt="c"] .m-opt-out--c { display: grid; }
  .sd .m-stmt { margin: 0; padding: 2.6cqi 3cqi; border-left: 4px solid var(--kd-blue-1); background: var(--kd-white); font-size: clamp(12px, 2.8cqi, 18px); line-height: 1.4; }
  .m-risk { font-size: clamp(10px, 2cqi, 13px); font-weight: var(--kd-weight-medium); }
  .m-map[data-opt="b"] .m-risk { color: var(--kd-blue-2); }

  /* 2 message house: Before shows the buzzwords, After the clear message */
  .m-msg { display: grid; grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr); gap: 3cqi 4cqi; align-items: center; }
  .m-msg > .m-ctl { grid-column: 1 / -1; }
  .m-house { display: grid; gap: 1.4cqi; }
  .m-roof { display: grid; place-items: center; padding: 6cqi 3cqi 2.4cqi; background: var(--kd-blue-1); color: var(--kd-white); clip-path: polygon(50% 0, 100% 42%, 100% 100%, 0 100%, 0 42%); text-align: center; font-size: clamp(12px, 2.8cqi, 17px); font-weight: var(--kd-weight-medium); line-height: 1.2; transition: background-color .3s ease; }
  .m-pillars { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.4cqi; }
  .m-pillars span { display: grid; place-items: center; min-height: 14cqi; padding: 1.6cqi; background: var(--kd-white); border: 1.5px solid var(--kd-blue-1); font-size: clamp(10px, 2.1cqi, 13px); line-height: 1.25; text-align: center; hyphens: auto; overflow-wrap: anywhere; }
  .m-pillars b { font-weight: var(--kd-weight-regular); }
  .m-base { padding: 1.8cqi; background: var(--kd-signal-1); color: var(--kd-blue-1); text-align: center; font-size: clamp(10px, 2cqi, 13px); font-weight: var(--kd-weight-medium); transition: background-color .3s ease; }
  .m-msg[data-ba="after"] .m-b, .m-msg[data-ba="before"] .m-a { display: none; }
  .m-msg[data-ba="before"] .m-roof { background: var(--kd-ink-2); }
  .m-msg[data-ba="before"] .m-base { background: var(--kd-beige-3); color: var(--kd-ink-2); }
  .m-msg[data-ba="before"] .m-pillars span { border-color: var(--kd-beige-3); color: var(--kd-ink-2); }
  .m-voice { display: grid; gap: 2.4cqi; }
  .m-voice > div { padding: 2.6cqi; background: var(--kd-white); border-radius: var(--kd-radius); }
  .m-say { box-shadow: inset 4px 0 0 var(--kd-blue-2); transform: rotate(1.2deg); }
  .m-dont { box-shadow: inset 4px 0 0 var(--kd-beige-3); color: var(--kd-ink-2); transform: rotate(-1deg); }
  .m-voice b { display: block; margin-bottom: 1cqi; font-size: clamp(9px, 1.9cqi, 12px); font-weight: var(--kd-weight-medium); letter-spacing: .06em; text-transform: uppercase; }
  .sd .m-voice p { margin: 0; font-size: clamp(12px, 2.6cqi, 16px); line-height: 1.3; }
  .m-dont p { text-decoration: line-through; text-decoration-color: color-mix(in srgb, var(--kd-ink) 50%, transparent); }

  /* 3 brand guide: tap a colour, the post and the card take it on */
  .m-id { display: grid; gap: 2cqi; }
  .m-id[data-acc="0"] { --acc: var(--kd-ink); --acc-fg: var(--kd-white); }
  .m-id[data-acc="1"] { --acc: var(--kd-blue-2); --acc-fg: var(--kd-white); }
  .m-id[data-acc="2"] { --acc: var(--kd-lilac); --acc-fg: var(--kd-blue-1); }
  .m-id[data-acc="3"] { --acc: var(--kd-signal-1); --acc-fg: var(--kd-blue-1); }
  .m-book { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); border-radius: var(--kd-radius); overflow: hidden; box-shadow: 0 14px 30px -18px rgba(26, 1, 117, .5); }
  .m-page { display: flex; flex-direction: column; gap: 3cqi; padding: 4cqi; min-height: 44cqi; }
  .m-page--l { background: var(--kd-blue-1); color: var(--kd-white); box-shadow: inset -14px 0 18px -14px rgba(0, 0, 0, .5); }
  .m-page--l .m-logo { flex: 1; display: grid; place-items: center; color: var(--kd-signal-1); }
  .m-page--r { background: var(--kd-white); box-shadow: inset 14px 0 18px -14px rgba(26, 1, 117, .25); }
  .m-sw { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1.2cqi; }
  .m-swb { display: grid; gap: .8cqi; padding: 0; border: 0; background: none; text-align: left; font-size: clamp(8px, 1.7cqi, 11px); }
  .m-swb i { aspect-ratio: 1; border-radius: 3px; box-shadow: 0 0 0 1px rgba(255, 255, 255, .25); transition: box-shadow .2s ease, transform .2s ease; }
  .m-swb:hover i { transform: translateY(-2px); }
  .m-swb[aria-pressed="true"] i { box-shadow: 0 0 0 2px var(--kd-blue-1), 0 0 0 4px var(--kd-white); }
  .m-swb:nth-child(1) i { background: var(--kd-ink); } .m-swb:nth-child(2) i { background: var(--kd-blue-2); }
  .m-swb:nth-child(3) i { background: var(--kd-lilac); } .m-swb:nth-child(4) i { background: var(--kd-signal-1); }
  .m-aa { font-size: clamp(32px, 11cqi, 66px); line-height: .9; font-weight: var(--kd-weight-medium); }
  .m-apply { margin-top: auto; display: grid; grid-template-columns: 1fr 1fr; gap: 2cqi; align-items: end; }
  .m-post { display: grid; gap: 1.6cqi; aspect-ratio: 1; padding: 2.4cqi; background: var(--acc); color: var(--acc-fg); transform: rotate(-3deg); transition: background-color .35s ease, color .35s ease; }
  .m-post span, .m-card span { font-size: clamp(9px, 2cqi, 12px); font-weight: var(--kd-weight-logo); }
  .m-post b { align-self: end; font-size: clamp(11px, 2.8cqi, 17px); line-height: 1.1; font-weight: var(--kd-weight-medium); }
  /* the card takes the chosen colour as its ground with a matching text colour, so it always reads (blue text on navy did not) */
  .m-card { display: grid; gap: 1cqi; aspect-ratio: 1.6; padding: 2cqi; background: var(--acc); color: var(--acc-fg); transform: rotate(4deg); box-shadow: inset 0 -5px 0 var(--kd-blue-1), 0 0 0 1px color-mix(in srgb, var(--kd-blue-1) 20%, transparent); transition: background-color .35s ease, color .35s ease; }
  .m-id[data-acc="0"] .m-card { box-shadow: inset 0 -5px 0 var(--kd-signal-1); }
  .sd-canvas .m-card em { height: 4px; background: currentColor; opacity: .35; }

  /* 4 sales deck: flip through the slides */
  .m-deck { display: grid; gap: 4cqi; }
  .m-fan { position: relative; aspect-ratio: 16 / 7.4; margin: 0 6cqi; }
  .m-slide { position: absolute; inset: 0; border-radius: var(--kd-radius); box-shadow: 0 14px 30px -18px rgba(26, 1, 117, .55); }
  .m-slide--back { display: flex; align-items: flex-start; padding: 3cqi 4cqi; background: var(--kd-white); border: 1px solid var(--kd-beige-3); }
  .sd-canvas .m-slide--back em { width: 30%; }
  .m-slide--b0 { transform: translate(7cqi, -4cqi) rotate(5deg); }
  .m-slide--b1 { transform: translate(3.5cqi, -2cqi) rotate(2.5deg); }
  .m-slide--front { display: grid; grid-template-columns: 1.3fr 1fr; grid-template-rows: auto 1fr auto; column-gap: 4cqi; padding: 3.6cqi 4cqi; background: var(--kd-blue-1); color: var(--kd-white); transform: rotate(-2deg); opacity: 0; visibility: hidden; transition: opacity .35s ease, transform .35s ease, visibility 0s .35s; }
  .m-deck[data-slide="0"] .m-slide--f0, .m-deck[data-slide="1"] .m-slide--f1, .m-deck[data-slide="2"] .m-slide--f2, .m-deck[data-slide="3"] .m-slide--f3 { opacity: 1; visibility: visible; transition: opacity .35s ease, transform .35s ease; }
  .m-slide--front .m-kick { grid-column: 1 / -1; color: var(--kd-signal-1); opacity: 1; }
  .m-slide--front b { align-self: center; font-size: clamp(13px, 4cqi, 25px); line-height: 1.1; font-weight: var(--kd-weight-medium); }
  .m-bars { grid-row: 2 / 4; grid-column: 2; display: flex; align-items: flex-end; gap: 1.6cqi; border-bottom: 1.5px solid rgba(255, 255, 255, .4); }
  .m-bars i { flex: 1; height: var(--h); border-radius: 2px 2px 0 0; background: rgba(255, 255, 255, .25); }
  .m-bars i.on { background: var(--kd-signal-1); }
  .m-logo--s { font-size: clamp(11px, 2.4cqi, 15px); color: var(--kd-white); }
  .m-nav { display: grid; grid-template-columns: auto minmax(0, 1fr) auto; align-items: center; gap: 2cqi; }
  .m-arrow { display: grid; place-items: center; width: 32px; height: 32px; border: 1.5px solid var(--kd-blue-1); border-radius: var(--kd-radius); background: var(--kd-white); font-size: 15px; }
  .m-arrow:hover { background: var(--kd-blue-1); color: var(--kd-white); }
  .m-arc { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1.4cqi; }
  .m-arc button { display: grid; gap: 2px; width: 100%; padding: 1.2cqi 0 0; border: 0; border-top: 2px solid var(--kd-beige-3); background: none; text-align: left; font-size: clamp(9px, 1.9cqi, 12px); font-weight: var(--kd-weight-medium); line-height: 1.2; }
  .m-arc button span { font-size: .85em; opacity: .55; }
  .m-arc button[aria-pressed="true"] { border-top-color: var(--kd-blue-1); }

  /* 5 rollout: five assets from five different companies, until the brand is switched on */
  .m-roll { display: grid; gap: 3cqi; }
  .m-wall { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); grid-template-areas: "web web roll" "li li roll" "sig deck roll"; gap: 2.4cqi; }
  .m-as { position: relative; display: grid; gap: .8cqi; align-content: start; transition: transform .45s cubic-bezier(.3, .7, .3, 1) var(--d); }
  .m-as--web { grid-area: web; } .m-as--li { grid-area: li; } .m-as--sig { grid-area: sig; } .m-as--deck { grid-area: deck; } .m-as--roll { grid-area: roll; }
  .m-as-l { font-size: clamp(8px, 1.7cqi, 11px); font-weight: var(--kd-weight-medium); letter-spacing: .06em; text-transform: uppercase; opacity: .65; }
  .m-as-in { display: flex; flex-direction: column; gap: 1.2cqi; padding: 2cqi; border-radius: var(--kd-radius); background: var(--kd-blue-1); color: var(--kd-white); box-shadow: 0 10px 22px -14px rgba(26, 1, 117, .6); transition: background-color .45s ease var(--d), color .45s ease var(--d), border-radius .45s ease var(--d); }
  .m-as--roll .m-as-in { min-height: 100%; justify-content: space-between; }
  .m-as--roll { grid-template-rows: auto 1fr; }
  .m-as--li .m-as-in { flex-direction: row; align-items: center; gap: 3cqi; }
  .m-as--sig .m-as-in, .m-as--deck .m-as-in { min-height: 14cqi; }
  .sd-canvas .m-as-in em { width: 80%; height: 5px; background: rgba(255, 255, 255, .35); transition: background-color .45s ease var(--d); }
  .sd-canvas .m-as-in em.s { width: 55%; }
  .sd-canvas .m-as-in u { width: 40%; height: 3cqi; background: var(--kd-signal-1); transition: background-color .45s ease var(--d), border-radius .45s ease var(--d); }
  .m-as-in .lg { align-self: flex-start; font-style: normal; font-size: clamp(10px, 2.4cqi, 15px); font-weight: var(--kd-weight-logo); color: var(--kd-signal-1); }
  .m-as-in .lg::after { content: 'talio'; }
  /* before: each asset from a different company */
  .m-roll[data-ba="before"] .m-as:nth-child(odd) { transform: rotate(-2.5deg); }
  .m-roll[data-ba="before"] .m-as:nth-child(even) { transform: rotate(2deg) translateY(4px); }
  .m-roll[data-ba="before"] .m-as--web .m-as-in { background: var(--kd-beige-3); color: var(--kd-ink-2); }
  .m-roll[data-ba="before"] .m-as--li .m-as-in { background: var(--kd-lilac); color: var(--kd-ink); border-radius: 14px; }
  .m-roll[data-ba="before"] .m-as--sig .m-as-in { background: var(--kd-white); color: var(--kd-ink-2); }
  .m-roll[data-ba="before"] .m-as--deck .m-as-in { background: var(--kd-blue-3); }
  .m-roll[data-ba="before"] .m-as--roll .m-as-in { background: var(--kd-ink); }
  .m-roll[data-ba="before"] .m-as-in em { background: color-mix(in srgb, var(--kd-ink) 22%, transparent); }
  .m-roll[data-ba="before"] .m-as--roll .m-as-in em, .m-roll[data-ba="before"] .m-as--deck .m-as-in em { background: rgba(255, 255, 255, .3); }
  .m-roll[data-ba="before"] .m-as-in u { background: var(--kd-blue-2); border-radius: 12px; }
  .m-roll[data-ba="before"] .m-as-in .lg { color: inherit; padding: 0 1cqi; border: 1.5px dashed currentColor; border-radius: 3px; font-weight: var(--kd-weight-regular); font-size: clamp(8px, 1.8cqi, 11px); letter-spacing: .1em; }
  .m-roll[data-ba="before"] .m-as-in .lg::after { content: 'LOGO'; }
  .m-roll[data-ba="before"] .m-as--li .m-as-in .lg::after { content: 'Logo'; }
  .m-roll[data-ba="before"] .m-as--deck .m-as-in .lg::after { content: 'logo v2'; }

  @media (max-width: 560px) {
    .m-msg { grid-template-columns: 1fr; }
    .m-plot { aspect-ratio: 2 / 1; }
    .m-fan { aspect-ratio: 16 / 10; }
    .m-slide--front { grid-template-columns: 1fr; }
    .m-slide--front .m-bars { display: none; }
    .m-slide--front b { font-size: 15px; }
    .m-arc button { font-size: 0; } .m-arc button span { font-size: 11px; opacity: 1; }
  }
  @media (prefers-reduced-motion: reduce) {
    .m-you, .m-as, .m-as-in, .m-slide--front, .m-post, .m-card, .m-roof, .m-base { transition: none !important; }
  }

  /* ---------- Content Production pictures (clickable) ---------- */
  /* 1 voice: the chosen argument lights up its quote and shows what it becomes */
  .c-voice { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); gap: 4cqi; align-items: start; }
  .c-notes { display: grid; gap: 1.4cqi; padding: 3cqi; background: var(--kd-white); border-radius: var(--kd-radius); background-image: repeating-linear-gradient(transparent 0 calc(4.4cqi - 1px), color-mix(in srgb, var(--kd-blue-2) 14%, transparent) calc(4.4cqi - 1px) 4.4cqi); transform: rotate(-1.5deg); }
  .sd .c-notes p { margin: 0; font-size: clamp(11px, 2.5cqi, 15px); line-height: 1.3; color: var(--kd-ink-2); transition: color .3s ease; }
  .c-notes mark { background: none; transition: background-size .35s ease; background-image: linear-gradient(transparent 52%, var(--kd-signal-1) 52% 94%, transparent 94%); background-repeat: no-repeat; background-size: 0 100%; color: inherit; }
  .c-voice[data-arg="0"] .c-q--0, .c-voice[data-arg="1"] .c-q--1, .c-voice[data-arg="2"] .c-q--2 { color: var(--kd-ink); }
  .c-voice[data-arg="0"] .c-q--0 mark, .c-voice[data-arg="1"] .c-q--1 mark, .c-voice[data-arg="2"] .c-q--2 mark { background-size: 100% 100%; }
  .c-args { display: grid; gap: 1.4cqi; }
  .c-arg { display: grid; grid-template-columns: auto 1fr; gap: 1.6cqi; align-items: center; padding: 1.8cqi 2.2cqi; border: 1.5px solid var(--kd-blue-1); border-radius: var(--kd-radius); background: var(--kd-white); color: var(--kd-blue-1); font: inherit; font-size: clamp(11px, 2.3cqi, 14px); font-weight: var(--kd-weight-medium); line-height: 1.2; text-align: left; cursor: pointer; transition: background-color .2s ease, color .2s ease; }
  .c-arg[aria-pressed="true"] { background: var(--kd-blue-1); color: var(--kd-white); }
  .c-arg:hover { background: var(--kd-lilac-tint); } .c-arg[aria-pressed="true"]:hover { background: var(--kd-blue-1); }
  .c-arg span { display: grid; place-items: center; width: 4.2cqi; height: 4.2cqi; border-radius: 50%; background: var(--kd-signal-1); color: var(--kd-blue-1); font-size: .9em; }
  .c-becomes { display: grid; gap: .8cqi; margin-top: 1cqi; padding: 2.2cqi; border-radius: var(--kd-radius); background: var(--kd-signal-1); color: var(--kd-blue-1); transform: rotate(1deg); }
  .sd .c-hook { display: none; margin: 0; font-size: clamp(11px, 2.4cqi, 15px); line-height: 1.3; font-weight: var(--kd-weight-medium); }
  .c-voice[data-arg="0"] .c-hook--0, .c-voice[data-arg="1"] .c-hook--1, .c-voice[data-arg="2"] .c-hook--2 { display: block; }

  /* 2 linkedin: tap a day, see its piece */
  .c-li { display: grid; gap: 3cqi; }
  .c-cal { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); border: 1.5px solid var(--kd-ink); border-radius: var(--kd-radius); overflow: hidden; background: var(--kd-white); }
  .c-day { display: grid; align-content: start; gap: 1cqi; min-height: 13cqi; padding: 1.4cqi; border-left: 1px solid var(--kd-beige-3); }
  .c-day:first-child { border-left: 0; }
  .c-day > span { font-size: clamp(8px, 1.8cqi, 11px); font-weight: var(--kd-weight-medium); letter-spacing: .06em; text-transform: uppercase; opacity: .65; }
  .c-ev { padding: .8cqi 1.2cqi; border: 1.5px solid var(--kd-blue-1); border-radius: 3px; background: var(--kd-white); color: var(--kd-blue-1); font: inherit; font-size: clamp(8px, 1.8cqi, 11px); font-weight: var(--kd-weight-medium); text-align: left; overflow-wrap: anywhere; cursor: pointer; }
  .c-ev[aria-pressed="true"] { background: var(--kd-blue-1); color: var(--kd-white); }
  .c-ev--a[aria-pressed="true"] { background: var(--kd-signal-1); border-color: var(--kd-signal-1); color: var(--kd-blue-1); }
  .c-post { display: grid; gap: 1.6cqi; width: 78%; justify-self: center; padding: 3cqi; border-radius: var(--kd-radius); background: var(--kd-white); box-shadow: 0 14px 30px -18px rgba(26, 1, 117, .5); transform: rotate(-1.5deg); }
  .c-who { display: flex; align-items: center; gap: 1.6cqi; font-size: clamp(10px, 2.2cqi, 13px); }
  .c-who b { font-weight: var(--kd-weight-medium); }
  .c-av { width: 5cqi; height: 5cqi; border-radius: 50%; background: var(--kd-lilac); }
  .c-in { margin-left: auto; padding: .2cqi 1cqi; border-radius: 3px; background: var(--kd-blue-1); color: var(--kd-white); font-size: clamp(8px, 1.8cqi, 11px); font-weight: var(--kd-weight-logo); }
  .sd .c-post p { display: none; margin: 0; font-size: clamp(11px, 2.6cqi, 16px); line-height: 1.35; }
  .c-li[data-day="0"] .c-pt--0, .c-li[data-day="1"] .c-pt--1, .c-li[data-day="2"] .c-pt--2 { display: block !important; }
  .c-react { display: flex; align-items: center; gap: .8cqi; padding-top: 1.4cqi; border-top: 1px solid var(--kd-beige-3); }
  .c-react i { width: 2.8cqi; height: 2.8cqi; border-radius: 50%; background: var(--kd-blue-2); }
  .c-react i:nth-child(2) { background: var(--kd-signal-1); } .c-react i:nth-child(3) { background: var(--kd-lilac); }
  .c-ok { margin-left: auto; padding: .4cqi 1.6cqi; border-radius: var(--kd-radius); background: var(--kd-signal-1); color: var(--kd-blue-1); font-size: clamp(9px, 2cqi, 12px); font-weight: var(--kd-weight-medium); }

  /* 3 articles: the guide, then where it is found: search or AI answer */
  .c-art { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 4cqi; align-items: center; }
  .c-page { display: grid; gap: 1.6cqi; padding: 3.4cqi; border-radius: var(--kd-radius); background: var(--kd-white); box-shadow: 0 14px 30px -18px rgba(26, 1, 117, .5); transform: rotate(-1.5deg); }
  .c-page b { font-size: clamp(13px, 3.4cqi, 21px); line-height: 1.1; font-weight: var(--kd-weight-medium); margin-bottom: 1cqi; }
  .c-found { display: grid; gap: 2cqi; align-content: start; }
  .c-serp { display: grid; gap: 1.2cqi; }
  .c-res { display: grid; grid-template-columns: auto 1fr; gap: 1.6cqi; align-items: center; padding: 1.6cqi 2cqi; border-radius: var(--kd-radius); background: var(--kd-white); }
  .c-res.on { box-shadow: inset 3px 0 0 var(--kd-blue-2); }
  .c-res b { display: block; font-size: clamp(10px, 2.2cqi, 13px); font-weight: var(--kd-weight-medium); }
  .c-res.on b { color: var(--kd-blue-2); }
  .c-res span:not(.c-n) { font-size: clamp(9px, 2cqi, 12px); opacity: .75; }
  .c-res em { margin-top: .6cqi; }
  .c-n { display: grid; place-items: center; width: 4cqi; height: 4cqi; border-radius: 50%; box-shadow: inset 0 0 0 1px var(--kd-beige-3); font-size: clamp(9px, 2cqi, 12px); font-weight: var(--kd-weight-medium); }
  .c-res.on .c-n { background: var(--kd-signal-1); box-shadow: none; color: var(--kd-blue-1); }
  .c-ai { display: grid; gap: 1.2cqi; padding: 2.6cqi; border-radius: var(--kd-radius); background: var(--kd-blue-1); color: var(--kd-white); }
  .c-ai-l { color: var(--kd-signal-1); font-size: clamp(9px, 2cqi, 12px); font-weight: var(--kd-weight-medium); }
  .sd .c-ai p { margin: 0; font-size: clamp(10px, 2.3cqi, 14px); line-height: 1.35; }
  .c-cite { justify-self: start; padding: .4cqi 1.6cqi; border-radius: var(--kd-radius); background: var(--kd-signal-1); color: var(--kd-blue-1); font-size: clamp(9px, 2cqi, 12px); font-weight: var(--kd-weight-medium); }
  .c-art[data-view="search"] .c-ai, .c-art[data-view="ai"] .c-serp { display: none; }

  /* 4 sales material: three pieces in a pile; the chosen one comes to the front */
  .c-col { display: grid; gap: 3cqi; }
  .c-pile { position: relative; height: 46cqi; }
  .c-pc { position: absolute; border-radius: var(--kd-radius); box-shadow: 0 14px 30px -18px rgba(26, 1, 117, .55); transition: transform .4s cubic-bezier(.3, .7, .3, 1), box-shadow .4s ease; }
  .c-slide { left: 0; top: 4cqi; width: 58%; display: grid; align-content: space-between; aspect-ratio: 16 / 9; padding: 3.4cqi; background: var(--kd-blue-1); color: var(--kd-white); transform: rotate(-3deg); }
  .c-slide b { font-size: clamp(14px, 4.2cqi, 26px); line-height: 1.05; font-weight: var(--kd-weight-medium); }
  .c-slide mark { background: linear-gradient(transparent 58%, color-mix(in srgb, var(--kd-signal-1) 80%, transparent) 58% 92%, transparent 92%); color: inherit; }
  .c-one { right: 2%; top: 0; width: 38%; display: grid; gap: 1.6cqi; padding: 3cqi; background: var(--kd-white); transform: rotate(3deg); }
  .c-one b { font-size: clamp(12px, 3cqi, 18px); line-height: 1.15; font-weight: var(--kd-weight-medium); }
  .c-one ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 1.6cqi; }
  .c-one li { position: relative; padding-left: 3cqi; }
  .c-one li::before { content: ''; position: absolute; left: 0; top: 50%; width: 1.6cqi; height: 1.6cqi; margin-top: -.8cqi; border-radius: 50%; background: var(--kd-blue-2); }
  .c-one li::after { content: ''; display: block; height: 1.2cqi; border-radius: 3px; background: color-mix(in srgb, var(--kd-ink) 12%, transparent); }
  .c-case { left: 26%; bottom: 0; width: 46%; display: grid; gap: 1.2cqi; padding: 2.6cqi; background: var(--kd-signal-1); color: var(--kd-blue-1); transform: rotate(1.5deg); }
  .sd .c-case p { margin: 0; font-size: clamp(11px, 2.5cqi, 15px); line-height: 1.3; font-weight: var(--kd-weight-medium); }
