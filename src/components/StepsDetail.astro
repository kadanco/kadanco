                    {[labels.cnt.deck, labels.cnt.onePager, labels.cnt.caseStudy].map((l, k) => <button type="button" class="m-chip" data-mx-set="front" data-mx-val={k} aria-pressed={k === 0 ? 'true' : 'false'}>{l}</button>)}
                  </div>
                  <div class="c-pile" aria-hidden="true">
                    <div class="c-slide c-pc c-pc--0"><b><mark>{labels.cnt.deckH}</mark></b><span class="m-logo m-logo--s">talio</span></div>
                    <div class="c-one c-pc c-pc--1"><span class="m-kick">{labels.cnt.onePager}</span><b>{labels.cnt.opH}</b><ul><li></li><li></li><li></li></ul></div>
                    <div class="c-case c-pc c-pc--2"><span class="m-kick">{labels.cnt.caseStudy}</span><p>“{labels.cnt.quote}”</p><em class="s"></em></div>
                  </div>
                </div>
              )}

              {s.key === 'pipeline' && labels.cnt && (
                <div class="c-pipe" data-mx data-stage="3">
                  <ol class="c-chain">{labels.cnt.chain.map((c, k) => <li class={`c-st c-st--${k}`}><button type="button" data-mx-set="stage" data-mx-val={k} aria-pressed={k === 3 ? 'true' : 'false'}><span>{String(k + 1).padStart(2, '0')}</span><b>{c}</b></button></li>)}</ol>
                  <div class="c-crm">
                    <span class="m-kick">{labels.cnt.crm}</span>
                    <div class="c-track" aria-hidden="true">{labels.cnt.chain.map((_, k) => <i class={`c-dot c-dot--${k}`}></i>)}</div>
                    <div aria-live="polite">{labels.cnt.chainText.map((t, k) => <p class={`c-ct c-ct--${k}`}>{t}</p>)}</div>
                  </div>
                </div>
              )}
            </div>
          </div>
        </div>
      </article>
    ))}

    {cta && (
      <div class="sd-cta">
        <div><h3>{cta.h3}</h3><p>{cta.body}</p></div>
        <a href={ctaHref} class="btn btn-lg sd-cta-btn">{cta.button}</a>
      </div>
    )}
  </div>
</div>

<script is:inline>
  // Clickable pictures (look 'campaign'). A button with data-mx-set="name" data-mx-val="v" sets
  // data-name="v" on its picture ([data-mx]) and marks itself pressed; data-mx-step="1" or "-1"
  // moves data-slide through data-mx-count slides; arrow keys do the same when the deck has focus.
  // data-mx-start sets the state shown first when JavaScript runs (without it the finished state shows).
  document.querySelectorAll('[data-mx]').forEach(function (root) {
    function set(name, val) {
      root.setAttribute('data-' + name, val);
      root.querySelectorAll('[data-mx-set="' + name + '"]').forEach(function (b) { b.setAttribute('aria-pressed', b.getAttribute('data-mx-val') === String(val) ? 'true' : 'false'); });
    }
    var start = root.getAttribute('data-mx-start');
    if (start) set('ba', start);
    root.addEventListener('click', function (e) {
      var b = e.target.closest('button'); if (!b || !root.contains(b)) return;
      if (b.hasAttribute('data-mx-set')) set(b.getAttribute('data-mx-set'), b.getAttribute('data-mx-val'));
      if (b.hasAttribute('data-mx-step')) {
        var n = +root.getAttribute('data-mx-count'), cur = +root.getAttribute('data-slide');
        set('slide', (cur + +b.getAttribute('data-mx-step') + n) % n);
      }
    });
    if (root.hasAttribute('data-mx-count')) root.addEventListener('keydown', function (e) {
      if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
      var n = +root.getAttribute('data-mx-count'), cur = +root.getAttribute('data-slide');
      set('slide', (cur + (e.key === 'ArrowRight' ? 1 : -1) + n) % n); e.preventDefault();
    });
  });
</script>

<style>
