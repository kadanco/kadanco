  .w-hl { display: block; width: 62%; height: 10px; border-radius: 3px; background: var(--kd-blue-1); box-shadow: 0 4px 0 -1px var(--kd-signal-1); margin-bottom: 4px; }

  /* concept: site map, wireframe with copy pins, keyword and question notes */
  .w-concept { display: grid; grid-template-columns: .8fr 1.4fr; grid-template-rows: auto auto; gap: 12px; align-items: start; }
  .w-tree { display: grid; justify-items: start; gap: 14px; padding: 12px 8px; border-radius: var(--kd-radius); border: 1px dashed var(--wf); }
  .w-node { display: block; padding: 3px 6px; border-radius: 3px; border: 1.5px solid var(--kd-blue-1); background: var(--kd-white); font-size: 10px; font-weight: var(--kd-weight-medium); white-space: nowrap; text-align: center; }
  .w-node--top { position: relative; background: var(--kd-blue-1); color: var(--kd-white); }
