  .p-node { flex: none; display: grid; place-items: center; width: 34px; height: 26px; border-radius: var(--kd-radius); border: 2px solid var(--kd-blue-1); font-weight: var(--kd-weight-medium); }
  .p-node--gone { border-style: dashed; border-color: var(--kd-lilac); color: var(--kd-lilac); text-decoration: line-through; }
  .p-node--goal { background: var(--kd-signal-1); border-color: var(--kd-signal-1); }
  .p-phones { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; }
