---
// src/components/HomeHero.astro
// The homepage hero: blue radial gradient (from the original site), eyebrow,
// H1, lead and two buttons; the main button is lime, as on the original. The text never changes here. An optional visual can sit on the
// right through the "visual" slot; without it the hero is a single column.
// Used by HomePage.astro and by the dev-only hero options page.
import { asLocale } from '../i18n/utils';

const locale = asLocale(Astro.currentLocale);

const copy = {
  en: {
    eyebrow: 'Execution as a Service',
    h1a: 'Stop Buying Management.',
    h1b: 'Start Buying Execution.',
    // a line break (\n) starts a new line in the intro
    lead: 'Kadanco is Execution as a Service: senior operators with decades of field experience who plan and run your product, marketing and sales. Nothing gets delegated to juniors. Up and running within two weeks.',
    cta: 'Get A Free Audit',
    offersLink: 'Book a Strategy Call',
  },
  de: {
    eyebrow: 'Execution as a Service',
    h1a: 'Schluss mit Beratung.',
    h1b: 'Kaufen Sie Umsetzung.',
    lead: 'Kadanco ist Execution as a Service: Macher mit jahrzehntelanger Praxiserfahrung, die Ihr Produkt, Ihr Marketing und Ihren Vertrieb planen und umsetzen. Nichts wird an Junioren delegiert. Innerhalb von zwei Wochen startklar.',
    cta: 'Kostenloses Audit anfordern',
    offersLink: 'Zu den Angeboten',
  },
};

const c = copy[locale] ?? copy.en;
const hasVisual = Astro.slots.has('visual');
---
<section class:list={['home-hero', { 'home-hero--split': hasVisual }]}>
  <div class="container home-hero-in">
    <div class="home-hero-copy">
      <span class="home-hero-eyebrow">{c.eyebrow}</span>
      <h1>{c.h1a} <em>{c.h1b}</em></h1>
      {/* hyphenated words (hand-offs) never break at the hyphen: non-breaking hyphen */}
      <p>{c.lead.split('\n').map((line, i) => <>{i > 0 && <br />}{line.replace(/(\w)-(\w)/g, '$1\u2011$2')}</>)}</p>
      <div class="home-hero-actions">
        <a href="#contact" class="btn btn-lime btn-lg" data-open-modal>{c.cta}</a>
        <a href="#contact" class="btn btn-ghost btn-lg" data-open-modal>{c.offersLink}</a>
      </div>
    </div>
    {hasVisual && <div class="home-hero-visual"><slot name="visual" /></div>}
  </div>
</section>

<style>
  /* blue radial gradient from the original site, clears the fixed 80px nav */
  .home-hero {
    background: radial-gradient(125% 120% at 50% -10%, var(--kd-legacy-hero-1) 0%, var(--kd-legacy-hero-2) 58%, var(--kd-legacy-hero-3) 100%);
    color: var(--kd-white);
  }
  .home-hero-in { padding-top: calc(80px + 64px); padding-bottom: 72px; }
  .home-hero-copy { display: flex; flex-direction: column; gap: 24px; align-items: flex-start; }
  .home-hero-eyebrow { font-size: var(--kd-text-xs); line-height: var(--kd-lh-xs); font-weight: var(--kd-weight-medium); letter-spacing: .04em; text-transform: uppercase; color: var(--kd-lilac); }
  .home-hero h1 { margin: 0; font-size: var(--kd-text-xl); line-height: var(--kd-lh-xl); font-weight: var(--kd-weight-medium); letter-spacing: .06px; text-wrap: balance; max-width: 900px; }
  .home-hero h1 em { font-style: normal; color: var(--kd-signal-1); }
  .home-hero p { margin: 0; font-size: clamp(19px, 2.4vw, 28px); line-height: 1.3; color: var(--kd-lilac-soft); max-width: 42ch; }
  .home-hero-actions { display: flex; gap: 14px; flex-wrap: wrap; margin-top: 4px; }

  /* with a visual: text and visual 50/50; stacks below 980px.
     Height follows the window but leaves about 150px below the hero, so the
     logo row underneath is visible without scrolling. */
  .home-hero--split { display: flex; align-items: center; min-height: clamp(600px, calc(100svh - 150px), 820px); }
  .home-hero--split .home-hero-in { width: 100%; padding-top: calc(80px + 48px); padding-bottom: 56px; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 48px; align-items: center; }
  /* both sentences run on as one headline */
  .home-hero--split h1 { font-size: clamp(34px, 3.6vw, 48px); }
  .home-hero--split p { font-size: clamp(18px, 1.7vw, 22px); line-height: 1.4; }
  .home-hero-visual { min-width: 0; }
  @media (max-width: 980px) {
    .home-hero--split { min-height: 0; }
    .home-hero--split .home-hero-in { grid-template-columns: minmax(0, 1fr); gap: 48px; padding-top: calc(80px + 56px); }
  }

  .home-hero :where(a):focus-visible { outline: 2px solid var(--kd-white); outline-offset: 2px; }
</style>
