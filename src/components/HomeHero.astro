---
// src/components/HomeHero.astro
// The homepage hero: navy ground with a faint grid, eyebrow, H1, lead and two
// buttons. The text never changes here. An optional visual can sit on the
// right through the "visual" slot; without it the hero is a single column.
// Used by HomePage.astro and by the dev-only hero options page.
import { asLocale } from '../i18n/utils';

const locale = asLocale(Astro.currentLocale);

const copy = {
  en: {
    eyebrow: 'Product · Marketing · Sales Engineering',
    h1a: 'Stop Buying Advice.',
    h1b: 'Start Buying Execution.',
    lead: 'Product, marketing and sales experience from one senior team. We own the plan and run it. No junior hand-offs.',
    cta: 'Get A Free Audit',
    offersLink: 'See The Offers',
  },
  de: {
    eyebrow: 'Product · Marketing · Sales Engineering',
    h1a: 'Schluss mit Beratung.',
    h1b: 'Kaufen Sie Umsetzung.',
    lead: 'Produkt-, Marketing- und Vertriebserfahrung aus einem erfahrenen Team. Wir verantworten den Plan und setzen ihn selbst um. Keine Übergabe an Junioren.',
    cta: 'Kostenloses Audit anfordern',
    offersLink: 'Zu den Angeboten',
  },
};

const c = copy[locale] ?? copy.en;
const hasVisual = Astro.slots.has('visual');
---
<section class:list={['home-hero', { 'home-hero--split': hasVisual }]}>
  <div class="container home-hero-in">
    <div class="home-hero-copy">
      <span class="home-hero-eyebrow">{c.eyebrow}</span>
      <h1>{c.h1a} <em>{c.h1b}</em></h1>
      <p>{c.lead}</p>
      <div class="home-hero-actions">
        <a href="#contact" class="btn btn-cta btn-lg" data-open-modal>{c.cta}</a>
        <a href="#offers" class="btn btn-ghost btn-lg">{c.offersLink}</a>
      </div>
    </div>
    {hasVisual && <div class="home-hero-visual"><slot name="visual" /></div>}
  </div>
</section>

<style>
  /* navy with a faint grid, clears the fixed 80px nav */
  .home-hero {
    background-color: var(--kd-blue-1);
    background-image: linear-gradient(rgba(255,255,255,.05) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.05) 1px, transparent 1px);
    background-size: 40px 40px;
    color: var(--kd-white);
  }
  .home-hero-in { padding-top: calc(80px + 64px); padding-bottom: 72px; }
  .home-hero-copy { display: flex; flex-direction: column; gap: 24px; align-items: flex-start; }
  .home-hero-eyebrow { font-size: var(--kd-text-xs); line-height: var(--kd-lh-xs); font-weight: var(--kd-weight-medium); letter-spacing: .04em; text-transform: uppercase; color: var(--kd-lilac); }
  .home-hero h1 { margin: 0; font-size: var(--kd-text-xl); line-height: var(--kd-lh-xl); font-weight: var(--kd-weight-medium); letter-spacing: .06px; text-wrap: balance; max-width: 900px; }
  .home-hero h1 em { font-style: normal; color: var(--kd-signal-1); }
  .home-hero p { margin: 0; font-size: clamp(19px, 2.4vw, 28px); line-height: 1.3; color: var(--kd-lilac-soft); max-width: 42ch; }
  .home-hero-actions { display: flex; gap: 14px; flex-wrap: wrap; margin-top: 4px; }

  /* with a visual: text left, visual right; stacks below 980px */
  .home-hero--split .home-hero-in { display: grid; grid-template-columns: minmax(0, 6fr) minmax(0, 5fr); gap: 56px; align-items: center; }
  /* each sentence on its own line, sized to fit the narrower column */
  .home-hero--split h1 { font-size: clamp(34px, 4vw, 52px); }
  .home-hero--split h1 em { display: block; }
  .home-hero--split p { font-size: clamp(19px, 1.9vw, 24px); }
  .home-hero-visual { min-width: 0; }
  @media (max-width: 980px) {
    .home-hero--split .home-hero-in { grid-template-columns: minmax(0, 1fr); gap: 48px; }
  }

  .home-hero :where(a):focus-visible { outline: 2px solid var(--kd-white); outline-offset: 2px; }
</style>
