---
// src/components/SelfCheck.astro
// Self-check for a use case page (idea from valubyl.com's activation
// diagnostic). Statements to tick; the result card beside them changes with
// every tick (simplified 2026-10-26, owner: no bars, no revenue and cost lines):
//   - a small app wireframe gets worse, one realistic flaw per statement
//     (1 users leave, 2 a "book a demo" pop-up, 3 help hints, 4 a feature
//     that looks different, 5 duplicate buttons, 6 inconsistent type and spacing),
//   - the heading moves on with the number ticked, six steps (levels 1 to 6; 0 = nothing ticked),
//   - one line below it: the risk of the statement ticked last (the hint when none is ticked).
// The section shell and heading come from UseCaseDetail.astro; this is the body.
// Without JavaScript the statements show and the result card stays hidden.
// kind 'site' (Website Production) swaps the app for a website in a browser, with its own
// six flaws: 1 a vague headline, 2 a dated look and stock photo, 3 a broken phone layout,
// 4 your result gone from search, 5 a change waiting for a developer, 6 a form that leaks leads.
// kind 'bingo' (Marketing, Positioning and Brand) shows a buzzword bingo card: every tick
// daubs one or two buzzwords, and all six ticked shout "Bingo".
// kind 'feed' (Marketing, Content Production) shows the founder's LinkedIn post with the blog,
// deck and CRM beside it: 1 the last post is weeks old, 2 likes and no meetings, 3 the post turns
// into marketing speak with a stock photo, 4 the blog goes stale, 5 the deck tells another story,
// 6 nobody knows which piece brought the deal.
interface Item { text: string; risk: string }
interface Props {
  items: Item[];
  levels: string[];   // headings for 0 to 6 ticked
  hint: string;       // the line under the heading when nothing is ticked
  kind?: 'app' | 'site' | 'bingo' | 'feed';
}
const { items, levels, hint, kind = 'app' } = Astro.props;
const bingo = {
  en: { title: 'Buzzword bingo', win: 'Bingo!', words: ['All-in-one', 'AI-powered', 'End-to-end', 'Innovative', 'Platform', 'Best-in-class', 'Next-gen', 'Scalable', 'Synergy'] },
  de: { title: 'Buzzword-Bingo', win: 'Bingo!', words: ['All-in-One', 'KI-gestützt', 'End-to-End', 'Innovativ', 'Plattform', 'Best-in-Class', 'Next-Gen', 'Skalierbar', 'Synergien'] },
}[Astro.currentLocale === 'de' ? 'de' : 'en'];
const feed = {
  en: { now: 'Today', ago: '5 weeks ago', meet: '✓ Meeting booked', nomeet: '✕ No meetings', jargon: ['Excited to announce', 'Synergy', 'Thought leadership'], blog: 'Blog', fresh: 'This week', stale: 'Months ago', deck: 'Sales deck', crm: 'CRM' },
  de: { now: 'Heute', ago: 'Vor 5 Wochen', meet: '✓ Termin gebucht', nomeet: '✕ Keine Termine', jargon: ['Wir freuen uns', 'Synergien', 'Thought Leadership'], blog: 'Blog', fresh: 'Diese Woche', stale: 'Vor Monaten', deck: 'Sales-Deck', crm: 'CRM' },
}[Astro.currentLocale === 'de' ? 'de' : 'en'];
---
<div class="sc" data-sc>
  <ul class="sc-list">
    {items.map((it, i) => (
      <li><label class="sc-item"><input type="checkbox" class="sc-box" data-i={i} /><span>{it.text}</span></label></li>
    ))}
  </ul>
  <div class="sc-result">
    {kind === 'feed' ? (
    <div class="sc-wf sc-feed" aria-hidden="true">
      <div class="sc-f-post">
        <div class="sc-f-top"><span class="sc-f-av"></span><div class="sc-f-id"><b></b><em></em></div><span class="sc-f-time"><span class="n">{feed.now}</span><span class="o">{feed.ago}</span></span></div>
        <div class="sc-f-body"><div class="sc-f-text"><em></em><em></em><em class="s"></em></div><div class="sc-f-jargon">{feed.jargon.map((j) => <span>{j}</span>)}</div></div>
        <div class="sc-f-img"><i class="hl"></i><i class="mtn"></i></div>
        <div class="sc-f-react"><i></i><i></i><i></i><span class="sc-f-meet"><span class="y">{feed.meet}</span><span class="x">{feed.nomeet}</span></span></div>
      </div>
      <div class="sc-f-side">
        <div class="sc-f-card sc-f-blog"><b>{feed.blog}</b><em></em><span class="sc-f-date"><span class="n">{feed.fresh}</span><span class="o">{feed.stale}</span></span></div>
        <div class="sc-f-card sc-f-deck"><b>{feed.deck}</b><em></em></div>
        <div class="sc-f-card sc-f-crm"><b>{feed.crm}</b><span class="sc-f-q">?</span><em></em></div>
      </div>
    </div>
    ) : kind === 'bingo' ? (
    <div class="sc-wf sc-bingo" aria-hidden="true">
      <div class="sc-bg-head"><b>{bingo.title}</b><span class="sc-bg-win">{bingo.win}</span></div>
      <div class="sc-bg-grid">{bingo.words.map((w, k) => <span class={`sc-bg-c sc-bg-c--${k}`}><i></i>{w}</span>)}</div>
    </div>
    ) : kind === 'site' ? (
    <div class="sc-wf sc-site" aria-hidden="true">
      <div class="sc-wf-bar"><i></i><i></i><i></i><span class="sc-s-url"></span></div>
      <div class="sc-wf-body sc-s-body">
        <div class="sc-s-nav"><span class="sc-s-logo"></span><em></em><em></em><u></u></div>
        <div class="sc-s-hero">
          <div class="sc-s-copy">
            <div class="sc-s-hl"><span class="sc-s-clear"><span class="sc-s-h"></span><span class="sc-s-h sc-s-h--b"></span></span><span class="sc-s-vague"><em></em><em></em><em></em></span></div>
            <u class="sc-s-cta"></u>
          </div>
          <div class="sc-s-img"><i class="sc-s-sun"></i><i class="sc-s-mtn"></i></div>
        </div>
        <div class="sc-s-low">
          <div class="sc-s-search"><b>⌕</b><span class="sc-s-you"></span><span></span><span></span></div>
          <div class="sc-s-form"><em></em><em></em><u></u><span class="sc-s-leak">?</span></div>
        </div>
        <div class="sc-s-phone"><span></span><span class="w"></span><span></span><span class="sc-s-bang">!</span></div>
        <span class="sc-s-ticket"><b>⧗</b><em></em></span>
      </div>
    </div>
    ) : (
    <div class="sc-wf" aria-hidden="true">
      <div class="sc-wf-bar"><i></i><i></i><i></i></div>
      <div class="sc-wf-body">
        <div class="sc-wf-steps"><b></b><s></s><b></b><s></s><b></b></div>
        <span class="sc-wf-h"></span><span class="sc-wf-l"></span><span class="sc-wf-l sc-wf-l--s"></span>
        <div class="sc-wf-cards"><span class="sc-wf-card"><i></i><i></i></span><span class="sc-wf-card sc-wf-card--b"><i></i><i></i></span></div>
        <div class="sc-wf-row">
          <span class="sc-wf-btn"></span><span class="sc-wf-btn sc-wf-btn--x1"></span><span class="sc-wf-btn sc-wf-btn--x2"></span>
          <span class="sc-wf-users"><em></em><em></em><em></em></span>
        </div>
        <span class="sc-wf-help sc-wf-help--1">?</span><span class="sc-wf-help sc-wf-help--2">?</span><span class="sc-wf-help sc-wf-help--3">!</span>
        <div class="sc-wf-pop"><span></span><span class="s"></span><u></u></div>
      </div>
    </div>
    )}

    <div class="sc-text" aria-live="polite">
      <div class="sc-stack">{levels.map((l, n) => <b class:list={['sc-h', { on: n === 0 }]} data-n={n}>{l}</b>)}</div>
      <div class="sc-stack"><p class="sc-risk on" data-risk="-1">{hint}</p>{items.map((it, i) => <p class="sc-risk" data-risk={i}>{it.risk}</p>)}</div>
    </div>
  </div>
</div>

<style>
  .sc { display: grid; grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr); gap: 28px; align-items: start; }
  @media (max-width: 880px) { .sc { grid-template-columns: minmax(0, 1fr); } }

  .sc-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
  .sc-item { display: flex; gap: 14px; align-items: flex-start; padding: 16px 18px; border-radius: var(--kd-radius); background: var(--kd-surface); border: 1px solid var(--kd-line); cursor: pointer; font-size: 17px; line-height: 1.45; transition: border-color .15s ease; }
  .sc-item:hover { border-color: var(--kd-blue-2); }
  .sc-item:has(.sc-box:checked) { border-color: var(--kd-blue-2); box-shadow: inset 4px 0 0 var(--kd-blue-2); }
  .sc-box { appearance: none; flex: none; width: 22px; height: 22px; margin: 1px 0 0; border: 2px solid var(--kd-blue-1); border-radius: var(--kd-radius); background: var(--kd-surface); display: grid; place-items: center; cursor: pointer; }
  .sc-box:checked { background: var(--kd-blue-2); border-color: var(--kd-blue-2); }
  .sc-box:checked::after { content: ''; width: 6px; height: 11px; margin-top: -2px; border: solid var(--kd-white); border-width: 0 2.5px 2.5px 0; transform: rotate(45deg); }
  .sc-box:focus-visible { outline: 2px solid var(--kd-blue-2); outline-offset: 2px; }

  /* result card: only with JavaScript, sticky beside the list on wide screens */
  .sc-result { display: none; position: sticky; top: 104px; padding: 24px; border-radius: var(--kd-radius); background: var(--kd-blue-1); color: var(--kd-white); }
  .sc.is-js .sc-result { display: block; }
  @media (max-width: 880px) { .sc-result { position: static; } }

  /* the wireframe: a tidy app at rest; each ticked statement (d1 to d6) adds a realistic flaw */
  .sc-wf { border-radius: var(--kd-radius); background: var(--kd-white); overflow: hidden; --wf: color-mix(in srgb, var(--kd-blue-1) 16%, transparent); }
  .sc-wf-bar { display: flex; gap: 5px; padding: 8px 10px; background: var(--kd-blue-2); }
  .sc-wf-bar i { width: 7px; height: 7px; border-radius: 50%; background: rgba(255, 255, 255, .5); }
  .sc-wf-body { position: relative; display: grid; gap: 8px; padding: 14px; }
  .sc-wf-body *, .sc-wf-body { transition: opacity .3s ease, background-color .3s ease, height .3s ease, width .3s ease, margin .3s ease, box-shadow .3s ease, color .3s ease, gap .3s ease; }
  .sc-wf-steps { display: flex; align-items: center; margin-bottom: 2px; }
  .sc-wf-steps b { width: 10px; height: 10px; border-radius: 50%; background: var(--kd-blue-2); }
  .sc-wf-steps s { flex: 1; height: 2px; background: var(--kd-blue-2); }
  .sc-wf-h { display: block; width: 58%; height: 12px; border-radius: 3px; background: var(--kd-blue-1); }
  .sc-wf-l { display: block; width: 88%; height: 6px; border-radius: 3px; background: var(--wf); }
  .sc-wf-l--s { width: 60%; }
  .sc-wf-cards { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; align-items: start; height: 56px; } /* fixed: the odd card can grow inside it */
  .sc-wf-card { display: grid; gap: 5px; align-content: start; height: 44px; padding: 8px; border-radius: 3px; background: var(--kd-lilac-tint); box-shadow: inset 0 0 0 1px var(--kd-lilac); }
  .sc-wf-card i { display: block; height: 5px; border-radius: 3px; background: var(--wf); }
  .sc-wf-card i:first-child { width: 60%; height: 7px; background: var(--kd-lilac); }
  .sc-wf-row { display: flex; align-items: center; gap: 6px; height: 22px; }
  .sc-wf-btn { height: 18px; width: 70px; border-radius: var(--kd-radius); background: var(--kd-blue-2); }
  .sc-wf-btn--x1, .sc-wf-btn--x2 { width: 0; opacity: 0; }
  .sc-wf-users { display: flex; margin-left: auto; }
  .sc-wf-users em { width: 16px; height: 16px; margin-left: -4px; border-radius: 50%; background: var(--kd-lilac); border: 2px solid var(--kd-white); }
  .sc-wf-help { position: absolute; width: 18px; height: 18px; border-radius: 50%; display: grid; place-items: center; background: var(--kd-signal-1); color: var(--kd-blue-1); font-size: 11px; font-weight: var(--kd-weight-medium); opacity: 0; }
  .sc-wf-help--1 { top: 34px; right: 16px; } .sc-wf-help--2 { top: 96px; left: 44%; } .sc-wf-help--3 { bottom: 12px; left: 90px; }
  .sc-wf-pop { position: absolute; top: 30px; right: 12px; width: 42%; display: grid; gap: 6px; padding: 10px; border-radius: var(--kd-radius); background: var(--kd-white); box-shadow: 0 8px 20px -6px rgba(10, 0, 60, .45), 0 0 0 1.5px var(--kd-blue-1); opacity: 0; }
  .sc-wf-pop span { display: block; height: 6px; border-radius: 3px; background: var(--kd-blue-1); }
  .sc-wf-pop span.s { width: 70%; background: var(--wf); }
  .sc-wf-pop u { display: block; width: 60%; height: 14px; border-radius: var(--kd-radius); background: var(--kd-blue-2); }
  /* 1: users leave, the onboarding progress stalls after the first step */
  .sc-wf.d1 .sc-wf-users em { opacity: .15; }
  .sc-wf.d1 .sc-wf-steps s, .sc-wf.d1 .sc-wf-steps b:not(:first-child) { background: var(--wf); }
  /* 2: a "book a demo" pop-up over the product */
  .sc-wf.d2 .sc-wf-pop { opacity: 1; }
  /* 3: help hints everywhere */
  .sc-wf.d3 .sc-wf-help { opacity: 1; }
  /* 4: one feature looks different: other colours, shadow instead of border, other height */
  .sc-wf.d4 .sc-wf-card--b { height: 56px; background: var(--kd-white); box-shadow: 0 6px 14px -6px rgba(10, 0, 60, .45); }
  .sc-wf.d4 .sc-wf-card--b i:first-child { background: var(--kd-signal-1); }
  /* 5: the same button rebuilt in other styles */
  .sc-wf.d5 .sc-wf-btn--x1 { width: 56px; opacity: 1; height: 22px; background: var(--kd-lilac); }
  .sc-wf.d5 .sc-wf-btn--x2 { width: 46px; opacity: 1; height: 14px; background: transparent; box-shadow: inset 0 0 0 2px var(--kd-blue-1); }
  /* 6: no shared system: headings, text and spacing stop matching */
  .sc-wf.d6 .sc-wf-h { width: 44%; background: var(--kd-blue-2); }
  .sc-wf.d6 .sc-wf-l { margin-left: 10px; }
  .sc-wf.d6 .sc-wf-l--s { margin-left: 0; width: 72%; }
  .sc-wf.d6 .sc-wf-cards { gap: 14px; }

  /* ---------- kind 'feed': the founder's post, with blog, deck and CRM beside it ---------- */
  .sc-feed { display: grid; grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr); gap: 10px; padding: 14px; background: var(--kd-beige-1); color: var(--kd-ink); }
  .sc-feed *, .sc-feed { transition: opacity .3s ease, background-color .3s ease, color .3s ease, transform .3s ease, border-color .3s ease; }
  .sc-feed em { display: block; height: 6px; border-radius: 3px; background: color-mix(in srgb, var(--kd-ink) 14%, transparent); }
  .sc-feed em.s { width: 60%; }
  .sc-f-post { display: grid; gap: 8px; align-content: start; padding: 12px; border-radius: var(--kd-radius); background: var(--kd-white); }
  .sc-f-top { display: flex; align-items: center; gap: 8px; }
  .sc-f-av { flex: none; width: 24px; height: 24px; border-radius: 50%; background: var(--kd-lilac); }
  .sc-f-id { flex: 1; display: grid; gap: 4px; }
  .sc-f-id b { display: block; width: 60%; height: 7px; border-radius: 3px; background: var(--kd-blue-1); }
  .sc-f-time, .sc-f-date { flex: none; font-size: 11px; font-weight: var(--kd-weight-medium); }
  /* two-state labels: both versions share one cell, so the width and height never change */
  .sc-f-time, .sc-f-date, .sc-f-meet { display: inline-grid; }
  :is(.sc-f-time, .sc-f-date, .sc-f-meet) > span { grid-area: 1 / 1; }
  .sc-f-time .o, .sc-f-date .o, .sc-f-meet .x { visibility: hidden; }
  .sc-f-body { display: grid; }
  .sc-f-body > * { grid-area: 1 / 1; }
  .sc-f-text { display: grid; gap: 5px; }
  .sc-f-jargon { display: flex; align-content: start; flex-wrap: wrap; gap: 4px; visibility: hidden; }
  .sc-f-jargon span { padding: 1px 6px; border-radius: var(--kd-radius); background: var(--kd-beige-2); font-size: 11px; }
  .sc-f-img { position: relative; height: 58px; border-radius: 3px; background: var(--kd-blue-1); overflow: hidden; }
  .sc-f-img .hl { position: absolute; left: 12px; top: 18px; width: 60%; height: 9px; border-radius: 3px; background: var(--kd-white); box-shadow: 0 4px 0 -1px var(--kd-signal-1); }
  .sc-f-img .mtn { position: absolute; left: 20%; bottom: 0; width: 60%; height: 70%; background: color-mix(in srgb, var(--kd-ink) 25%, var(--kd-white)); clip-path: polygon(0 100%, 50% 10%, 100% 100%); opacity: 0; }
  .sc-f-react { display: flex; align-items: center; gap: 4px; padding-top: 6px; border-top: 1px solid var(--kd-beige-3); }
  .sc-f-react i { width: 12px; height: 12px; border-radius: 50%; background: var(--kd-blue-2); }
  .sc-f-react i:nth-child(2) { background: var(--kd-signal-1); } .sc-f-react i:nth-child(3) { background: var(--kd-lilac); }
  .sc-f-meet { margin-left: auto; padding: 1px 7px; border-radius: var(--kd-radius); background: var(--kd-signal-1); color: var(--kd-blue-1); font-size: 11px; font-weight: var(--kd-weight-medium); }
  .sc-f-side { display: grid; gap: 8px; align-content: start; }
  .sc-f-card { position: relative; display: grid; gap: 6px; padding: 10px; border-radius: var(--kd-radius); background: var(--kd-white); }
  .sc-f-card b { font-size: 11px; font-weight: var(--kd-weight-medium); letter-spacing: .06em; text-transform: uppercase; }
  .sc-f-deck { background: var(--kd-blue-1); color: var(--kd-white); }
  .sc-f-deck em { background: var(--kd-signal-1); width: 70%; }
  .sc-f-q { position: absolute; top: 8px; right: 8px; width: 18px; height: 18px; border-radius: 50%; display: grid; place-items: center; background: var(--kd-signal-1); color: var(--kd-blue-1); font-size: 11px; font-weight: var(--kd-weight-medium); opacity: 0; }
  .sc-f-crm em { border-top: 2px solid var(--kd-blue-2); background: none; height: 0; }
  /* 1: the last post is weeks old */
  .sc-feed.d1 .sc-f-time .n { visibility: hidden; } .sc-feed.d1 .sc-f-time .o { visibility: visible; }
  .sc-feed.d1 .sc-f-post { opacity: .6; }
  /* 2: likes, no meetings */
  .sc-feed.d2 .sc-f-meet .y { visibility: hidden; } .sc-feed.d2 .sc-f-meet .x { visibility: visible; }
  .sc-feed.d2 .sc-f-meet { background: var(--kd-beige-2); color: var(--kd-ink-2); }
  /* 3: marketing speak and a stock photo */
  .sc-feed.d3 .sc-f-text { visibility: hidden; } .sc-feed.d3 .sc-f-jargon { visibility: visible; }
  .sc-feed.d3 .sc-f-img { background: var(--kd-beige-2); } .sc-feed.d3 .sc-f-img .hl { opacity: 0; } .sc-feed.d3 .sc-f-img .mtn { opacity: 1; }
  /* 4: the blog goes stale */
  .sc-feed.d4 .sc-f-blog { opacity: .5; outline: 1.5px dashed var(--kd-beige-3); outline-offset: -1.5px; }
  .sc-feed.d4 .sc-f-date .n { visibility: hidden; } .sc-feed.d4 .sc-f-date .o { visibility: visible; }
  /* 5: the deck tells another story */
  .sc-feed.d5 .sc-f-deck { background: var(--kd-lilac); color: var(--kd-ink); transform: rotate(-3deg); border-radius: 14px; }
  .sc-feed.d5 .sc-f-deck em { background: var(--kd-white); }
  /* 6: nobody knows which piece brought the deal */
  .sc-feed.d6 .sc-f-q { opacity: 1; }
  .sc-feed.d6 .sc-f-crm em { border-top-style: dashed; border-top-color: var(--kd-beige-3); }
  @media (prefers-reduced-motion: reduce) { .sc-feed *, .sc-feed { transition: none !important; } }

  /* ---------- kind 'bingo': a buzzword bingo card, taped to the result card ---------- */
  .sc-bingo { position: relative; padding: 16px; background: var(--kd-beige-1); color: var(--kd-ink); transform: rotate(-1deg); overflow: visible; }
  .sc-bingo::before { content: ''; position: absolute; left: 50%; top: -10px; width: 70px; height: 20px; margin-left: -35px; background: color-mix(in srgb, var(--kd-signal-1) 72%, transparent); transform: rotate(-3deg); }
  .sc-bg-head { display: flex; align-items: center; justify-content: space-between; gap: 10px; margin-bottom: 12px; }
  .sc-bg-head b { font-size: 13px; font-weight: var(--kd-weight-medium); letter-spacing: .08em; text-transform: uppercase; }
  .sc-bg-win { padding: 2px 10px; border-radius: var(--kd-radius); background: var(--kd-blue-1); color: var(--kd-signal-1); font-size: 15px; font-weight: var(--kd-weight-medium); transform: rotate(4deg) scale(.6); opacity: 0; transition: opacity .3s ease, transform .3s cubic-bezier(.3, 1.6, .5, 1); }
  .sc-bg-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); border: 2px solid var(--kd-ink); }
  .sc-bg-c { position: relative; display: grid; place-items: center; min-height: 58px; padding: 6px; border: 1px solid color-mix(in srgb, var(--kd-ink) 25%, transparent); font-size: 13px; line-height: 1.2; text-align: center; overflow-wrap: anywhere; }
  .sc-bg-c i { position: absolute; left: 50%; top: 50%; width: 46px; height: 46px; margin: -23px 0 0 -23px; border-radius: 50%; background: color-mix(in srgb, var(--kd-signal-1) 85%, transparent); transform: scale(0); transition: transform .3s cubic-bezier(.3, 1.6, .5, 1); }
  .sc-bg-c { isolation: isolate; } .sc-bg-c i { z-index: -1; }
  /* which buzzwords each statement daubs: 1 all-in-one and platform, 2 AI-powered, 3 end-to-end and innovative,
     4 best-in-class, 5 next-gen and scalable, 6 synergy; all six is a full card */
  .sc-bingo.d1 :is(.sc-bg-c--0, .sc-bg-c--4) i, .sc-bingo.d2 .sc-bg-c--1 i, .sc-bingo.d3 :is(.sc-bg-c--2, .sc-bg-c--3) i,
  .sc-bingo.d4 .sc-bg-c--5 i, .sc-bingo.d5 :is(.sc-bg-c--6, .sc-bg-c--7) i, .sc-bingo.d6 .sc-bg-c--8 i { transform: scale(1) rotate(-8deg); }
  .sc-bingo.d1.d2.d3.d4.d5.d6 .sc-bg-win { opacity: 1; transform: rotate(4deg) scale(1); }
  @media (prefers-reduced-motion: reduce) { .sc-bg-c i, .sc-bg-win { transition: none; } }

  /* ---------- kind 'site': a website in a browser, healthy at rest ---------- */
  .sc-wf-bar .sc-s-url { margin-left: 8px; width: 34%; height: 9px; border-radius: var(--kd-radius); background: rgba(255, 255, 255, .25); }
  .sc-s-body { gap: 10px; }
  .sc-s-nav { display: flex; align-items: center; gap: 8px; }
  .sc-s-logo { width: 34px; height: 9px; border-radius: 3px; background: var(--kd-blue-1); }
  .sc-s-nav em { width: 26px; height: 5px; }
  .sc-s-nav em:first-of-type { margin-left: auto; }
  .sc-s-nav u { display: block; width: 40px; height: 14px; border-radius: var(--kd-radius); background: var(--kd-blue-2); }
  .sc-s-hero { display: grid; grid-template-columns: 1.1fr 1fr; gap: 12px; align-items: center; }
  .sc-s-copy { display: grid; gap: 6px; }
  .sc-s-h { display: block; height: 10px; width: 92%; border-radius: 3px; background: var(--kd-blue-1); }
  .sc-s-h--b { width: 66%; background: var(--kd-blue-2); box-shadow: 0 3px 0 -1px var(--kd-signal-1); }
  .sc-s-hl { display: grid; }
  .sc-s-hl > * { grid-area: 1 / 1; display: grid; gap: 6px; align-content: start; }
  .sc-s-vague { gap: 4px; visibility: hidden; }
  .sc-s-vague em { display: block; height: 5px; border-radius: 3px; background: var(--wf); }
  .sc-s-vague em:nth-child(2) { width: 86%; } .sc-s-vague em:nth-child(3) { width: 70%; }
  .sc-s-cta { display: block; width: 64px; height: 16px; margin-top: 4px; border-radius: var(--kd-radius); background: var(--kd-blue-2); }
  .sc-s-img { position: relative; aspect-ratio: 4 / 3; border-radius: var(--kd-radius); background: var(--kd-blue-2); overflow: hidden; }
  .sc-s-sun { position: absolute; right: 18%; top: 18%; width: 26%; aspect-ratio: 1; border-radius: 50%; background: var(--kd-signal-1); }
  .sc-s-mtn { position: absolute; left: 10%; bottom: 0; width: 70%; height: 52%; background: var(--kd-lilac); clip-path: polygon(0 100%, 45% 10%, 100% 100%); opacity: 0; }
  .sc-s-low { display: grid; grid-template-columns: 1.2fr 1fr; gap: 10px; }
  .sc-s-search { display: grid; gap: 5px; align-content: start; padding: 8px; border-radius: var(--kd-radius); box-shadow: inset 0 0 0 1px var(--wf); }
  .sc-s-search b { font-size: 12px; line-height: 1; font-weight: var(--kd-weight-medium); }
  .sc-s-search span { display: block; height: 6px; border-radius: 3px; background: var(--wf); }
  .sc-s-search .sc-s-you { width: 80%; background: var(--kd-blue-2); box-shadow: -4px 0 0 var(--kd-signal-1); }
  .sc-s-form { position: relative; display: grid; gap: 5px; align-content: start; padding: 8px; border-radius: var(--kd-radius); background: var(--kd-lilac-tint); }
  .sc-s-form em { height: 10px; border-radius: 3px; background: var(--kd-white); }
  .sc-s-form u { display: block; width: 50%; height: 12px; border-radius: var(--kd-radius); background: var(--kd-blue-2); }
  .sc-s-leak { position: absolute; right: -6px; bottom: -6px; width: 18px; height: 18px; border-radius: 50%; display: grid; place-items: center; background: var(--kd-signal-1); color: var(--kd-blue-1); font-size: 11px; font-weight: var(--kd-weight-medium); opacity: 0; }
  .sc-s-phone { position: absolute; right: 22px; top: 34px; width: 54px; height: 92px; display: grid; gap: 5px; align-content: start; padding: 10px 6px; border-radius: 8px; border: 2px solid var(--kd-blue-1); background: var(--kd-white); opacity: 0; }
  .sc-s-phone span { display: block; height: 6px; border-radius: 3px; background: var(--kd-blue-1); }
  .sc-s-phone span.w { width: 150%; height: 18px; background: var(--kd-blue-2); }
  .sc-s-phone .sc-s-bang { position: absolute; top: -8px; left: -8px; width: 18px; height: 18px; border-radius: 50%; display: grid; place-items: center; background: var(--kd-signal-1); color: var(--kd-blue-1); font-size: 11px; font-weight: var(--kd-weight-medium); }
  .sc-s-ticket { position: absolute; top: 34px; left: 40%; display: flex; align-items: center; gap: 6px; width: 30%; padding: 6px 8px; border-radius: var(--kd-radius); background: var(--kd-white); box-shadow: 0 8px 20px -6px rgba(10, 0, 60, .45), 0 0 0 1.5px var(--kd-blue-1); opacity: 0; }
  .sc-s-ticket b { font-size: 12px; line-height: 1; }
  .sc-s-ticket em { flex: 1; height: 6px; border-radius: 3px; background: var(--wf); }
  /* 1: a vague headline: the clear two lines turn into grey filler */
  .sc-site.d1 .sc-s-clear { visibility: hidden; }
  .sc-site.d1 .sc-s-vague { visibility: visible; }
  /* 2: a dated look: off-brand colours and a stock photo */
  .sc-site.d2 .sc-s-img { background: color-mix(in srgb, var(--kd-blue-1) 12%, var(--kd-white)); }
  .sc-site.d2 .sc-s-sun { background: color-mix(in srgb, var(--kd-blue-1) 25%, var(--kd-white)); }
  .sc-site.d2 .sc-s-mtn { opacity: 1; background: color-mix(in srgb, var(--kd-blue-1) 30%, var(--kd-white)); }
  .sc-site.d2 :is(.sc-s-cta, .sc-s-nav u, .sc-s-form u) { background: var(--kd-lilac); border-radius: 10px; }
  .sc-site.d2 .sc-s-h--b { box-shadow: none; }
  /* 3: the phone view breaks: content runs off the screen */
  .sc-site.d3 .sc-s-phone { opacity: 1; }
  /* 4: your result is gone from search */
  .sc-site.d4 .sc-s-search .sc-s-you { width: 30%; background: var(--wf); box-shadow: none; }
  /* 5: a change waits for a developer */
  .sc-site.d5 .sc-s-ticket { opacity: 1; }
  /* 6: leads leak from the form */
  .sc-site.d6 .sc-s-leak { opacity: 1; }
  .sc-site.d6 .sc-s-form { background: var(--kd-white); outline: 1.5px dashed var(--kd-blue-2); outline-offset: -1.5px; }

  /* under the picture: the heading for the number ticked, and the risk of the latest tick */
  .sc-text { display: grid; gap: 8px; margin-top: 20px; }
  .sc-h { display: block; font-size: var(--kd-text-m); line-height: var(--kd-lh-m); font-weight: var(--kd-weight-medium); }
  /* all headings share one cell and all risk lines another, so the card always has the height of the
     longest text and nothing moves when a box is ticked (owner, 2026-10-26) */
  .sc-stack { display: grid; }
  .sc-stack > * { grid-area: 1 / 1; visibility: hidden; }
  .sc-stack > .on { visibility: visible; }
  .sc-stack > .sc-h { align-self: end; } /* a short heading sits right on top of its risk line */
  .sc .sc-risk { margin: 0; font-size: 17px; line-height: 1.5; color: var(--kd-lilac-soft); }
  @media (prefers-reduced-motion: reduce) { .sc-wf-body *, .sc-wf-body { transition: none !important; } }
</style>

<script is:inline>
  // Each tick: the picture gains that statement's flaw, the heading moves on to the
  // number ticked, and the line below shows the risk of the statement ticked last.
  document.querySelectorAll('[data-sc]').forEach(function (root) {
    root.classList.add('is-js');
    var boxes = Array.prototype.slice.call(root.querySelectorAll('.sc-box'));
    var wf = root.querySelector('.sc-wf');
    var heads = root.querySelectorAll('.sc-h');
    var risks = root.querySelectorAll('.sc-risk');
    var order = []; // tick order, newest last
    function update(changed) {
      if (changed) {
        var k = +changed.getAttribute('data-i');
        order = order.filter(function (x) { return x !== k; });
        if (changed.checked) order.push(k);
      }
      var n = 0;
      boxes.forEach(function (b, i) {
        if (b.checked) n++;
        if (wf && i < 6) wf.classList.toggle('d' + (i + 1), b.checked);
      });
      heads.forEach(function (h) { h.classList.toggle('on', +h.getAttribute('data-n') === Math.min(n, heads.length - 1)); });
      var latest = order.length ? order[order.length - 1] : -1;
      risks.forEach(function (r) { r.classList.toggle('on', +r.getAttribute('data-risk') === latest); });
    }
    boxes.forEach(function (b) { b.addEventListener('change', function () { update(b); }); });
    update(null);
  });
</script>
