---
// src/components/Footer.astro
// Shared site footer, rendered once by Layout.astro.
//
// Structure follows the hubsell footer: a brand block beside a grid of link
// columns, then a legal row, then the company meta line. Colours and fonts are
// unchanged; everything below uses the existing tokens (--muted, --indigo,
// --border, --ink) and the site's eyebrow treatment for column headings.
//
// The link columns matter on mobile: the nav dropdowns are hidden below 880px,
// so this is the only route to the use-case and glossary pages on a phone.
const year = new Date().getFullYear();

const useCases = [
  { label: 'DACH market entry', href: '/use-cases/dach-market-entry/' },
  { label: 'Founder-led content', href: '/use-cases/founder-led-content/' },
  { label: 'Conversion rebuild', href: '/use-cases/conversion-rebuild/' },
  { label: 'Event pipeline', href: '/use-cases/event-pipeline/' },
];
---
<footer class="footer" data-theme="light">
  <div class="container">

    <div class="foot-top">
      <div class="foot-brand-block">
        <a class="brand" href="/" aria-label="Kadanco, home">
          <img class="brand-logo" src="https://assets.kadanco.com/logo/wordmark-dark.svg" alt="Kadanco" />
        </a>
        <p class="foot-tag">An embedded marketing team for B2B companies. We own the plan and run it ourselves.</p>
      </div>

      <nav class="foot-cols" aria-label="Footer">
        <div class="foot-col">
          <p class="foot-colhead">Use cases</p>
          <ul>
            {useCases.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
            <li><a class="is-all" href="/#use-cases">All use cases</a></li>
          </ul>
        </div>

        <div class="foot-col">
          <p class="foot-colhead">Company</p>
          <ul>
            <li><a href="/#services">Services</a></li>
            <li><a href="/#founders">Who we are</a></li>
            <li><a href="/#faq">FAQ</a></li>
          </ul>
        </div>

        <div class="foot-col">
          <p class="foot-colhead">Resources</p>
          <ul>
            <li><a href="/glossary/">Glossary</a></li>
          </ul>
        </div>

        <div class="foot-col">
          <p class="foot-colhead">Contact</p>
          <ul>
            <li><a href="mailto:hello@kadanco.com">hello@kadanco.com</a></li>
            <li><a href="https://www.linkedin.com/company/kadanco/" aria-label="Kadanco on LinkedIn">LinkedIn</a></li>
          </ul>
        </div>
      </nav>
    </div>

    <nav class="foot-legal" aria-label="Legal">
      <a href="/imprint/">Imprint &amp; Privacy</a>
    </nav>

    <div class="foot-bottom">
      <p class="foot-meta">&copy; {year} Kadanco UG (haftungsbeschr&auml;nkt) &middot; Prenzlauer Allee 186, 10405 Berlin, Germany &middot; HRB 206268 B</p>
    </div>

  </div>
</footer>

<style>
  /* a little more room than the old single-row footer needed */
  .footer { padding: 56px 0 34px; }

  .foot-top {
    display: grid;
    grid-template-columns: minmax(220px, 1.1fr) 3fr;
    gap: 40px clamp(24px, 4vw, 56px);
  }
  .foot-tag {
    margin-top: 14px;
    max-width: 34ch;
    font-size: 0.92rem;
    line-height: 1.5;
    color: var(--muted);
  }

  .foot-cols {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 30px 24px;
  }
  .foot-colhead {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--indigo);
  }
  .foot-col ul {
    list-style: none;
    margin: 14px 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 11px;
  }
  .foot-col a {
    color: var(--muted);
    text-decoration: none;
    font-size: 0.92rem;
  }
  .foot-col a:hover { color: var(--indigo); }
  .foot-col a.is-all { color: var(--ink); font-weight: 500; }
  .foot-col a.is-all:hover { color: var(--indigo); }

  .foot-legal {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 22px;
    margin-top: 40px;
    padding-top: 22px;
    border-top: 1px solid var(--border);
  }
  .foot-legal a {
    color: var(--muted);
    text-decoration: none;
    font-size: 0.92rem;
  }
  .foot-legal a:hover { color: var(--indigo); }

  .foot-bottom {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 28px;
    align-items: center;
    justify-content: space-between;
    margin-top: 14px;
  }
  .foot-meta {
    font-size: 0.82rem;
    line-height: 1.5;
    color: var(--muted);
  }

  @media (max-width: 820px) {
    .foot-top { grid-template-columns: 1fr; gap: 34px; }
  }
</style>
