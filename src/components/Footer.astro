---
// src/components/Footer.astro
// Shared site footer, rendered once by Layout.astro.
//
// Structure follows the hubsell footer: a brand block beside a grid of link
// columns, then a legal row, then the company meta line. Ink ground, beige
// text and lilac column heads, per the October 2026 design.
//
// The link columns matter on mobile: the nav dropdowns are hidden below 880px,
// so this is the only route to the use-case and glossary pages on a phone.
import { asLocale, useTranslations, localizedHref } from '../i18n/utils';

const locale = asLocale(Astro.currentLocale);
const t = useTranslations(locale);
const year = new Date().getFullYear();

const useCases = [
  { key: 'uc.dach', href: '/use-cases/dach-market-entry/' },
  { key: 'uc.founder', href: '/use-cases/founder-led-content/' },
  { key: 'uc.conversion', href: '/use-cases/conversion-rebuild/' },
  { key: 'uc.events', href: '/use-cases/event-pipeline/' },
];
---
<footer class="footer">
  <div class="container">

    <div class="foot-top">
      <div class="foot-brand-block">
        <a class="brand" href={localizedHref(locale, '/')} aria-label={t('nav.home')}>
          <img class="brand-logo" src="https://assets.kadanco.com/logo/wordmark-light.svg" alt="Kadanco" />
        </a>
        <p class="foot-tag">{t('footer.tagline')}</p>
      </div>

      <nav class="foot-cols" aria-label="Footer">
        <div class="foot-col">
          <p class="foot-colhead">{t('footer.head.usecases')}</p>
          <ul>
            {useCases.map((l) => <li><a href={localizedHref(locale, l.href)}>{t(l.key)}</a></li>)}
            <li><a class="is-all" href={localizedHref(locale, '/use-cases/')}>{t('nav.allusecases')}</a></li>
          </ul>
        </div>

        <div class="foot-col">
          <p class="foot-colhead">{t('footer.head.company')}</p>
          <ul>
            <li><a href={localizedHref(locale, '/#product')}>{t('nav.product')}</a></li>
            <li><a href={localizedHref(locale, '/#marketing')}>{t('nav.marketing')}</a></li>
            <li><a href={localizedHref(locale, '/#sales')}>{t('nav.sales')}</a></li>
            <li><a href={localizedHref(locale, '/#about')}>{t('nav.about')}</a></li>
          </ul>
        </div>

        <div class="foot-col">
          <p class="foot-colhead">{t('footer.head.resources')}</p>
          <ul>
            <li><a href="/glossary/">{t('nav.glossary')}</a></li>
          </ul>
        </div>

        <div class="foot-col">
          <p class="foot-colhead">{t('footer.head.contact')}</p>
          <ul>
            <li><a href="mailto:hello@kadanco.com">hello@kadanco.com</a></li>
            <li><a href="https://www.linkedin.com/company/kadanco/" aria-label={t('footer.linkedin')}>LinkedIn</a></li>
          </ul>
        </div>
      </nav>
    </div>

    <nav class="foot-legal" aria-label="Legal">
      <a href={localizedHref(locale, '/imprint/')}>{t('footer.imprint')}</a>
      <a href={localizedHref(locale, '/privacy-policy/')}>{t('footer.privacy')}</a>
    </nav>

    <div class="foot-bottom">
      <p class="foot-meta">&copy; {year} Kadanco UG (haftungsbeschr&auml;nkt) &middot; Prenzlauer Allee 186, 10405 Berlin, Germany &middot; HRB 206268 B</p>
    </div>

  </div>
</footer>

<style>
  /* a little more room than the old single-row footer needed */
  .footer { padding: 56px 0 34px; }

  .foot-top {
    display: grid;
    grid-template-columns: minmax(220px, 1.1fr) 3fr;
    gap: 40px clamp(24px, 4vw, 56px);
  }
  .foot-tag {
    margin-top: 14px;
    max-width: 34ch;
    font-size: 0.92rem;
    line-height: 1.5;
    color: var(--kd-beige-3);
  }

  .foot-cols {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 30px 24px;
  }
  .foot-colhead {
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--kd-lilac);
  }
  .foot-col ul {
    list-style: none;
    margin: 14px 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 11px;
  }
  .foot-col a {
    color: var(--kd-beige-1);
    text-decoration: none;
    font-size: 0.92rem;
  }
  .foot-col a:hover { color: var(--kd-signal-1); }
  .foot-col a.is-all { font-weight: var(--kd-weight-medium); color: var(--kd-white); }

  .foot-legal {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 22px;
    margin-top: 40px;
    padding-top: 22px;
    border-top: 1px solid rgba(255, 255, 255, 0.14);
  }
  .foot-legal a {
    color: var(--kd-beige-1);
    text-decoration: none;
    font-size: 0.92rem;
  }
  .foot-legal a:hover { color: var(--kd-signal-1); }

  .foot-bottom {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 28px;
    align-items: center;
    justify-content: space-between;
    margin-top: 14px;
  }
  .foot-meta {
    font-size: 0.82rem;
    line-height: 1.5;
    color: var(--kd-beige-3);
  }

  @media (max-width: 820px) {
    .foot-top { grid-template-columns: 1fr; gap: 34px; }
  }
</style>
