---
// src/components/Footer.astro
// Shared site footer, rendered once by Layout.astro.
//
// Structure follows the hubsell footer: a brand block beside a grid of link
// columns, then a legal row, then the company meta line. Ink ground, beige
// text and lilac column heads, per the October 2026 design.
//
// Columns: Services, Use Cases and Resources (the same groups as the nav,
// from src/data/menus.ts), then Company with About and contact details.
// The columns sit in two rows: Services and Use Cases (its list in two
// columns) on top, Resources and Company below. The claim sits under the logo.
import { asLocale, useTranslations, localizedHref } from '../i18n/utils';
import { siteMenus } from '../data/menus';

const locale = asLocale(Astro.currentLocale);
const t = useTranslations(locale);
const year = new Date().getFullYear();

const menus = siteMenus(locale, t);
---
<footer class="footer">
  <div class="container">

    <div class="foot-top">
      <div class="foot-brand-block">
        <a class="brand" href={localizedHref(locale, '/')} aria-label={t('nav.home')}>
          <img class="brand-logo" src="https://assets.kadanco.com/logo/wordmark-light.svg" alt="Kadanco" />
        </a>
        <p class="foot-claim">{t('footer.claim')}</p>
        <p class="foot-tag">{t('footer.tagline')}</p>
      </div>

      <nav class="foot-cols" aria-label="Footer">
        {menus.map((m) => (
          <div class:list={['foot-col', { 'foot-col--wide': m.key === 'nav.usecases' }]}>
            <p class="foot-colhead">{t(m.key)}</p>
            <ul>
              {m.items.map((it) => <li><a class:list={{ 'is-all': it.all }} href={localizedHref(locale, it.href)}>{it.label}</a></li>)}
            </ul>
          </div>
        ))}

        <div class="foot-col">
          <p class="foot-colhead">{t('footer.head.company')}</p>
          <ul>
            <li><a href={localizedHref(locale, '/#about')}>{t('nav.about')}</a></li>
            <li><a href="mailto:hello@kadanco.com">hello@kadanco.com</a></li>
            <li><a href="https://www.linkedin.com/company/kadanco/" aria-label={t('footer.linkedin')}>LinkedIn</a></li>
          </ul>
        </div>
      </nav>
    </div>

    <nav class="foot-legal" aria-label="Legal">
      <a href={localizedHref(locale, '/imprint/')}>{t('footer.imprint')}</a>
      <a href={localizedHref(locale, '/privacy-policy/')}>{t('footer.privacy')}</a>
    </nav>

    <div class="foot-bottom">
      <p class="foot-meta">&copy; {year} Kadanco UG (haftungsbeschr&auml;nkt) &middot; Prenzlauer Allee 186, 10405 Berlin, Germany &middot; HRB 206268 B</p>
    </div>

  </div>
</footer>

<style>
  /* a little more room than the old single-row footer needed */
  .footer { padding: 56px 0 34px; }

  .foot-top {
    display: grid;
    grid-template-columns: minmax(220px, 1.1fr) 3fr;
    gap: 40px clamp(24px, 4vw, 56px);
  }
  .foot-claim {
    margin-top: 14px;
    font-size: 1.05rem;
    font-weight: var(--kd-weight-medium);
    color: var(--kd-signal-1);
  }
  .foot-tag {
    margin-top: 8px;
    max-width: 34ch;
    font-size: 0.92rem;
    line-height: 1.5;
    color: var(--kd-beige-3);
  }

  /* two rows on three tracks: Services | Use Cases (two tracks wide), then Resources | Company */
  .foot-cols {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 40px 24px;
  }
  .foot-col--wide { grid-column: span 2; }
  /* fills top to bottom, then the second column */
  .foot-col.foot-col--wide ul { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); grid-template-rows: repeat(5, auto); grid-auto-flow: column; gap: 11px 24px; }
  .foot-colhead {
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--kd-lilac);
  }
  .foot-col ul {
    list-style: none;
    margin: 14px 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 11px;
  }
  .foot-col a {
    color: var(--kd-beige-1);
    text-decoration: none;
    font-size: 0.92rem;
  }
  .foot-col a:hover { color: var(--kd-signal-1); }
  .foot-col a.is-all { font-weight: var(--kd-weight-medium); color: var(--kd-white); }

  .foot-legal {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 22px;
    margin-top: 40px;
    padding-top: 22px;
    border-top: 1px solid rgba(255, 255, 255, 0.14);
  }
  .foot-legal a {
    color: var(--kd-beige-1);
    text-decoration: none;
    font-size: 0.92rem;
  }
  .foot-legal a:hover { color: var(--kd-signal-1); }

  .foot-bottom {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 28px;
    align-items: center;
    justify-content: space-between;
    margin-top: 14px;
  }
  .foot-meta {
    font-size: 0.82rem;
    line-height: 1.5;
    color: var(--kd-beige-3);
  }

  @media (max-width: 880px) {
    .foot-top { grid-template-columns: 1fr; gap: 34px; }
  }
  @media (max-width: 560px) {
    .foot-cols { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .foot-col.foot-col--wide ul { grid-template-columns: 1fr; grid-template-rows: none; grid-auto-flow: row; }
  }
</style>
