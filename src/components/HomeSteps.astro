---
// src/components/HomeSteps.astro
// "How We Work": the live "How We Operate" section with its original look
// (deep band, CadenceTimeline on the left, text on the right) and new text,
// rewritten for product, marketing and sales and cleaned of the masterplan
// D29 words. The original "and it compounds" line under step 03 is gone.
import CadenceTimeline from './CadenceTimeline.astro';
import { asLocale } from '../i18n/utils';

const locale = asLocale(Astro.currentLocale);
const copy = {
  en: {
    eyebrow: 'How We Work',
    h2a: "We Don't Advise The Work.",
    h2b: 'We Own It And Do It.',
    lead: 'The people who scope your work are the people who do it, across product, marketing and sales. We own the outcome and keep everything pointed at revenue. Four clients at a time, so every account gets senior people.',
    steps: [
      { n: '01', title: 'Map', body: 'We learn your product, your buyers, your funnel and your numbers. Then we agree on the few moves that change the most.' },
      { n: '02', title: 'Build', body: 'We do the work ourselves: the product experience, the site, the content, the campaigns and the sales process. No briefs handed to someone else.' },
      { n: '03', title: 'Ship', amp: '& improve', body: 'The first work goes live within two weeks. Then we keep shipping, and every month builds on the last.' },
    ],
  },
  de: {
    eyebrow: 'Wie wir arbeiten',
    h2a: 'Wir beraten die Arbeit nicht.',
    h2b: 'Wir verantworten und machen sie.',
    lead: 'Die Personen, die Ihre Arbeit definieren, sind dieselben, die sie machen, über Produkt, Marketing und Vertrieb hinweg. Wir verantworten das Ergebnis und richten alles auf Umsatz aus. Vier Kunden gleichzeitig, damit jeder Account erfahrene Leute bekommt.',
    steps: [
      { n: '01', title: 'Verstehen', body: 'Wir lernen Ihr Produkt, Ihre Käufer, Ihren Funnel und Ihre Zahlen kennen. Dann einigen wir uns auf die wenigen Hebel, die am meisten bewegen.' },
      { n: '02', title: 'Aufbauen', body: 'Wir machen die Arbeit selbst: Produkterlebnis, Website, Content, Kampagnen und Vertriebsprozess. Keine Briefings, die an andere weitergereicht werden.' },
      { n: '03', title: 'Liefern', amp: '& verbessern', body: 'Die erste Arbeit ist innerhalb von zwei Wochen live. Danach liefern wir weiter, und jeder Monat baut auf dem letzten auf.' },
    ],
  },
}[locale];
---

<!-- original look: same markup and classes as the live How We Operate section -->
<section class="section band-deep" id="how-we-work" data-theme="dark">
  <div class="container">
    <div class="split">
      <CadenceTimeline steps={copy.steps} />
      <div class="content">
        <span class="eyebrow">{copy.eyebrow}</span>
        <h2>{copy.h2a} <span class="hl">{copy.h2b}</span></h2>
        <p class="lead" style="margin-top:20px">{copy.lead}</p>
      </div>
    </div>
  </div>
</section>
