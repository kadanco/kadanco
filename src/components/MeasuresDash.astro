---
// src/components/MeasuresDash.astro
// "What we measure" as a wireframe analytics app, in the same style as the
// hero slider and the self-check (white app window, navy outline, wireframe
// lines, department colours). Each measure gets its own kind of picture so
// the tiles do not repeat:
//   funnel    activation rate: stages from signup to paid, before and after bars
//   path      time to first result: a long path that becomes a short one
//   columns   trial to paid: monthly columns that rise after the start line
//   inbox     support tickets: a busy inbox next to a quiet one
//   build     time to ship a screen: library parts that come together into a screen
// Website Production (2026-10-26) adds:
//   speed     load time: a slow page that is still loading next to a fast, complete one
//   rank      search rankings: your result moves from far down the list to the top
//   answers   mentions in AI answers: an AI answer that names and links your site
// Tiles are placed by order (first wide, then four), whatever their picture.
// Sales (2026-10-26): look 'sales' adds a lilac dashboard frame and an example figure per tile
// (kpi), with an "Example data" tag in the bar (owner: example figures allowed when labelled);
//   threads   contacts per deal: one contact before, a whole buying group after
// No figures: the pictures show direction only, and a note says they are examples.
// Each tile can explain itself: hover, keyboard focus or a tap opens a panel with
// what changes and why (the cause: what we do). A small script toggles it on tap,
// so touch screens without hover work too.
// The parts grow in when the window scrolls into view (the inline script in
// UseCaseDetail.astro adds .is-in to [data-dash]); reduced motion shows the end state.
type Viz = 'funnel' | 'path' | 'columns' | 'inbox' | 'build' | 'speed' | 'rank' | 'answers' | 'threads';
interface Item { title: string; body: string; dir?: 'up' | 'down'; viz?: Viz; kpi?: string; change?: string; cause?: string }
interface Props { items: Item[]; labels: { app: string; before: string; after: string; goalUp: string; goalDown: string; note: string; change: string; cause: string; hint: string; you?: string; ai?: string; example?: string }; look?: 'product' | 'sales' }
const { items, labels, look = 'product' } = Astro.props;
const ORDER: Viz[] = ['funnel', 'path', 'columns', 'inbox', 'build'];
const tiles = items.map((it, i) => ({ ...it, viz: it.viz ?? ORDER[i % ORDER.length] }));
const cols = [3, 4, 3, 5, 6, 7, 8, 9]; // column heights (of 10), the last five after the start line
---
<div class:list={['md', `md--${look}`]} data-dash>
  <div class="md-bar"><i></i><i></i><i></i><span>{labels.app}</span>{look === 'sales' && labels.example && <b class="md-ex">{labels.example}</b>}</div>
  <div class="md-body">
    <div class="md-side" aria-hidden="true"><b></b><em class="on"></em><em></em><em></em><em></em><em></em></div>
    <div class="md-grid">
      {tiles.map((t, n) => (
        <section class:list={['md-tile', `md-tile--${t.viz}`, `md-pos--${n + 1}`, { 'md-tile--why': t.change }]} tabindex={t.change ? 0 : undefined}>
          <header class="md-head">
            <h3>{t.title}</h3>
            {t.dir && <span class="md-goal">{t.dir === 'up' ? `↑ ${labels.goalUp}` : `↓ ${labels.goalDown}`}</span>}
          </header>
          {t.kpi && <b class="md-kpi">{t.kpi}</b>}

          <div class="md-viz" aria-hidden="true">
            {t.viz === 'funnel' && (
              <div class="v-funnel">
                {[[100, 100], [62, 82], [34, 66], [18, 44]].map(([b, a]) => (
                  <div class="v-stage"><em></em><div class="v-pair"><span class="v-b" style={`--w:${b}%`}></span><span class="v-a" style={`--w:${a}%`}></span></div></div>
                ))}
                <div class="v-key"><span class="v-key-b">{labels.before}</span><span class="v-key-a">{labels.after}</span></div>
              </div>
            )}
            {t.viz === 'path' && (
              <div class="v-path">
                <div class="v-track v-track--b"><span class="v-lbl">{labels.before}</span><div class="v-line"><i></i><i></i><i></i><i></i><i></i><i></i><b>!</b></div></div>
                <div class="v-track v-track--a"><span class="v-lbl">{labels.after}</span><div class="v-line"><i></i><i></i><b>✓</b></div></div>
              </div>
            )}
            {t.viz === 'columns' && (
              <div class="v-cols">
                {cols.map((h, i) => <span class={i >= 3 ? 'a' : ''} style={`--h:${h * 10}%;--d:${i * 60}ms`}></span>)}
                <i class="v-start"></i>
              </div>
            )}
            {t.viz === 'inbox' && (
              <div class="v-inbox">
                <div class="v-list"><span class="v-lbl">{labels.before}</span>{Array.from({ length: 5 }).map(() => <div class="v-row"><b>?</b><em></em></div>)}</div>
                <div class="v-list v-list--a"><span class="v-lbl">{labels.after}</span>{Array.from({ length: 2 }).map(() => <div class="v-row"><b>?</b><em></em></div>)}<div class="v-empty">✓</div></div>
              </div>
            )}
            {t.viz === 'build' && (
              <div class="v-build">
                <div class="v-lib"><u class="p1"></u><u class="p2"></u><u class="p3"></u><u class="p4"></u><u class="p5"></u><u class="p6"></u></div>
                <span class="v-arrow"></span>
                <div class="v-screen"><u class="p1"></u><u class="p4"></u><u class="p5"></u><u class="p6"></u><u class="p2"></u></div>
              </div>
            )}

            {t.viz === 'threads' && (
              <div class="v-threads">
                <div class="v-th"><span class="v-lbl">{labels.before}</span><svg viewBox="0 0 100 60"><line x1="20" y1="30" x2="80" y2="30" /><circle cx="20" cy="30" r="8" class="p" /><rect x="70" y="20" width="20" height="20" rx="3" class="d" /></svg></div>
                <div class="v-th v-th--a"><span class="v-lbl">{labels.after}</span><svg viewBox="0 0 100 60"><line x1="18" y1="12" x2="80" y2="30" /><line x1="14" y1="30" x2="80" y2="30" /><line x1="18" y1="48" x2="80" y2="30" /><line x1="40" y1="8" x2="80" y2="30" /><line x1="40" y1="52" x2="80" y2="30" /><circle cx="18" cy="12" r="6" class="p" /><circle cx="14" cy="30" r="6" class="p" /><circle cx="18" cy="48" r="6" class="p" /><circle cx="40" cy="8" r="6" class="p2" /><circle cx="40" cy="52" r="6" class="p2" /><rect x="70" y="20" width="20" height="20" rx="3" class="d" /></svg></div>
              </div>
            )}
            {t.viz === 'speed' && (
              <div class="v-speed">
                <div class="v-pg v-pg--b"><span class="v-lbl">{labels.before}</span><div class="v-win"><span class="v-load"><i></i></span><em></em><em class="s"></em><span class="v-blank"></span></div></div>
                <div class="v-pg v-pg--a"><span class="v-lbl">{labels.after}</span><div class="v-win"><span class="v-load v-load--done"><i></i></span><em class="h"></em><em class="s"></em><span class="v-pic"></span></div></div>
              </div>
            )}
            {t.viz === 'rank' && (
              <div class="v-rank">
                <div class="v-rlist"><span class="v-lbl">{labels.before}</span>{[1, 2, 3, 4, 5].map((k) => <div class:list={['v-rrow', { you: k === 5 }]}><b>{k}</b><em></em></div>)}</div>
                <div class="v-rlist v-rlist--a"><span class="v-lbl">{labels.after}</span>{[1, 2, 3, 4, 5].map((k) => <div class:list={['v-rrow', { you: k === 1 }]}><b>{k}</b><em></em></div>)}</div>
              </div>
            )}
            {t.viz === 'answers' && (
              <div class="v-ans">
                <span class="v-ask"><em></em><em class="s"></em></span>
                <div class="v-reply"><span class="v-ai">✦ {labels.ai ?? 'AI'}</span><em></em><em class="s"></em><span class="v-cite">↗ {labels.you ?? ''}</span></div>
              </div>
            )}
          </div>

          <p>{t.body}</p>

          {t.change && (
            <div class="md-why">
              <h4>{t.title}</h4>
              <span class="md-why-l">{labels.change}</span><p>{t.change}</p>
              <span class="md-why-l md-why-l--cause">{labels.cause}</span><p>{t.cause}</p>
            </div>
          )}
        </section>
      ))}
    </div>
  </div>
  <p class="md-note">{labels.note} {tiles.some((t) => t.change) && labels.hint}</p>
</div>

<style>
  .md { --wf: color-mix(in srgb, var(--kd-blue-1) 14%, transparent); border: 2px solid var(--kd-blue-1); border-radius: var(--kd-radius); background: var(--kd-white); color: var(--kd-blue-1); overflow: hidden; box-shadow: 0 18px 40px -24px rgba(26, 1, 117, .45); }
  .md-bar { display: flex; align-items: center; gap: 6px; padding: 10px 14px; background: var(--kd-blue-1); }
  .md-bar i { width: 10px; height: 10px; border-radius: 50%; background: rgba(255, 255, 255, .35); }
  .md-bar span { margin-left: 12px; padding: 3px 12px; border-radius: var(--kd-radius); background: rgba(255, 255, 255, .12); color: var(--kd-lilac-tint); font-size: 12px; }
  .md-body { display: flex; }
  .md-side { flex: none; width: 150px; display: grid; align-content: start; gap: 12px; padding: 20px 16px; background: color-mix(in srgb, var(--kd-blue-1) 5%, transparent); }
  .md-side b { width: 60%; height: 12px; margin-bottom: 8px; border-radius: 3px; background: var(--kd-blue-1); }
  .md-side em { height: 8px; border-radius: 4px; background: var(--wf); }
  .md-side em.on { background: var(--kd-blue-2); }
  @media (max-width: 880px) { .md-side { display: none; } }

  /* mixed tile sizes: funnel wide, inbox tall */
  .md-grid { flex: 1; min-width: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); grid-template-areas: "a a b" "c d e"; gap: 14px; padding: 18px; }
  .md-pos--1 { grid-area: a; } .md-pos--2 { grid-area: b; } .md-pos--3 { grid-area: c; } .md-pos--4 { grid-area: d; } .md-pos--5 { grid-area: e; }
  @media (max-width: 1100px) { .md-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); grid-template-areas: "a a" "b c" "d e"; } }
  @media (max-width: 560px) { .md-grid { grid-template-columns: minmax(0, 1fr); grid-template-areas: "a" "b" "c" "d" "e"; padding: 12px; } }

  .md-tile { display: flex; flex-direction: column; gap: 12px; padding: 18px; border-radius: var(--kd-radius); border: 1px solid var(--wf); background: var(--kd-white); }
  .md-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 10px; }
  .md-head h3 { margin: 0; font-size: 17px; line-height: 1.3; font-weight: var(--kd-weight-medium); }
  .md-goal { flex: none; padding: 1px 8px; border-radius: var(--kd-radius); background: var(--kd-blue-2); color: var(--kd-white); font-size: 11px; font-weight: var(--kd-weight-medium); letter-spacing: .04em; white-space: nowrap; }
  .md-viz { flex: 1; display: flex; align-items: center; min-height: 120px; }
  .md-viz > * { width: 100%; }
  .md-tile p { margin: 0; font-size: 15px; line-height: 1.45; color: var(--kd-fg-2); }
  .v-lbl { display: block; font-size: 11px; font-weight: var(--kd-weight-medium); letter-spacing: .04em; text-transform: uppercase; opacity: .65; }

  /* growth: parts start small and grow in once the window is in view */
  .md :is(.v-b, .v-a) { width: var(--w); transition: width 1s cubic-bezier(.2, .7, .2, 1) .2s; }
  .md .v-cols span { height: var(--h); transition: height .7s cubic-bezier(.2, .7, .2, 1) var(--d); }
  .md .v-track--a .v-line { clip-path: inset(0 0 0 0); transition: clip-path 1s ease .4s; }
  .md .v-list--a .v-row, .md .v-empty { transition: opacity .4s ease .6s; }
  .md .v-screen u { transition: opacity .4s ease, transform .4s ease; }
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .md:not(.is-in) :is(.v-b, .v-a) { width: 0; }
    :global(.js) .md:not(.is-in) .v-cols span { height: 0; }
    :global(.js) .md:not(.is-in) .v-track--a .v-line { clip-path: inset(0 100% 0 0); }
    :global(.js) .md:not(.is-in) .v-screen u { opacity: 0; transform: translateY(6px); }
  }
  .md .v-screen u:nth-child(2) { transition-delay: .5s; } .md .v-screen u:nth-child(3) { transition-delay: .65s; } .md .v-screen u:nth-child(4) { transition-delay: .8s; } .md .v-screen u:nth-child(5) { transition-delay: .95s; }

  /* funnel: each stage has a before bar (grey) and an after bar (blue); later stages keep more users */
  .v-funnel { display: grid; gap: 8px; }
  .v-stage { display: grid; grid-template-columns: 70px 1fr; align-items: center; gap: 10px; }
  .v-stage em { height: 7px; border-radius: 4px; background: var(--wf); }
  .v-pair { display: grid; gap: 3px; }
  .v-b, .v-a { display: block; height: 8px; border-radius: 3px; }
  .v-b { background: color-mix(in srgb, var(--kd-blue-1) 22%, transparent); }
  .v-a { background: var(--kd-blue-2); }
  .v-key { display: flex; gap: 14px; margin-top: 4px; font-size: 11px; font-weight: var(--kd-weight-medium); letter-spacing: .04em; text-transform: uppercase; }
  .v-key span::before { content: ''; display: inline-block; width: 10px; height: 8px; margin-right: 6px; border-radius: 2px; vertical-align: middle; }
  .v-key-b::before { background: color-mix(in srgb, var(--kd-blue-1) 22%, transparent); }
  .v-key-a::before { background: var(--kd-blue-2); }

  /* path: many steps and a warning before, few steps and a check after */
  .v-path { display: grid; gap: 16px; }
  .v-track { display: grid; gap: 6px; }
  .v-line { position: relative; display: flex; align-items: center; justify-content: space-between; height: 18px; }
  .v-line::before { content: ''; position: absolute; left: 0; right: 0; top: 50%; height: 2px; margin-top: -1px; background: var(--wf); }
  .v-line i { position: relative; width: 10px; height: 10px; border-radius: 50%; background: var(--kd-white); border: 2px solid color-mix(in srgb, var(--kd-blue-1) 30%, transparent); }
  .v-line b { position: relative; display: grid; place-items: center; width: 18px; height: 18px; border-radius: 50%; font-size: 11px; }
  .v-track--b .v-line b { background: var(--kd-lilac); }
  .v-track--a .v-line { width: 46%; }
  .v-track--a .v-line::before { background: var(--kd-blue-2); }
  .v-track--a .v-line i { border-color: var(--kd-blue-2); background: var(--kd-blue-2); }
  .v-track--a .v-line b { background: var(--kd-signal-1); }

  /* columns: months, a dashed start line, blue columns rising after it */
  .v-cols { position: relative; display: flex; align-items: flex-end; gap: 6px; height: 120px; padding-bottom: 2px; border-bottom: 2px solid var(--wf); }
  .v-cols span { flex: 1; border-radius: 3px 3px 0 0; background: color-mix(in srgb, var(--kd-blue-1) 20%, transparent); }
  .v-cols span.a { background: var(--kd-blue-2); }
  .v-start { position: absolute; top: 0; bottom: 0; left: calc(3 / 8 * 100% - 1px); border-left: 2px dashed var(--kd-signal-1); }

  /* inbox: a busy list of questions before, a short one after */
  .v-inbox { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; align-items: start; }
  .v-list { display: grid; gap: 6px; padding: 10px; border-radius: var(--kd-radius); border: 1px solid var(--wf); }
  .v-list--a { border-color: var(--kd-blue-2); }
  .v-row { display: flex; align-items: center; gap: 6px; }
  .v-row b { flex: none; display: grid; place-items: center; width: 14px; height: 14px; border-radius: 50%; background: var(--kd-lilac); font-size: 9px; }
  .v-row em { flex: 1; height: 6px; border-radius: 3px; background: var(--wf); }
  .v-empty { display: grid; place-items: center; height: 34px; border-radius: var(--kd-radius); border: 1.5px dashed var(--kd-blue-2); color: var(--kd-blue-2); font-size: 14px; }
  @media (prefers-reduced-motion: no-preference) { :global(.js) .md:not(.is-in) :is(.v-list--a .v-row, .v-empty) { opacity: 0; } }

  /* build: parts from the library come together into a screen */
  .v-build { display: grid; grid-template-columns: 1fr auto 1.3fr; align-items: center; gap: 10px; }
  .v-lib { display: grid; grid-template-columns: 1fr 1fr; gap: 6px; padding: 8px; border-radius: var(--kd-radius); border: 1px dashed var(--wf); }
  .v-build u { display: block; border-radius: 3px; }
  .v-build .p1 { height: 10px; background: var(--kd-blue-1); }
  .v-build .p2 { height: 14px; background: var(--kd-blue-2); }
  .v-build .p3 { height: 14px; box-shadow: inset 0 0 0 2px var(--kd-blue-2); }
  .v-build .p4 { height: 6px; background: var(--wf); }
  .v-build .p5 { height: 22px; background: var(--kd-lilac-tint); box-shadow: inset 0 0 0 1px var(--kd-lilac); }
  .v-build .p6 { height: 10px; box-shadow: inset 0 0 0 1.5px color-mix(in srgb, var(--kd-blue-1) 25%, transparent); }
  .v-arrow { width: 16px; height: 2px; position: relative; background: var(--kd-blue-1); }
  .v-arrow::after { content: ''; position: absolute; right: -1px; top: -4px; border: 5px solid transparent; border-left-color: var(--kd-blue-1); border-right: 0; }
  .v-screen { display: grid; gap: 6px; padding: 10px; border-radius: var(--kd-radius); border: 2px solid var(--kd-blue-1); }
  .v-screen .p1 { width: 60%; } .v-screen .p2 { width: 46%; }

  /* speed: a slow page still loading, a fast page complete */
  .v-speed { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  .v-pg { display: grid; gap: 6px; }
  .v-win { display: grid; gap: 6px; padding: 10px; border-radius: var(--kd-radius); border: 1px solid var(--wf); }
  .v-pg--a .v-win { border: 1.5px solid var(--kd-blue-2); }
  .v-load { display: block; height: 4px; border-radius: 2px; background: var(--wf); overflow: hidden; }
  .v-load i { display: block; height: 100%; width: 30%; background: var(--kd-lilac); }
  .v-load--done i { width: 100%; background: var(--kd-blue-2); }
  .v-win em { height: 6px; border-radius: 3px; background: var(--wf); }
  .v-win em.h { background: var(--kd-blue-1); width: 80%; }
  .v-win em.s { width: 60%; }
  .v-blank { height: 34px; border-radius: 3px; border: 1.5px dashed var(--wf); }
  .v-pic { height: 34px; border-radius: 3px; background: var(--kd-blue-2); }
  .md .v-load i { transition: width 1.2s cubic-bezier(.2, .7, .2, 1) .3s; }
  @media (prefers-reduced-motion: no-preference) { :global(.js) .md:not(.is-in) .v-load--done i { width: 0; } }

  /* rank: your result climbs from the bottom of the list to the top */
  .v-rank { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  .v-rlist { display: grid; gap: 4px; padding: 10px; border-radius: var(--kd-radius); border: 1px solid var(--wf); }
  .v-rlist--a { border-color: var(--kd-blue-2); }
  .v-rrow { display: flex; align-items: center; gap: 6px; }
  .v-rrow b { flex: none; display: grid; place-items: center; width: 14px; height: 14px; border-radius: 50%; font-size: 9px; box-shadow: inset 0 0 0 1px var(--wf); }
  .v-rrow em { flex: 1; height: 6px; border-radius: 3px; background: var(--wf); }
  .v-rrow.you em { background: var(--kd-lilac); }
  .v-rlist--a .v-rrow.you em { background: var(--kd-blue-2); }
  .v-rlist--a .v-rrow.you b { background: var(--kd-signal-1); box-shadow: none; }
  .md .v-rlist--a .v-rrow.you { transition: transform .8s cubic-bezier(.2, .7, .2, 1) .3s; }
  @media (prefers-reduced-motion: no-preference) { :global(.js) .md:not(.is-in) .v-rlist--a .v-rrow.you { transform: translateY(40px); } }

  /* answers: a question, and an AI answer that names and links you */
  .v-ans { display: grid; gap: 8px; }
  .v-ask { justify-self: end; display: grid; gap: 4px; width: 62%; padding: 8px 10px; border-radius: var(--kd-radius); background: var(--kd-lilac-tint); }
  .v-ask em, .v-reply em { height: 6px; border-radius: 3px; background: color-mix(in srgb, var(--kd-blue-1) 18%, transparent); }
  .v-ask em.s, .v-reply em.s { width: 60%; }
  .v-reply { display: grid; gap: 5px; width: 86%; padding: 10px; border-radius: var(--kd-radius); background: var(--kd-blue-1); color: var(--kd-white); }
  .v-reply em { background: rgba(255, 255, 255, .22); }
  .v-ai { font-size: 11px; font-weight: var(--kd-weight-medium); color: var(--kd-signal-1); }
  .v-cite { justify-self: start; padding: 1px 7px; border-radius: var(--kd-radius); background: var(--kd-signal-1); color: var(--kd-blue-1); font-size: 11px; font-weight: var(--kd-weight-medium); }
  .md .v-reply { transition: opacity .5s ease .4s, transform .5s ease .4s; }
  @media (prefers-reduced-motion: no-preference) { :global(.js) .md:not(.is-in) .v-reply { opacity: 0; transform: translateY(8px); } }

  /* ---------- look 'sales': lilac dashboard frame and example figures ---------- */
  .md--sales { border: 1px solid var(--kd-lilac); }
  .md--sales .md-bar { background: var(--kd-lilac-tint); }
  .md--sales .md-bar i { background: var(--kd-lilac); }
  .md--sales .md-bar span { background: var(--kd-white); color: var(--kd-blue-1); font-weight: var(--kd-weight-medium); }
  .md-ex { margin-left: auto; padding: 2px 8px; border-radius: var(--kd-radius); background: var(--kd-blue-1); color: var(--kd-white); font-size: 11px; font-weight: var(--kd-weight-medium); }
  .md--sales .md-side { background: color-mix(in srgb, var(--kd-lilac) 14%, var(--kd-white)); }
  .md--sales .md-side em.on { background: var(--kd-blue-1); }
  .md--sales .md-tile { border-color: color-mix(in srgb, var(--kd-lilac) 70%, transparent); }
  .md--sales .md-goal { background: var(--kd-blue-1); }
  .md-kpi { margin-top: -4px; font-size: clamp(26px, 3vw, 36px); line-height: 1; font-weight: var(--kd-weight-medium); font-variant-numeric: tabular-nums; color: var(--kd-blue-1); }
  .md--sales .v-a, .md--sales .v-cols span.a, .md--sales .v-track--a .v-line i { background: var(--kd-blue-1); }
  .md--sales .v-b, .md--sales .v-cols span { background: var(--kd-lilac); }
  .md--sales .v-cols span.a { background: var(--kd-blue-1); }
  .md--sales .v-key-a::before { background: var(--kd-blue-1); } .md--sales .v-key-b::before { background: var(--kd-lilac); }

  /* threads: one contact before, a buying group after */
  .v-threads { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  .v-th { display: grid; gap: 6px; padding: 8px; border-radius: var(--kd-radius); border: 1px solid var(--wf); }
  .v-th--a { border-color: var(--kd-blue-1); }
  .v-th svg { width: 100%; height: auto; }
  .v-th line { stroke: color-mix(in srgb, var(--kd-blue-1) 35%, transparent); stroke-width: 1.5; }
  .v-th .p { fill: var(--kd-lilac); } .v-th .p2 { fill: var(--kd-signal-1); } .v-th .d { fill: var(--kd-blue-1); }

  /* why panel: slides up over the tile on hover, keyboard focus or tap */
  .md-tile--why { position: relative; overflow: hidden; cursor: pointer; outline: none; }
  .md-tile--why:focus-visible { box-shadow: 0 0 0 2px var(--kd-blue-2); }
  .md-why { position: absolute; inset: 0; display: flex; flex-direction: column; justify-content: center; gap: 6px; padding: 22px; background: var(--kd-blue-1); color: var(--kd-white); opacity: 0; transform: translateY(12px); pointer-events: none; transition: opacity .25s ease, transform .25s ease; }
  .md-why h4 { margin: 0 0 8px; font-size: 17px; line-height: 1.3; font-weight: var(--kd-weight-medium); }
  .md-why-l { font-size: 11px; font-weight: var(--kd-weight-medium); letter-spacing: .06em; text-transform: uppercase; color: var(--kd-signal-1); }
  .md-why-l--cause { margin-top: 8px; color: var(--kd-lilac); }
  .md .md-why p { margin: 0; font-size: 16px; line-height: 1.45; color: var(--kd-white); }
  .md-tile--why:focus-visible .md-why, .md-tile--why.is-open .md-why { opacity: 1; transform: none; }
  /* hover only where there is a real pointer; touch screens use the tap toggle (no sticky hover) */
  @media (hover: hover) { .md-tile--why:hover .md-why { opacity: 1; transform: none; } }
  @media (prefers-reduced-motion: reduce) { .md-why { transition: none; transform: none; } }

  .md-note { margin: 0; padding: 0 18px 16px; font-size: 13px; color: var(--kd-fg-2); }
  @media (min-width: 881px) { .md-note { padding-left: 168px; } }
</style>

<script is:inline>
  // Tap (or click) a tile to open its explanation; tapping again or another tile closes it.
  document.querySelectorAll('[data-dash]').forEach(function (root) {
    var tiles = root.querySelectorAll('.md-tile--why');
    tiles.forEach(function (t) {
      t.addEventListener('click', function () {
        var open = !t.classList.contains('is-open');
        tiles.forEach(function (o) { o.classList.remove('is-open'); });
        if (open) t.classList.add('is-open');
      });
      t.addEventListener('keydown', function (e) { if (e.key === 'Escape') t.blur(); });
    });
  });
</script>
