---
// src/components/ContactModal.astro
// Shared Plunk-backed contact modal. Rendered once by Layout.astro so every page
// that shows the nav also has a working "Lets Talk" / "Get a free audit" target.
// Opened by any [data-open-modal] button anywhere on the page.
// The /api/contact Cloudflare Function and its Plunk secret are unchanged.
//
// All visible strings come from the i18n dictionary. Strings the script needs
// (sending state, error text) are passed down as data- attributes on the form
// so the inline script stays language-agnostic.
import { asLocale, useTranslations } from '../i18n/utils';

const locale = asLocale(Astro.currentLocale);
const t = useTranslations(locale);
---
<div class="modal-overlay" id="contact" role="dialog" aria-modal="true" aria-labelledby="contact-title">
  <div class="modal">
    <button class="x" data-close-modal aria-label={t('modal.close')}>✕</button>
    <div id="form-body">
      <span class="eyebrow indigo">{t('modal.eyebrow')}</span>
      <h3 id="contact-title">{t('modal.title')}</h3>
      <p class="muted" style="margin-top:6px">{t('modal.lead')}</p>
      <form id="contact-form" novalidate data-sending={t('modal.sending')} data-error={t('modal.error')} data-emailfallback={t('modal.emailfallback')}>
        <div class="hp" aria-hidden="true">
          <label for="f-hp">{t('modal.hp')}</label>
          <input id="f-hp" name="_gotcha" tabindex="-1" autocomplete="off" />
        </div>
        <div class="field"><label for="f-name">{t('modal.name')}</label><input id="f-name" name="name" autocomplete="name" required /></div>
        <div class="field"><label for="f-email">{t('modal.email')}</label><input id="f-email" name="email" type="email" autocomplete="email" required /></div>
        <div class="field"><label for="f-company">{t('modal.company')}</label><input id="f-company" name="company" autocomplete="organization" /></div>
        <div class="field"><label for="f-website">{t('modal.website')} <span class="muted">{t('modal.optional')}</span></label><input id="f-website" name="website" /></div>
        <div class="field"><label for="f-goal">{t('modal.goal')}</label><textarea id="f-goal" name="goal"></textarea></div>
        <p class="form-error" id="form-error" role="alert" style="display:none"></p>
        <button class="btn btn-primary btn-block" type="submit">{t('modal.send')}</button>
      </form>
    </div>
    <div id="form-success" class="success" style="display:none">
      <div class="check" aria-hidden="true">✓</div>
      <h3>{t('modal.success.title')}</h3>
      <p class="muted" style="margin-top:6px">{t('modal.success.body')}</p>
    </div>
  </div>
</div>

<script is:inline>
  (function () {
    var overlay = document.getElementById('contact');
    if (!overlay) return;
    var lastFocus = null;
    function openModal() { lastFocus = document.activeElement; overlay.classList.add('open'); document.body.style.overflow = 'hidden'; var f = overlay.querySelector('input, button'); if (f) f.focus(); }
    function closeModal() { overlay.classList.remove('open'); document.body.style.overflow = ''; if (lastFocus && lastFocus.focus) lastFocus.focus(); }
    document.querySelectorAll('[data-open-modal]').forEach(function (b) { b.addEventListener('click', function (e) { e.preventDefault(); openModal(); }); });
    document.querySelectorAll('[data-close-modal]').forEach(function (b) { b.addEventListener('click', closeModal); });
    overlay.addEventListener('click', function (e) { if (e.target === overlay) closeModal(); });
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && overlay.classList.contains('open')) closeModal(); });
    var form = document.getElementById('contact-form');
    if (!form) return;
    var errEl = document.getElementById('form-error');
    function val(id) { var el = document.getElementById(id); return el ? el.value : ''; }
    form.addEventListener('submit', function (e) {
      e.preventDefault();
      if (!form.checkValidity()) { form.reportValidity(); return; }
      var btn = form.querySelector('button[type="submit"]'); var label = btn.textContent;
      btn.disabled = true; btn.textContent = form.dataset.sending || 'Sending…'; errEl.style.display = 'none';
      fetch('/api/contact', { method: 'POST', headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ name: val('f-name'), email: val('f-email'), company: val('f-company'), website: val('f-website'), goal: val('f-goal'), _gotcha: val('f-hp') }) })
      .then(function (res) { return res.json().catch(function () { return {}; }).then(function (out) {
        if (res.ok && out.ok) { document.getElementById('form-body').style.display = 'none'; document.getElementById('form-success').style.display = 'block'; }
        else { throw new Error((out && out.error) || form.dataset.error || 'Something went wrong.'); } }); })
      .catch(function (err) { errEl.textContent = err.message + (form.dataset.emailfallback || ''); errEl.style.display = 'block'; btn.disabled = false; btn.textContent = label; });
    });
  })();
</script>