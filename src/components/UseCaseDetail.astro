---
// src/components/UseCaseDetail.astro
// One use case detail page. Layout from the October use case designs
// (design/261021_Kadanco_Use_Cases/), built with our tokens and components:
//   department-coloured hero (text left, icon panel right),
//   the situation (problem / what we do), optional route comparison
//   (route cards), optional reasons it stalls (why), optional funnel (where visitors drop off), the
//   steps as stacked cards, expanding cards, a bento grid or the product UI mock (stepsLayout), optional "also included" cards with tags, outcomes, optional native
//   operator block, optional first-90-days timeline (horizontal row), FAQ,
//   and a department-coloured CTA band.
// Colours follow the department: product blue, marketing lime, sales lilac.
// The route cards and the 90-day row have their own designs, so no section
// repeats the homepage (matrix and How We Work timeline stay homepage only).
// Stacked cards share one height, so each covers the previous one cleanly;
// on phones they sit in a plain column.
import IsoIcon from './IsoIcon.astro';
import StepsProductUI from './StepsProductUI.astro';
import StepsScene from './StepsScene.astro';
import SelfCheck from './SelfCheck.astro';
import DeliverableTabs from './DeliverableTabs.astro';
import HeroMorph from './HeroMorph.astro';
import HeroBuild from './HeroBuild.astro';
import { auditHref, callHref } from '../data/intakes';
import MeasuresDash from './MeasuresDash.astro';
import StepsDetail from './StepsDetail.astro';
import type { UseCasePage, Mark } from '../data/use-case-pages/types';
import { asLocale, localizedHref } from '../i18n/utils';

interface Props { page: UseCasePage }
const { page } = Astro.props;
const locale = asLocale(Astro.currentLocale);
const c = page[locale] ?? page.en;
// the nav reads gradients as dark unless told; lime and lilac grounds are light
const ground = page.dept === 'product' ? 'dark' : 'light';
const navCta = page.dept === 'marketing' ? 'dark' : undefined; // lime hero and CTA band
// light sections alternate page and paper grounds, whichever optional blocks are present
const light = [c.check && 'check', c.situation && 'situation', c.comparison && 'routes', c.why && 'why', c.funnel && 'funnel', c.deliverables && 'deliverables', c.inside && 'inside', c.also && 'also', c.outcomes && 'outcomes', c.measures && 'measures', c.ways && 'ways', c.operator && 'operator', c.timeline && 'timeline', c.stories && 'stories', 'faq'].filter(Boolean);
const SCENES = ['web', 'slider', 'fan', 'map', 'board', 'calendar', 'sequence', 'org'] as const;
const scene = SCENES.find((k) => k === page.stepsLayout);
// route card marks: check, half, cross
const MARK_PATH: Record<Mark, string> = { has: 'M5 12.5l4.5 4.5L19 7.5', part: 'M6 12h12', gap: 'M7 7l10 10M17 7L7 17' };
// audit buttons go to the page's own intake (page.audit) or the department's, every other CTA to the strategy call page
const audit = localizedHref(locale, page.audit ?? auditHref[page.dept]);
const call = localizedHref(locale, callHref);
const sec = (name: string) => (light.indexOf(name) % 2 ? 'ucd-sec ucd-sec--alt' : 'ucd-sec');
const ui = {
  en: { problem: 'The problem', solve: 'What we do', uiHint: 'Hover a part of the screen', sceneHint: 'Hover the picture or a step to see how it works.' },
  de: { problem: 'Das Problem', solve: 'Was wir tun', uiHint: 'Fahren Sie über einen Bereich', sceneHint: 'Fahren Sie über das Bild oder einen Schritt, um zu sehen, wie es funktioniert.' },
}[locale];
---
<main id="top" class={`ucd ucd--${page.dept}`}>
  <div class="ucd-hero" data-theme={ground} data-nav-cta={navCta}>
    <section class="container ucd-hero-in">
      <div class="ucd-hero-copy">
        <span class="ucd-dept">{c.dept}</span>
        <h1>{c.h1a} <em>{c.h1b}</em></h1>
        <p>{c.lead}</p>
        <div class="ucd-hero-actions">
          <a href={audit} class="btn btn-lg ucd-btn">{c.ctaPrimary}</a>
          {c.ctaSecondaryHref
            ? <a href={c.ctaSecondaryHref} class="btn btn-lg ucd-btn-ghost">{c.ctaSecondary}</a>
            : <a href={call} class="btn btn-lg ucd-btn-ghost">{c.ctaSecondary}</a>}
        </div>
      </div>
      {page.heroVisual === 'morph' ? (
        <div class="ucd-hero-visual ucd-hero-visual--bare"><HeroMorph label={locale === 'de' ? 'Dieselbe App vorher, unübersichtlich, und nachher, klar' : 'The same app before, cluttered, and after, clear'} /></div>
      ) : page.heroVisual === 'build' ? (
        <div class="ucd-hero-visual ucd-hero-visual--bare"><HeroBuild stages={c.deliverables?.tabs.map((t) => t.label) ?? []} label={locale === 'de' ? 'Eine Website entsteht: Marke, Konzept, Design, Code, dann gefunden in Suche und KI-Antworten' : 'A website taking shape: brand, concept, design, code, then found in search and AI answers'} /></div>
      ) : page.heroVisual === 'app' ? (
        <div class="ucd-hero-visual ucd-app" role="img" aria-label={c.crumb}>
          <div class="ucd-app-win">
            <div class="ucd-app-bar"><i></i><i></i><i></i></div>
            <div class="ucd-app-body">
              <div class="ucd-app-steps"><b class="on"></b><s class="on"></s><b class="on"></b><s></s><b></b></div>
              <span class="ucd-app-h"></span><span class="ucd-app-l"></span><span class="ucd-app-l ucd-app-l--s"></span>
              <div class="ucd-app-card"><span class="ucd-app-l"></span><div class="ucd-app-prog"><u></u></div></div>
              <span class="ucd-app-btn"></span>
            </div>
          </div>
        </div>
      ) : (
        <div class="ucd-hero-visual" role="img" aria-label={c.crumb}><IsoIcon name={page.icon} size={200} /></div>
      )}
    </section>
  </div>

  {c.check && (
    <section class={sec('check')} id="check" data-theme="light">
      <div class="container">
        <div class="ucd-head">
          <span class="ucd-eyebrow">{c.check.eyebrow}</span>
          <h2>{c.check.h2a} <em>{c.check.h2b}</em></h2>
          <p class="ucd-lede">{c.check.lede}</p>
        </div>
        <SelfCheck items={c.check.items} results={c.check.results} labels={c.check.labels} kind={page.checkVisual} />
      </div>
    </section>
  )}

  {c.situation && (
  <section class={sec('situation')} data-theme="light">
    <div class="container">
      <div class="ucd-head">
        <span class="ucd-eyebrow">{c.situation.eyebrow}</span>
        <h2>{c.situation.h2a} <em>{c.situation.h2b}</em></h2>
        <p class="ucd-lede">{c.situation.lede}</p>
      </div>
      <div class="ucd-split">
        <div class="ucd-panel"><h3>{ui.problem}</h3><p>{c.situation.problem}</p></div>
        <div class="ucd-panel ucd-panel--solve"><h3>{ui.solve}</h3><p>{c.situation.solve}</p></div>
      </div>
    </div>
  </section>
  )}

  {c.comparison && (
    <section class={sec('routes')} id="routes" data-theme="light">
      <div class="container">
        <div class="ucd-head">
          <span class="ucd-eyebrow">{c.comparison.eyebrow}</span>
          <h2>{c.comparison.h2a} <em>{c.comparison.h2b}</em></h2>
          <p class="ucd-lede">{c.comparison.lead}</p>
        </div>
        <ul class="ucd-routes">
          {c.comparison.rows.map((r) => (
            <li class="ucd-route">
              <h3>{r.route}</h3>
              <p>{r.why}</p>
              <ul class="ucd-checks">
                {r.marks.map((m, k) => (
                  <li class={`ucd-chk ucd-chk--${m}`}>
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d={MARK_PATH[m]} /></svg>
                    {c.comparison!.cols[k]}<span class="ucd-sr">: {c.comparison!.legend[m]}</span>
                  </li>
                ))}
              </ul>
            </li>
          ))}
        </ul>
        <div class="ucd-route-kad">
          <div class="ucd-route-kad-text">
            <span class="ucd-route-tag">{c.comparison.solution}</span>
            <h3>{c.comparison.kad.route}</h3>
            <p>{c.comparison.kad.why}</p>
          </div>
          <ul class="ucd-checks">
            {c.comparison.cols.map((col) => (
              <li class="ucd-chk ucd-chk--has">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d={MARK_PATH.has} /></svg>
                {col}<span class="ucd-sr">: {c.comparison!.legend.has}</span>
              </li>
            ))}
          </ul>
        </div>
        <p class="ucd-route-cap">{c.comparison.cap}</p>
      </div>
    </section>
  )}

  {c.why && (
    <section class={sec('why')} data-theme="light">
      <div class="container">
        <div class="ucd-head">
          <span class="ucd-eyebrow">{c.why.eyebrow}</span>
          <h2>{c.why.h2a} <em>{c.why.h2b}</em></h2>
        </div>
        <div class="ucd-also">
          {c.why.items.map((it) => <div class="ucd-also-card"><h3>{it.title}</h3><p>{it.body}</p></div>)}
        </div>
      </div>
    </section>
  )}

  {c.funnel && (
    <section class={sec('funnel')} data-theme="light">
      <div class="container">
        <div class="ucd-head">
          <span class="ucd-eyebrow">{c.funnel.eyebrow}</span>
          <h2>{c.funnel.h2a} <em>{c.funnel.h2b}</em></h2>
        </div>
        <ol class="ucd-funnel">
          {c.funnel.stages.map((st, i) => (
            <li style={`--w:${100 - i * (40 / Math.max(1, c.funnel!.stages.length - 1))}%`} class={i === c.funnel!.stages.length - 1 ? 'is-goal' : undefined}>
              <span class="ucd-funnel-bar">{st.label}</span>
              <span class="ucd-funnel-note">{st.leak ?? c.funnel!.end}</span>
            </li>
          ))}
        </ol>
      </div>
    </section>
  )}

  {c.deliverables && (
    <section class={sec('deliverables')} id="deliverables" data-theme="light">
      <div class="container">
        <div class="ucd-head">
          <span class="ucd-eyebrow">{c.deliverables.eyebrow}</span>
          <h2>{c.deliverables.h2a} <em>{c.deliverables.h2b}</em></h2>
          <p class="ucd-lede">{c.deliverables.lede}</p>
        </div>
        {c.deliverables.layout === 'steps'
          ? <StepsDetail steps={c.deliverables.tabs} cta={c.deliverables.cta} ctaHref={audit} labels={locale === 'de'
              ? { step: 'Schritt', doing: 'Was wir tun', get: 'Was Sie bekommen', you: 'Von Ihnen:',
                  report: 'UX-Audit', impact: ['Hoch', 'Mittel', 'Niedrig'], drop: 'Größter Abbruch', test: 'Test 5 von 6 bestanden',
                  states: ['Standard', 'Lädt', 'Leer', 'Fehler'], tokens: 'Tokens', components: 'Komponenten', doLbl: 'So', dontLbl: 'Nicht so',
                  passed: 'Tests bestanden', ready: 'Bereit zum Mergen', preview: 'Vorschau',
                  web: { url: 'ihrefirma.de', positioning: 'Positionierung', risk: 'Risiko', voice: ['Klar', 'Direkt', 'Kompetent'], message: 'Botschaft', pages: ['Start', 'Produkt', 'Preise', 'Über uns'],
                    keyword: 'Keyword', question: 'Käuferfrage', devices: ['Desktop', 'Tablet', 'Handy'], cms: 'CMS', publish: 'Veröffentlichen', live: 'Live',
                    checks: ['Responsiv', 'Sicher', 'CRM verbunden'], query: 'website für b2b software', ai: 'KI-Antwort', speed: 'Ladezeit' } }
              : { step: 'Step', doing: 'What we do', get: 'What you get', you: 'From you:',
                  report: 'UX audit', impact: ['High', 'Medium', 'Low'], drop: 'Biggest drop', test: 'Test 5 of 6 passed',
                  states: ['Default', 'Loading', 'Empty', 'Error'], tokens: 'Tokens', components: 'Components', doLbl: 'Do', dontLbl: "Don't",
                  passed: 'Tests passed', ready: 'Ready to merge', preview: 'Preview',
                  web: { url: 'yourcompany.com', positioning: 'Positioning', risk: 'Risk', voice: ['Clear', 'Direct', 'Expert'], message: 'Message', pages: ['Home', 'Product', 'Pricing', 'About'],
                    keyword: 'Keyword', question: 'Buyer question', devices: ['Desktop', 'Tablet', 'Phone'], cms: 'CMS', publish: 'Publish', live: 'Live',
                    checks: ['Responsive', 'Secure', 'CRM connected'], query: 'website for b2b software', ai: 'AI answer', speed: 'Load time' } }} />
          : <DeliverableTabs tabs={c.deliverables.tabs} id={`${page.id}-dt`} />}
      </div>
    </section>
  )}

  {c.inside && (
  <section class={sec('inside')} data-theme="light">
    <div class="container">
      <div class="ucd-head">
        <span class="ucd-eyebrow">{c.inside.eyebrow}</span>
        <h2>{c.inside.h2}</h2>
        <p class="ucd-lede">{c.inside.lede}</p>
      </div>
      {scene ? (
        <StepsScene kind={scene} steps={c.inside.steps} hint={ui.sceneHint} />
      ) : page.stepsLayout === 'ui' ? (
        <StepsProductUI steps={c.inside.steps} hint={ui.uiHint} />
      ) : page.stepsLayout === 'bento' ? (
        <div class={`ucd-bento ucd-bento--${c.inside.steps.length}`}>
          {c.inside.steps.map((st, i) => (
            <article class={`ucd-tile ucd-tile--${i + 1}`} tabindex="0">
              <div class="ucd-tile-media" role="img" aria-label={st.title} data-image-slot={`${page.id}-${i + 1}`}>
                <IsoIcon name={page.stepIcons[i % page.stepIcons.length]} size={i === 0 ? 160 : 110} />
              </div>
              <div class="ucd-tile-text">
                <span class="ucd-step">{st.label}</span>
                <h3>{st.title}</h3>
                <p>{st.body}</p>
                {st.points && <ul class="ucd-tile-more">{st.points.map((p) => <li>{p}</li>)}</ul>}
              </div>
            </article>
          ))}
        </div>
      ) : page.stepsLayout === 'expand' ? (
        <div class="ucd-expand">
          {c.inside.steps.map((st, i) => (
            <article class="ucd-xcard" tabindex="0" aria-label={`${st.label}: ${st.title}`}>
              <div class="ucd-xcard-media" data-image-slot={`${page.id}-${i + 1}`} aria-hidden="true">
                <IsoIcon name={page.stepIcons[i % page.stepIcons.length]} size={140} />
              </div>
              <div class="ucd-xcard-panel">
                <span class="ucd-step">{st.label}</span>
                <h3>{st.title}</h3>
                <p>{st.body}</p>
              </div>
            </article>
          ))}
        </div>
      ) : (
      <div class="ucd-stack">
        {c.inside.steps.map((st, i) => (
          <article class={`ucd-card ucd-card--${(i % 3) + 1}`} style={`--i:${i}`}>
            <div class="ucd-card-text">
              <span class="ucd-step">{st.label}</span>
              <h3>{st.title}</h3>
              <p>{st.body}</p>
            </div>
            <div class="ucd-card-media" role="img" aria-label={st.title} data-image-slot={`${page.id}-${i + 1}`}>
              <IsoIcon name={page.stepIcons[i % page.stepIcons.length]} size={150} />
            </div>
          </article>
        ))}
      </div>
      )}
    </div>
  </section>
  )}

  {c.also && (
    <section class={sec('also')} data-theme="light">
      <div class="container">
        <div class="ucd-head">
          <span class="ucd-eyebrow">{c.also.eyebrow}</span>
          <h2>{c.also.h2}</h2>
        </div>
        <div class="ucd-also">
          {c.also.items.map((it) => <div class="ucd-also-card"><h3>{it.title}</h3><p>{it.body}</p></div>)}
        </div>
        {c.also.tags && (
          <div class="ucd-tags">
            {c.also.tagsHead && <p class="ucd-tags-head">{c.also.tagsHead}</p>}
            <ul>{c.also.tags.map((t) => <li>{t}</li>)}</ul>
          </div>
        )}
      </div>
    </section>
  )}

  {c.outcomes && (
    <section class={sec('outcomes')} data-theme="light">
      <div class="container">
        <div class="ucd-head">
          <span class="ucd-eyebrow">{c.outcomes.eyebrow}</span>
          <h2>{c.outcomes.h2}</h2>
        </div>
        <div class="ucd-out">
          {c.outcomes.items.map((o) => <div class="ucd-out-card"><b>{o.big}</b><p>{o.text}</p></div>)}
        </div>
      </div>
    </section>
  )}

  {c.measures && (
    <section class={sec('measures')} data-theme="light">
      <div class="container">
        <div class="ucd-head">
          <span class="ucd-eyebrow">{c.measures.eyebrow}</span>
          <h2>{c.measures.h2a} <em>{c.measures.h2b}</em></h2>
          <p class="ucd-lede">{c.measures.lede}</p>
        </div>
        <MeasuresDash items={c.measures.items} labels={locale === 'de'
          ? { app: c.measures.app ?? 'Ihre Produktzahlen', you: 'ihrefirma.de', ai: 'KI-Antwort', before: 'Vorher', after: 'Nachher', goalUp: 'Ziel: hoch', goalDown: 'Ziel: runter', note: 'Beispielhafte Darstellung, keine echten Zahlen.', change: 'Was sich ändert', cause: 'Warum', hint: 'Fahren Sie über eine Kachel oder tippen Sie darauf, um zu sehen, was sich ändert und warum.' }
          : { app: c.measures.app ?? 'Your product metrics', you: 'yourcompany.com', ai: 'AI answer', before: 'Before', after: 'After', goalUp: 'Goal: up', goalDown: 'Goal: down', note: 'Example views, no real figures.', change: 'What changes', cause: 'Why', hint: 'Hover or tap a tile to see what changes and why.' }} />
      </div>
    </section>
  )}

  {c.ways && (
    <section class={sec('ways')} id="ways" data-theme="light">
      <div class="container">
        <div class="ucd-head">
          <span class="ucd-eyebrow">{c.ways.eyebrow}</span>
          <h2>{c.ways.h2a} <em>{c.ways.h2b}</em></h2>
        </div>
        <div class="ucd-ways">
          {c.ways.options.map((o, i) => (
            <div class:list={['ucd-way', { 'ucd-way--alt': i % 2 === 1 }]}>
              <span class="ucd-way-tag">{o.tag}</span>
              <h3>{o.title}</h3>
              <span class="ucd-way-len">{o.length}</span>
              <p>{o.body}</p>
              <ul>{o.points.map((pt) => <li>{pt}</li>)}</ul>
              <a href={call} class="btn ucd-way-btn">{o.cta}</a>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  {c.operator && (
    <section class={sec('operator')} data-theme="light">
      <div class="container ucd-op">
        <div class="ucd-head ucd-op-head">
          <span class="ucd-eyebrow">{c.operator.eyebrow}</span>
          <h2>{c.operator.h2a} <em>{c.operator.h2b}</em></h2>
        </div>
        <div class="ucd-op-body">
          <div class="ucd-op-faces" aria-hidden="true">
            <img src="https://assets.kadanco.com/public/maria.jpeg" alt="" width="64" height="64" loading="lazy" />
            <img src="https://assets.kadanco.com/public/karan.jpeg" alt="" width="64" height="64" loading="lazy" />
          </div>
          <p>{c.operator.body}</p>
          <a class="ucd-link" href={localizedHref(locale, '/#about')}>{c.operator.link} →</a>
        </div>
      </div>
    </section>
  )}

  {c.timeline && (
    <section class={sec('timeline')} data-theme="light">
      <div class="container">
        <div class="ucd-head">
          <span class="ucd-eyebrow">{c.timeline.eyebrow}</span>
          <h2>{c.timeline.h2a} <em>{c.timeline.h2b}</em></h2>
        </div>
        <ol class="ucd-days">
          {c.timeline.steps.map((s) => (
            <li class="ucd-day">
              <span class="ucd-day-n">{s.n}</span>
              <h3>{s.title}{s.amp && <span class="ucd-day-amp"> {s.amp}</span>}</h3>
              <p>{s.body}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>
  )}

  {c.stories && (
    <section class={sec('stories')} id="stories" data-theme="light">
      <div class="container">
        <div class="ucd-head">
          <span class="ucd-eyebrow">{c.stories.eyebrow}</span>
          <h2>{c.stories.h2a} <em>{c.stories.h2b}</em></h2>
          <p class="ucd-lede">{c.stories.lede}</p>
        </div>
        <div class="ucd-stories">
          {c.stories.items.map((st) => (
            <article class="ucd-story">
              <div class="ucd-story-top">
                <span class="ucd-story-logo" aria-hidden="true">{st.client.slice(0, 1)}</span>
                <div><h3>{st.client}</h3><span class="ucd-story-ind">{st.industry}</span></div>
                {st.placeholder && <span class="ucd-story-ph">Placeholder</span>}
              </div>
              <dl>
                <dt>{locale === 'de' ? 'Ausgangslage' : 'Challenge'}</dt><dd>{st.challenge}</dd>
                <dt>{locale === 'de' ? 'Was wir gemacht haben' : 'What we did'}</dt><dd>{st.work}</dd>
              </dl>
              <p class="ucd-story-res">{st.result}</p>
              {st.quote && <blockquote>{st.quote}{st.who && <cite>{st.who}</cite>}</blockquote>}
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class={sec('faq')} data-theme="light">
    <div class="container">
      <div class="ucd-head">
        <span class="ucd-eyebrow">{c.faq.eyebrow}</span>
        <h2>{c.faq.h2}</h2>
      </div>
      <div class="ucd-faq">
        {c.faq.items.map((f) => <div class="ucd-faq-item"><h3>{f.q}</h3><p>{f.a}</p></div>)}
      </div>
    </div>
  </section>

  <section class="ucd-cta" id="contact" data-theme={ground} data-nav-cta={navCta}>
    <div class="container">
      <h2>{c.cta.h2a} <em>{c.cta.h2b}</em></h2>
      <p>{c.cta.lead}</p>
      <div class="ucd-cta-actions"><a href={audit} class="btn btn-lg ucd-btn">{c.cta.button}</a></div>
    </div>
  </section>
</main>

<script is:inline>
  // draws the dashboard curves once they scroll into view
  (function () {
    var dashes = document.querySelectorAll('[data-dash]');
    if (!dashes.length || !('IntersectionObserver' in window)) { dashes.forEach(function (d) { d.classList.add('is-in'); }); return; }
    var io = new IntersectionObserver(function (es) { es.forEach(function (e) { if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); } }); }, { threshold: 0.35 });
    dashes.forEach(function (d) { io.observe(d); });
  })();
</script>

<style>
  /* ---------- department themes ---------- */
  .ucd--marketing { --h-bg: var(--kd-signal-1); --h-ink: var(--kd-blue-1); --h-em: var(--kd-blue-2); --h-mix: 62%;
    --btn-bg: var(--kd-blue-1); --btn-fg: var(--kd-white); --tag: var(--kd-blue-1);
    --card-1: var(--kd-signal-1); --card-2: color-mix(in srgb, var(--kd-signal-1) 24%, var(--kd-white)); --card-ink: var(--kd-blue-1); --card-step: var(--kd-blue-2); --accent-line: var(--kd-signal-1); }
  .ucd--sales { --h-bg: var(--kd-lilac); --h-ink: var(--kd-blue-1); --h-em: var(--kd-blue-2); --h-mix: 55%;
    --btn-bg: var(--kd-blue-1); --btn-fg: var(--kd-white); --tag: var(--kd-blue-1);
    --card-1: var(--kd-lilac); --card-2: var(--kd-lilac-tint); --card-ink: var(--kd-blue-1); --card-step: var(--kd-blue-2); --accent-line: var(--kd-lilac); }
  .ucd--product { --h-bg: var(--kd-blue-2); --h-ink: var(--kd-white); --h-em: var(--kd-signal-1); --h-mix: 82%;
    --btn-bg: var(--kd-signal-1); --btn-fg: var(--kd-blue-1); --tag: var(--kd-white);
    --card-1: var(--kd-blue-2); --card-2: var(--kd-blue-3); --card-ink: var(--kd-white); --card-step: var(--kd-signal-1); --accent-line: var(--kd-blue-2); }

  .ucd { background: var(--kd-bg); color: var(--kd-fg); }
  .ucd h1, .ucd h2, .ucd h3 { margin: 0; font-weight: var(--kd-weight-medium); letter-spacing: .06px; text-wrap: balance; }
  .ucd p { margin: 0; }
  .ucd em { font-style: normal; }

  /* ---------- hero (department colour) ---------- */
  /* Hero rule (owner, 2026-10-24): on laptops and up every use case hero has the same
     height, follows the screen height and never runs past the first screen, so the
     CTAs are always visible. Copy budget: headline about 50 characters (German 60),
     lead 160 to 200 (German up to 230). Phones and tablets stack (see below). */
  .ucd-hero { display: flex; align-items: center; min-height: clamp(560px, calc(100svh - 64px), 780px); background: radial-gradient(125% 120% at 50% -10%, color-mix(in srgb, var(--h-bg) var(--h-mix), var(--kd-white)), var(--h-bg) 72%); color: var(--h-ink); }
  .ucd-hero-in { width: 100%; display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, .9fr); gap: 48px; align-items: center; padding-top: calc(80px + 32px); padding-bottom: 48px; } /* clears the fixed 80px nav (no breadcrumbs, owner decision) */
  .ucd-hero-copy { display: flex; flex-direction: column; gap: 20px; align-items: flex-start; }
  .ucd-dept { padding: 4px 12px; border-radius: var(--kd-radius); border: 1.5px solid var(--tag); color: var(--tag); font-size: 13px; font-weight: var(--kd-weight-medium); letter-spacing: .04em; text-transform: uppercase; }
  /* the headline also scales with the screen height, so short laptop screens keep the CTAs in view */
  .ucd-hero h1 { font-size: clamp(36px, min(7vw, 7svh), 70px); line-height: var(--kd-lh-xl); max-width: 18ch; }
  .ucd-hero h1 em { color: var(--h-em); }
  .ucd-hero p { font-size: clamp(17px, min(1.8vw, 2.5svh), 22px); line-height: 1.45; max-width: 46ch; opacity: .9; }
  .ucd-hero-actions { display: flex; gap: 14px; flex-wrap: wrap; margin-top: 4px; }
  .ucd-btn { background: var(--btn-bg); border-color: var(--btn-bg); color: var(--btn-fg); }
  .ucd-btn:hover { transform: translateY(-2px); filter: brightness(1.1); }
  .ucd-btn-ghost { background: transparent; border-color: var(--h-ink); color: var(--h-ink); }
  .ucd-btn-ghost:hover { background: var(--h-ink); color: var(--h-bg); }
  .ucd-hero-visual { display: flex; align-items: center; justify-content: center; aspect-ratio: 4 / 3; border-radius: var(--kd-radius); background: var(--kd-blue-1); color: var(--kd-white); }
  .ucd-hero-visual :global(.iso-ic) { color: var(--kd-white); }
  .ucd-hero-visual :global(.iso-ic polygon) { fill: var(--kd-blue-1); }
  /* Product heroes: a small app window in the wireframe style of the step scenes */
  .ucd-app { padding: 9%; }
  .ucd-app-win { width: 100%; max-width: 380px; border-radius: var(--kd-radius); background: var(--kd-white); overflow: hidden; box-shadow: 0 24px 48px -24px rgba(0, 0, 0, .5); }
  .ucd-app-bar { display: flex; gap: 6px; padding: 10px 12px; background: var(--kd-blue-2); }
  .ucd-app-bar i { width: 9px; height: 9px; border-radius: 50%; background: rgba(255, 255, 255, .5); }
  .ucd-app-body { display: grid; gap: 10px; padding: 18px; }
  .ucd-app-steps { display: flex; align-items: center; margin-bottom: 6px; }
  .ucd-app-steps b { width: 14px; height: 14px; border-radius: 50%; border: 2px solid var(--kd-lilac); }
  .ucd-app-steps b.on { background: var(--kd-blue-2); border-color: var(--kd-blue-2); }
  .ucd-app-steps s { flex: 1; height: 2px; background: var(--kd-lilac); }
  .ucd-app-steps s.on { background: var(--kd-blue-2); }
  .ucd-app-h { display: block; width: 70%; height: 14px; border-radius: 3px; background: var(--kd-blue-1); }
  .ucd-app-l { display: block; width: 90%; height: 8px; border-radius: 3px; background: var(--kd-lilac-tint); }
  .ucd-app-l--s { width: 60%; }
  .ucd-app-card { display: grid; gap: 10px; padding: 14px; border: 1px solid var(--kd-lilac); border-radius: var(--kd-radius); }
  .ucd-app-prog { height: 8px; border-radius: 4px; background: var(--kd-lilac-tint); overflow: hidden; }
  .ucd-app-prog u { display: block; width: 66%; height: 100%; background: var(--kd-signal-1); }
  /* 'morph': no navy box, the before/after app (HeroMorph.astro) fills the space */
  .ucd-hero-visual.ucd-hero-visual--bare { display: block; aspect-ratio: auto; padding: 0; background: none; }
  .ucd-app-btn { display: block; width: 45%; height: 30px; margin-top: 4px; border-radius: var(--kd-radius); background: var(--kd-blue-2); }
  @media (max-width: 880px) {
    .ucd-hero { min-height: 0; } /* stacked: height follows the content */
    .ucd-hero-in { grid-template-columns: 1fr; gap: 32px; padding-top: calc(80px + 48px); padding-bottom: 64px; }
    .ucd-hero-visual { aspect-ratio: 5 / 2; } /* after the text (text first when stacked); short so it stays a picture, not a block */
    .ucd-hero-visual :global(.iso-ic) { width: 140px !important; height: 140px !important; }
  }
  @media (max-width: 560px) {
    .ucd-hero-actions { flex-direction: column; align-items: stretch; width: 100%; }
    .ucd-hero-visual { aspect-ratio: 2 / 1; }
    .ucd-hero-visual :global(.iso-ic) { width: 110px !important; height: 110px !important; }
  }

  /* ---------- sections ---------- */
  .ucd-sec { padding: clamp(56px, 7vw, 72px) 0; }
  .ucd-sec--alt { background: var(--kd-surface-2); }
  .ucd-sec[id] { scroll-margin-top: 80px; } /* in-page links land below the fixed nav */
  .ucd-head { display: flex; flex-direction: column; gap: 12px; max-width: 60ch; margin-bottom: 40px; }
  .ucd-eyebrow { font-size: var(--kd-text-xs); line-height: var(--kd-lh-xs); font-weight: var(--kd-weight-medium); letter-spacing: .04em; text-transform: uppercase; color: var(--kd-accent); }
  .ucd-sec h2 { font-size: var(--kd-text-l); line-height: var(--kd-lh-l); }
  .ucd-sec h2 em { color: var(--kd-accent); }
  .ucd-lede { font-size: var(--kd-text-s); line-height: var(--kd-lh-s); color: var(--kd-fg-2); }

  .ucd-split { display: grid; grid-template-columns: 1fr 1fr; gap: 28px; }
  @media (max-width: 880px) { .ucd-split { grid-template-columns: 1fr; } }
  .ucd-panel { padding: 32px; border-radius: var(--kd-radius); background: var(--kd-surface); border: 1px solid var(--kd-line); }
  .ucd-panel h3 { font-size: var(--kd-text-m); line-height: var(--kd-lh-m); margin-bottom: 10px; }
  .ucd-panel p { font-size: 18px; line-height: 1.5; color: var(--kd-fg-2); }
  .ucd-panel--solve { border-left: 4px solid var(--accent-line); }

  /* ---------- stacked step cards (equal heights) ---------- */
  .ucd-stack { display: flex; flex-direction: column; gap: 28px; padding-bottom: 16px; }
  .ucd-card {
    position: sticky; top: calc(96px + var(--i) * 16px);
    height: clamp(340px, calc(100svh - 200px), 420px);
    display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    border-radius: var(--kd-radius); overflow: hidden; box-shadow: 0 -10px 40px -14px rgba(26, 1, 117, .34);
    background: var(--card-bg); color: var(--card-ink);
  }
  .ucd-card--1, .ucd-card--3 { --card-bg: var(--card-1); }
  .ucd-card--2 { --card-bg: var(--card-2); }
  .ucd-card-text { display: flex; flex-direction: column; gap: 14px; padding: 44px; }
  .ucd-step { font-size: 13px; font-weight: var(--kd-weight-medium); letter-spacing: .04em; text-transform: uppercase; color: var(--card-step); }
  .ucd-card h3 { font-size: clamp(26px, 3vw, 38px); line-height: 1.12; }
  .ucd-card p { font-size: 18px; line-height: 1.45; opacity: .88; }
  .ucd-card-media { display: flex; align-items: center; justify-content: center; background: var(--kd-blue-1); }
  .ucd-card-media :global(.iso-ic) { color: var(--kd-white); }
  .ucd-card-media :global(.iso-ic polygon) { fill: var(--kd-blue-1); }
  @media (max-width: 880px) {
    .ucd-card { grid-template-columns: 1fr; position: relative; top: auto; height: auto; }
    .ucd-card-media { order: -1; min-height: 170px; }
    .ucd-card-media :global(.iso-ic) { width: 104px !important; height: 104px !important; }
    .ucd-card-text { padding: 28px; }
  }

  /* ---------- funnel: bars narrow towards the goal, leak notes on the right ---------- */
  .ucd-funnel { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 14px; max-width: 1000px; }
  .ucd-funnel li { display: grid; grid-template-columns: minmax(0, 3fr) minmax(0, 2fr); gap: 24px; align-items: center; }
  .ucd-funnel-bar { width: var(--w); padding: 18px 22px; border-radius: var(--kd-radius); background: var(--kd-blue-2); color: var(--kd-white); font-size: 18px; font-weight: var(--kd-weight-medium); }
  .ucd-funnel li:nth-child(2) .ucd-funnel-bar { opacity: .82; }
  .ucd-funnel li:nth-child(3) .ucd-funnel-bar { opacity: .64; }
  .ucd-funnel li.is-goal .ucd-funnel-bar { opacity: 1; background: var(--kd-signal-1); color: var(--kd-blue-1); }
  .ucd-funnel-note { position: relative; padding-left: 18px; font-size: 16px; line-height: 1.4; color: var(--kd-fg-2); }
  .ucd-funnel-note::before { content: ""; position: absolute; left: 0; top: .6em; width: 10px; border-top: 2px dashed var(--kd-lilac); }
  .ucd-funnel li.is-goal .ucd-funnel-note { color: var(--kd-accent); font-weight: var(--kd-weight-medium); }
  @media (max-width: 720px) {
    .ucd-funnel li { grid-template-columns: 1fr; gap: 6px; }
    .ucd-funnel-bar { width: 100%; }
  }

  /* ---------- also included ---------- */
  .ucd-also { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 20px; }
  .ucd-also-card { padding: 28px; border-radius: var(--kd-radius); background: var(--kd-surface); border: 1px solid var(--kd-line); border-left: 4px solid var(--accent-line); }
  .ucd-also-card h3 { font-size: var(--kd-text-s); line-height: var(--kd-lh-s); margin-bottom: 8px; }
  .ucd-also-card p { font-size: 16px; line-height: 1.5; color: var(--kd-fg-2); }
  .ucd-tags { margin-top: 32px; }
  .ucd-tags-head { margin-bottom: 12px !important; font-size: 13px; font-weight: var(--kd-weight-medium); letter-spacing: .04em; text-transform: uppercase; color: var(--kd-fg-2); }
  .ucd-tags ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 10px; }
  .ucd-tags li { padding: 6px 14px; border-radius: var(--kd-radius); border: 2px solid var(--kd-line); font-size: 15px; font-weight: var(--kd-weight-medium); }

  /* ---------- steps as mixed-size cards (bento) ----------
     One large card leads, the others sit beside it at different sizes.
     Hover, focus or a tap shrinks the image and opens the list of what the
     step includes. Fixed row heights, so nothing around it moves. */
  .ucd-bento { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); grid-auto-rows: 440px; gap: 20px; }
  .ucd-bento--3 { grid-auto-rows: 330px; }
  .ucd-bento--3 .ucd-tile--1 { grid-column: 1 / 3; grid-row: 1 / 3; }
  .ucd-bento--4 .ucd-tile--1 { grid-column: 1 / 3; }
  .ucd-bento--4 .ucd-tile--4 { grid-column: 2 / 4; }
  .ucd-tile { display: flex; flex-direction: column; border-radius: var(--kd-radius); overflow: hidden; background: var(--card-bg); color: var(--card-ink); outline: none; cursor: pointer; }
  .ucd-tile:focus-visible { box-shadow: 0 0 0 3px var(--kd-accent); }
  .ucd-tile--1, .ucd-tile--4 { --card-bg: var(--card-1); }
  .ucd-tile--2, .ucd-tile--3 { --card-bg: var(--card-2); }
  .ucd-tile-media { flex: 1 1 auto; min-height: 72px; display: flex; align-items: center; justify-content: center; background: var(--kd-blue-1); transition: flex-grow .45s ease; }
  .ucd-tile-media :global(.iso-ic) { color: var(--kd-white); transition: transform .45s ease; }
  .ucd-tile-media :global(.iso-ic polygon) { fill: var(--kd-blue-1); }
  .ucd-tile-text { display: flex; flex-direction: column; gap: 10px; padding: 24px 28px 28px; }
  .ucd-tile h3 { font-size: clamp(21px, 2.1vw, 27px); line-height: 1.15; }
  .ucd-tile--1 h3 { font-size: clamp(26px, 3vw, 36px); }
  .ucd-tile p { font-size: 16px; line-height: 1.45; opacity: .88; }
  .ucd-tile-more { list-style: none; margin: 0; padding: 0; display: grid; gap: 6px; max-height: 0; opacity: 0; overflow: hidden; transition: max-height .45s ease, opacity .3s ease; }
  .ucd-tile-more li { position: relative; padding-left: 20px; font-size: 15px; font-weight: var(--kd-weight-medium); }
  .ucd-tile-more li::before { content: ""; position: absolute; left: 0; top: .5em; width: 9px; height: 9px; border-radius: 2px; background: currentColor; opacity: .7; }
  .ucd-tile:is(:hover, :focus-visible, :focus-within) .ucd-tile-media { flex-grow: 0; }
  .ucd-tile:is(:hover, :focus-visible, :focus-within) .ucd-tile-media :global(.iso-ic) { transform: scale(.55); }
  .ucd-tile:is(:hover, :focus-visible, :focus-within) .ucd-tile-more { max-height: 10em; opacity: 1; transition-delay: .1s; }
  .ucd-bento:hover .ucd-tile:not(:hover) .ucd-tile-media { flex-grow: 1; }
  .ucd-bento:hover .ucd-tile:not(:hover) .ucd-tile-media :global(.iso-ic) { transform: none; }
  .ucd-bento:hover .ucd-tile:not(:hover) .ucd-tile-more { max-height: 0; opacity: 0; transition-delay: 0s; }
  @media (max-width: 880px) {
    .ucd-bento, .ucd-bento--3 { grid-template-columns: 1fr 1fr; grid-auto-rows: auto; }
    .ucd-bento .ucd-tile--1, .ucd-bento--4 .ucd-tile--4 { grid-column: 1 / -1; grid-row: auto; }
    .ucd-tile-media { flex: none; height: 160px; }
    .ucd-tile-more { max-height: none; opacity: 1; }
    .ucd-tile { cursor: default; }
  }
  @media (max-width: 560px) { .ucd-bento, .ucd-bento--3 { grid-template-columns: 1fr; } }
  @media (prefers-reduced-motion: reduce) { .ucd-tile-media, .ucd-tile-more, .ucd-tile-media :global(.iso-ic) { transition: none; } }

  /* ---------- steps as expanding cards ----------
     From the "Wähle deine Zahlungsart" row on klarna.com/de (screenshots in
     design/Klarna example/): equal image cards in one row; hover, focus or a
     tap widens one card and narrows the others, and its bottom panel opens to
     show the step text. Solid panel in the department colour (no glass).
     Phones and reduced motion: a plain column with all text visible. */
  .ucd-expand { display: flex; gap: 16px; height: clamp(440px, 60vh, 540px); }
  .ucd-xcard { position: relative; flex: 1 1 0; min-width: 0; border-radius: var(--kd-radius); overflow: hidden; background: var(--kd-blue-1); color: var(--card-ink); cursor: pointer; outline: none; transition: flex-grow .55s cubic-bezier(.2, .7, .2, 1); }
  .ucd-xcard:is(:hover, :focus-visible, :focus-within) { flex-grow: 3.2; }
  .ucd-xcard:focus-visible { box-shadow: 0 0 0 3px var(--kd-accent); }
  /* while the pointer is over the row, only the hovered card is wide (a clicked card keeps focus otherwise) */
  .ucd-expand:hover .ucd-xcard:not(:hover) { flex-grow: 1; }
  .ucd-xcard-media { position: absolute; inset: 0 0 96px; display: flex; align-items: center; justify-content: center; }
  .ucd-xcard-media :global(.iso-ic) { color: var(--kd-white); }
  .ucd-xcard-media :global(.iso-ic polygon) { fill: var(--kd-blue-1); }
  .ucd-xcard-panel { position: absolute; left: 14px; right: 14px; bottom: 14px; display: flex; flex-direction: column; gap: 6px; padding: 16px 18px; border-radius: var(--kd-radius); background: var(--card-1); color: var(--card-ink); }
  .ucd-xcard:nth-child(even) .ucd-xcard-panel { background: var(--card-2); }
  .ucd-xcard-panel h3 { font-size: 19px; line-height: 1.2; }
  .ucd-xcard-panel p { max-height: 0; opacity: 0; overflow: hidden; font-size: 16px; line-height: 1.45; transition: max-height .45s ease, opacity .3s ease; }
  .ucd-xcard:is(:hover, :focus-visible, :focus-within) .ucd-xcard-panel { right: auto; max-width: min(560px, calc(100% - 28px)); }
  .ucd-xcard:is(:hover, :focus-visible, :focus-within) .ucd-xcard-panel h3 { font-size: clamp(22px, 2.2vw, 28px); }
  .ucd-xcard:is(:hover, :focus-visible, :focus-within) .ucd-xcard-panel p { max-height: 12em; opacity: .9; transition-delay: .15s; }
  .ucd-expand:hover .ucd-xcard:not(:hover) .ucd-xcard-panel { right: 14px; max-width: none; }
  .ucd-expand:hover .ucd-xcard:not(:hover) .ucd-xcard-panel h3 { font-size: 19px; }
  .ucd-expand:hover .ucd-xcard:not(:hover) .ucd-xcard-panel p { max-height: 0; opacity: 0; transition-delay: 0s; }
  @media (max-width: 880px), (prefers-reduced-motion: reduce) {
    .ucd-expand { flex-direction: column; height: auto; }
    .ucd-xcard, .ucd-xcard:is(:hover, :focus-visible, :focus-within) { flex: none; cursor: default; transition: none; }
    .ucd-xcard-media { position: relative; inset: auto; height: 180px; }
    .ucd-xcard-panel, .ucd-xcard:is(:hover, :focus-visible, :focus-within) .ucd-xcard-panel { position: static; max-width: none; border-radius: 0; padding: 24px; }
    .ucd-xcard-panel p { max-height: none; opacity: .9; }
  }

  /* ---------- outcomes ---------- */
  .ucd-out { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  @media (max-width: 880px) { .ucd-out { grid-template-columns: 1fr; } }
  .ucd-out-card { padding: 28px; border-radius: var(--kd-radius); background: var(--kd-surface); border: 1px solid var(--kd-line); border-top: 4px solid var(--accent-line); }
  .ucd-out-card b { display: block; font-size: 34px; line-height: 1.12; font-weight: var(--kd-weight-medium); color: var(--kd-accent); margin-bottom: 6px; }
  .ucd-out-card p { font-size: 16px; line-height: 1.45; color: var(--kd-fg-2); }

  /* ---------- native operator ---------- */
  .ucd-op { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 48px; align-items: start; }
  @media (max-width: 880px) { .ucd-op { grid-template-columns: 1fr; gap: 24px; } }
  .ucd-op-head { margin-bottom: 0; }
  .ucd-op-body { display: flex; flex-direction: column; gap: 18px; align-items: flex-start; }
  .ucd-op-faces { display: flex; }
  .ucd-op-faces img { width: 64px; height: 64px; border-radius: 50%; object-fit: cover; border: 3px solid var(--kd-surface-2); }
  .ucd-op-faces img + img { margin-left: -14px; }
  .ucd-op-body p { font-size: var(--kd-text-s); line-height: var(--kd-lh-s); color: var(--kd-fg-2); }
  .ucd-link { font-size: 18px; font-weight: var(--kd-weight-medium); color: var(--kd-accent); text-decoration: none; }
  .ucd-link:hover { text-decoration: underline; }

  /* ---------- route comparison: cards, Kadanco card on navy with department-coloured marks ---------- */
  .ucd-sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  .ucd-routes { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); gap: 16px; }
  .ucd-route { display: flex; flex-direction: column; gap: 10px; padding: 24px; border-radius: var(--kd-radius); background: var(--kd-surface); border: 1px solid var(--kd-line); }
  .ucd-route h3 { font-size: 20px; line-height: 1.25; }
  .ucd-route p { flex: 1; font-size: 16px; line-height: 1.5; color: var(--kd-fg-2); }
  .ucd-checks { list-style: none; margin: 6px 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
