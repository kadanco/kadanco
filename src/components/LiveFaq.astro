---
// src/components/LiveFaq.astro
// The FAQ section in the live kadanco.com design (branch main): paper band,
// centred filled "FAQ" label, "Questions, Answered." and a three-column grid
// of white cards. The questions and answers are the new homepage copy,
// passed in from HomePage.astro (EN and DE). The live look (10px radius,
// filled label, old paper ground) is scoped to this section. In dark mode it
// switches to the site's dark theme colours; light stays as live.
// Note: the live label uses weight 600, which the site no longer loads
// (brand rule: 400 and 500), so the browser shows it at 500.
interface Props {
  eyebrow: string;
  h2a: string;
  h2b: string;
  faqs: { q: string; a: string }[];
}
const { eyebrow, h2a, h2b, faqs } = Astro.props;
---
<section id="faq" class="section band-paper center live-faq" data-theme="light">
  <div class="container">
    <span class="eyebrow indigo">{eyebrow}</span>
    <h2>{h2a} <span class="hl-indigo">{h2b}</span></h2>
    <div class="grid cols-3" style="margin-top:48px">
      {faqs.map((f) => (
        <div class="card faq-card">
          <h3>{f.q}</h3>
          <p>{f.a}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  /* live values, scoped to this section only */
  .live-faq { --radius: 10px; --paper: var(--kd-legacy-paper); color: var(--lv-fg, var(--kd-ink)); }
  .live-faq .hl-indigo { color: var(--lv-accent, var(--indigo)); }
  .live-faq .card { background: var(--lv-card, var(--kd-white)); border-color: var(--lv-line, var(--border)); }
  .live-faq .faq-card h3 { color: var(--lv-fg, var(--indigo-deep)); }
  .live-faq .faq-card p { color: var(--lv-fg2, var(--ink)); }
  .live-faq .eyebrow { display: inline-block; font-size: 0.74rem; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; padding: 8px 14px; border-radius: var(--radius); border: 0; margin-bottom: 24px; }
  .live-faq .eyebrow.indigo { background: var(--kd-blue-2); color: var(--kd-white); }

  /* dark mode: same layout, the site's dark theme colours (light keeps the live look) */
  :global(:root[data-mode="dark"]) .live-faq { --paper: var(--kd-bg); --lv-fg: var(--kd-fg); --lv-fg2: var(--kd-fg-2); --lv-card: var(--kd-surface); --lv-line: var(--kd-line); --lv-accent: var(--kd-accent); --lv-tag: var(--kd-night-line); }
  @media (prefers-color-scheme: dark) { :global(:root:not([data-mode])) .live-faq { --paper: var(--kd-bg); --lv-fg: var(--kd-fg); --lv-fg2: var(--kd-fg-2); --lv-card: var(--kd-surface); --lv-line: var(--kd-line); --lv-accent: var(--kd-accent); --lv-tag: var(--kd-night-line); } }
</style>
