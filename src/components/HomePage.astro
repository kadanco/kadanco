    ],
    complianceEyebrow: 'Compliance',
    badges: [
      { src: 'https://assets.kadanco.com/badges/gdpr.svg', alt: 'GDPR compliant' },
      { src: 'https://assets.kadanco.com/badges/eu.svg', alt: 'EU' },
      { src: 'https://assets.kadanco.com/badges/made-in-germany.svg', alt: 'Made in Germany' },
    ],
    ctaEyebrow: 'Free, no obligation',
    ctaH2a: 'Tell Us Where It Hurts.',
    ctaH2b: "We'll Reply In A Day.",
  },
  de: {
    eyebrow: 'Product · Marketing · Sales Engineering',
    h1a: 'Schluss mit Beratung.',
    h1b: 'Kaufen Sie Umsetzung.',
    lead: 'Produkt-, Marketing- und Vertriebserfahrung aus einem erfahrenen Team. Wir verantworten den Plan und setzen ihn selbst um. Keine Übergabe an Junioren.',
    cta: 'Kostenloses Audit anfordern',
    offersLink: 'Zu den Angeboten',
    offersEyebrow: 'Drei Erfahrungen. Eine Methode.',
    offersH2a: 'Ein Team für Ihren',
    offersH2b: 'ganzen Funnel.',
    offersLede: 'Jedes Angebot wird von Anfang bis Ende gebaut und einsatzbereit übergeben.',
    cards: [
      { id: 'product', tone: 'product', label: '01 · Produkt', title: 'Product Design Engineering', body: 'Audit, Designsystem und neu gestaltete Nutzerwege für das Produkt selbst.', link: 'Produkt-Review buchen' },
      { id: 'marketing', tone: 'marketing', label: '02 · Marketing', title: 'Product Marketing Engineering', body: 'Positionierung, Launch und Inhalte, die Ihr Produkt verständlich machen.', link: 'Positionierung schärfen' },
      { id: 'sales', tone: 'sales', label: '03 · Vertrieb', title: 'Sales Engineering', body: 'Eine Pipeline, die nicht an einer Gründerin oder einem Gründer hängt.', link: 'Pipeline aufbauen' },
    ],
    stepA: 'Mit Kadanco gehen Sie einen Schritt weiter, mit',
    stepB: 'Product Marketing Engineering.',
    logosEyebrow: 'Zwei Karrieren hinter der Arbeit',
    logosNote: 'Wir bringen vier Jahrzehnte gemeinsame Erfahrung aus Enterprise-Software, Services, Automotive, Pharma und SaaS mit, in Produkt, Marketing und Vertrieb.',
    ucEyebrow: 'Use Cases',
    ucH2a: 'Was die Funktion',
    ucH2b: 'liefert.',
    ucLede: 'Einige der Ergebnisse, für die Teams uns holen, und die Workstreams, die dahinterstehen.',
    ucLink: 'Zum Use Case',
    useCases: [
      { eyebrow: 'Markteintritt', name: 'DACH-Markteintritt', href: '/de/use-cases/dach-market-entry/', summary: 'Eine deutschsprachige Präsenz, die wächst, End-to-End betrieben.', bundle: ['Lokalisierte Positionierung', 'Ein deutschsprachiger Content-Motor', 'LinkedIn für das Team', 'Ein Event-Programm', 'Distribution, die sich aufbaut'] },
      { eyebrow: 'Founder-Content', name: 'Founder-Content & Pipeline', href: '/de/use-cases/founder-led-content/', summary: 'Ein Publishing-Programm in der Stimme der Gründer, das messbare Pipeline erzeugt.', bundle: ['Messaging & Positionierung', 'Ghostwriting & Content', 'SEO & GEO', 'Outbound, vorgewärmt durch Content', 'RevOps, um Conversions zu messen'] },
      { eyebrow: 'Conversion', name: 'Relaunch, der die Conversion hebt', href: '/de/use-cases/conversion-rebuild/', summary: 'Eine Website und eine Botschaft, die zum heutigen Unternehmen passen.', bundle: ['Neupositionierung auf den Stand von heute', 'Marken- und Website-Relaunch', 'Vertriebsunterlagen', 'Conversion-Optimierung', 'Lifecycle & Automatisierung'] },
      { eyebrow: 'Events', name: 'Event-Pipeline-Engineering', href: '/de/use-cases/event-pipeline/', summary: 'Bewertete Events, ABM vor dem Event und ein ROI-Report in 30 Tagen.', bundle: ['Events, bewertet nach ICP-Überschneidung und Personendichte', 'LinkedIn- und Meta-ABM ab vier Wochen vorher, mit Kalender-Slots', 'Dinners und Roundtables, auf denen Deals entstehen', 'Anreicherung am selben Tag, CRM-Sync und sequenziertes Follow-up'] },
    ],
    aboutEyebrow: 'Über uns',
    aboutH2a: 'Zwei Macher,',
    aboutH2b: 'die Verantwortung übernehmen.',
    aboutIntro: 'ist eine komplette Marketing-Funktion für B2B-Unternehmen. Zwei Macher übernehmen die Verantwortung für die Strategie und setzen sie selbst um. Ein Team, ein System, eine Zahl, die Sie steuern. Kein Agentur-Overhead, keine Übergaben an Junioren, kein Stapel Freelancer, den Sie managen müssen.',
    founders: [
      { name: 'Maria', photo: 'https://assets.kadanco.com/public/maria.jpeg', role: 'Gründerin & Product Managerin', body: '20+ Jahre Produkterfahrung, Made in Berlin | B2B Sustainable Energy Management | EdTech | Financial Wellbeing', linkedin: 'https://www.linkedin.com/in/miarichter/' },
      { name: 'Karan', photo: 'https://assets.kadanco.com/public/karan.jpeg', role: 'Gründer & Growth Manager', body: 'Ersetzen Sie Ihren GTM-Stack durch eine Plattform | Founder @ hubsell', linkedin: 'https://www.linkedin.com/in/krnshrm/' },
    ],
    founderLink: 'LinkedIn-Profil ansehen',
    tags: ['Produktentwicklung', 'Produktmanagement', 'Produktdesign', 'Produktmarketing', 'Leadgenerierung', 'Demand Generation', 'Growth Marketing', 'E-Mail-Marketing', 'Marketingberatung', 'Marketingstrategie', 'Copywriting'],
    faqEyebrow: 'FAQ',
    faqH2a: 'Fragen,',
    faqH2b: 'beantwortet.',
    faqs: [
      { q: 'Wie arbeiten Sie mit uns?', a: 'Wir arbeiten als Ihre Marketing-Funktion in einem Quartalsmandat: Markt, ICP und Funnel verstehen, die Maßnahmen festlegen, die die Pipeline am stärksten bewegen, und sie dann selbst umsetzen. Vier Kunden gleichzeitig.' },
      { q: 'Wie schnell sehen wir Ergebnisse?', a: 'Die erste Umsetzung ist innerhalb von zwei Wochen nach Start live. Danach arbeiten wir in Quartalszyklen: planen, liefern, auswerten, und der Motor wird stärker.' },
      { q: 'Wer macht die Arbeit?', a: 'Die beiden Macher, die Ihre Arbeit definieren, sind die beiden, die sie machen. Keine Account-Ebene, keine Junior-Umsetzung, kein Aufschlag.' },
      { q: 'Was kostet das?', a: 'Wir schneiden jedes Mandat auf das zu, was Ihre Pipeline braucht, mit einer planbaren Untergrenze und einer Obergrenze, die Sie steuern. Am schnellsten kommen Sie in einem kurzen Gespräch zu einer Zahl.' },
      { q: 'Nur Unternehmen, die nach Deutschland kommen?', a: 'Nein. Wir betreiben die komplette Marketing-Funktion für B2B-Unternehmen allgemein. Der DACH-Markteintritt ist ein Use Case, den wir auf muttersprachlichem Niveau beherrschen, nicht das ganze Angebot.' },
      { q: 'Was gehört zur Funktion?', a: 'Der ganze Stack: Positionierung, Marke und Website, Content und Ghostwriting, ABM und Demand, Paid, Events, SEO und GEO, CRO und RevOps. Wir setzen die Maßnahmen ein, die Ihre Pipeline bewegen.' },
    ],
    complianceEyebrow: 'Compliance',
    badges: [
      { src: 'https://assets.kadanco.com/badges/gdpr.svg', alt: 'DSGVO-konform' },
      { src: 'https://assets.kadanco.com/badges/eu.svg', alt: 'EU' },
      { src: 'https://assets.kadanco.com/badges/made-in-germany.svg', alt: 'Made in Germany' },
    ],
    ctaEyebrow: 'Kostenlos und unverbindlich',
    ctaH2a: 'Sagen Sie uns, wo es hakt.',
    ctaH2b: 'Wir antworten innerhalb eines Tages.',
  },
};

const c = copy[locale] ?? copy.en;

const logos = [
  { file: 'mercedes-benz', alt: 'Mercedes-Benz' },
  { file: 'opel', alt: 'Opel' },
  { file: 'toyota', alt: 'Toyota' },
  { file: 'merck', alt: 'Merck' },
  { file: 'oracle', alt: 'Oracle' },
  { file: 'consorsbank', alt: 'Consorsbank' },
  { file: 'dkb', alt: 'DKB' },
  { file: 'sparkasse', alt: 'Sparkasse' },
];
---
<main id="top" class="home">

  <!-- ===================== HERO ===================== -->
  <section class="home-hero">
    <div class="container home-hero-in">
      <span class="home-eyebrow home-eyebrow--lilac">{c.eyebrow}</span>
      <h1>{c.h1a} <em>{c.h1b}</em></h1>
      <p>{c.lead}</p>
      <div class="home-actions">
        <a href="#contact" class="btn btn-cta btn-lg" data-open-modal>{c.cta}</a>
        <a href="#offers" class="btn btn-ghost btn-lg">{c.offersLink}</a>
      </div>
    </div>
  </section>

  <!-- ===================== CLIENT LOGOS (infinite marquee) ===================== -->
  <section class="home-logos">
    <div class="container">
      <span class="home-eyebrow home-logos-head">{c.logosEyebrow}</span>
      <div class="logo-marquee">
        <div class="logo-track">
          {logos.map((l) => <img src={`https://assets.kadanco.com/logos/${l.file}.svg`} alt={l.alt} class="logo" />)}
          {/* decorative duplicate set for the seamless loop */}
          {logos.map((l) => <img src={`https://assets.kadanco.com/logos/${l.file}.svg`} alt="" aria-hidden="true" class="logo logo--dupe" />)}
        </div>
      </div>
      <p class="home-logos-note">{c.logosNote}</p>
    </div>
  </section>

  <!-- ===================== OFFERS ===================== -->
  <section class="home-sec" id="offers">
    <div class="container">
      <div class="home-head">
        <span class="home-eyebrow">{c.offersEyebrow}</span>
        <h2>{c.offersH2a} <em>{c.offersH2b}</em></h2>
        <p class="home-lede">{c.offersLede}</p>
      </div>
      <div class="home-offers">
        {c.cards.map((card) => (
          <a class={`home-card home-card--${card.tone}`} id={card.id} href="#contact" data-open-modal>
            <span class="home-lbl">{card.label}</span>
            <h3>{card.title}</h3>
            <p>{card.body}</p>
            <span class="home-link">{card.link} →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ===================== STEP BAND ===================== -->
  <section class="home-band">
    <div class="container home-band-in">
      <span class="home-mark" aria-hidden="true"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M12 19V5"/><path d="M5 12l7-7 7 7"/></svg></span>
      <p>{c.stepA} <mark>{c.stepB}</mark></p>
    </div>
  </section>

  <!-- ===================== USE CASES (teaser cards) ===================== -->
  <section class="home-sec home-sec--alt" id="use-cases">
    <div class="container">
      <div class="home-head">
        <span class="home-eyebrow">{c.ucEyebrow}</span>
        <h2>{c.ucH2a} <em>{c.ucH2b}</em></h2>
        <p class="home-lede">{c.ucLede}</p>
      </div>
      <div class="home-uc">
        {c.useCases.map((u) => (
          <a class="home-uc-card" href={u.href}>
            <span class="home-lbl home-lbl--blue">{u.eyebrow}</span>
            <h3>{u.name}</h3>
            <p>{u.summary}</p>
            <ul class="home-uc-bundle">
              {u.bundle.map((b) => <li>{b}</li>)}
            </ul>
            <span class="home-link home-link--accent">{c.ucLink} →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ===================== ABOUT: content from the old homepage, October design ===================== -->
  <section class="home-sec" id="about">
    <div class="container">
      <div class="home-sh">
        <div class="home-head">
          <span class="home-eyebrow">{c.aboutEyebrow}</span>
          <h2>{c.aboutH2a} <em>{c.aboutH2b}</em></h2>
        </div>
        <p class="home-sh-intro"><span class="home-strong">KADANCO</span> {c.aboutIntro}</p>
      </div>
      <div class="home-founders">
        {c.founders.map((f) => (
          <article class="home-founder">
            <img class="home-founder-photo" src={f.photo} alt={f.name} width="104" height="104" loading="lazy" />
            <div class="home-founder-b">
              <span class="home-lbl home-lbl--blue">{f.role}</span>
              <h3>{f.name}</h3>
              <p>{f.body}</p>
              <a class="home-link home-link--accent" href={f.linkedin} target="_blank" rel="noopener">{c.founderLink} →</a>
            </div>
          </article>
        ))}
      </div>
      <ul class="home-tags">
        {c.tags.map((tag) => <li class="home-lbl home-lbl--outline">{tag}</li>)}
      </ul>
    </div>
  </section>

  <!-- ===================== FAQ ===================== -->
  <section class="home-sec home-sec--alt" id="faq">
    <div class="container">
      <div class="home-head">
        <span class="home-eyebrow">{c.faqEyebrow}</span>
        <h2>{c.faqH2a} <em>{c.faqH2b}</em></h2>
      </div>
      <div class="home-faq">
        {c.faqs.map((f) => (
          <article class="home-faq-card">
            <h3>{f.q}</h3>
            <p>{f.a}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ===================== COMPLIANCE ===================== -->
  <section class="home-compliance">
    <div class="container home-compliance-in">
      <span class="home-eyebrow">{c.complianceEyebrow}</span>
      <div class="home-badges">
        {c.badges.map((b) => <img src={b.src} alt={b.alt} width="104" height="104" loading="lazy" />)}
      </div>
    </div>
  </section>

  <!-- ===================== CTA BAND ===================== -->
  <section class="home-ctaband" id="contact">
    <div class="container home-ctaband-in">
      <span class="home-eyebrow home-eyebrow--white">{c.ctaEyebrow}</span>
      <h2>{c.ctaH2a} <span class="home-soft">{c.ctaH2b}</span></h2>
      <a href="#contact" class="btn btn-cta btn-lg" data-open-modal>{c.cta}</a>
    </div>
  </section>

</main>

<style>
  .home { background: var(--kd-bg); color: var(--kd-fg); }
  .home h1, .home h2, .home h3 { margin: 0; font-weight: var(--kd-weight-medium); letter-spacing: .06px; text-wrap: balance; }
  .home p { margin: 0; }
  .home em { font-style: normal; }

  .home-eyebrow { font-size: var(--kd-text-xs); line-height: var(--kd-lh-xs); font-weight: var(--kd-weight-medium); letter-spacing: .04em; text-transform: uppercase; color: var(--kd-accent); }
  .home-eyebrow--lilac { color: var(--kd-lilac); }
  .home-eyebrow--white { color: var(--kd-white); opacity: .85; }

  /* links: S step (21/28, weight 500) with an arrow, per the brand system */
  .home-link { font-size: var(--kd-text-s); line-height: var(--kd-lh-s); font-weight: var(--kd-weight-medium); text-decoration: none; }
  .home-link--accent { color: var(--kd-accent); }
  .home-link--accent:hover { text-decoration: underline; }

  /* ---------- hero: navy with a faint grid, clears the fixed 80px nav ---------- */
  .home-hero {
    background-color: var(--kd-blue-1);
    background-image: linear-gradient(rgba(255,255,255,.05) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.05) 1px, transparent 1px);
    background-size: 40px 40px;
    color: var(--kd-white);
  }
  .home-hero-in { padding-top: calc(80px + 64px); padding-bottom: 72px; display: flex; flex-direction: column; gap: 24px; align-items: flex-start; }
  .home-hero h1 { font-size: var(--kd-text-xl); line-height: var(--kd-lh-xl); max-width: 900px; }
  .home-hero h1 em { color: var(--kd-signal-1); }
  .home-hero p { font-size: clamp(19px, 2.4vw, 28px); line-height: 1.3; color: var(--kd-lilac-soft); max-width: 42ch; }
  .home-actions { display: flex; gap: 14px; flex-wrap: wrap; margin-top: 4px; }

  /* ---------- sections ---------- */
  .home-sec { padding: 72px 0; }
  .home-head { display: flex; flex-direction: column; gap: 12px; margin-bottom: 32px; max-width: 60ch; }
  .home-sec h2 { font-size: var(--kd-text-l); line-height: var(--kd-lh-l); }
  .home-sec h2 em { color: var(--kd-accent); }
  .home-lede { font-size: var(--kd-text-s); line-height: var(--kd-lh-s); color: var(--kd-fg-2); }

  /* ---------- offer cards (department colours, fixed in both themes) ---------- */
  .home-offers { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; }
  @media (max-width: 820px) { .home-offers { grid-template-columns: 1fr; } }
  .home-card { display: flex; flex-direction: column; gap: 18px; padding: 32px; border-radius: var(--kd-radius); min-height: 340px; text-decoration: none; transition: transform .18s ease; }
  .home-card:hover { transform: translateY(-4px); }
  .home-card h3 { font-size: var(--kd-text-m); line-height: var(--kd-lh-m); }
  .home-card p { font-size: 19px; line-height: 1.4; }
  .home-card .home-link { margin-top: auto; }
  .home-lbl { display: inline-flex; align-items: center; align-self: flex-start; padding: 3px 12px; border-radius: var(--kd-radius); font-size: 14px; font-weight: var(--kd-weight-medium); letter-spacing: .04em; text-transform: uppercase; }
  .home-lbl--blue { background: var(--kd-blue-2); color: var(--kd-white); }

  .home-card--product { background: var(--kd-dept-product); color: var(--kd-white); }
  .home-card--product .home-lbl { background: var(--kd-signal-1); color: var(--kd-blue-1); }
  .home-card--product p { color: var(--kd-lilac-tint); }
  .home-card--product .home-link { color: var(--kd-signal-1); }
  .home-card--marketing { background: var(--kd-dept-marketing); color: var(--kd-blue-1); }
  .home-card--sales { background: var(--kd-dept-sales); color: var(--kd-blue-1); }
