---
// src/components/HomePage.astro
// The homepage, built from design/02_pages/Kadanco_Home-20261015-0850.html.
// Used by src/pages/index.astro (EN) and src/pages/de/index.astro (DE), so
// both languages share one layout; only the copy below differs.
//
// Supports dark mode: every ground and text colour that should switch uses
// the theme role tokens (--kd-bg, --kd-surface, --kd-fg, ...). The navy hero,
// the three department cards and the blue CTA band keep their fixed colours.
// Client logos and compliance badges turn light in dark mode via --kd-logo-filter.
//
// Class names carry a home- prefix so they never collide with global.css.
import { asLocale } from '../i18n/utils';

const locale = asLocale(Astro.currentLocale);

const copy = {
  en: {
    eyebrow: 'Product · Marketing · Sales Engineering',
    h1a: 'Stop Buying Advice.',
    h1b: 'Start Buying Execution.',
    lead: 'Product, marketing and sales experience from one senior team. We own the plan and run it. No junior hand-offs.',
    cta: 'Get A Free Audit',
    offersLink: 'See The Offers',
    offersEyebrow: 'Three experiences. One method.',
    offersH2a: 'One Team Across Your',
    offersH2b: 'Whole Funnel.',
    offersLede: 'Each offer is engineered end to end and handed off ready to run.',
    cards: [
      { id: 'product', tone: 'product', label: '01 · Product', title: 'Product Design Engineering', body: 'Audit, design system and redesigned journeys for the product itself.', link: 'Book A Product Review' },
      { id: 'marketing', tone: 'marketing', label: '02 · Marketing', title: 'Product Marketing Engineering', body: 'Positioning, launch and content that make the product make sense.', link: 'Fix Your Positioning' },
      { id: 'sales', tone: 'sales', label: '03 · Sales', title: 'Sales Engineering', body: "A pipeline engine that doesn't depend on one founder.", link: 'Build My Pipeline' },
    ],
    stepA: 'With Kadanco you go one step further and advance with',
    stepB: 'Product Marketing Engineering.',
    logosEyebrow: 'Two careers behind the work',
    logosNote: 'We bring four decades of collective experience across enterprise software, services, automotive, pharma, and SaaS in product, marketing, and sales.',
    ucEyebrow: 'Use Cases',
    ucH2a: 'What The Function',
    ucH2b: 'Delivers.',
    ucLede: 'A few of the outcomes teams hire us for, and the bundle of workstreams behind each.',
    ucLink: 'Full use case',
    useCases: [
      { eyebrow: 'Market entry', name: 'DACH market entry', href: '/use-cases/dach-market-entry/', summary: 'A German-language presence that compounds, run end to end.', bundle: ['Localised positioning', 'A German content engine', 'LinkedIn for the team', 'An event motion', 'Distribution that compounds'] },
      { eyebrow: 'Founder content', name: 'Founder-led content & pipeline', href: '/use-cases/founder-led-content/', summary: "A publishing motion in the founder's voice, feeding measurable pipeline.", bundle: ['Messaging & positioning', 'Ghostwriting & content', 'SEO & GEO', 'Outbound warmed by the content', 'RevOps to track what converts'] },
      { eyebrow: 'Conversion', name: 'Rebuild that lifts conversion', href: '/use-cases/conversion-rebuild/', summary: 'A site and message that match where the company actually is now.', bundle: ['Repositioning around where you are now', 'Brand & website rebuild', 'Sales collateral', 'Conversion-rate optimisation', 'Lifecycle & automation'] },
      { eyebrow: 'Events', name: 'Event pipeline engineering', href: '/use-cases/event-pipeline/', summary: 'Scored events, pre-event ABM, and CFO-grade ROI in 30 days.', bundle: ['Events scored by ICP overlap and persona density', 'LinkedIn & Meta ABM from four weeks out, with calendar holds', 'Hosted dinners and roundtables where deals close', 'Same-day enrichment, CRM sync and sequenced follow-up'] },
    ],
    aboutEyebrow: 'Who We Are',
    aboutH2a: 'Two Operators',
    aboutH2b: 'That Take Ownership.',
    aboutIntro: 'is a complete marketing function for B2B companies. Two operators take ownership of the strategy and run the execution themselves. One team, one system of action, one number you control. No agency overhead, no junior hand-offs, no stack of freelancers to manage.',
    founders: [
      { name: 'Maria', photo: 'https://assets.kadanco.com/public/maria.jpeg', role: 'Founder & Product Manager', body: '20+ Product Experience Made in Berlin | B2B Sustainable Energy Management | EdTech | Financial Wellbeing', linkedin: 'https://www.linkedin.com/in/miarichter/' },
      { name: 'Karan', photo: 'https://assets.kadanco.com/public/karan.jpeg', role: 'Founder & Growth Manager', body: 'Replace your GTM stack with one platform | Founder @ hubsell', linkedin: 'https://www.linkedin.com/in/krnshrm/' },
    ],
    founderLink: 'View LinkedIn Profile',
    tags: ['Product Development', 'Product Management', 'Product Design', 'Product Marketing', 'Lead Generation', 'Demand Generation', 'Growth Marketing', 'Email Marketing', 'Marketing Consulting', 'Marketing Strategy', 'Copywriting'],
    faqEyebrow: 'FAQ',
    faqH2a: 'Questions,',
    faqH2b: 'Answered.',
    faqs: [
      { q: 'How do you work with us?', a: 'We run as your marketing function on a quarterly engagement: map the market, ICP and funnel, agree the motions that move pipeline most, then execute them ourselves. Four clients at a time.' },
      { q: 'How fast do we see results?', a: 'First execution is live inside two weeks of kickoff. From there we run in quarterly cycles, plan, ship, review, and the engine compounds.' },
      { q: 'Who does the work?', a: 'The two operators who scope your work are the two who do it. No account-management layer, no junior delivery, no markup.' },
      { q: 'What does it cost?', a: 'We scope each engagement to what your pipeline needs, with a predictable floor and a ceiling you control. The fastest way to a number is a short conversation.' },
      { q: 'Only companies entering Germany?', a: 'No. We run the full marketing function for B2B companies generally. DACH market entry is one use case we do well in native German, not the whole offer.' },
