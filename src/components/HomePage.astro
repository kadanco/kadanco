---
// src/components/HomePage.astro
// The homepage, built from design/02_pages/Kadanco_Home-20261015-0850.html.
// Used by src/pages/index.astro (EN) and src/pages/de/index.astro (DE), so
// both languages share one layout; only the copy below differs.
//
// Supports dark mode: every ground and text colour that should switch uses
// the theme role tokens (--kd-bg, --kd-surface, --kd-fg, ...). The navy hero,
// the three department cards and the blue CTA band keep their fixed colours.
// Use cases come from src/data/use-cases.ts (shared with /use-cases/).
// Who We Are, Compliance and the final CTA are restored exactly as live
// (LiveFounders, LiveCompliance, LiveCta) and keep the pre-October look on purpose.
// Client logos turn light in dark mode via --kd-logo-filter.
//
// Class names carry a home- prefix so they never collide with global.css.
import HomeHero from './HomeHero.astro';
import HomeHeroVisual from './HomeHeroVisual.astro';
import DeptStack from './DeptStack.astro';
import ServiceBoard from './ServiceBoard.astro';
import LiveFounders from './LiveFounders.astro';
import LiveCta from './LiveCta.astro';
import LiveCompliance from './LiveCompliance.astro';
import LiveFaq from './LiveFaq.astro';
import HomeComparison from './HomeComparison.astro';
import HomeSteps from './HomeSteps.astro';
import { useCases } from '../data/use-cases';
import { asLocale, localizedHref } from '../i18n/utils';

const locale = asLocale(Astro.currentLocale);

const copy = {
  en: {
    offersEyebrow: 'Our Services',
    offersH2a: 'One Team Across Your',
    offersH2b: 'Entire Go To Market.',
    offersLede: 'Each offer is built end to end and handed off ready to run.',
    cards: [
      { id: 'product', tone: 'product', label: '01 · Product', title: 'Product Design & Development', body: 'Audit, design system and redesigned journeys to make the product easy to use and adopt.', link: 'Book a UX Review' },
      { id: 'marketing', tone: 'marketing', label: '02 · Marketing', title: 'Digital Marketing & Branding', body: 'Positioning, launch and content that make your story clear and differentiated.', link: 'Book a Strategy Call' },
      { id: 'sales', tone: 'sales', label: '03 · Sales', title: 'Sales Support & Systems', body: 'Methods, tools, and tactics to generate uptick in your sales pipeline.', link: 'Book a Pipeline Audit' },
    ],
    logosEyebrow: 'Two careers behind the expertise',
    logosNote: 'We bring four decades of collective experience across product, marketing, and sales in enterprise software, services, automotive, pharma, and SaaS.',
    ucEyebrow: 'Use Cases',
    ucH2a: 'What We Deliver.',
    ucH2b: 'Across Product, Marketing And Sales.',
    ucLede: 'The problems teams bring us, from the product itself to the sales pipeline.',
    ucAll: 'See All Use Cases',
    faqEyebrow: 'FAQ',
    faqH2a: 'Questions,',
    faqH2b: 'Answered.',
    faqs: [
      { q: 'How do you work with us?', a: 'We work as your product, marketing and sales team on a quarterly engagement: map the product, market, ICP and funnel, agree the few moves that grow revenue most, then do them ourselves. Four clients at a time.' },
      { q: 'How fast do we see results?', a: 'First execution is live inside two weeks of kickoff. From there we run in quarterly cycles, plan, ship, review, and each cycle builds on the last.' },
      { q: 'Who does the work?', a: 'The senior operators who scope your work are the ones who do it. No account-management layer, no junior delivery, no markup.' },
      { q: 'What does it cost?', a: 'We scope each engagement to what your pipeline needs, with a predictable floor and a ceiling you control. The fastest way to a number is a short conversation.' },
      { q: 'Only companies entering Germany?', a: 'No. We plan and run product, marketing and sales for B2B companies generally. DACH market entry is one use case among several, and we do it well in native German.' },
      { q: "What's included?", a: 'Product (UX audit, design system, onboarding), marketing (positioning, website, content, SEO and GEO, campaigns, events) and sales (target lists, outreach, sales process, RevOps). We use whichever of these grow your revenue.' },
    ],
  },
  de: {
    offersEyebrow: 'Drei Erfahrungen. Eine Methode.',
    offersH2a: 'Ein Team für Ihren',
    offersH2b: 'gesamten Go-to-Market.',
    offersLede: 'Jedes Angebot wird von Anfang bis Ende gebaut und einsatzbereit übergeben.',
    cards: [
      { id: 'product', tone: 'product', label: '01 · Produkt', title: 'Produktdesign & Entwicklung', body: 'Audit, Designsystem und neu gestaltete Nutzerwege für das Produkt selbst.', link: 'Produkt-Review buchen' },
      { id: 'marketing', tone: 'marketing', label: '02 · Marketing', title: 'Digitales Marketing & Branding', body: 'Positionierung, Launch und Inhalte, die Ihr Produkt verständlich machen.', link: 'Positionierung schärfen' },
      { id: 'sales', tone: 'sales', label: '03 · Vertrieb', title: 'Vertriebsunterstützung & Systeme', body: 'Eine Pipeline, die nicht an einer Gründerin oder einem Gründer hängt.', link: 'Pipeline aufbauen' },
    ],
    logosEyebrow: 'Zwei Karrieren hinter der Arbeit',
    logosNote: 'Wir bringen vier Jahrzehnte gemeinsame Erfahrung aus Enterprise-Software, Services, Automotive, Pharma und SaaS mit, in Produkt, Marketing und Vertrieb.',
    ucEyebrow: 'Use Cases',
    ucH2a: 'Was wir liefern.',
    ucH2b: 'Über Produkt, Marketing und Vertrieb hinweg.',
    ucLede: 'Die Probleme, mit denen Teams zu uns kommen, vom Produkt selbst bis zur Vertriebspipeline.',
    ucAll: 'Alle Use Cases ansehen',
    faqEyebrow: 'FAQ',
    faqH2a: 'Fragen,',
    faqH2b: 'beantwortet.',
    faqs: [
      { q: 'Wie arbeiten Sie mit uns?', a: 'Wir arbeiten als Ihr Team für Produkt, Marketing und Vertrieb in einem Quartalsmandat: Produkt, Markt, ICP und Funnel verstehen, die wenigen Hebel festlegen, die den Umsatz am stärksten steigern, und sie dann selbst umsetzen. Vier Kunden gleichzeitig.' },
      { q: 'Wie schnell sehen wir Ergebnisse?', a: 'Die erste Umsetzung ist innerhalb von zwei Wochen nach Start live. Danach arbeiten wir in Quartalszyklen: planen, liefern, auswerten, und jeder Zyklus baut auf dem letzten auf.' },
      { q: 'Wer macht die Arbeit?', a: 'Die erfahrenen Macher, die Ihre Arbeit definieren, sind dieselben, die sie machen. Keine Account-Ebene, keine Junior-Umsetzung, kein Aufschlag.' },
      { q: 'Was kostet das?', a: 'Wir schneiden jedes Mandat auf das zu, was Ihre Pipeline braucht, mit einer planbaren Untergrenze und einer Obergrenze, die Sie steuern. Am schnellsten kommen Sie in einem kurzen Gespräch zu einer Zahl.' },
      { q: 'Nur Unternehmen, die nach Deutschland kommen?', a: 'Nein. Wir planen und verantworten Produkt, Marketing und Vertrieb für B2B-Unternehmen allgemein. Der DACH-Markteintritt ist einer von mehreren Use Cases, und wir setzen ihn auf muttersprachlichem Niveau um.' },
      { q: 'Was gehört dazu?', a: 'Produkt (UX-Audit, Designsystem, Onboarding), Marketing (Positionierung, Website, Content, SEO und GEO, Kampagnen, Events) und Vertrieb (Ziellisten, Ansprache, Vertriebsprozess, RevOps). Wir setzen ein, was Ihren Umsatz steigert.' },
    ],
  },
};

const c = copy[locale] ?? copy.en;

// featured case first (wide), then the rest in the grid

const logos = [
  { file: 'mercedes-benz', alt: 'Mercedes-Benz' },
  { file: 'opel', alt: 'Opel' },
  { file: 'toyota', alt: 'Toyota' },
  { file: 'merck', alt: 'Merck' },
  { file: 'oracle', alt: 'Oracle' },
  { file: 'consorsbank', alt: 'Consorsbank' },
  { file: 'dkb', alt: 'DKB' },
  { file: 'sparkasse', alt: 'Sparkasse' },
];
---
<main id="top" class="home">

  <!-- ===================== HERO (text: HomeHero.astro, service stack: HomeHeroVisual.astro) ===================== -->
  <HomeHero><HomeHeroVisual slot="visual" /></HomeHero>

  <!-- ===================== CLIENT LOGOS (infinite marquee) ===================== -->
  <section class="home-logos">
    <div class="container">
      <span class="home-eyebrow home-logos-head">{c.logosEyebrow}</span>
      <div class="logo-marquee">
        <div class="logo-track">
          {logos.map((l) => <img src={`https://assets.kadanco.com/logos/${l.file}.svg`} alt={l.alt} class="logo" />)}
          {/* decorative duplicate set for the seamless loop */}
          {logos.map((l) => <img src={`https://assets.kadanco.com/logos/${l.file}.svg`} alt="" aria-hidden="true" class="logo logo--dupe" />)}
        </div>
      </div>
      <p class="home-logos-note">{c.logosNote}</p>
    </div>
  </section>

  <!-- ===================== COMPARISON: live spot, October route matrix (HomeComparison.astro) ===================== -->
  <HomeComparison />

  <!-- ===================== OFFERS ===================== -->
  <section class="home-sec" id="offers">
    <div class="container">
      <div class="home-head">
        <span class="home-eyebrow">{c.offersEyebrow}</span>
        <h2>{c.offersH2a} <em>{c.offersH2b}</em></h2>
        <p class="home-lede">{c.offersLede}</p>
      </div>
      <div class="home-offers">
        {c.cards.map((card) => (
          <a class={`home-card home-card--${card.tone}`} id={card.id} href="#contact" data-open-modal>
            <ServiceBoard id={card.id as 'product' | 'marketing' | 'sales'} width={128} />
            <span class="home-lbl">{card.label}</span>
            <h3>{card.title}</h3>
            <p>{card.body}</p>
            <span class="home-link">{card.link} →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ===================== USE CASES: one stacked card per department (DeptStack.astro) ===================== -->
  <section class="home-sec home-sec--alt" id="use-cases">
    <div class="container">
      <div class="home-head">
        <span class="home-eyebrow">{c.ucEyebrow}</span>
        <h2>{c.ucH2a} <em>{c.ucH2b}</em></h2>
        <p class="home-lede">{c.ucLede}</p>
      </div>
      <DeptStack cards={c.cards} />
      <a class="btn btn-primary home-uc-all" href={localizedHref(locale, '/use-cases/')}>{c.ucAll}</a>
    </div>
  </section>

  <!-- ===================== WHO WE ARE: restored exactly as live (LiveFounders.astro) ===================== -->
  <LiveFounders />

  <!-- ===================== HOW WE WORK: the live How We Operate, rewritten (HomeSteps.astro) ===================== -->
  <HomeSteps />

  <!-- ===================== FAQ: live design, new questions (LiveFaq.astro) ===================== -->
  <LiveFaq eyebrow={c.faqEyebrow} h2a={c.faqH2a} h2b={c.faqH2b} faqs={c.faqs} />

  <!-- ===================== COMPLIANCE: restored exactly as live (LiveCompliance.astro) ===================== -->
  <LiveCompliance />

  <!-- ===================== FINAL CTA: restored exactly as live (LiveCta.astro) ===================== -->
  <LiveCta />

</main>

<style>
  .home { background: var(--kd-bg); color: var(--kd-fg); }
  .home h1, .home h2, .home h3 { margin: 0; font-weight: var(--kd-weight-medium); letter-spacing: .06px; text-wrap: balance; }
  .home p { margin: 0; }
  .home em { font-style: normal; }

  .home-eyebrow { font-size: var(--kd-text-xs); line-height: var(--kd-lh-xs); font-weight: var(--kd-weight-medium); letter-spacing: .04em; text-transform: uppercase; color: var(--kd-accent); }

  /* links: S step (21/28, weight 500) with an arrow, per the brand system */
  .home-link { font-size: var(--kd-text-s); line-height: var(--kd-lh-s); font-weight: var(--kd-weight-medium); text-decoration: none; }

  /* ---------- sections ---------- */
  .home-sec { padding: 72px 0; }
  .home-head { display: flex; flex-direction: column; gap: 12px; margin-bottom: 32px; max-width: 60ch; }
  .home-sec h2 { font-size: var(--kd-text-l); line-height: var(--kd-lh-l); }
  .home-sec h2 em { color: var(--kd-accent); }
  .home-lede { font-size: var(--kd-text-s); line-height: var(--kd-lh-s); color: var(--kd-fg-2); }

  /* ---------- offer cards (department colours, fixed in both themes) ---------- */
  .home-offers { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; }
  @media (max-width: 820px) { .home-offers { grid-template-columns: 1fr; } }
  .home-card { display: flex; flex-direction: column; gap: 18px; padding: 32px; border-radius: var(--kd-radius); min-height: 340px; text-decoration: none; transition: transform .18s ease; }
  .home-card:hover { transform: translateY(-4px); }
  .home-card h3 { font-size: var(--kd-text-m); line-height: var(--kd-lh-m); }
  .home-card p { font-size: 19px; line-height: 1.4; }
  .home-card .home-link { margin-top: auto; }
  .home-lbl { display: inline-flex; align-items: center; align-self: flex-start; padding: 3px 12px; border-radius: var(--kd-radius); font-size: 14px; font-weight: var(--kd-weight-medium); letter-spacing: .04em; text-transform: uppercase; }

  .home-card--product { background: var(--kd-dept-product); color: var(--kd-white); }
  /* icon accents per card ground: lime on blue, blue on lime, defaults on lilac */
  .home-card--product .home-lbl { background: var(--kd-signal-1); color: var(--kd-blue-1); }
  .home-card--product p { color: var(--kd-lilac-tint); }
  .home-card--product .home-link { color: var(--kd-signal-1); }
  .home-card--marketing { background: var(--kd-dept-marketing); color: var(--kd-blue-1); }
  .home-card--sales { background: var(--kd-dept-sales); color: var(--kd-blue-1); }
  .home-card--marketing .home-lbl, .home-card--sales .home-lbl { background: var(--kd-blue-2); color: var(--kd-white); }
  .home-card--marketing .home-link, .home-card--sales .home-link { color: var(--kd-blue-2); }

  /* ---------- client logos: white band between hero and offers ---------- */
  .home-logos { background: var(--kd-surface); border-bottom: 1px solid var(--kd-line); padding: 48px 0; text-align: center; }
  .home-logos-head { display: block; margin-bottom: 28px; }
  .home-logos .logo { filter: var(--kd-logo-filter); }
  .home .home-logos-note { max-width: 60ch; margin: 28px auto 0; font-size: 16px; line-height: 1.5; color: var(--kd-fg-2); }

  /* alternate ground for every second content section */
  .home-sec--alt { background: var(--kd-surface-2); }

  /* ---------- use cases: teaser cards (label, title, body, bundle, arrow link) ---------- */
  .home-uc-all { display: flex; width: fit-content; margin: 32px auto 0; }


  .home :where(a, button):focus-visible { outline: 2px solid var(--kd-accent); outline-offset: 2px; }
  @media (max-width: 640px) { .home-sec { padding: 56px 0; } .home-card { min-height: 0; } }
  @media (prefers-reduced-motion: reduce) { .home-card { transition: none; } .home-card:hover { transform: none; } }
</style>
